<view class="page {{barBelow ? 'has-tabbar' : 'tall'}} {{name}}" style="{{themeStyle}}">
  <view class="card" wx:if="{{!cards.length}}">
    <view class="empty">
      <text class="empty-mark">选</text>
      <text class="empty-text say">{{logged ? '暂无自选集合' : '登录后可查看自选集合'}}</text>
      <text class="hint empty-tip">将想温习的篇目加入集合，按自己的节奏安排复习</text>
      <button class="btn ghost mini empty-btn" wx:if="{{!logged}}" bindtap="onLogin">登录</button>
      <button class="btn ghost mini empty-btn" wx:else bindtap="onCollections">管理自选集合</button>
    </view>
  </view>

  <view wx:for="{{cards}}" wx:key="id" wx:for-item="coll">
    <view class="card-open coll-head" id="coll-{{coll.id}}">
      <text class="card-title poem">{{coll.name}}</text>
      <text class="card-sub">{{coll.sub}}</text>
    </view>

    <progress-view id="pv-{{coll.id}}" view="{{coll.view}}" defers="{{coll.defers}}"
                   ring-text="{{coll.ringText}}"
                   labels="{{coll.labels}}"
                   bind:open="onOpen" bind:defer="onOpenDefer" />
  </view>

  <view class="card" wx:if="{{cards.length}}">
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onCollections">
      <view class="row-main">
        <text class="row-title">管理自选集合</text>
        <text class="row-sub">新建 · 改名 · 增删篇目</text>
      </view>
      <text class="row-go">›</text>
    </view>
  </view>

  <recite-sheet id="sheet" theme-style="{{themeStyle}}"
                queue="{{sheetRows}}" bind:need="onSheetNeed" bind:finish="onSheetFinish" bind:defer="onDeferChange" />

  <view class="safe-bottom"></view>
  <tab-bar id="tabbar" current="4" />
</view>
