.card-open.coll-head {
  padding: var(--sp-2) var(--card-x);
}

.coll-head > .card-title {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dot {
  flex: none;
  margin-left: 0.5em;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
}

.empty-btn {
  margin: var(--sp-3) auto 0;
}
