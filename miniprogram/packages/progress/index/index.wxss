.overview {
  padding-top: var(--sp-4);
  padding-bottom: var(--sp-3);
}

.ov-head {
  display: flex;
  align-items: center;
  padding-bottom: var(--sp-3);
  border-bottom: 1rpx solid var(--line-2);
}

.ov-main {
  padding-left: var(--sp-3);
  min-width: 0;
}

.ov-title {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-lead);
  color: var(--strong-text);
  letter-spacing: var(--ls-title);
}

.ov-sub {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: var(--sp-1);
}

.ov-row {
  display: flex;
  padding-top: var(--sp-3);
}

.num-v.due {
  color: var(--amber);
}

.num-k {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 6rpx;
}

.warn {
  display: block;
  color: var(--amber);
  padding-top: var(--sp-3);
}

.day {
  min-height: 96rpx;
  padding: var(--sp-2) var(--sp-3);
  border-bottom: 1rpx solid var(--line-2);
}

.day.zero {
  min-height: 68rpx;
  padding: var(--sp-2) var(--sp-3);
}

.day.zero .day-label {
  font-size: var(--fs-hint);
  color: var(--ink-3);
}

.day.zero .day-count {
  opacity: .7;
}

.day:last-child {
  border-bottom: none;
}

.day-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.day-label {
  font-family: var(--font-poem);
  font-size: var(--fs-body);
  color: var(--ink-2);
  line-height: 1.4;
}

.day.today {
  border-radius: var(--radius-sm);
  background: var(--sink);
}

.day-label.today {
  color: var(--strong-text);
  font-weight: 600;
}

.day-count {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
}

.day-bar {
  margin-top: var(--sp-2);
}

.day-label.today + .day-count {
  color: var(--ink-2);
}

.day-items {
  display: flex;
  flex-wrap: wrap;
  margin-top: var(--sp-2);
}

.day-item {
  font-family: var(--font-poem);
  font-size: var(--fs-hint);
  color: var(--ink-2);
  margin: 0 var(--sp-3) var(--sp-1) 0;
}

.stage {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-2) 0;
  border-bottom: 1rpx solid var(--line-2);
}

.stage:last-child {
  border-bottom: none;
}

.stage-name {
  font-size: var(--fs-body);
  color: var(--ink-2);
}

.stage-count {
  font-family: var(--font-num);
  font-size: var(--fs-body);
  color: var(--strong-text);
  font-variant-numeric: tabular-nums;
}

.stage {
  min-height: 64rpx;
}
