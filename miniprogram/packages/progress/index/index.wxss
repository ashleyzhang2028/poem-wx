/* ---------- 总览 ---------- */
.overview {
  padding: var(--sp-4) var(--sp-4) var(--sp-3);
}

.ov-head {
  display: flex;
  align-items: center;
  padding-bottom: var(--sp-3);
  border-bottom: 1rpx solid var(--line-2);
}

/* 掌握度环：与首页那个进度环共用全局 .ring ——
   两个环放在一起要长得像，用户才会认成同一件事 */
.ov-ring {
  width: 116rpx;
  height: 116rpx;
  flex: none;
}

.ov-main {
  padding-left: var(--sp-3);
  min-width: 0;
}

.ov-title {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-lead);
  font-weight: 600;
  color: var(--ink);
  letter-spacing: var(--ls-title);
}

.ov-sub {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: var(--sp-1);
}

.ov-row {
  display: flex;
  padding-top: var(--sp-3);
}

.num-v.due {
  color: var(--amber);
}

.num-k {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 6rpx;
}

.warn {
  display: block;
  color: var(--amber);
  padding-top: var(--sp-3);
}

/* ---------- 未来七天 ---------- */
.day {
  padding: var(--sp-2) 0;
  border-bottom: 1rpx solid var(--line-2);
}

/* 没有排期的那几天不占版面：一行高度 + 一个零。
   两行都是「0 首」，字却按「今天」那一行的大小排，扫下来像是五天都有内容 ——
   所以整行压低一档：字号降、颜色推远，让它读起来就是「空」 */
.day.zero {
  padding: 10rpx 0;
}

.day.zero .day-label {
  font-size: var(--fs-hint);
  color: var(--ink-3);
}

.day.zero .day-count {
  opacity: .7;
}

.day:last-child {
  border-bottom: none;
}

.day-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 日期那一行的字：与「几首」同一档 —— 同一行里两个字号的差不能超过一档，
   否则「10/6」会比它右边的「0 首」大出一截，看着像标题配脚注 */
.day-label {
  font-family: var(--font-poem);
  font-size: var(--fs-body);
  color: var(--ink-2);
  line-height: 1.4;
}

/* 「今天」那一行：左侧一道墨线 + 加重字色。
   上一版只把字染成主色 —— 七天里有六天都是灰的，唯一那点绿确实显眼，
   但「显眼」和「看得出一行是一行」不是一件事：零排期那几天字号更小、
   整行更矮，今天这一行不加一道线，跟它们排在一起还是容易看串。 */
.day.today {
  box-shadow: inset 6rpx 0 0 var(--ink);
  padding-left: var(--sp-3);
  border-radius: var(--radius-sm);
  background: var(--sink);
}

.day-label.today {
  color: var(--ink);
  font-weight: 600;
}

.day-count {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
}

.day-bar {
  margin-top: 12rpx;
}

.day-label.today + .day-count {
  color: var(--ink-2);
}

.day-items {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.day-item {
  font-family: var(--font-poem);
  font-size: var(--fs-hint);
  color: var(--ink-2);
  margin: 0 var(--sp-3) var(--sp-1) 0;
}

/* ---------- 记忆阶段 ---------- */
.stage {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-2) 0;
  border-bottom: 1rpx solid var(--line-2);
}

.stage:last-child {
  border-bottom: none;
}

.stage-name {
  font-size: var(--fs-body);
  color: var(--ink-2);
}

.stage-count {
  font-family: var(--font-num);
  font-size: var(--fs-body);
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}

/* 记忆阶段里那几行：名字是说明、数字是结论，两者同档同高 */
.stage {
  min-height: 64rpx;
}
