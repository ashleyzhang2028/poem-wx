/* ---------- 总览 ---------- */
.overview {
  padding: var(--sp-4) var(--sp-4) var(--sp-3);
}

.ov-head {
  display: flex;
  align-items: center;
  padding-bottom: var(--sp-3);
  border-bottom: 1rpx solid var(--line-2);
}

/* 掌握度环：与首页那个进度环共用全局 .ring ——
   两个环放在一起要长得像，用户才会认成同一件事 */
.ov-ring {
  width: 116rpx;
  height: 116rpx;
  flex: none;
}

.ov-main {
  padding-left: var(--sp-3);
  min-width: 0;
}

.ov-title {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-lead);
  font-weight: 600;
  color: var(--green);
  letter-spacing: 1rpx;
}

.ov-sub {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: var(--sp-1);
}

.ov-row {
  display: flex;
  padding-top: var(--sp-3);
}

.num {
  flex: 1;
  text-align: center;
}

.num-v {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-hero);
  font-weight: 600;
  color: var(--green);
  font-variant-numeric: tabular-nums;
}

.num-v.due {
  color: var(--amber);
}

.num-k {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 6rpx;
}

.warn {
  display: block;
  color: var(--amber);
  padding-top: var(--sp-3);
}

/* ---------- 未来七天 ---------- */
.day {
  padding: var(--sp-2) 0;
  border-bottom: 1rpx solid var(--line-2);
}

/* 没有排期的那几天不占版面：一行高度 + 一个零 */
.day.zero {
  padding: 10rpx 0;
}

.day:last-child {
  border-bottom: none;
}

.day-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.day-label {
  font-family: var(--font-poem);
  font-size: var(--fs-title);
  color: var(--ink-2);
}

/* 「今天」那一行给主色：七天里只要一眼认得出哪行是今天 */
.day-label.today {
  color: var(--green);
  font-weight: 600;
}

.day-count {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
}

.day-bar {
  margin-top: 12rpx;
}

/* 未来七天里，今天那一条用琥珀色 —— 七天里只要一眼认出哪条是今天 */
.day-label.today + .day-count {
  color: var(--green);
}

.day-items {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.day-item {
  font-family: var(--font-poem);
  font-size: var(--fs-hint);
  color: var(--ink-2);
  margin: 0 var(--sp-3) var(--sp-1) 0;
}

/* ---------- 记忆阶段 ---------- */
.stage {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-2) 0;
  border-bottom: 1rpx solid var(--line-2);
}

.stage:last-child {
  border-bottom: none;
}

.stage-name {
  font-size: var(--fs-body);
  color: var(--ink-2);
}

.stage-count {
  font-family: var(--font-poem);
  font-size: var(--fs-body);
  color: var(--green);
  font-variant-numeric: tabular-nums;
}
