<view class="page">
  <lock-card wx:if="{{locked}}" title="进度要登录" note="背诵进度要登录之后才看得到。本机数据不会因为登录被上传，同步是你主动点的事。" mark="进" />

  <block wx:else>
  <view class="page-head">
    <text class="head-title">走到哪了</text>
    <text class="head-sub">未来七天排期 · 记忆阶段分布</text>
  </view>

  <view class="card overview">
    <view class="ov-head">
      <view class="ring ov-ring">
        <view class="ring-track"></view>
        <view class="ring-fill" style="--p:{{masteryPercent}}"></view>
        <text class="ring-text">{{masteryPercent}}%</text>
      </view>
      <view class="ov-main">
        <text class="ov-title">掌握度</text>
        <text class="ov-sub">已掌握 {{overview.mastered}} / 已学 {{overview.learned}}</text>
      </view>
    </view>

    <view class="ov-row">
      <view class="num">
        <text class="num-v">{{overview.learned}}</text>
        <text class="num-k">已学</text>
      </view>
      <view class="num">
        <text class="num-v">{{overview.mastered}}</text>
        <text class="num-k">已掌握</text>
      </view>
      <view class="num">
        <text class="num-v {{overview.dueToday ? 'due' : ''}}">{{overview.dueToday}}</text>
        <text class="num-k">今日到期</text>
      </view>
    </view>

    <text class="hint warn" wx:if="{{backlogCount}}">有 {{backlogCount}} 首已经逾期，今天背的时候会优先排进来。</text>
  </view>

  <view class="card">
    <view class="card-title bar">未来七天</view>
    <view class="day {{item.count ? '' : 'zero'}}" wx:for="{{days}}" wx:key="label">
      <view class="day-head">
        <text class="day-label {{item.today ? 'today' : ''}}">{{item.label}}</text>
        <text class="day-count">{{item.count}} 首</text>
      </view>
      <view class="meter day-bar" wx:if="{{item.count}}">
        <view class="meter-fill day-bar-fill" style="width:{{item.percent}}%"></view>
      </view>
      <view class="day-items" wx:if="{{item.items.length}}">
        <text class="day-item" wx:for="{{item.items}}" wx:for-item="p" wx:key="id">{{p.title}}</text>
      </view>
    </view>
    <text class="hint" wx:if="{{farther}}">另有 {{farther}} 首排在七天之外</text>
    <view class="empty" wx:if="{{!days.length}}">
      <text class="empty-mark">空</text>
      <text class="empty-text">还没有排期
先去首页背一首</text>
    </view>
  </view>

  <view class="card" wx:if="{{stageRows.length}}">
    <view class="card-title bar">记忆阶段</view>
    <view class="stage" wx:for="{{stageRows}}" wx:key="name">
      <text class="stage-name">{{item.name}}</text>
      <text class="stage-count">{{item.count}}</text>
    </view>
  </view>

  <view class="empty" wx:if="{{!overview.learned}}">
    <text class="empty-mark">始</text>
    <text class="empty-text">还没有背诵记录
去首页开始第一首</text>
  </view>

  <view class="safe-bottom"></view>
  </block>
</view>
