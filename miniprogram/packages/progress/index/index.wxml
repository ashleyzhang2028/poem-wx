<view class="page" style="{{themeStyle}}">
  <lock-card wx:if="{{locked}}" title="进度要登录" note="登录后才能看" mark="进" />

  <block wx:else>
  <view class="page-head">
    <text class="head-title">背诵概览</text>
  </view>

  <view class="card overview">
    <view class="ov-head">
      <view class="ring ov-ring">
        <view class="ring-track"></view>
        <view class="ring-fill" style="--p:{{masteryPercent}}"></view>
        <text class="ring-text">{{masteryPercent}}%</text>
      </view>
      <view class="ov-main">
        <text class="ov-title">掌握度</text>
        <text class="ov-sub">已掌握 {{overview.mastered}} / 已学 {{overview.learned}}</text>
      </view>
    </view>

    <view class="stats ov-row">
      <view class="stat">
        <text class="stat-v">{{overview.learned}}</text>
        <text class="stat-k">已学</text>
      </view>
      <view class="stat">
        <text class="stat-v">{{overview.mastered}}</text>
        <text class="stat-k">已掌握</text>
      </view>
      <view class="stat">
        <text class="stat-v {{overview.dueToday ? 'due' : ''}}">{{overview.dueToday}}</text>
        <text class="stat-k">今日到期</text>
      </view>
    </view>

    <text class="hint warn" wx:if="{{backlogCount}}">逾期 {{backlogCount}} 首 · 会优先排进今天</text>
  </view>

  <view class="card">
    <view class="card-title bar">未来七天</view>
    <view class="day {{item.count ? '' : 'zero'}} {{item.today ? 'today' : ''}}" wx:for="{{days}}" wx:key="label">
      <view class="day-head">
        <text class="day-label {{item.today ? 'today' : ''}}">{{item.label}}</text>
        <text class="day-count">{{item.count}} 首</text>
      </view>
      <view class="meter day-bar" wx:if="{{item.count}}">
        <view class="meter-fill day-bar-fill" style="width:{{item.percent}}%"></view>
      </view>
      <view class="day-items" wx:if="{{item.items.length}}">
        <text class="day-item" wx:for="{{item.items}}" wx:for-item="p" wx:key="id">{{p.title}}</text>
      </view>
    </view>
    <text class="hint" wx:if="{{farther}}">另有 {{farther}} 首在七天外</text>
    <view class="empty" wx:if="{{!days.length}}">
      <text class="empty-mark">空</text>
      <text class="empty-text">还没有排期</text>
    </view>
  </view>

  <view class="empty" wx:if="{{!overview.learned}}">
    <text class="empty-mark">始</text>
    <text class="empty-text">还没有背诵记录</text>
  </view>

  <view class="safe-bottom"></view>
  </block>
</view>
