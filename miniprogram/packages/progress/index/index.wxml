<view class="page {{barBelow ? 'has-tabbar' : 'tall'}}" style="{{themeStyle}}">
  <progress-view view="{{view}}" defers="{{defers}}" ring-text="{{ringText}}"
                 bind:open="onOpen" bind:defer="onOpenDefer" />

  <view class="card" wx:if="{{selfOn}}">
    <text class="card-title">自选背诵</text>
    <text class="hint self-lead">自选集合的进度另有一页，每个集合一份读数</text>
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onSelf">
      <view class="row-main">
        <text class="row-title">自选集合的背诵进度</text>
        <text class="row-sub">{{selfSub}}</text>
      </view>
      <text class="row-go">›</text>
    </view>
  </view>

  <view class="card" wx:if="{{selfOn && !selfCount}}">
    <view class="empty">
      <text class="empty-mark">选</text>
      <text class="empty-text say">还没有自选集合</text>
      <text class="hint empty-tip">在课外阅读或搜索里看到好诗，加进自己的集合</text>
    </view>
  </view>

  <recite-sheet id="sheet" theme-style="{{themeStyle}}"
                queue="{{sheetRows}}" bind:finish="onSheetFinish" bind:defer="onDeferChange" />

  <view class="safe-bottom"></view>
  <tab-bar id="tabbar" current="4" />
</view>
