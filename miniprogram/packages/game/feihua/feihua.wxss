.opt-group {
  display: flex;
  flex-wrap: wrap;
  margin: 16rpx 0 0;
}

.pref-item {
  display: flex;
  align-items: center;
  font-size: 27rpx;
  color: var(--ink-2);
  padding-right: 20rpx;
}

.pref-item radio {
  transform: scale(.8);
}

.chars {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}

.char {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--line);
  background: var(--bg-soft);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.char.active {
  background: var(--green-light);
  border-color: var(--green);
}

/* 原生圆点收到右上角，96rpx 的字块中心留给那个字 */
.char-radio {
  position: absolute;
  right: -6rpx;
  top: -6rpx;
  transform: scale(.6);
}

.char-t {
  font-family: var(--font-poem);
  font-size: 38rpx;
  color: var(--ink);
  line-height: 1.1;
}

.char.active .char-t {
  color: var(--green);
}

.char-n {
  font-size: 18rpx;
  color: var(--ink-3);
}

.char.active .char-n {
  color: var(--green);
  opacity: .75;
}

.fh-line {
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line-2);
}

.fh-line:last-child {
  border-bottom: none;
}

.fh-seg {
  display: block;
  font-family: var(--font-poem);
  font-size: 32rpx;
  color: var(--ink);
  line-height: 1.7;
}

.fh-src {
  display: block;
  font-size: 23rpx;
  color: var(--ink-3);
  margin-top: 8rpx;
}

.said {
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line-2);
}

.said-t {
  font-family: var(--font-poem);
  font-size: 31rpx;
  color: var(--green);
}

.lv-input {
  margin: 24rpx 0 20rpx;
}

.actions {
  display: flex;
  gap: 16rpx;
}

.actions .btn {
  flex: 1;
}

.fh-msg {
  display: block;
  text-align: center;
  padding-top: 20rpx;
}

.fh-msg.ok {
  color: var(--green);
}

.fh-msg.no {
  color: var(--red);
}

.fh-tip {
  display: block;
  text-align: center;
  padding: 40rpx 0;
}

/* 未登录 / 档位不够时的那张卡 */
.locked-card .note {
  display: block;
  margin-top: 16rpx;
}

.locked-btn {
  margin-top: 32rpx;
}
