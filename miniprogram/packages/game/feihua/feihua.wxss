.fh-stage {
  text-align: center;
}

.fh-scope {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  letter-spacing: var(--ls-caption);
}

.fh-char {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--sp-5) 0 var(--sp-4);
}

.fh-char-t {
  font-family: var(--font-poem);
  font-size: var(--fs-glyph);
  line-height: 1;
  color: var(--ink);
}

.fh-ask {
  display: block;
  font-size: var(--fs-hint);
  color: var(--ink-3);
  margin-bottom: var(--sp-2);
}

.fh-field {
  margin: var(--sp-2) 0 var(--sp-3);
}

.fh-actions {
  display: flex;
  gap: var(--sp-2);
}

.fh-actions .btn {
  flex: 1;
}

.fh-msg {
  display: block;
  font-size: var(--fs-body);
  padding-top: var(--sp-3);
  line-height: var(--lh-loose);
}

.fh-msg.ok {
  color: var(--green);
}

.fh-msg.no {
  color: var(--red);
}

.fh-note {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  padding-top: var(--sp-2);
}

.fh-line {
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line-2);
}

.fh-line:last-child {
  border-bottom: none;
}

.fh-seg {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-title);
  color: var(--ink);
  line-height: 1.7;
}

.fh-src {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 8rpx;
}

.fh-reveal {
  margin-top: var(--sp-3);
}
