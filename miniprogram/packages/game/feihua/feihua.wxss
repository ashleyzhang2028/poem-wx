.opt-group {
  display: flex;
  flex-wrap: wrap;
  margin: 16rpx 0 0;
}

.pref-item {
  display: flex;
  align-items: center;
  font-size: var(--fs-body);
  color: var(--ink-2);
  padding-right: 20rpx;
}

.pref-item radio {
  transform: scale(.8);
}

.chars {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}

.char {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--line);
  background: var(--bg-soft);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.char.active {
  background: var(--green-light);
  border-color: var(--green);
}

/* 原生圆点收到右上角，96rpx 的字块中心留给那个字 */
.char-radio {
  position: absolute;
  right: -6rpx;
  top: -6rpx;
  transform: scale(.6);
}

.char-t {
  font-family: var(--font-poem);
  font-size: var(--fs-hero);
  color: var(--ink);
  line-height: 1.1;
}

.char.active .char-t {
  color: var(--green);
}

.char-n {
  font-size: var(--fs-pinyin);
  color: var(--ink-3);
}

.char.active .char-n {
  color: var(--green);
  opacity: .75;
}

.fh-line {
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line-2);
}

.fh-line:last-child {
  border-bottom: none;
}

.fh-seg {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-title);
  color: var(--ink);
  line-height: 1.7;
}

.fh-src {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 8rpx;
}

.said {
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line-2);
}

.said-t {
  font-family: var(--font-poem);
  font-size: var(--fs-title);
  color: var(--green);
}

.lv-input {
  margin: 24rpx 0 20rpx;
}

.actions {
  display: flex;
  gap: 16rpx;
}

.actions .btn {
  flex: 1;
}

.fh-msg {
  display: block;
  text-align: center;
  padding-top: 20rpx;
}

.fh-msg.ok {
  color: var(--green);
}

.fh-msg.no {
  color: var(--red);
}

.fh-tip {
  display: block;
  text-align: center;
  padding: 40rpx 0;
}

/* 令字那一档是空的（生僻档常见）：给一句话，不留一块空白 */
.char-empty {
  display: block;
  padding: var(--sp-3) 0;
  text-align: center;
}

/* 分组小标题（玩法 / 档位）：压低一档，它是目录不是内容 */
.opt-label {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  letter-spacing: var(--ls-caption);
  padding: var(--sp-1) 0 2rpx;
}
