.fh-stage {
  text-align: center;
}

.fh-head {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
}

.fh-scope {
  flex: 1;
  min-width: 0;
  text-align: left;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  letter-spacing: var(--ls-caption);
}

.fh-clock {
  flex: none;
  font-family: var(--font-num);
  font-size: var(--fs-hint);
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
}

.fh-clock.urgent {
  color: var(--red);
  animation: clock-beat 1s ease-in-out infinite;
}

.fh-bar {
  height: 4rpx;
  margin: var(--sp-2) 0;
  border-radius: var(--radius-pill);
  background: var(--sink);
  overflow: hidden;
}

.fh-bar-fill {
  height: 100%;
  border-radius: var(--radius-pill);
  background: var(--strong);
  transition: width 1s linear;
}

.fh-bar-fill.urgent {
  background: var(--red);
}

@keyframes clock-beat {
  50% {
    transform: scale(1.25);
  }
}

.fh-open {
  flex: none;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  padding-left: var(--sp-2);
}

.fh-char {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--sp-2);
  padding: var(--sp-4) 0 var(--sp-2);
}

.fh-mark {
  font-size: var(--fs-lead);
  color: var(--strong-text);
}

.fh-char-t {
  font-family: var(--font-poem);
  font-size: calc(var(--fs-glyph) * .8);
  line-height: 1;
  color: var(--strong);
}

.fh-ask {
  display: block;
  font-size: var(--fs-hint);
  color: var(--ink-3);
  margin-bottom: var(--sp-2);
}

.fh-stage .inline-btns .btn,
.fh-stage .inline-btns .btn.mini {
  flex: 1;
  padding: 0;
  font-size: var(--fs-title);
  letter-spacing: var(--ls-title);
  line-height: 1.2;
}

.fh-field {
  margin: var(--sp-2) 0 var(--sp-3);
}

.fh-msg {
  display: block;
  font-size: var(--fs-body);
  padding-top: var(--sp-3);
  line-height: var(--lh-loose);
}

.fh-msg.ok {
  color: var(--green);
}

.fh-msg.no {
  color: var(--red);
}

.fh-msg.wait {
  color: var(--ink-3);
}

.fh-start {
  margin: var(--sp-2) 0;
}

.fh-loading {
  display: block;
  padding: var(--sp-3) 0;
  font-size: var(--fs-hint);
  color: var(--ink-3);
}

.fh-remark {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-body);
  color: var(--ink-2);
  letter-spacing: var(--ls-title);
  line-height: var(--lh-loose);
  padding-top: var(--sp-3);
}

.fh-cheer {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-body);
  color: var(--strong-text);
  line-height: var(--lh-loose);
  padding-top: var(--sp-2);
}

.fh-note {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  padding-top: var(--sp-2);
}

.fh-line {
  padding: var(--sp-3) 0;
  border-bottom: 1rpx solid var(--line-2);
}

.fh-line:last-child {
  border-bottom: none;
}

.fh-seg {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-title);
  color: var(--ink);
  line-height: 1.7;
}

.fh-src {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: var(--sp-1);
}

.fh-note.ranked {
  color: var(--strong-text);
}

.restart {
  margin-top: var(--sp-3);
}

.qa-line {
  display: flex;
  align-items: flex-start;
  gap: var(--sp-2);
  padding: var(--sp-2) 0;
  border-bottom: 1rpx solid var(--line-2);
}

.qa-line:last-child {
  border-bottom: none;
}

.qa-n {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  border-radius: var(--radius-pill);
  background: var(--strong-soft);
  color: var(--strong-text);
  font-family: var(--font-num);
  font-size: var(--fs-caption);
  font-variant-numeric: tabular-nums;
  display: flex;
  align-items: center;
  justify-content: center;
}

.qa-body {
  flex: 1;
  min-width: 0;
}

.qa-seg {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-title);
  color: var(--ink);
  line-height: 1.7;
}

.qa-src {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

.pick {
  padding-bottom: var(--sp-2);
}

.pick-search {
  margin-bottom: var(--sp-1);
}

.pick-input {
  flex: 1;
  min-width: 0;
  font-family: var(--font-poem);
  font-size: var(--fs-body);
  color: var(--ink);
}

.pick-go {
  flex: none;
  font-size: var(--fs-caption);
  color: var(--strong-text);
  padding-left: var(--sp-2);
}

.pick-go.open {
  color: var(--ink-3);
}

.pick-meta {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-2);
  padding: 0 2rpx var(--sp-1);
}

.pick-meta-t {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  letter-spacing: var(--ls-caption);
}

.pick-panel {
  max-height: 0;
  border-top: 1rpx solid transparent;
  overflow: hidden;
  opacity: 0;
  transition: max-height var(--t-move) var(--ease), opacity var(--t-move) var(--ease),
    padding-top var(--t-move) var(--ease), border-top-color var(--t-move) var(--ease);
}

.pick-panel.open {
  max-height: 6000rpx;
  padding-top: var(--sp-2);
  border-top-color: var(--line-2);
  opacity: 1;
}

.pick-scopes {
  margin-top: var(--sp-2);
}

.pick-head {
  display: flex;
  align-items: center;
  height: var(--h-opt-tight);
  margin-bottom: var(--sp-1);
  border-radius: var(--radius-sm);
}

.pick-head-hover {
  background: var(--sink);
}

.pick-head-t {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-caption);
  color: var(--ink-2);
  letter-spacing: var(--ls-caption);
}

.pick-fold {
  flex: none;
  display: flex;
  align-items: center;
  gap: var(--sp-1);
}

.pick-fold-t {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  letter-spacing: var(--ls-caption);
}

.pick-arrow {
  flex: none;
  width: 14rpx;
  height: 14rpx;
  margin-top: -6rpx;
  border-right: 2rpx solid var(--ink-3);
  border-bottom: 2rpx solid var(--ink-3);
  transform: rotate(45deg);
  transition: transform var(--t-move) var(--ease), margin-top var(--t-move) var(--ease);
}

.pick-arrow.up {
  margin-top: 0;
  transform: rotate(225deg);
}

.pick-group-head {
  margin-top: var(--sp-2);
  display: flex;
  align-items: center;
  gap: var(--sp-1);
  height: var(--h-opt-tight);
  border-radius: var(--radius-sm);
}

.pick-group-name {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  letter-spacing: var(--ls-caption);
}

.pick-count {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-family: var(--font-num);
  font-size: var(--fs-caption);
  color: var(--ink-4);
  font-variant-numeric: tabular-nums;
}

.pick-chars {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-1);
  padding-bottom: var(--sp-1);
  opacity: 1;
  overflow: hidden;
  transition: max-height var(--t-move) var(--ease), opacity var(--t-move) var(--ease),
    padding-bottom var(--t-move) var(--ease);
}

.pick-chars.folded {
  max-height: 0;
  padding-bottom: 0;
  opacity: 0;
}

.pick-chip {
  flex: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 68rpx;
  height: 60rpx;
  padding: 0 var(--sp-2);
  border-radius: var(--radius-sm);
  background: var(--sink);
  font-family: var(--font-poem);
  font-size: var(--fs-body);
  line-height: 1;
  color: var(--ink-2);
  transition: background var(--t-press) var(--ease), color var(--t-press) var(--ease);
}

.pick-chip.on {
  background: var(--strong);
  color: var(--on-ink);
}

.pick-chip.dim {
  opacity: .42;
}
