.fh-stage {
  text-align: center;
}

.fh-head {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
}

.fh-scope {
  flex: 1;
  min-width: 0;
  text-align: left;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  letter-spacing: var(--ls-caption);
}

.fh-clock {
  flex: none;
  font-family: var(--font-num);
  font-size: var(--fs-hint);
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
}

.fh-clock.urgent {
  color: var(--red);
  animation: clock-beat 1s ease-in-out infinite;
}

.fh-bar {
  height: 4rpx;
  margin: var(--sp-2) 0;
  border-radius: var(--radius-pill);
  background: var(--sink);
  overflow: hidden;
}

.fh-bar-fill {
  height: 100%;
  border-radius: var(--radius-pill);
  background: var(--strong);
  transition: width 1s linear;
}

.fh-bar-fill.urgent {
  background: var(--red);
}

@keyframes clock-beat {
  50% {
    transform: scale(1.25);
  }
}

.fh-open {
  flex: none;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  padding-left: var(--sp-2);
}

.fh-char {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--sp-2);
  padding: var(--sp-4) 0 var(--sp-2);
}

.fh-mark {
  font-size: var(--fs-lead);
  color: var(--strong-text);
}

.fh-char-t {
  font-family: var(--font-poem);
  font-size: calc(var(--fs-glyph) * .8);
  line-height: 1;
  color: var(--ink);
}

.fh-ask {
  display: block;
  font-size: var(--fs-hint);
  color: var(--ink-3);
  margin-bottom: var(--sp-2);
}

.fh-stage .inline-btns .btn,
.fh-stage .inline-btns .btn.mini {
  flex: 1;
  height: var(--h-opt-tight);
  padding: 0;
  font-size: var(--fs-title);
  letter-spacing: var(--ls-title);
  line-height: 1.2;
}

.fh-field {
  margin: var(--sp-2) 0 var(--sp-3);
}

.fh-msg {
  display: block;
  font-size: var(--fs-body);
  padding-top: var(--sp-3);
  line-height: var(--lh-loose);
}

.fh-msg.ok {
  color: var(--green);
}

.fh-msg.no {
  color: var(--red);
}

.fh-remark {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-body);
  color: var(--ink-2);
  letter-spacing: var(--ls-title);
  line-height: var(--lh-loose);
  padding-top: var(--sp-3);
}

.fh-cheer {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-body);
  color: var(--strong-text);
  line-height: var(--lh-loose);
  padding-top: var(--sp-2);
}

.fh-note {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  padding-top: var(--sp-2);
}

.fh-line {
  padding: var(--sp-3) 0;
  border-bottom: 1rpx solid var(--line-2);
}

.fh-line:last-child {
  border-bottom: none;
}

.fh-seg {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-title);
  color: var(--ink);
  line-height: 1.7;
}

.fh-src {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: var(--sp-1);
}

.fh-note.ranked {
  color: var(--strong-text);
}

.restart {
  margin-top: var(--sp-3);
}

.qa-line {
  display: flex;
  align-items: flex-start;
  gap: var(--sp-2);
  padding: var(--sp-2) 0;
  border-bottom: 1rpx solid var(--line-2);
}

.qa-line:last-child {
  border-bottom: none;
}

.qa-n {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  border-radius: var(--radius-pill);
  background: var(--strong-soft);
  color: var(--strong-text);
  font-family: var(--font-num);
  font-size: var(--fs-caption);
  font-variant-numeric: tabular-nums;
  display: flex;
  align-items: center;
  justify-content: center;
}

.qa-body {
  flex: 1;
  min-width: 0;
}

.qa-seg {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-title);
  color: var(--ink);
  line-height: 1.7;
}

.qa-src {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
}
