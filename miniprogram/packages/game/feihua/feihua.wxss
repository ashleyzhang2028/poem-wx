/* .opt-group / .pref-item 的排布在 app.wxss 里定一次，这里不再重复；
   这一页只留「令字格比上一行多留一口气」这件事 */
.chars {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-2);
  margin-top: var(--sp-2);
}

.fh-line {
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line-2);
}

.fh-line:last-child {
  border-bottom: none;
}

.fh-seg {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-title);
  color: var(--ink);
  line-height: 1.7;
}

.fh-src {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 8rpx;
}

.said {
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line-2);
}

.said-t {
  font-family: var(--font-poem);
  font-size: var(--fs-title);
  color: var(--green);
}

.lv-input {
  margin: 24rpx 0 20rpx;
}

.fh-msg {
  display: block;
  text-align: center;
  padding-top: 20rpx;
}

.fh-msg.ok {
  color: var(--green);
}

.fh-msg.no {
  color: var(--red);
}

.fh-tip {
  display: block;
  text-align: center;
  padding: 40rpx 0;
}

/* 令字那一档是空的（生僻档常见）：给一句话，不留一块空白 */
.char-empty {
  display: block;
  padding: var(--sp-3) 0;
  text-align: center;
}

/* 分组小标题（玩法 / 档位）：压低一档，它是目录不是内容 */
.opt-label {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  letter-spacing: var(--ls-caption);
  padding: var(--sp-1) 0 2rpx;
}
