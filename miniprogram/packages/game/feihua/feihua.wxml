<view class="page {{barBelow ? 'has-tabbar' : 'tall'}}" style="{{themeStyle}}">
  <lock-card wx:if="{{!allowed}}" title="飞花令" note="登录后才能玩" mark="令" bind:login="onLogin" />

  <block wx:else>

    <view class="card fh-stage {{flash ? 'flash ' + flash : ''}}">
      <view class="fh-head">
        <text class="fh-scope">{{scopeName}}</text>
        <text class="combo {{streak >= 5 ? 'hot' : ''}}" wx:if="{{streak >= 2}}">{{streak}} 连对</text>
        <text class="fh-clock {{urgent ? 'urgent' : ''}}">{{leftText}}</text>
      </view>

      <view class="fh-bar"><view class="fh-bar-fill {{urgent ? 'urgent' : ''}}" style="width:{{leftPct}}%"></view></view>

      <view class="fh-char">
        <text class="fh-char-t">{{char || '令'}}</text>
        <text class="fh-mark" wx:if="{{mark}}">{{mark}}</text>
      </view>
      <text class="fh-ask">{{ask}}</text>

      <view class="field fh-field {{flash ? 'flash ' + flash : ''}}">
        <input class="field-input" value="{{input}}" placeholder="例如：云深不知处"
               confirm-type="done" focus="{{!locked}}"
               bindinput="onInput" bindconfirm="onSubmit" />
      </view>

      <view class="inline-btns">
        <button class="btn ghost" bindtap="onHint" disabled="{{locked || hinted}}">提示</button>
        <button class="btn primary" bindtap="onSubmit" disabled="{{locked}}">接令</button>
        <button class="btn ghost" bindtap="onSkip">换令</button>
      </view>

      <text class="fh-msg {{messageOk ? 'ok' : 'no'}}" wx:if="{{message}}">{{message}}</text>

      <text class="fh-cheer" wx:if="{{cheerLine}}">{{cheerLine}}</text>

      <text class="fh-note" wx:if="{{streak}}">连对 {{streak}} 句 · 最好 {{best}} 句</text>
      <text class="fh-note ranked" wx:if="{{ranked}}">这一轮 {{lastScore}} 句已上榜 · {{rankWhere}}</text>

      <text class="fh-remark" wx:if="{{remark}}">{{remark}}</text>

      <button class="btn ghost block restart" wx:if="{{locked && done.length}}" bindtap="onRestart">
        再开一轮
      </button>
    </view>

    <view class="card log-card" hover-class="log-hover" hover-stay-time="60" bindtap="onLog">
      <view class="log-glyph">录</view>
      <view class="log-main">
        <view class="log-head">
          <text class="gc-name">成绩记录</text>
        </view>
        <text class="log-sub">{{log.line}}</text>
      </view>
      <text class="row-go">›</text>
    </view>

    <view class="card" wx:if="{{done.length}}">
      <view class="card-title">这一轮接上的</view>
      <view class="qa-line" wx:for="{{done}}" wx:key="index">
        <text class="qa-n">{{index + 1}}</text>
        <view class="qa-body">
          <text class="qa-seg">{{item.seg}}</text>
          <text class="qa-src" wx:if="{{item.title}}">{{item.title}}</text>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="card-open" bindtap="onReveal" hover-class="card-hover" hover-stay-time="60">
        <text class="card-title">看看还有哪些</text>
        <text class="fh-open">{{revealed ? '收起' : '展开'}}</text>
      </view>
      <view wx:if="{{revealed}}">
        <view class="fh-line" hover-class="row-hover" hover-stay-time="60"
              wx:for="{{answers}}" wx:key="index" data-id="{{item.id}}" bindtap="onOpen">
          <text class="fh-seg">{{item.seg}}</text>
          <text class="fh-src">{{item.title}} · {{item.author}}</text>
        </view>
        <view class="empty" wx:if="{{!answers.length}}">
          <text class="empty-mark">字</text>
          <text class="empty-text">这个范围里没有含「{{char}}」的句子</text>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="card-head">
        <text class="card-title">出题范围</text>
      </view>
      <radio-group class="opt-group inline tight cols-3" bindchange="onScope">
        <label class="opt-row {{scope === item.id ? 'active' : ''}}" wx:for="{{scopes}}" wx:key="id">
          <radio class="opt-radio" value="{{item.id}}" checked="{{scope === item.id}}" />
          <view class="opt-main">
            <text class="opt-name">{{item.name}}</text>
          </view>
        </label>
      </radio-group>
    </view>

    <view class="card">
      <text class="field-label">难度</text>
      <view class="seg">
        <radio-group class="seg-group" bindchange="onLevel">
          <label class="seg-item mini {{level === item.id ? 'on' : ''}}" wx:for="{{levels}}" wx:key="id">
            <radio class="seg-radio" value="{{item.id}}" checked="{{level === item.id}}" />
            <text class="seg-text">{{item.name}}</text>
          </label>
        </radio-group>
      </view>
    </view>
  </block>

  <view class="safe-bottom"></view>
  <tab-bar id="tabbar" current="2" />
</view>
