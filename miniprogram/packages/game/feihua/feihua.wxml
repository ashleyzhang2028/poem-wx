<view class="page {{barBelow ? 'has-tabbar' : 'tall'}} {{name}}" style="{{themeStyle}}">
  <lock-card wx:if="{{!allowed}}" title="飞花令" note="{{lockNote}}" mark="令" bind:login="onLogin" />

  <block wx:else>

    <view class="card pick">
      <view class="search pick-search" hover-class="search-hover" hover-stay-time="60" bindtap="onPickToggle">
        <view class="search-icon" style="mask-image:url('{{icons.search}}');-webkit-mask-image:url('{{icons.search}}');"></view>
        <input class="pick-input" value="{{char}}" placeholder="挑一个令字" disabled
               confirm-type="search" bindconfirm="onPickToggle" />
        <text class="pick-go {{picking ? 'open' : ''}}">{{picking ? '收起' : '换字'}}</text>
      </view>

      <view class="pick-meta">
        <text class="pick-meta-t">{{scopeName}} · {{levelName}}</text>
        <text class="pick-meta-t" wx:if="{{corpusReady === false}}">课内语料还没到位，先按诗词漫读找</text>
      </view>

      <view class="pick-panel {{picking ? 'open' : ''}}">
        <view class="pick-head" hover-class="pick-head-hover" hover-stay-time="60" bindtap="onPickOpen">
          <text class="pick-head-t">挑一个令字</text>
          <text class="pick-fold">
            <text class="pick-fold-t">收起</text>
            <view class="pick-arrow up"></view>
          </text>
        </view>
        <view class="seg">
          <radio-group class="seg-group" bindchange="onLevel">
            <label class="seg-item mini {{level === item.id ? 'on' : ''}}" wx:for="{{levels}}" wx:key="id">
              <radio class="seg-radio" value="{{item.id}}" checked="{{level === item.id}}" />
              <text class="seg-text">{{item.name}}</text>
            </label>
          </radio-group>
        </view>
        <radio-group class="opt-group grid pick-scopes" bindchange="onScope">
          <label class="opt-row {{scope === item.id ? 'active' : ''}}" wx:for="{{scopes}}" wx:key="id">
            <radio class="opt-radio" value="{{item.id}}" checked="{{scope === item.id}}" />
            <view class="opt-main">
              <text class="opt-name">{{item.name}}</text>
            </view>
          </label>
        </radio-group>
        <block wx:for="{{groups}}" wx:key="name" wx:for-item="group">
          <view class="pick-group-head" data-name="{{group.name}}" hover-class="pick-head-hover" hover-stay-time="60" bindtap="onFold">
            <text class="pick-group-name">{{group.name}}</text>
            <text class="pick-count">{{group.chars.length}}</text>
            <view class="pick-arrow {{folded[group.name] ? '' : 'up'}}"></view>
          </view>
          <view class="pick-chars {{folded[group.name] ? 'folded' : ''}}">
            <text class="pick-chip {{item.on ? 'on' : ''}} {{item.dim ? 'dim' : ''}}"
                  wx:for="{{group.chars}}" wx:key="ch" data-ch="{{item.ch}}" bindtap="onPickChar">{{item.ch}}</text>
          </view>
        </block>
      </view>
    </view>

    <view class="card fh-stage {{flash ? 'flash ' + flash : ''}}">
      <view class="fh-head">
        <text class="fh-scope">{{scopeName}}</text>
        <text class="combo {{streak >= 5 ? 'hot' : ''}}" wx:if="{{streak >= 2}}">{{streak}} 连</text>
        <text class="fh-clock {{urgent ? 'urgent' : ''}}">{{leftText}}</text>
      </view>

      <view class="fh-bar"><view class="fh-bar-fill {{urgent ? 'urgent' : ''}}" style="width:{{leftPct}}%"></view></view>

      <view class="fh-char">
        <text class="fh-char-t">{{char || '令'}}</text>
        <text class="fh-mark" wx:if="{{mark}}">{{mark}}</text>
      </view>
      <text class="fh-ask" wx:if="{{ask}}">{{ask}}</text>

      <button class="btn primary block fh-start" wx:if="{{!started}}" bindtap="onStart" disabled="{{!char}}">开始计时</button>

      <view class="field fh-field">
        <input class="field-input" value="{{input}}" placeholder="例如：云深不知处"
               confirm-type="done" focus="{{!locked}}"
               bindinput="onInput" bindconfirm="onSubmit" />
      </view>

      <view class="inline-btns">
        <button class="btn ghost" bindtap="onHint" disabled="{{locked || hinted}}">提示</button>
        <button class="btn primary" bindtap="onSubmit" disabled="{{locked || judging}}">接令</button>
        <button class="btn ghost" bindtap="onSkip" disabled="{{!started || over}}">换令</button>
      </view>

      <text class="fh-msg {{messageOk ? 'ok' : 'no'}} {{msgHint ? 'wait' : ''}}" wx:if="{{message}}">{{message}}</text>

      <text class="fh-cheer" wx:if="{{cheerLine}}">{{cheerLine}}</text>

      <text class="fh-note" wx:if="{{streak}}">连续 {{streak}} 句 · 最好 {{best}} 句</text>
      <text class="fh-note ranked" wx:if="{{ranked}}">本轮 {{lastScore}} 句已上榜 · {{rankWhere}}</text>

      <text class="fh-remark" wx:if="{{remark}}">{{remark}}</text>

      <button class="btn ghost block restart" wx:if="{{over}}" bindtap="onRestart">
        再开一轮
      </button>
    </view>

    <view class="card" wx:if="{{done.length}}">
      <view class="card-title">本轮已接</view>
      <view class="qa-line" wx:for="{{done}}" wx:key="index">
        <text class="qa-n">{{index + 1}}</text>
        <view class="qa-body">
          <text class="qa-seg">{{item.seg}}</text>
          <text class="qa-src" wx:if="{{item.title}}">{{item.title}}</text>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="card-open" bindtap="onReveal" hover-class="card-hover" hover-stay-time="60">
        <text class="card-title">查看其他诗句</text>
        <text class="fh-open">{{revealed ? '收起' : '展开'}}</text>
      </view>
      <view wx:if="{{revealed}}">
        <text class="fh-loading" wx:if="{{revealing}}">正在检索…</text>
        <view class="fh-line" hover-class="row-hover" hover-stay-time="60"
              wx:for="{{answers}}" wx:key="index" data-id="{{item.id}}" bindtap="onOpen">
          <text class="fh-seg">{{item.seg}}</text>
          <text class="fh-src">{{item.title}} · {{item.author}}</text>
        </view>
        <view class="empty" wx:if="{{!revealing && !answers.length}}">
          <text class="empty-mark">字</text>
          <text class="empty-text">当前范围无含「{{char}}」的诗句</text>
        </view>
      </view>
    </view>

    <view class="card log-card" hover-class="log-hover" hover-stay-time="60" bindtap="onLog">
      <view class="log-glyph">录</view>
      <view class="log-main">
        <view class="log-head">
          <text class="gc-name">成绩记录</text>
        </view>
        <text class="log-sub">{{log.line}}</text>
      </view>
      <text class="row-go">›</text>
    </view>
    
  </block>

  <view class="safe-bottom"></view>
  <tab-bar id="tabbar" current="2" />
</view>
