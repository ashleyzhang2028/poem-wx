<view class="page">
  <lock-card wx:if="{{!allowed}}" title="飞花令" note="{{reason}}" mark="令" />

  <block wx:else>
    <view class="page-head">
      <text class="head-title">挑一个令字</text>
      <text class="head-sub">课内 251 首里，有多少句写过它</text>
    </view>

    <view class="card">
      <text class="opt-label">玩法</text>
      <radio-group class="opt-group" bindchange="onKind">
        <label class="pref-item" wx:for="{{kinds}}" wx:key="key">
          <radio value="{{item.key}}" checked="{{kind === item.key}}" color="#2f6055" />
          <text>{{item.label}}</text>
        </label>
      </radio-group>

      <radio-group class="opt-group" bindchange="onLevel">
        <label class="pref-item" wx:for="{{levels}}" wx:key="id">
          <radio value="{{item.id}}" checked="{{level === item.id}}" color="#2f6055" />
          <text>{{item.name}}</text>
        </label>
      </radio-group>

      <radio-group class="chars" bindchange="onChar">
        <label class="char {{char === item.char ? 'active' : ''}}" wx:for="{{chars}}" wx:key="char">
          <radio class="char-radio" value="{{item.char}}" checked="{{char === item.char}}" color="#2f6055" />
          <text class="char-t">{{item.char}}</text>
          <text class="char-n">{{item.count}}</text>
        </label>
      </radio-group>
      <text class="hint char-empty" wx:if="{{!chars.length}}">这一档没有合适的令字</text>
    </view>

    <!-- 查一查 -->
    <view class="card" wx:if="{{kind === 'look' && char}}">
      <view class="card-title bar">含「{{char}}」的句子 · {{hitCount}} 句</view>
      <view class="fh-line" hover-class="row-hover" hover-stay-time="60" wx:for="{{lines}}" wx:key="index" data-id="{{item.id}}" bindtap="onOpen">
        <text class="fh-seg">{{item.seg}}</text>
        <text class="fh-src">{{item.title}} · {{item.author}}</text>
      </view>
      <view class="empty" wx:if="{{!hitCount}}">
        <text class="empty-mark">字</text>
        <text class="empty-text">课内 251 首里没有含「{{char}}」的句子
换个令字试试</text>
      </view>
    </view>

    <!-- 闯关 -->
    <view class="card" wx:if="{{kind === 'level' && char}}">
      <view class="card-title bar">令字「{{char}}」 · 已说 {{said.length}} 句</view>
      <view class="said" wx:for="{{said}}" wx:key="index">
        <text class="said-t">{{item}}</text>
      </view>

      <view class="lv-input" wx:if="{{!finished}}">
        <input value="{{input}}" placeholder="写一句带「{{char}}」的诗" confirm-type="done"
               bindinput="onInput" bindconfirm="onSubmit" />
      </view>

      <view class="actions" wx:if="{{!finished}}">
        <button class="btn primary" bindtap="onSubmit">说一句</button>
        <button class="btn ghost" bindtap="onGiveUp">接不上了</button>
      </view>

      <view class="actions" wx:else>
        <button class="btn primary" bindtap="onNextChar">换一个令字</button>
      </view>

      <text class="hint fh-msg {{messageOk ? 'ok' : 'no'}}" wx:if="{{message}}">{{message}}</text>
    </view>

    <text class="hint fh-tip" wx:if="{{!char}}">挑一个令字开始</text>
  </block>

  <view class="safe-bottom"></view>
</view>
