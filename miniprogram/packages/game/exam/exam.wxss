.picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: var(--fs-body);
  color: var(--ink);
  padding: var(--sp-3) 0;
  border-bottom: 1rpx solid var(--line-2);
}

.note {
  display: block;
  padding-top: var(--sp-2);
  line-height: var(--lh-body);
}

.exam-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 var(--sp-1) var(--sp-3);
}

.exam-progress {
  font-family: var(--font-num);
  font-size: var(--fs-title);
  color: var(--ink-2);
  font-variant-numeric: tabular-nums;
}

.exam-timer {
  font-size: var(--fs-body);
  color: var(--amber);
  font-variant-numeric: tabular-nums;
}

.stem {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-hero);
  color: var(--ink);
  line-height: 1.9;
  text-align: center;
  padding: var(--sp-2) 0;
}

.stem-sub {
  display: block;
  text-align: center;
  padding-top: var(--sp-2);
}

.options {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--sp-2);
  margin-top: var(--sp-1);
}

.option {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  min-height: var(--h-act);
  background: var(--card);
  border: 1rpx solid var(--line-2);
  border-radius: var(--radius-sm);
  padding: var(--sp-3);
  font-size: var(--fs-body);
  color: var(--ink);
  text-align: left;
  transition: transform var(--t-press), background-color var(--t-press), border-color var(--t-press);
}

.option-k {
  flex: none;
  width: 32rpx;
  font-size: var(--fs-hint);
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
}

.option-t {
  flex: 1;
  min-width: 0;
  line-height: 1.5;
}

.option:active {
  transform: scale(.98);
}

.option.picked {
  background: var(--strong);
  border-color: var(--strong);
  color: var(--on-ink);
  font-weight: 600;
}

.option.picked .option-k {
  color: var(--on-ink-soft);
}

.option.right {
  border-color: var(--green);
  background: var(--green-light);
  color: var(--green);
  font-weight: 600;
}

.option.right .option-k,
.option.wrong .option-k {
  color: inherit;
  opacity: .72;
}

.option.wrong {
  border-color: var(--red-edge);
  background: var(--red-light);
  color: var(--red);
}

.result {
  text-align: center;
  padding: var(--sp-6) var(--sp-4) var(--sp-5);
  background: var(--surface);
}

.score {
  font-family: var(--font-num);
  font-size: var(--fs-score);
  font-weight: 600;
  color: var(--strong-text);
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.score-k {
  font-size: var(--fs-hint);
  color: var(--ink-3);
  padding-left: var(--sp-1);
}

.result .hint {
  display: block;
  margin-top: var(--sp-2);
}

.wrong {
  padding: var(--sp-3) 0;
  border-bottom: 1rpx solid var(--line-2);
}

.wrong:last-child {
  border-bottom: none;
}

.grade {
  padding: var(--sp-3) 0;
  border-bottom: 1rpx solid var(--line-2);
}

.grade:last-child {
  border-bottom: none;
}

.grade-head {
  display: flex;
  align-items: flex-start;
  gap: var(--sp-2);
}

.grade-mark {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-hint);
  font-weight: 600;
  line-height: 1;
}

.grade-mark.ok {
  color: var(--green);
  background: var(--green-soft);
}

.grade-mark.no {
  color: var(--red);
  background: var(--red-soft);
}

.grade-stem {
  flex: 1;
  min-width: 0;
  font-family: var(--font-poem);
  font-size: var(--fs-title);
  color: var(--strong-text);
  line-height: 1.7;
}

.grade-line {
  display: block;
  font-size: var(--fs-hint);
  color: var(--ink-2);
  padding-left: calc(44rpx + var(--sp-2));
  margin-top: 4rpx;
}

.picked-line {
  color: var(--red);
}

.next-btn {
  margin-top: var(--sp-3);
}
