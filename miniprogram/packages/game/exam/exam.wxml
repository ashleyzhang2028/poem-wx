<view class="page">
  <lock-card wx:if="{{!allowed}}" title="模拟考试" note="{{reason}}" mark="考" />

  <block wx:elif="{{stage === 'setup'}}">
    <view class="page-head">
      <text class="head-title">限时一卷</text>
      <text class="head-sub">20 分钟 · 交卷后统一批</text>
    </view>

    <view class="card">
      <view class="card-title bar">考试范围</view>
      <picker range="{{scopes}}" range-key="name" value="{{scopeIndex}}" bindchange="onScope">
        <view class="picker">{{scopes[scopeIndex].name}} ›</view>
      </picker>
      <text class="hint note">共 {{count}} 题，限时 20 分钟，交卷后统一批。题目就地取材自所选集子，不接 AI、不额外收费。</text>
    </view>

    <view class="card">
      <view class="card-title bar">题型</view>
      <!-- 题型可多选：原生 checkbox，勾选框本身就是平台认识的那个勾选框 -->
      <checkbox-group class="native-group" bindchange="onToggleForm">
        <label class="native-label" wx:for="{{forms}}" wx:key="key">
          <checkbox value="{{item.key}}" checked="{{pickedForms.indexOf(item.key) >= 0}}" color="#2f6055" />
          <text>{{item.name}}</text>
        </label>
      </checkbox-group>
      <text class="hint note">选中的题型随机混出。至少留一种。</text>
    </view>
    <button class="btn primary block" bindtap="onStart">开始考试</button>
  </block>

  <block wx:elif="{{stage === 'running'}}">
    <view class="exam-bar">
      <text class="exam-progress">{{index + 1}} / {{questions.length}}</text>
      <text class="exam-timer">{{remainText}}</text>
    </view>

    <view class="card">
      <text class="stem">{{current.stem}}</text>
      <text class="hint stem-sub">出自《{{current.title}}》</text>
    </view>

    <view class="options">
      <view class="option {{picked ? (item === current.answer ? 'right' : (item === picked ? 'wrong' : '')) : ''}}"
            wx:for="{{current.options}}" wx:key="*this" data-v="{{item}}" bindtap="onPick">
        {{item}}
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="card result">
      <text class="score">{{score}}</text>
      <text class="score-k">分</text>
      <text class="hint">答对 {{correct}} / {{questions.length}} 题</text>
    </view>

    <view class="card" wx:if="{{wrong.length}}">
      <view class="card-title bar">错题</view>
      <view class="wrong" wx:for="{{wrong}}" wx:key="stem">
        <text class="wrong-stem">{{item.stem}}</text>
        <text class="wrong-line">正确答案：{{item.answer}}</text>
        <text class="wrong-line picked-line">你选的：{{item.picked}}</text>
      </view>
    </view>

    <button class="btn primary block" bindtap="onAgain">再考一次</button>
  </block>

  <view class="safe-bottom"></view>
</view>
