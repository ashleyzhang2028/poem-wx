<view class="page {{barBelow ? 'has-tabbar' : 'tall'}}" style="{{themeStyle}}">
  <lock-card wx:if="{{!allowed}}" title="考试" note="登录后才能用" mark="考" />

  <block wx:elif="{{stage === 'setup'}}">
    <view class="card">
      <view class="card-title">考试范围</view>

      <radio-group class="opt-group inline cols-2" bindchange="onScope">
        <label class="opt-row {{scope === item.id ? 'active' : ''}}" wx:for="{{scopes}}" wx:key="id">
          <radio class="opt-radio" value="{{item.id}}" checked="{{scope === item.id}}" />
          <view class="opt-main">
            <text class="opt-name">{{item.name}}</text>
          </view>
        </label>
      </radio-group>
      <text class="count-line">共 {{count}} 题 · 限时 20 分钟</text>
    </view>

    <view class="card">
      <view class="card-title">题型</view>

      <checkbox-group class="chip-group cols-3" bindchange="onToggleForm">
        <label class="chip multi {{pickedForms.indexOf(item.key) >= 0 ? 'on' : ''}}"
               wx:for="{{forms}}" wx:key="key">
          <checkbox class="seg-radio" value="{{item.key}}"
                    checked="{{pickedForms.indexOf(item.key) >= 0}}" />
          <text class="chip-t">{{item.name}}</text>
        </label>
      </checkbox-group>

    </view>
    <button class="btn primary block" bindtap="onStart">开始考试</button>
  </block>

  <block wx:elif="{{stage === 'running'}}">
    <view class="exam-bar">
      <text class="exam-progress">{{index + 1}} / {{questions.length}}</text>
      <text class="exam-timer">已答 {{marked}} 题</text>
      <text class="exam-timer">{{remainText}}</text>
    </view>

    <view class="dots exam-slots">
      <view class="dot {{item.cls}}" wx:for="{{slots}}" wx:key="i" data-i="{{item.i}}"
            hover-class="dot-hover" bindtap="onJump">{{item.i + 1}}</view>
    </view>

    <view class="card">
      <text class="stem">{{current.stem}}</text>

      <text class="hint stem-sub">{{metaLine}}</text>
    </view>

    <view class="options">
      <view class="option {{item.text === picked ? 'picked' : ''}}"
            wx:for="{{optionRows}}" wx:key="key" data-v="{{item.text}}" bindtap="onPick">
        <text class="option-k">{{item.key}}</text>
        <text class="option-t">{{item.text}}</text>
      </view>
    </view>

    <text class="quit-line" wx:if="{{quitLine}}">{{quitLine}}</text>

    <view class="exam-nav">
      <button class="btn ghost mini" bindtap="onPrev" disabled="{{index === 0}}">上一题</button>
      <button class="btn primary next-btn" bindtap="onNext">
        {{index + 1 >= questions.length ? '交卷' : '下一题'}}
      </button>
    </view>
  </block>

  <block wx:else>
    <view class="card result">
      <text class="score">{{score}}</text>
      <text class="score-k">分</text>
      <text class="hint">答对 {{correct}} / {{questions.length}}</text>

      <text class="cheer">{{cheerLine}}</text>

      <view class="rank" wx:if="{{rank}}">
        <text class="rank-name">{{rank.name}}</text>
        <text class="rank-note">{{rank.note}}</text>
      </view>

      <text class="hint best-line" wx:if="{{newBest}}">这一档比之前高，记下了</text>
      <text class="hint best-line" wx:elif="{{best}}">最好的一次是{{best}}</text>
    </view>

    <view class="card">
      <view class="card-title">逐题</view>
      <view class="grade" wx:for="{{graded}}" wx:key="stem">
        <view class="grade-head">
          <text class="grade-mark {{item.ok ? 'ok' : 'no'}}">{{item.ok ? '对' : '错'}}</text>
          <text class="grade-stem">{{item.stem}}</text>
        </view>
        <text class="grade-line">正确答案：{{item.answer}}</text>
        <text class="grade-line picked-line" wx:if="{{!item.ok}}">你选的：{{item.picked}}</text>
      </view>
    </view>

    <button class="btn primary block" bindtap="onAgain">再考一次</button>
  </block>

  <view class="safe-bottom"></view>
</view>
