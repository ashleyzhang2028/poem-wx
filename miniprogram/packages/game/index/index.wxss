.modes {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.mode {
  flex: 1;
  border-radius: var(--radius);
  padding: 28rpx 20rpx;
  border: 1rpx solid var(--line-2);
  background: var(--card);
  box-shadow: var(--shadow);
}

.mode-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--green);
}

.mode-amber .mode-name {
  color: var(--amber);
}

.mode-blue .mode-name {
  color: var(--blue);
}

.mode-desc {
  display: block;
  font-size: 22rpx;
  color: var(--ink-3);
  margin-top: 10rpx;
  line-height: 1.6;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  margin: 16rpx 0;
}

.chip {
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-family: var(--font-poem);
  font-size: 36rpx;
  border-radius: var(--radius-sm);
  background: var(--bg-soft);
  border: 1rpx solid var(--line);
  color: var(--ink);
  margin: 0 16rpx 16rpx 0;
}

.chip.active {
  background: var(--green);
  border-color: var(--green);
  color: #fff;
}

.line-seg {
  display: block;
  font-family: var(--font-poem);
  font-size: 32rpx;
  color: var(--ink);
}

.row-sub {
  margin-top: 8rpx;
}

.lock-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.lock-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--green);
}

.lock-sub {
  font-size: 26rpx;
  color: var(--ink-3);
  margin: 12rpx 0 28rpx;
  line-height: 1.7;
}
