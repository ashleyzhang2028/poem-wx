.modes {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.mode {

  flex: 1 1 calc(50% - 8rpx);

  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: space-between;
  width: auto;
  min-width: 0;
  margin: 0;
  text-align: left;
  line-height: 1.5;
  border-radius: var(--radius);
  padding: 28rpx 20rpx;
  border: 1rpx solid var(--line-2);
  background: var(--card);
  box-shadow: var(--shadow);
}

.mode-name {
  display: block;
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--strong-text);
}

.mode::after {
  border: none;
}

.mode-desc {
  flex: 1;
  display: block;
  width: 100%;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 10rpx;
  line-height: 1.6;
}

.mode-go {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-2);
  margin-top: 16rpx;
  letter-spacing: 1rpx;
}

.mode-off .mode-go {
  color: var(--ink-3);
}

.mode-off {
  opacity: .55;
}

.mode-off .mode-desc {
  color: var(--ink-3);
}

