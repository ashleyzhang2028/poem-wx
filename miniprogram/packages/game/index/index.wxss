.intro {
  padding: 8rpx 4rpx 24rpx;
}

.intro-t {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-hero);
  font-weight: 600;
  color: var(--green);
  letter-spacing: 2rpx;
}

.intro-s {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 8rpx;
  letter-spacing: 1rpx;
}

/* 三张入口卡：一行放不下三个名字（「模拟考试」四个字），
   与其硬挤成一窄条，不如让它按两列排 —— 呼吸感比整齐更重要 */
.modes {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.mode {
  /* 从 view 换成 button：原生按钮自带最小宽度与 ::after 边框，这里逐条收掉 */
  flex: 1 1 calc(50% - 8rpx);
  width: auto;
  min-width: 0;
  margin: 0;
  text-align: left;
  line-height: 1.5;
  border-radius: var(--radius);
  padding: 28rpx 20rpx;
  border: 1rpx solid var(--line-2);
  background: var(--card);
  box-shadow: var(--shadow);
}

.mode-name {
  display: block;
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--green);
}

.mode-amber .mode-name {
  color: var(--amber);
}

.mode-blue .mode-name {
  color: var(--blue);
}

.mode::after {
  border: none;
}

.mode-desc {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 10rpx;
  line-height: 1.6;
}

/* 卡内第三行给出下一步动作：两面墙一样的卡，点哪张全靠猜 */
.mode-go {
  display: block;
  font-size: var(--fs-caption);
  color: var(--green);
  margin-top: 16rpx;
  letter-spacing: 1rpx;
}

.mode-off .mode-go {
  color: var(--ink-3);
}

/* 令字格：外框在 app.wxss 里定一次（.char），
   这里只管这一页的排布 —— 令字比飞花令页少一格小字，所以格子矮一点 */
.char-count {
  display: block;
  padding: var(--sp-1) 0;
}

.chars {
  display: flex;
  flex-wrap: wrap;
  /* gap 一视同仁：上一版是「右 16 + 下 16」的 margin，横向与纵向各自累加，
     行与行之间的缝看着比列与列宽 */
  gap: var(--sp-2);
  margin: var(--sp-2) 0 var(--sp-1);
}

/* 这一页的令字格没有下面那行小字，所以矮一点、字大一点 */
.char {
  width: 88rpx;
  height: 88rpx;
  padding: 0;
}

.line-seg {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-poem);
  color: var(--ink);
}

.row-sub {
  margin-top: 8rpx;
}

.reveal-btn {
  margin-top: 20rpx;
}

.pager {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0 24rpx;
}

/* 翻页键：它同时挂着 .btn.mini，居中的事由 .btn 管；
   这里只把左右衬得宽一点，翻页这种连续动作手要放得下 */
.pg {
  padding: 0 var(--sp-4);
}

.pg[disabled] {
  color: var(--line);
  opacity: 1;
}

.pg-num {
  font-size: var(--fs-hint);
  color: var(--ink-3);
  padding: 0 16rpx;
}

/* 差一档的卡片：留个灰样子，让人知道往哪走，而不是整块消失 */
.mode-off {
  opacity: .55;
}

.mode-off .mode-desc {
  color: var(--ink-3);
}
