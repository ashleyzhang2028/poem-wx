.modes {
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
  margin-bottom: var(--sp-3);
}

.mode {
  justify-content: flex-start;
  border-radius: var(--radius);
  gap: var(--sp-3);
  height: auto;
  min-height: var(--h-btn);
  padding: var(--sp-3);
  line-height: var(--lh-tight);
}

.mode-head {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
}

.mode-main {
  flex: 1;
  min-width: 0;
  text-align: left;
}

.mode-desc {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: var(--sp-1);
  line-height: 1.6;
}

.mode-go {
  flex: none;
  font-size: var(--fs-caption);
  color: var(--ink-2);
  letter-spacing: var(--ls-title);
}

.mode-off {
  opacity: .55;
}

.mode-off .mode-go {
  color: var(--ink-3);
}

