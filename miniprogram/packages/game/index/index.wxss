.mode {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--line-2);
}

.mode:last-child {
  border-bottom: none;
}

.mode.locked {
  opacity: .55;
}

.mode-main {
  flex: 1;
  min-width: 0;
}

.mode-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.mode-name {
  font-family: var(--font-poem);
  font-size: 36rpx;
  color: var(--ink);
}

.mode.green .mode-name { color: var(--green); }
.mode.amber .mode-name { color: var(--amber); }
.mode.blue .mode-name { color: var(--blue); }

.mode-desc {
  display: block;
  font-size: 25rpx;
  color: var(--ink-3);
  margin-top: 8rpx;
}

.mode-go {
  font-size: 32rpx;
  color: var(--line);
  padding-left: 16rpx;
}
