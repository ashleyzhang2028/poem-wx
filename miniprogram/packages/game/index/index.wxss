.intro {
  padding: 8rpx 4rpx 24rpx;
}

.intro-t {
  display: block;
  font-family: var(--font-poem);
  font-size: 40rpx;
  font-weight: 600;
  color: var(--green);
  letter-spacing: 2rpx;
}

.intro-s {
  display: block;
  font-size: 24rpx;
  color: var(--ink-3);
  margin-top: 8rpx;
  letter-spacing: 1rpx;
}

/* 三张入口卡：一行放不下三个名字（「模拟考试」四个字），
   与其硬挤成一窄条，不如让它按两列排 —— 呼吸感比整齐更重要 */
.modes {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.mode {
  /* 从 view 换成 button：原生按钮自带最小宽度与 ::after 边框，这里逐条收掉 */
  flex: 1 1 calc(50% - 8rpx);
  width: auto;
  min-width: 0;
  margin: 0;
  text-align: left;
  line-height: 1.5;
  border-radius: var(--radius);
  padding: 28rpx 20rpx;
  border: 1rpx solid var(--line-2);
  background: var(--card);
  box-shadow: var(--shadow);
}

.mode-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--green);
}

.mode-amber .mode-name {
  color: var(--amber);
}

.mode-blue .mode-name {
  color: var(--blue);
}

.mode::after {
  border: none;
}

.mode-desc {
  display: block;
  font-size: 22rpx;
  color: var(--ink-3);
  margin-top: 10rpx;
  line-height: 1.6;
}

/* 卡内第三行给出下一步动作：两面墙一样的卡，点哪张全靠猜 */
.mode-go {
  display: block;
  font-size: 22rpx;
  color: var(--green);
  margin-top: 16rpx;
  letter-spacing: 1rpx;
}

.mode-off .mode-go {
  color: var(--ink-3);
}

/* 令字格：外框还是那块宋体方字，判定与选中交给原生 radio */
.char-count {
  display: block;
  padding: 4rpx 0 8rpx;
}

.chars {
  display: flex;
  flex-wrap: wrap;
  margin: 12rpx 0 4rpx;
}

.char {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-sm);
  background: var(--bg-soft);
  border: 1rpx solid var(--line);
  color: var(--ink);
  margin: 0 16rpx 16rpx 0;
}

.char.active {
  background: var(--green-light);
  border-color: var(--green);
}

/* 原生圆点缩到角上：字块中心留给那个字，判定仍由平台负责 */
.char-radio {
  position: absolute;
  right: -4rpx;
  top: -4rpx;
  transform: scale(.6);
}

.char-t {
  font-family: var(--font-poem);
  font-size: 36rpx;
  line-height: 1;
}

.char.active .char-t {
  color: var(--green);
}

.line-seg {
  display: block;
  font-family: var(--font-poem);
  font-size: 32rpx;
  color: var(--ink);
}

.row-sub {
  margin-top: 8rpx;
}

.reveal-btn {
  margin-top: 20rpx;
}

.pager {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0 24rpx;
}

.pg {
  font-size: 27rpx;
  color: var(--green);
  padding: 0 32rpx;
  height: 64rpx;
  line-height: 64rpx;
}

.pg[disabled] {
  color: var(--line);
  opacity: 1;
}

.pg-num {
  font-size: 25rpx;
  color: var(--ink-3);
  padding: 0 16rpx;
}

/* 差一档的卡片：留个灰样子，让人知道往哪走，而不是整块消失 */
.mode-off {
  opacity: .55;
}

.mode-off .mode-desc {
  color: var(--ink-3);
}
