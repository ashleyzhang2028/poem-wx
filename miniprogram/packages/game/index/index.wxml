<view class="page">
  <lock-card wx:if="{{locked}}" title="大会要登录" note="登录后才能进" mark="会" />

  <block wx:else>
  <view class="page-head">
    <text class="head-title">三样玩法</text>
  </view>

  <!-- 三张卡是入口不是选择：用原生 button，只是把外观压成卡片。
       不可用的卡照常列出但灰掉，desc 那行换成差在哪一档 -->
  <view class="modes">
    <button class="mode mode-{{item.color}} {{item.ok ? '' : 'mode-off'}}"
            wx:for="{{cards}}" wx:key="key" data-k="{{item.key}}" bindtap="onMode">
      <text class="mode-name">{{item.name}}</text>
      <text class="mode-desc" wx:if="{{item.ok && item.desc}}">{{item.desc}}</text>
      <text class="mode-go">{{item.ok ? '开始 ›' : '未开放'}}</text>
    </button>
  </view>

  <view class="card">
    <view class="card-title bar">飞花令 · 挑一个字</view>
    <!-- 令字是「选一个」：原生 radio 视觉隐藏，点格子即选中 -->
    <radio-group class="chars" bindchange="onChar">
      <!-- 圆点去掉：一个缩到 0.56 的原生圆点怼在格子右上角看不出能点，
           还压在字的笔画上。选中态由格子自己的底色 + 描边说清楚 -->
      <label class="char {{keyword === item ? 'active' : ''}}" wx:for="{{chars}}" wx:key="*this">
        <radio class="seg-radio" value="{{item}}" checked="{{keyword === item}}" color="#1c1c1e" />
        <text class="char-t">{{item}}</text>
      </label>
    </radio-group>
    <text class="hint char-count" wx:if="{{keyword}}">含「{{keyword}}」的句子 {{hitCount}} 条</text>
    <button class="btn primary block reveal-btn" bindtap="onReveal">
      {{revealed ? '收起' : '看答案'}}
    </button>
  </view>

  <block wx:if="{{revealed}}">
    <view class="card" wx:if="{{pagedLines.length}}">
      <view class="row" hover-class="row-hover" hover-stay-time="60"
            wx:for="{{pagedLines}}" wx:key="seg" data-id="{{item.id}}" bindtap="onOpen">
        <view class="row-main">
          <text class="line-seg">{{item.seg}}</text>
          <text class="row-sub">{{item.title}} · {{item.author}}</text>
        </view>
        <text class="row-go">›</text>
      </view>
    </view>

    <view class="pager" wx:if="{{hitCount > pageSize}}">
      <button class="btn mini pg" disabled="{{page <= 1}}" bindtap="onPrevPage">上一页</button>
      <text class="pg-num">第 {{page}} 页</text>
      <button class="btn mini pg" bindtap="onNextPage">下一页</button>
    </view>

    <view class="empty" wx:if="{{!hitCount}}">
        <text class="empty-mark">字</text>
        <text class="empty-text">没有含「{{keyword}}」的句子</text>
      </view>
  </block>

  <view class="safe-bottom"></view>
  </block>
</view>
