<view class="page">
  <view class="card">
    <view class="card-title">古诗词大会</view>
    <text class="hint">当前层级：{{tierLabel}}</text>
  </view>

  <view class="card">
    <view class="mode {{item.color}} {{item.locked ? 'locked' : ''}}" wx:for="{{modes}}" wx:key="key"
          data-k="{{item.key}}" bindtap="onMode">
      <view class="mode-main">
        <view class="mode-line">
          <text class="mode-name">{{item.name}}</text>
          <text class="tag ghost" wx:if="{{item.locked}}">{{item.hint}}</text>
        </view>
        <text class="mode-desc">{{item.desc}}</text>
      </view>
      <text class="mode-go">{{item.locked ? '🔒' : '›'}}</text>
    </view>
  </view>

  <view class="safe-bottom"></view>
</view>
