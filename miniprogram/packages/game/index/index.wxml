<view class="page {{barBelow ? 'has-tabbar' : 'tall'}}" style="{{themeStyle}}">
  <lock-card wx:if="{{locked}}" title="诗词大会" note="登录后才能进" mark="会" bind:login="onLogin" />

  <block wx:else>
    <view class="card hero">
      <view class="hero-seal {{heroTitle ? 'earned' : ''}}">{{heroMark}}</view>
      <view class="hero-main">
        <text class="hero-name poem">古诗文大会</text>
        <text class="hero-title" wx:if="{{heroTitle}}">当前功名 · {{heroTitle}}</text>
        <text class="hero-sub">{{heroSub}}</text>
      </view>
    </view>

    <view class="modes">
      <view class="card mode {{item.ok ? '' : 'mode-off'}}" wx:for="{{cards}}" wx:key="key"
            style="animation-delay:{{index * 70}}ms" data-k="{{item.key}}"
            hover-class="mode-hover" hover-stay-time="40" bindtap="onMode">
        <view class="mode-glyph glyph-{{item.key}}">{{item.glyph}}</view>
        <view class="mode-main">
          <view class="mode-head">
            <text class="gc-name">{{item.name}}</text>
            <text class="tag theme" wx:if="{{item.bestText}}">最好 {{item.bestText}}</text>
          </view>
          <text class="mode-desc">{{item.desc}}</text>
        </view>
        <view class="mode-side">
          <tier-tag wx:if="{{item.locked}}" tier="{{item.tier}}" />
          <text class="mode-go">开始</text>
        </view>
      </view>
    </view>

    <view class="card mode" style="animation-delay:210ms" hover-class="mode-hover" hover-stay-time="40"
          bindtap="onRanking">
      <view class="mode-glyph glyph-ranking">榜</view>
      <view class="mode-main">
        <text class="gc-name">排行榜</text>
        <text class="mode-desc">分学段 · 分年级 · 分学期 · 按日周月年</text>
      </view>
      <text class="mode-go">查看</text>
    </view>

    <view class="safe-bottom"></view>
  </block>

  <tab-bar id="tabbar" current="2" />
</view>
