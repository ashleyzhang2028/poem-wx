<view class="page">
  <view class="modes">
    <view class="mode mode-{{item.color}}" wx:for="{{modes}}" wx:key="key" data-k="{{item.key}}" bindtap="onMode">
      <text class="mode-name">{{item.name}}</text>
      <text class="mode-desc">{{item.desc}}</text>
    </view>
  </view>

  <view class="card">
    <view class="card-title">飞花令 · 挑一个字</view>
    <view class="chips">
      <text class="chip {{keyword === item ? 'active' : ''}}" wx:for="{{chars}}" wx:key="*this"
            data-c="{{item}}" bindtap="onChar">{{item}}</text>
    </view>
    <text class="hint">课内诗词里含「{{keyword}}」的句子 {{hitCount}} 条</text>
    <button class="btn primary block reveal-btn" bindtap="onReveal">
      {{revealed ? '收起来，我先说' : '想不出来了，看答案'}}
    </button>
  </view>

  <block wx:if="{{revealed}}">
    <view class="card" wx:if="{{pagedLines.length}}">
      <view class="row" wx:for="{{pagedLines}}" wx:key="seg" data-id="{{item.id}}" bindtap="onOpen">
        <view class="row-main">
          <text class="line-seg">{{item.seg}}</text>
          <text class="row-sub">{{item.title}} · {{item.author}}</text>
        </view>
        <text class="row-go">›</text>
      </view>
    </view>

    <view class="pager" wx:if="{{hitCount > pageSize}}">
      <text class="pg {{page <= 1 ? 'off' : ''}}" bindtap="onPrevPage">上一页</text>
      <text class="pg-num">第 {{page}} 页</text>
      <text class="pg" bindtap="onNextPage">下一页</text>
    </view>

    <view class="empty" wx:if="{{!hitCount}}">课内诗词里没有含这个字的句子，换个字试试</view>
  </block>

  <view class="safe-bottom"></view>
</view>
