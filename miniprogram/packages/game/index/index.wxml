<view class="page {{barBelow ? 'has-tabbar' : 'tall'}}" style="{{themeStyle}}">
  <lock-card wx:if="{{locked}}" title="大会要登录" note="登录后才能进" mark="会" />

  <block wx:else>
  <view class="modes">
    <button class="btn block mode {{item.ok ? '' : 'mode-off'}}"
            wx:for="{{cards}}" wx:key="key" data-k="{{item.key}}" bindtap="onMode">
      <view class="mode-main">
        <view class="mode-head">
          <text class="gc-name">{{item.name}}</text>
          <text class="tag theme" wx:if="{{item.bestText}}">最好 {{item.bestText}}</text>
        </view>
        <text class="mode-desc" wx:if="{{item.ok && item.desc}}">{{item.desc}}</text>
      </view>
      <text class="mode-go">{{item.ok ? '开始' : '未开放'}}</text>
    </button>
  </view>

  <view class="card ranking-card" wx:if="{{rankingOn}}" hover-class="row-hover" hover-stay-time="60"
        bindtap="onRanking">
    <view class="row row-flush">
      <view class="row-icon">榜</view>
      <view class="row-main">
        <text class="row-title poem">排行榜</text>
        <text class="row-sub">分学段 · 分年级 · 分学期 · 按日周月年</text>
      </view>
      <text class="row-go">›</text>
    </view>
  </view>

  <view class="safe-bottom"></view>
  </block>
</view>
