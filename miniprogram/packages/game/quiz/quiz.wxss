.picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: var(--fs-body);
  color: var(--ink);
  padding: var(--sp-3) 0;
  border-bottom: 1rpx solid var(--line-2);
}

.note {
  display: block;
  padding-top: var(--sp-2);
  line-height: var(--lh-body);
}

.exam-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 var(--sp-1) var(--sp-3);
}

.exam-progress {
  font-family: var(--font-num);
  font-size: var(--fs-title);
  color: var(--ink-2);
  font-variant-numeric: tabular-nums;
}

.exam-timer {
  font-size: var(--fs-body);
  color: var(--amber);
  font-variant-numeric: tabular-nums;
}

.stem {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-hero);
  color: var(--ink);
  line-height: 1.9;
  text-align: center;
  padding: var(--sp-2) 0;
}

.stem-sub {
  display: block;
  text-align: center;
  padding-top: var(--sp-2);
}

.options {
  margin-top: var(--sp-1);
}

.option {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  background: var(--card);
  border: 1rpx solid var(--line-2);
  border-radius: var(--radius-sm);
  padding: var(--sp-3);
  margin-bottom: var(--sp-2);
  font-size: var(--fs-body);
  color: var(--ink);
  text-align: left;
  transition: transform var(--t-press), background-color var(--t-press), border-color var(--t-press);
}

.option-k {
  flex: none;
  width: 32rpx;
  font-size: var(--fs-hint);
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
}

.option-t {
  flex: 1;
  min-width: 0;
  line-height: 1.5;
}

.option.right .option-k,
.option.wrong .option-k {
  color: inherit;
  opacity: .72;
}

.option:active {
  transform: scale(.98);
}

.option.right {
  border-color: var(--green);
  background: var(--green-light);
  color: var(--green);
  font-weight: 600;
}

.option.wrong {
  border-color: var(--red-edge);
  background: var(--red-light);
  color: var(--red);
}

.result {
  text-align: center;
  padding: var(--sp-6) var(--sp-4) var(--sp-5);
  background: var(--surface);
}

.score {
  font-family: var(--font-num);
  font-size: var(--fs-score);
  font-weight: 600;
  color: var(--strong-text);
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.score-k {
  font-size: var(--fs-hint);
  color: var(--ink-3);
  padding-left: var(--sp-1);
}

.result .hint {
  display: block;
  margin-top: var(--sp-2);
}

.wrong-stem {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-title);
  color: var(--strong-text);
  margin-bottom: 10rpx;
  line-height: 1.7;
}

.wrong-line {
  display: block;
  font-size: var(--fs-hint);
  color: var(--ink-2);
}

.picked-line {
  color: var(--red);
}

.verdict {
  margin-top: var(--sp-1);
  padding-top: var(--sp-3);
  border-top: 1rpx solid var(--line-2);
}

.verdict-line {
  display: block;
  font-size: var(--fs-body);
  line-height: var(--lh-body);
}

.verdict-line.ok {
  color: var(--green);
}

.verdict-line.no {
  color: var(--red);
}

.verdict-acts {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--sp-2);
}

.verdict-link {
  font-size: var(--fs-hint);
  color: var(--green);
  padding: var(--sp-1) 0;
}

.next-btn {
  width: 320rpx;
}
