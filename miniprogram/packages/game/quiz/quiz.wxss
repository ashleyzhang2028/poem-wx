.forms {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 16rpx;
}

.form {
  flex: 1 1 46%;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--bg-soft);
  padding: 20rpx;
}

.form.on {
  border-color: var(--green);
  background: var(--green-light);
}

.form-n {
  display: block;
  font-size: 28rpx;
  color: var(--ink);
}

.form-d {
  display: block;
  font-size: 22rpx;
  color: var(--ink-3);
  margin-top: 6rpx;
}

.picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 80rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--bg-soft);
  font-size: 28rpx;
  color: var(--ink);
  margin-top: 14rpx;
}

.picker-go {
  color: var(--ink-3);
}

.count-title {
  margin-top: 28rpx;
}

.quiz-head {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: var(--ink-3);
}

.quiz-stem {
  display: block;
  font-family: var(--font-poem);
  font-size: 38rpx;
  line-height: 1.9;
  color: var(--ink);
  padding: 28rpx 0 12rpx;
}

.quiz-ask {
  display: block;
  font-size: 25rpx;
  color: var(--ink-3);
}

.opt {
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--bg-soft);
  padding: 26rpx 24rpx;
  margin-bottom: 16rpx;
}

.opt:last-child {
  margin-bottom: 0;
}

.opt.right {
  border-color: var(--green);
  background: var(--green-light);
}

.opt.wrong {
  border-color: #ecd2cd;
  background: var(--red-light);
}

.opt-t {
  font-family: var(--font-poem);
  font-size: 32rpx;
  color: var(--ink);
  line-height: 1.7;
}

.result-card {
  text-align: center;
  padding: 60rpx 28rpx;
}

.score {
  display: block;
  font-size: 96rpx;
  font-weight: 600;
  color: var(--green);
  line-height: 1.1;
}

.score-label {
  display: block;
  font-size: 26rpx;
  color: var(--ink-3);
  margin-top: 12rpx;
}

.wrong-note {
  display: block;
  margin-bottom: 16rpx;
}

.wrong {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line-2);
}

.wrong:last-child {
  border-bottom: none;
}

.wrong-stem {
  display: block;
  font-family: var(--font-poem);
  font-size: 30rpx;
  color: var(--ink);
  line-height: 1.7;
}

.wrong-ans {
  display: block;
  font-size: 23rpx;
  color: var(--amber);
  margin-top: 8rpx;
}

.actions {
  display: flex;
  gap: 16rpx;
}

.actions .btn {
  flex: 1;
}
