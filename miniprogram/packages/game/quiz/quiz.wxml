<view class="page {{barBelow ? 'has-tabbar' : 'tall'}} {{name}}" style="{{themeStyle}}">
  <lock-card wx:if="{{!allowed}}" title="题库" note="登录后才能练" mark="题" bind:login="onLogin" />

  <block wx:elif="{{stage === 'setup'}}">
    <view class="card">
      <view class="card-head">
        <text class="card-title">出题范围</text>
      </view>
      <radio-group class="opt-group inline tight cols-2" bindchange="onScope">
        <label class="opt-row {{scope === item.id ? 'active' : ''}}" wx:for="{{scopes}}" wx:key="id">
          <radio class="opt-radio" value="{{item.id}}" checked="{{scope === item.id}}" />
          <view class="opt-main">
            <text class="opt-name scope-name">{{item.name}}</text>
          </view>
        </label>
      </radio-group>
      <text class="count-line">共 {{count}} 题</text>
    </view>

    <view class="card">
      <view class="card-title">题型</view>

      <view class="chip-group cols-3">
        <view class="chip multi {{item.on ? 'on' : ''}}"
              wx:for="{{forms}}" wx:key="key" data-key="{{item.key}}" bindtap="onToggleForm"
              hover-class="chip-hover" hover-stay-time="60">
          <text class="chip-t">{{item.name}}</text>
        </view>
      </view>

    </view>

    <button class="btn primary block" bindtap="onStart">开始</button>
  </block>

  <block wx:elif="{{stage === 'running'}}">
    <view class="exam-bar">
      <text class="exam-progress">{{index + 1}} / {{questions.length}}</text>
      <text class="combo {{combo.hot ? 'hot' : ''}}" wx:if="{{combo.shown}}">{{combo.n}} 连对</text>
      <text class="exam-timer">答对 {{correct}}</text>
    </view>

    <view class="card {{flash ? 'flash ' + flash : ''}}">
      <view class="stem">
        <text class="stem-row" wx:for="{{stemRows}}" wx:key="*this">{{item}}</text>
      </view>

      <text class="hint stem-sub">{{metaLine}}</text>
    </view>

    <view class="options">

      <view class="option {{item.cls}}"
            wx:for="{{optionRows}}" wx:key="key" data-v="{{item.text}}" bindtap="onPick">
        <text class="option-k">{{item.key}}</text>
        <text class="option-t">{{item.text}}</text>
      </view>
    </view>

    <view class="verdict" wx:if="{{last}}">
      <text class="verdict-line {{last.ok ? 'ok' : 'no'}}">{{last.ok ? '答对了' : '答错了 · 正确：' + last.answer}}</text>
      <view class="verdict-acts">
        <text class="verdict-link" bindtap="onOpen">看全篇</text>
        <button class="btn primary next-btn" bindtap="onNext">
          {{index + 1 >= questions.length ? '看结果' : '下一题'}}
        </button>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="card result">
      <text class="score">{{correct}}</text>
      <text class="score-k">/ {{questions.length}} 题</text>

      <text class="hint">正确率 {{pct}}%</text>

      <view class="rank" wx:if="{{rank}}">
        <text class="rank-name">{{rank.name}}</text>
        <text class="rank-note">{{rank.note}}</text>
      </view>

      <view class="dots" wx:if="{{questions.length}}">
        <view class="dot {{item ? 'on' : ''}}" wx:for="{{streakFlags}}" wx:key="index"
              hover-class="dot-hover">{{index + 1}}</view>
      </view>
    </view>

    <view class="card" wx:if="{{wrong.length}}">
      <view class="card-title">错题</view>
      <view class="wrong" wx:for="{{wrong}}" wx:key="stem">
        <text class="wrong-stem">{{item.stem}}</text>
        <text class="wrong-line">正确答案：{{item.answer}}</text>
        <text class="wrong-line picked-line">您选的：{{item.picked}}</text>
      </view>
    </view>

    <button class="btn primary block" bindtap="onAgain">再来一组</button>
  </block>

  <view class="safe-bottom"></view>
  <tab-bar id="tabbar" current="2" />
</view>
