.prof-head .head-title {
  display: block;
}

.prof-body {
  animation: prof-in .32s var(--ease) both;
}

.prof-para {
  display: block;
  margin-top: var(--sp-2);
  font-size: var(--fs-body);
  line-height: var(--lh-body);
  color: var(--ink-2);
}

@keyframes prof-in {
  from {
    opacity: 0;
    transform: translateY(12rpx);
  }
  to {
    opacity: 1;
    transform: none;
  }
}
