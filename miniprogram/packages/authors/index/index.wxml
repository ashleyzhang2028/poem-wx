<view class="page {{barBelow ? 'has-tabbar' : 'tall'}} {{name}}" style="{{themeStyle}}">
  <lock-card wx:if="{{locked}}" title="作者索引" note="登录后才能看" mark="人" bind:login="onLogin" />

  <block wx:else>

  <block wx:if="{{!author}}">

    <view class="card roster-head">
      <text class="head-title poem">{{totalPeople}} 位作者</text>
      <text class="head-sub">{{totalWorks}} 条作品 · {{eras.length}} 个朝代</text>
    </view>

    <view class="card author-search">
      <view class="search author-field">
        <view class="search-icon" style="mask-image:url('{{icons.search}}');-webkit-mask-image:url('{{icons.search}}');"></view>
        <input placeholder="搜作者" value="{{keyword}}" bindinput="onInput" confirm-type="search" />
        <view class="clear" hover-class="clear-hover" hover-stay-time="60" wx:if="{{keyword}}" bindtap="onClear">
          <view class="clear-ico" style="mask-image:url('{{icons.clear}}');-webkit-mask-image:url('{{icons.clear}}');"></view>
        </view>
      </view>

      <view class="suggest" wx:if="{{suggests.length}}">
        <view class="suggest-row" hover-class="row-hover" hover-stay-time="60"
              wx:for="{{suggests}}" wx:key="name"
              data-name="{{item.name}}" data-at="{{item.at}}" bindtap="onSuggest">
          <text class="a-name ellipsis suggest-name">{{item.name}}</text>
          <text class="suggest-era">{{item.era}}</text>
          <text class="tag course suggest-mark" wx:if="{{item.marked}}">课内</text>
          <text class="suggest-count" wx:elif="{{item.count}}">{{item.count}} 条</text>
          <text class="row-go">›</text>
        </view>
      </view>

      <text class="hint suggest-note" wx:if="{{remoteNote}}">{{remoteNote}}</text>
    </view>

    <view class="card index-card">
      <view class="card-open">
        <text class="card-title">朝代</text>
        <text class="index-total">{{eras.length}} 朝</text>
      </view>
      <view class="index-grid">
        <view class="index-cell" hover-class="row-hover" hover-stay-time="60"
              wx:for="{{eras}}" wx:key="at" data-at="{{item.at}}" bindtap="onJump">
          <text class="index-name ellipsis">{{item.name}}</text>
          <text class="index-count">{{item.count}} 家</text>
        </view>
      </view>
    </view>

    <view class="card era-card" wx:for="{{sections}}" wx:key="at" id="era-{{item.at}}">
      <view class="group-head">
        <text class="group-name">{{item.name}}</text>
        <text class="group-count">{{item.count}} 家 · {{item.works}} 条</text>
      </view>

      <view class="a-grid">
        <view class="a-cell" wx:for="{{item.people}}" wx:for-item="a" wx:key="name"
              hover-class="a-cell-hover" hover-stay-time="60"
              data-name="{{a.name}}" bindtap="onAuthor">
          <text class="a-name ellipsis">{{a.name}}</text>
          <text class="a-num">{{a.count || a.dynasty}}</text>
        </view>
      </view>
    </view>

    <view class="safe-bottom"></view>
  </block>

  <block wx:else>
    <view class="card">
      <text class="head-title">{{author}}</text>
      <text class="head-sub">{{unread ? '还有 ' + unread + ' 条没读' : '都读过了'}}</text>
      <text class="hint back-link" hover-class="clear-hover" hover-stay-time="60" bindtap="onBack">← 回到名册</text>
    </view>

    <view class="seg filter-group">
      <radio-group class="seg-group" bindchange="onFilter">
        <label class="seg-item {{filter === item.key ? 'on' : ''}}" wx:for="{{filters}}" wx:key="key">
          <radio class="seg-radio" value="{{item.key}}" checked="{{filter === item.key}}" />
          <view class="seg-icon" style="mask-image:url('{{item.icon}}');-webkit-mask-image:url('{{item.icon}}');"></view>
          <text class="seg-text">{{item.label}}</text>
        </label>
      </radio-group>
    </view>

    <view class="count hint">共 {{matched}} 条</view>

    <view class="card">
      <view class="row" hover-class="row-hover" hover-stay-time="60"
            wx:for="{{works}}" wx:key="id" data-id="{{item.id}}" data-sid="{{item.sid}}" data-src="{{item.source}}"
            bindtap="onOpen">
        <view class="row-main">
          <text class="row-title row-poem">{{item.title}}</text>
          <text class="row-sub">{{item.sub}}</text>
        </view>
        <text class="read-dot" wx:if="{{item.read}}">已读</text>
        <text class="row-go">›</text>
      </view>
      <text class="hint more-tip" wx:if="{{remoteMore}}" bindtap="onMoreFromSource">还有 {{matched - works.length}} 条，接着看</text>
      <text class="hint more-tip" wx:elif="{{remoteNote}}">{{remoteNote}}</text>
    </view>

    <view class="empty" wx:if="{{!works.length && loading}}">
      <text class="empty-mark">等</text>
      <text class="empty-text">正在取这一位的作品</text>
    </view>

    <view class="empty" wx:if="{{!works.length && !loading}}">
      <text class="empty-mark">空</text>
      <text class="empty-text">{{filter === '未读' ? '这一位的作品都读过了' : '这一位还没有收作品'}}</text>
      <text class="hint empty-tip" wx:if="{{filter === '未读'}}">切到「全部」看看</text>
    </view>

    <text class="hint more-tip" wx:if="{{more}}">往下拉，接着取</text>

    <view class="safe-bottom"></view>
  </block>
  </block>
  <tab-bar id="tabbar" current="3" />
</view>
