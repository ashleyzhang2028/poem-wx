.index-total {
  flex: none;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
}

.index-card {
  padding: var(--sp-3) var(--sp-4);
}

.index-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.index-head .card-title {
  margin-bottom: 0;
}

.index-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: var(--sp-2);
  border-top: 1rpx solid var(--line-2);
}

.index-cell {
  width: 50%;
  min-height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-2) 12rpx var(--sp-2) 0;
  border-bottom: 1rpx solid var(--line-2);
  border-radius: var(--radius-sm);
  transition: background-color var(--t-press);
}

.index-name {
  font-size: var(--fs-hint);
  color: var(--ink-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.index-count {
  font-family: var(--font-num);
  font-size: var(--fs-caption);
  color: var(--ink-3);
  padding-left: 12rpx;
  flex: none;
}

.era-card {
  padding: var(--sp-3) var(--sp-4);
}

.group-head {
  display: flex;
  align-items: baseline;
  padding-bottom: var(--sp-2);
  border-bottom: 1rpx solid var(--line-2);
}

.group-name {
  font-family: var(--font-poem);
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--strong-text);
  letter-spacing: var(--ls-title);
}

.group-count {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  padding-left: 12rpx;
  font-variant-numeric: tabular-nums;
}

.a-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(176rpx, 1fr));
  gap: 12rpx;
  margin-top: var(--sp-3);
}

.a-cell {
  display: flex;
  align-items: center;
  justify-content: space-between;

  min-height: 64rpx;
  padding: 8rpx var(--sp-3);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-pill);
  background: var(--surface);
  transition: background-color var(--t-press);
}

.a-cell-hover {
  background: var(--sink);
}

.a-name {
  font-size: var(--fs-hint);
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.a-num {
  font-family: var(--font-num);
  font-size: var(--fs-caption);
  color: var(--ink-3);
  padding-left: 10rpx;
  flex: none;
  font-variant-numeric: tabular-nums;
}

.filter-group {
  margin: 0 0 var(--sp-2);
}

.count {
  padding: 0 var(--sp-1) var(--sp-2);
}

.read-dot {
  flex: none;
  font-size: var(--fs-caption);
  color: var(--green);
  padding: 2rpx 14rpx;
  border-radius: var(--radius-pill);
  background: var(--green-soft);
  margin-right: var(--sp-1);
}

.empty-tip {
  display: block;
  margin-top: var(--sp-2);
}

.back-bar {
  display: flex;
  align-items: center;
  min-height: 76rpx;
  font-size: var(--fs-body);
  color: var(--ink-2);
  padding: var(--sp-1) var(--sp-1);
  border-radius: var(--radius-sm);
  transition: background-color var(--t-press);
}

.back-hover {
  background: var(--sink);
}

.back-arrow {
  font-size: var(--fs-hero);
  padding-right: var(--sp-1);
  line-height: 1;
}
