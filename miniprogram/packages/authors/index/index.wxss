.index-total {
  flex: none;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
}

.index-card {
  padding: var(--sp-3) var(--sp-4);
}

.index-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.index-head .card-title {
  margin-bottom: 0;
}

.index-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: var(--sp-2);
  border-top: 1rpx solid var(--line-2);
}

.index-cell {
  width: 33.3333%;
  min-height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-2) 12rpx var(--sp-2) 0;
  border-bottom: 1rpx solid var(--line-2);
  transition: background-color var(--t-press);
}

.index-name {
  font-size: var(--fs-title);
  color: var(--strong-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.index-count {
  font-family: var(--font-num);
  font-size: var(--fs-caption);
  color: var(--ink-3);
  padding-left: 12rpx;
  flex: none;
}

.roster-head {
  padding: var(--sp-3) var(--sp-1) var(--sp-1);
}

.roster-head .head-title {
  font-weight: 400;
}

.roster-head .head-sub {
  margin-top: var(--sp-1);
}

.author-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-3) var(--sp-1) var(--sp-1);
}

.author-head .head-side {
  flex: none;
  display: flex;
  align-items: center;
}

.author-head .head-sub {
  margin-top: 0;
}

.head-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin-left: var(--sp-2);
  border-radius: var(--radius-pill);
  transition: background-color var(--t-press);
}

.head-back-arrow {
  font-size: var(--fs-lead);
  line-height: 1;
  color: var(--ink-2);
}

.era-card {
  padding: var(--sp-3) var(--sp-4);
}

.group-head {
  display: flex;
  align-items: baseline;
  padding-bottom: var(--sp-2);
  border-bottom: 1rpx solid var(--line-2);
}

.group-name {
  font-family: var(--font-poem);
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--strong-text);
  letter-spacing: var(--ls-title);
}

.group-count {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  padding-left: 12rpx;
  font-variant-numeric: tabular-nums;
}

.a-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--sp-2) 12rpx;
  margin-top: var(--sp-2);
}

.a-cell {
  display: flex;
  align-items: center;
  justify-content: space-between;

  min-height: 64rpx;
  padding: 8rpx 0;
  transition: background-color var(--t-press);
}

.a-cell-hover {
  background: var(--sink);
}

.a-name {
  font-size: var(--fs-title);
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.a-num {
  font-family: var(--font-num);
  font-size: var(--fs-caption);
  color: var(--ink-3);
  padding-left: 10rpx;
  flex: none;
  font-variant-numeric: tabular-nums;
}

.filter-group {
  margin: var(--sp-3) 0 var(--sp-2);
}

.count {
  padding: 0 var(--sp-1) var(--sp-2);
}

.read-dot {
  flex: none;
  font-size: var(--fs-caption);
  color: var(--green);
  padding: 2rpx 14rpx;
  border-radius: var(--radius-pill);
  background: var(--green-soft);
  margin-right: var(--sp-1);
}

.empty-tip {
  display: block;
  margin-top: var(--sp-2);
}

