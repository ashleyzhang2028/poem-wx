.roster-head .head-title {
  font-size: var(--fs-lead);
}

.index-total {
  flex: none;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
}

.index-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: var(--card-title-gap);
  border-top: 1rpx solid var(--line-2);
}

.index-cell {
  width: 33.3333%;
  min-height: var(--h-opt);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-2) 12rpx var(--sp-2) 0;
  border-bottom: 1rpx solid var(--line-2);
  transition: background-color var(--t-press);
}

.index-name {
  min-width: 0;
  font-size: var(--fs-hint);
  color: var(--strong-text);
}

.index-count {
  font-family: var(--font-num);
  font-size: var(--fs-caption);
  color: var(--ink-3);
  padding-left: var(--sp-2);
  flex: none;
}

.group-head {
  display: flex;
  align-items: baseline;
  padding-bottom: var(--sp-2);
  border-bottom: 1rpx solid var(--line-2);
}

.group-name {
  font-family: var(--font-poem);
  font-size: var(--fs-title);
  color: var(--strong-text);
  letter-spacing: var(--ls-title);
}

.group-count {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  padding-left: var(--sp-2);
  font-variant-numeric: tabular-nums;
}

.a-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--sp-2) var(--sp-4);
  margin-top: var(--card-title-gap);
}

.a-cell {
  display: flex;
  align-items: center;
  justify-content: flex-start;

  min-height: 64rpx;
  padding: 8rpx 0;
  transition: background-color var(--t-press);
}

.a-cell-hover {
  background: var(--sink);
}

.a-name {
  min-width: 0;
  font-family: var(--font-poem);
  font-size: var(--fs-body);
  color: var(--strong-text);
}

.filter-group {
  margin: var(--sp-3) 0 var(--sp-2);
}

.count {
  padding: 0 var(--sp-1) var(--sp-2);
}

.empty-tip {
  display: block;
  margin-top: var(--sp-2);
}

.more-tip {
  display: block;
  text-align: center;
  padding: var(--sp-3) 0 var(--sp-2);
  font-size: var(--fs-caption);
}

.author-search .author-field {
  margin-bottom: 0;
}

.suggest {
  display: flex;
  flex-wrap: wrap;
  margin-top: var(--sp-2);
  border-top: 1rpx solid var(--line-2);
}

.suggest-row {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  width: 50%;
  min-height: var(--h-opt);
  border-bottom: 1rpx solid var(--line-2);
  transition: background-color var(--t-press);
}

.suggest-row:nth-child(odd) {
  padding-right: var(--sp-2);
}

.suggest-row:nth-child(even) {
  padding-left: var(--sp-2);
  border-left: 1rpx solid var(--line-2);
}

.suggest-name {
  flex: 1;
  font-family: var(--font-poem);
  font-size: var(--fs-body);
  color: var(--strong-text);
}

.suggest-era {
  flex: none;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  padding-left: var(--sp-2);
}

.suggest-mark {
  flex: none;
  margin-left: var(--sp-2);
}

.suggest-count {
  flex: none;
  font-family: var(--font-num);
  font-size: var(--fs-caption);
  color: var(--ink-3);
  padding-left: var(--sp-2);
  font-variant-numeric: tabular-nums;
}

.suggest-note {
  display: block;
  margin-top: var(--sp-2);
}

.back-link {
  display: block;
  margin-top: var(--sp-2);
}
