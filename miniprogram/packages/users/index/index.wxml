<view class="page {{barBelow ? 'has-tabbar' : 'tall'}}" style="{{themeStyle}}">

  <lock-card wx:if="{{!logged}}" title="用户列表" note="登录后才能看" mark="人" bind:login="onLogin" />

  <block wx:else>

    <view class="card">
      <text class="hint note" wx:if="{{!remoteReady}}">只读 · 服务器未接上</text>
      <text class="hint note" wx:elif="{{!adminReady}}">只读</text>

      <view class="acct" wx:for="{{users}}" wx:key="id">
        <text class="seq">{{item.seq}}</text>
        <view class="acct-main">
          <text class="acct-name">{{item.label}}</text>
          <text class="acct-sub">{{item.id}}</text>
        </view>

        <view class="acct-acts">
          <text class="tag acct-tier" wx:if="{{item.tierLabel}}">{{item.tierLabel}}</text>
          <text class="acct-until" wx:if="{{item.untilText}}">至 {{item.untilText}}</text>
          <button class="btn mini acct-act" wx:if="{{canWrite && item.editable}}" data-u="{{item.id}}"
                  bindtap="onSetTier">改档</button>
          <text class="acct-lock" wx:if="{{!canWrite}}">只读</text>
        </view>
      </view>

      <view class="empty" wx:if="{{!users.length}}">
        <text class="empty-mark">名</text>
        <text class="empty-text">名录里还没有人</text>
      </view>

      <text class="hint note error" wx:if="{{msg}}">{{msg}}</text>
    </view>

  </block>

  <view class="due-mask" wx:if="{{dueOpen}}" bindtap="onDueCancel">
    <view class="due" catchtap="onDueStop">
      <text class="due-title">改成 {{dueTierLabel}}</text>
      <view class="due-field">
        <text class="due-label">到期日</text>
        <picker mode="date" value="{{dueDate}}" start="{{dueMin}}" bindchange="onDueChange">
          <view class="due-day">{{dueDate || '点这里选日期'}}</view>
        </picker>
      </view>
      <text class="hint note error" wx:if="{{dueNote}}">{{dueNote}}</text>
      <button class="btn primary block" bindtap="onDueConfirm">确定</button>
      <button class="due-btn" bindtap="onDueForever">不设到期，长期有效</button>
      <button class="due-btn" bindtap="onDueCancel">取消</button>
    </view>
  </view>

  <view class="safe-bottom"></view>
  <tab-bar id="tabbar" current="4" />
</view>
