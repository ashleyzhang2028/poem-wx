.note {
  display: block;
  padding-top: var(--sp-2);
  line-height: var(--lh-body);
}

.error {
  color: var(--red);
}

.sum-total {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: var(--sp-2);
  padding-bottom: var(--sp-3);
  margin-bottom: var(--sp-2);
  border-bottom: 1rpx solid var(--line-2);
}

.sum-v {
  font-family: var(--font-num);
  font-size: var(--fs-stat);
  font-weight: 400;
  color: var(--strong-text);
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
  letter-spacing: -1rpx;
}

.sum-tag {
  font-size: var(--fs-hint);
  color: var(--ink-3);
}

.sum-partial {
  font-size: var(--fs-caption);
  color: var(--amber);
}

.sum-row {
  display: flex;
  padding: var(--sp-2) 0;
  border-bottom: 1rpx solid var(--line-2);
}

.sum-row:last-of-type {
  border-bottom: none;
}

.sum-label {
  flex: none;
  width: 76rpx;
  font-size: var(--fs-hint);
  color: var(--ink-2);
}

.sum-body {
  flex: 1;
  min-width: 0;
}

.sum-cells {
  display: flex;
}

.sum-num {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-family: var(--font-num);
  font-size: var(--fs-lead);
  color: var(--strong-text);
  line-height: var(--lh-tight);
  font-variant-numeric: tabular-nums;
}

.sum-scale {
  display: block;
  padding-top: var(--sp-1);
  font-size: var(--fs-caption);
  color: var(--ink-3);
  letter-spacing: var(--ls-caption);
}

.acct {
  display: flex;
  align-items: center;
  padding: var(--sp-3) 0;
  border-bottom: 1rpx solid var(--line-2);
}

.acct:last-of-type {
  border-bottom: none;
}

.acct-main {
  flex: 1;
  min-width: 0;
}

.acct-name {
  display: block;
  font-size: var(--fs-body);
  color: var(--strong-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.acct-sub {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 6rpx;
}

.acct-acts {
  display: flex;
  align-items: center;
  flex: none;
  gap: var(--sp-2);
  padding-left: var(--sp-2);
}

.acct-tier {
  color: var(--strong-text);
  background: var(--strong-soft);
}

.acct-act {
  color: var(--ink-2);
  border-color: var(--line-strong);
}

.acct-lock {
  font-size: var(--fs-caption);
  color: var(--ink-3);
}
