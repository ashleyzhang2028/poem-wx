.note {
  display: block;
  padding-top: var(--sp-2);
  line-height: var(--lh-body);
}

.error {
  color: var(--red);
}

.acct {
  display: flex;
  align-items: center;
  padding: var(--sp-3) 0;
  border-bottom: 1rpx solid var(--line-2);
}

.acct:last-of-type {
  border-bottom: none;
}

.acct-main {
  flex: 1;
  min-width: 0;
}

.acct-name {
  display: block;
  font-size: var(--fs-body);
  color: var(--strong-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.acct-sub {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 6rpx;
}

.acct-acts {
  display: flex;
  align-items: center;
  flex: none;
  gap: var(--sp-2);
  padding-left: var(--sp-2);
}

.acct-tier {
  color: var(--strong-text);
  background: var(--strong-soft);
}

.acct-act {
  color: var(--ink-2);
  border-color: var(--line-strong);
}

.acct-lock {
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

.acct-until {
  flex: none;
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

.due-mask {
  position: fixed;
  inset: 0;
  z-index: 60;
  background: rgba(0, 0, 0, .35);
  display: flex;
  align-items: flex-end;
}

.due {
  position: relative;
  width: 100%;
  box-sizing: border-box;
  padding: var(--sp-4) var(--sp-4) var(--sp-4);
  background: var(--surface);
  border-radius: var(--radius) var(--radius) 0 0;
}

.due-title {
  display: block;
  font-size: var(--fs-title);
  color: var(--strong-text);
  padding-bottom: var(--sp-2);
}

.due-field {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  padding: var(--sp-2) 0;
}

.due-label {
  font-size: var(--fs-body);
  color: var(--ink-2);
}

.due-day {
  flex: 1;
  padding: var(--sp-2) var(--sp-3);
  font-size: var(--fs-body);
  color: var(--strong-text);
  background: var(--sink);
  border-radius: var(--radius-ctl);
}

.due-btn {
  display: block;
  width: 100%;
  box-sizing: border-box;
  margin-top: var(--sp-2);
  padding: var(--sp-3) 0;
  text-align: center;
  font-size: var(--fs-body);
  color: var(--ink-2);
  background: var(--sink);
  border-radius: var(--radius-ctl);
}
