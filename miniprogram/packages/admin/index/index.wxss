.grant {
  background: var(--surface);
}

.grant-head {
  padding-top: var(--sp-1);
}

.grant-tier-name {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-hero);
  font-weight: 700;
  color: var(--strong-text);
  letter-spacing: var(--ls-title);
  line-height: var(--lh-tight);
}

.grant-meter {
  margin-top: var(--sp-3);
}

.grant-meter-t {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 10rpx;
}

.note {
  display: block;
  padding-top: var(--sp-2);
  line-height: var(--lh-body);
}

.error {
  color: var(--red);
}

.cap-group {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  letter-spacing: var(--ls-caption);
  margin: var(--sp-3) 0 var(--sp-1);
}

.cap {
  display: flex;

  align-items: center;
  min-height: 64rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid var(--line-2);
}

.cap:last-child {
  border-bottom: none;
}

.cap-mark {
  width: 44rpx;
  flex: none;
  font-size: var(--fs-body);

  text-align: center;
  line-height: 1.4;
}

.cap-mark.on {
  color: var(--green);
}

.cap-mark.off {
  color: var(--line);
}

.cap-name {
  font-size: var(--fs-body);
  color: var(--strong-text);
  line-height: 1.4;
  margin-left: var(--sp-2);
  margin-right: var(--sp-2);
}

.cap-note {
  padding-left: var(--sp-2);
}

.cap-name.dim {
  color: var(--ink-3);
}

.cap-note {
  flex: 1;
  text-align: right;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  line-height: 1.4;
}

.acct {
  display: flex;
  align-items: center;
  padding: var(--sp-3) 0;
  border-bottom: 1rpx solid var(--line-2);
}

.acct:last-of-type {
  border-bottom: none;
}

.acct-main {
  flex: 1;
  min-width: 0;
}

.acct-name {
  display: block;
  font-size: var(--fs-body);
  color: var(--strong-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.acct-sub {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 6rpx;
}

.acct-acts {
  display: flex;
  flex-shrink: 0;
  gap: var(--sp-1);
}

.acct-act {
  color: var(--ink-2);
  border-color: var(--line-strong);
}

.acct-lock {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  padding-left: var(--sp-3);
}

.empty-tip {
  display: block;
  margin-top: var(--sp-2);
}
