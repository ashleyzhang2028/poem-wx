.grant {
  margin-top: var(--sp-3);
  background: var(--surface);
}

.grant-head {
  padding-top: var(--sp-1);
}

.grant-tier-name {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-hero);
  font-weight: 700;
  color: var(--strong-text);
  letter-spacing: var(--ls-title);
  line-height: var(--lh-tight);
}

.grant-meter {
  margin-top: var(--sp-3);
}

.grant-meter-t {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 10rpx;
}

.note {
  display: block;
  padding-top: var(--sp-2);
  line-height: var(--lh-body);
}

.error {
  color: var(--red);
}

.compare-body {
  height: 620rpx;
}

.compare-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line-2);
}

.compare-body .compare-row:last-child {
  border-bottom: none;
}

.compare-head {
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

.compare-cap {
  flex: 1 1 auto;
  font-size: var(--fs-body);
  color: var(--strong-text);
}

.compare-tier {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 6rpx;
  flex: 0 0 96rpx;
  font-size: var(--fs-caption);
  color: var(--ink-2);
}

.compare-note {
  font-size: var(--fs-pinyin);
  color: var(--green);
  background: var(--green-soft);
  border-radius: var(--radius-pill);
  padding: 2rpx 12rpx;
}

.compare-mark {
  font-size: var(--fs-body);
}

.compare-mark.on {
  color: var(--green);
}

.compare-mark.off {
  color: var(--line);
}

.acct {
  display: flex;
  align-items: center;
  padding: var(--sp-3) 0;
  border-bottom: 1rpx solid var(--line-2);
}

.acct:last-of-type {
  border-bottom: none;
}

.acct-main {
  flex: 1;
  min-width: 0;
}

.acct-name {
  display: block;
  font-size: var(--fs-body);
  color: var(--strong-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.acct-sub {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 6rpx;
}

.acct-acts {
  display: flex;
  flex-shrink: 0;
  gap: var(--sp-1);
}

.acct-act {
  color: var(--ink-2);
  border-color: var(--line-strong);
}

.acct-lock {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  padding-left: var(--sp-3);
}

.empty-tip {
  display: block;
  margin-top: var(--sp-2);
}
