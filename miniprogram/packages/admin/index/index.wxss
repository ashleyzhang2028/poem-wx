/* ============================================================
   权限页：它是一张「我有什么」的对账单，不是收银台。
   所以第一张卡只说清当前档位与能力覆盖，其余都是证据。
   ============================================================ */

.grant {
  background: linear-gradient(168deg, #fffefb 0%, var(--bg-soft) 62%, #eef4f0 100%);
  border-color: var(--green-edge);
}

.grant-head {
  padding-top: var(--sp-1);
}

.grant-tier {
  display: flex;
  align-items: baseline;
}

.grant-tier-v {
  font-family: var(--font-poem);
  font-size: var(--fs-mark);
  font-weight: 600;
  color: var(--green);
  letter-spacing: var(--ls-title);
}

.grant-tier-k {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  padding-left: var(--sp-2);
}

.grant-meter {
  margin-top: var(--sp-3);
}

.grant-meter-t {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 10rpx;
}

.note {
  display: block;
  padding-top: var(--sp-2);
  line-height: var(--lh-body);
}

.error {
  color: var(--red);
}

/* ---------- 能力矩阵 ----------
   一行一项：勾 / 叉 + 名字 + 「差在哪」。
   分组标题压低一档，它不是内容，是目录 */
.cap-group {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  letter-spacing: var(--ls-caption);
  margin: var(--sp-3) 0 var(--sp-1);
}

.cap {
  display: flex;
  align-items: baseline;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--line-2);
}

.cap:last-child {
  border-bottom: none;
}

.cap-mark {
  width: 44rpx;
  flex: none;
  font-size: var(--fs-body);
}

.cap-mark.on {
  color: var(--green);
}

.cap-mark.off {
  color: var(--line);
}

.cap-name {
  font-size: var(--fs-body);
  color: var(--ink);
  margin-right: var(--sp-2);
}

.cap-name.dim {
  color: var(--ink-3);
}

.cap-note {
  flex: 1;
  text-align: right;
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

/* ---------- 名录 ----------
   一行一个人：左边身份，右边两个动作 */
.acct {
  display: flex;
  align-items: center;
  padding: var(--sp-3) 0;
  border-bottom: 1rpx solid var(--line-2);
}

.acct:last-of-type {
  border-bottom: none;
}

.acct-main {
  flex: 1;
  min-width: 0;
}

.acct-name {
  display: block;
  font-size: var(--fs-body);
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.acct-sub {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 6rpx;
}

.acct-acts {
  display: flex;
  flex-shrink: 0;
  gap: var(--sp-1);
}

/* 改档 / 改角色是原生 button，只压小尺寸与去掉原生最小宽度 */
.acct-act {
  color: var(--green);
  border-color: var(--line);
}

.acct-lock {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  padding-left: var(--sp-3);
}

.empty-tip {
  display: block;
  margin-top: var(--sp-2);
}
