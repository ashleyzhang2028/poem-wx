.acct {
  display: flex;
  align-items: center;
  padding: var(--sp-3) 0;
  border-bottom: 1rpx solid var(--line-2);
}

.acct:last-of-type {
  border-bottom: none;
}

.acct-main {
  flex: 1;
  min-width: 0;
}

.acct-name {
  display: block;
  font-size: var(--fs-body);
  color: var(--strong-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.acct-sub {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 6rpx;
}

.acct-acts {
  display: flex;
  flex-shrink: 0;
  gap: var(--sp-1);
}

.acct-act {
  color: var(--ink-2);
  border-color: var(--line-strong);
}

.acct-lock {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  padding-left: var(--sp-3);
}

.empty-tip {
  display: block;
  margin-top: var(--sp-2);
}
