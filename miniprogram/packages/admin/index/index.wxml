<view class="page" style="{{themeStyle}}">

  <tier-view />

  <view class="card roster" wx:if="{{!logged}}">
    <text class="hint note">名录要登录 · 见上面那张表</text>
  </view>

  <view class="row" hover-class="row-hover" hover-stay-time="60" wx:if="{{logged}}" bindtap="onUsers">
    <view class="row-icon">人</view>
    <view class="row-main">
      <text class="row-title">用户列表</text>
      <text class="row-sub">{{usersSub}}</text>
    </view>
    <text class="row-go">›</text>
  </view>

  <view class="safe-bottom"></view>
</view>
