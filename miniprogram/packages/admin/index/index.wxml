<view class="page" style="{{themeStyle}}">

  <view class="card">
    <view class="row row-flush" wx:if="{{logged}}"
          hover-class="row-hover" hover-stay-time="60" bindtap="onUsers">
      <view class="row-icon">人</view>
      <view class="row-main">
        <text class="row-title">用户列表</text>
        <text class="row-sub">{{usersSub}}</text>
      </view>
      <text class="row-go">›</text>
    </view>

    <text class="hint note" wx:else>管理要登录</text>
  </view>

  <view class="safe-bottom"></view>
</view>
