<view class="page" style="{{themeStyle}}">

  <lock-card wx:if="{{!logged}}" title="权限要登录" note="登录后才能看" mark="权" />

  <block wx:else>
  <view class="card grant">
    <view class="card-title bar">我的权限</view>
    <view class="grant-head">

      <text class="grant-tier-name">{{status.label}}</text>

      <view class="grant-meter">
        <view class="meter">
          <view class="meter-fill" style="width:{{stats.percent}}%"></view>
        </view>
        <text class="grant-meter-t">{{stats.enabled}} / {{stats.caps}} 项能力</text>
      </view>
    </view>

    <text class="hint note" wx:if="{{status.blocked === 'unsigned'}}">连不上服务器 · 暂按 Free</text>
  </view>

  <view class="card compare">
    <view class="card-title bar">权限对比</view>
    <view class="compare-row compare-head">
      <text class="compare-cap">功能</text>
      <text class="compare-tier">{{head.name}}</text>
    </view>
    <scroll-view class="compare-body" scroll-y>
      <view class="compare-row" wx:for="{{compareRows}}" wx:key="cap">
        <text class="compare-cap">{{item.name}}</text>
        <text class="compare-tier {{col.now ? 'is-now' : ''}}"
              wx:for="{{item.cells}}" wx:for-item="col" wx:key="tier">
          <text class="compare-note" wx:if="{{col.now}}">现在</text>
          <text class="compare-mark {{col.on ? 'on' : 'off'}}">{{col.on ? '✓' : '✕'}}</text>
        </text>
      </view>
    </scroll-view>
  </view>

  <view class="card">
    <view class="card-title bar">用户名录</view>
    <text class="hint note" wx:if="{{!remoteReady}}">只读 · 服务器未接上{{generatedAt ? ' · 生成于 ' + generatedAt : ''}}</text>
    <text class="hint note" wx:elif="{{!adminReady}}">只读</text>

    <view class="acct" wx:for="{{users}}" wx:key="id">
      <view class="acct-main">
        <text class="acct-name">{{item.label}}</text>
        <text class="acct-sub">{{item.tierLabel ? item.tierLabel : '未分级'}}</text>
      </view>

      <view class="acct-acts">
        <button class="btn mini acct-act" wx:if="{{canWrite && item.editable}}" data-u="{{item.id}}"
                bindtap="onSetTier">改档</button>
        <button class="btn mini acct-act" wx:if="{{canSetRole && item.editable}}" data-u="{{item.id}}"
                bindtap="onSetRole">角色</button>
        <text class="acct-lock" wx:if="{{!canWrite && !canSetRole}}">只读</text>
      </view>
    </view>

    <view class="empty" wx:if="{{!users.length}}">
        <text class="empty-mark">名</text>
        <text class="empty-text">名录里还没有人</text>

      </view>
    <text class="hint note" wx:if="{{rosterNote}}">名录：{{rosterNote}}</text>
    <text class="hint note error" wx:if="{{msg}}">{{msg}}</text>
  </view>

  <view class="card">
    <view class="card-title bar">要一个更高的档位</view>
    <button class="btn ghost block" bindtap="onCopyFeedback">联系邮箱</button>
    <button class="btn ghost block" bindtap="onLoadAccounts">{{busy ? '刷新中…' : '刷新名录'}}</button>
  </view>
  </block>

  <view class="safe-bottom"></view>
</view>
