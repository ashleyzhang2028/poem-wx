.ap-note {
  display: block;
  margin-bottom: var(--sp-3);
}

.ap-input {
  display: flex;
  align-items: center;
  height: var(--h-field);
  padding: 0 var(--sp-3);
  margin-bottom: var(--sp-2);
  border: 1rpx solid var(--line-strong);
  border-radius: var(--radius-ctl);
  font-size: var(--fs-body);
  color: var(--ink);
}

.ap-stats {
  margin-bottom: 0;
}

.ap-amount {
  font-family: var(--font-num);
}

.ap-order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ap-id {
  word-break: break-all;
}

.ap-pager {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--sp-3);
  padding-top: var(--sp-3);
  border-top: 1rpx solid var(--line-2);
}

.ap-page {
  width: auto;
  margin: 0;
}

.ap-page-n {
  font-family: var(--font-num);
  font-size: var(--fs-hint);
  color: var(--ink-2);
}

@media (max-width: 350px) {
  .ap-stats .stat-v {
    font-size: var(--fs-head);
  }
}
