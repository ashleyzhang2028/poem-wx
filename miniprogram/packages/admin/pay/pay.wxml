<view class="page {{barBelow ? 'has-tabbar' : 'tall'}} {{name}}" style="{{themeStyle}}">

  <view class="card" wx:if="{{!canWrite}}">
    <text class="hint">需要管理员登录。</text>
  </view>

  <block wx:else>
    <text class="hint ap-note" wx:if="{{reason}}">{{reason}}</text>

    <view class="card" wx:if="{{summary}}">
      <text class="card-title">购买记录</text>

      <view class="stats ap-stats">
        <view class="stat">
          <text class="stat-v">{{summary.count}}</text>
          <text class="stat-k">全部笔数</text>
        </view>
        <view class="stat">
          <text class="stat-v">{{summary.paid}}</text>
          <text class="stat-k">已支付</text>
        </view>
        <view class="stat">
          <text class="stat-v"><text class="ap-amount">¥{{summary.paidText}}</text></text>
          <text class="stat-k">合计金额</text>
        </view>
      </view>

      <view class="ap-status">
        <view class="row row-flush" wx:for="{{statusRows}}" wx:key="key"
              hover-class="row-hover" hover-stay-time="60" data-key="{{item.key}}" bindtap="onStatus">
          <view class="row-main">
            <text class="row-title">{{item.name}}</text>
            <text class="row-sub">{{item.count}} 笔 · ¥{{item.text}}</text>
          </view>
          <text class="row-go">›</text>
        </view>
      </view>
    </view>

    <view class="card" wx:if="{{catalog}}">
      <text class="card-title">添加道具</text>
      <input class="ap-input" placeholder="道具 ID（与 MP 后台一致）" value="{{draft.productId}}"
             data-field="productId" bindinput="onDraft" />
      <picker range="{{planChoices}}" value="{{draft.planIndex}}" data-field="planIndex" bindchange="onDraft">
        <view class="ap-input">档位：{{planChoices[draft.planIndex]}}</view>
      </picker>
      <picker range="{{periodChoices}}" value="{{draft.periodIndex}}" data-field="periodIndex" bindchange="onDraft">
        <view class="ap-input">周期：{{periodChoices[draft.periodIndex]}}</view>
      </picker>
      <input class="ap-input" type="digit" placeholder="价格（元）" value="{{draft.price}}"
             data-field="price" bindinput="onDraft" />
      <button class="btn primary block" bindtap="onAddProduct">添加</button>
    </view>

    <view class="card" wx:if="{{catalog}}">
      <text class="card-title">价格与促销</text>
      <text class="hint ap-note">价格必须与 MP 后台「道具管理」里的道具一致。促销：先在 MP 后台建促销价道具，下面添加后选择生效。</text>

      <view class="ap-slots">
        <picker wx:for="{{slots}}" wx:key="key" data-index="{{index}}" range="{{item.labels}}" bindchange="onPickActive">
          <view class="ap-slot">
            <text class="ap-slot-t">{{item.title}}</text>
            <text class="ap-slot-v">{{item.activeText}}</text>
          </view>
        </picker>
      </view>
    </view>
  </block>

  <view class="safe-bottom"></view>
  <tab-bar id="tabbar" current="4" />
</view>
