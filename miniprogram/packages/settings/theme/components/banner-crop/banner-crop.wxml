<view class="bc-root" wx:if="{{open}}" catchtouchmove="onLock">
  <view class="bc-mask" bindtap="onCancel"></view>

  <view class="bc-panel {{name}}" style="{{themeStyle}}">
    <view class="bc-head">
      <text class="bc-title">图片截取</text>
      <text class="bc-ratio">{{ratioW}} × {{ratioH}}</text>
    </view>

    <view class="bc-stage" style="width: {{stageW}}px; height: {{stageH}}px">
      <image class="bc-img" wx:if="{{src}}" src="{{src}}" mode="scaleToFill"
             style="width: {{imgW}}px; height: {{imgH}}px; left: {{imgX}}px; top: {{imgY}}px" />
      <view class="bc-frame"></view>
      <view class="bc-stage-touch" bindtouchstart="onTouchStart" bindtouchmove="onTouchMove"
            bindtouchend="onTouchEnd" bindtouchcancel="onTouchEnd"></view>
    </view>

    <view class="bc-acts">
      <button class="btn ghost mini" bindtap="onCancel">取消</button>
      <button class="btn ghost mini" hover-class="none" bindtap="onZoomOut">缩小</button>
      <button class="btn ghost mini" hover-class="none" bindtap="onZoomIn">放大</button>
      <button class="btn mini primary" loading="{{busy}}" bindtap="onConfirm">截取</button>
    </view>
  </view>
</view>

<canvas class="bc-canvas" type="2d" id="{{canvasId}}"></canvas>
