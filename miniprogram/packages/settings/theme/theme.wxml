<view class="page theme-page {{barBelow ? 'has-tabbar' : 'tall'}}" style="{{themeStyle}}">
  <page-banner src="{{banner}}" />

  <nav-bar />

  <lock-card wx:if="{{locked}}" title="主题" note="登录后才能改" mark="主" bind:login="onLogin" />

  <block wx:else>
  <view class="card group-card" wx:for="{{groups}}" wx:for-item="group" wx:key="key">
    <view class="card-head">
      <text class="card-title group-title">{{group.title}}</text>
      <tier-tag wx:if="{{group.locked}}" tier="{{group.tier}}" />
    </view>

    <view class="swatch-grid" wx:if="{{group.key !== own}}">
      <view class="swatch {{theme === item.key ? 'on' : ''}} {{item.locked ? 'locked' : ''}}"
            wx:for="{{group.items}}" wx:key="key"
            style="--sw:{{item.rgb}};--sw-soft:{{item.soft}};--sw-on:{{item.on}}"
            hover-class="{{item.locked ? 'none' : 'swatch-hover'}}" hover-stay-time="60"
            data-key="{{item.key}}" bindtap="onPick">
        <view class="swatch-dot"></view>
        <text class="swatch-name">{{item.name}}</text>
      </view>
    </view>

    <view class="own" wx:else>
      <view class="swatch own-pick {{theme === item.key ? 'on' : ''}} {{item.locked ? 'locked' : ''}}"
            wx:for="{{group.items}}" wx:key="key"
            hover-class="{{item.locked ? 'none' : 'swatch-hover'}}" hover-stay-time="60"
            data-key="{{item.key}}" bindtap="onOwnPick">
        <view class="own-thumb swatch-dot {{item.set ? 'has-img' : ''}}">
          <image class="own-thumb-img" wx:if="{{item.set}}" src="{{item.banner}}" mode="aspectFill" />
        </view>
        <text class="swatch-name">{{ownSet ? '已换上你的图' : '还没有图'}}</text>
      </view>

      <text class="own-note">图片存于本机，不同步到服务器</text>

      <view class="own-acts">
        <button class="btn ghost mini" bindtap="onOwnUpload">{{ownSet ? '换图' : '选图'}}</button>
        <button class="btn ghost mini" wx:if="{{ownSet}}" bindtap="onOwnClear">恢复默认</button>
      </view>
    </view>
  </view>

  <view class="card group-card">
    <view class="card-head">
      <text class="card-title group-title">自定义主题色</text>
      <tier-tag wx:if="{{ownLocked}}" tier="max" />
    </view>

    <view class="tone">
      <view class="tone-row">
        <view class="tone-chip" style="background: {{toneView.toneRgba || '#c7c9cd'}}; color: {{toneView.toneOnInk || '#ffffff'}}">{{toneView.toneHex || '自定义'}}</view>
        <input class="tone-hex" type="text" maxlength="7" value="{{toneView.toneHex}}"
               placeholder="#8C2F2D" placeholder-class="tone-hex-ph"
               confirm-type="done" bindinput="onToneHex" bindconfirm="onToneHex" bindblur="onToneHex" />
        <button class="tone-clear" wx:if="{{toneView.toneOn}}" hover-class="none" bindtap="onToneReset">清掉</button>
      </view>

      <view class="tone-bar" style="background: {{toneView.toneRgba || '#c7c9cd'}}">
        <text class="tone-bar-t" style="color: {{toneView.toneOnInk || '#ffffff'}}">{{toneView.toneText}}</text>
      </view>

      <view class="tone-grid">
        <view class="tone-cell tone-hue {{toneView.toneHex === item ? 'on' : ''}}"
              wx:for="{{toneView.toneHues}}" wx:key="*this"
              style="background: {{item}}" data-hex="{{item}}" bindtap="onTonePick"></view>
      </view>

      <view class="tone-grid">
        <view class="tone-cell tone-light {{toneView.toneHex === item ? 'on' : ''}}"
              wx:for="{{toneView.toneLights}}" wx:key="*this"
              style="background: {{item}}" data-hex="{{item}}" bindtap="onTonePick"></view>
      </view>
    </view>
  </view>

  <view class="card group-card">
    <view class="card-head">
      <text class="card-title group-title">字体</text>
      <tier-tag wx:if="{{fontLocked}}" tier="{{fontTier}}" />
    </view>

    <view class="font-list">
      <view class="font-row {{font === item.key ? 'on' : ''}} {{item.locked ? 'locked' : ''}}"
            wx:for="{{fonts}}" wx:key="key"
            hover-class="{{item.locked ? 'none' : 'font-hover'}}" hover-stay-time="60"
            data-key="{{item.key}}" bindtap="onFont">
        <text class="font-sample" style="font-family:'{{item.tone}}'">{{fontSample}}</text>
        <text class="font-name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <view class="safe-bottom gap-bottom"></view>
  </block>
  <banner-crop id="crop" bind:done="onCropDone" />

  <tab-bar id="tabbar" current="4" />
</view>
