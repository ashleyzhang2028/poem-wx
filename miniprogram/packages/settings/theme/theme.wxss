.group-title {
  flex: 1;
  min-width: 0;
  margin-bottom: 0;
}

.swatch-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--sp-2) var(--sp-1);
  padding-top: var(--sp-2);
}

.swatch {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 6rpx 0;
  min-height: 108rpx;
}

.swatch-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--sw-soft);
  box-shadow: inset 0 0 0 1rpx var(--sw);
  transition: background-color var(--t-press), transform var(--t-press);
}

.swatch-hover .swatch-dot,
.swatch-dot:focus,
.swatch.on .swatch-dot {
  background: var(--sw);
}

.swatch-hover .swatch-dot {
  transform: scale(.92);
}

.swatch.on .swatch-dot {
  box-shadow: inset 0 0 0 1rpx var(--sw), 0 0 0 4rpx var(--sw-soft);
}

.swatch-name {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.swatch.on .swatch-name {
  color: var(--ink-2);
}

.swatch.locked .swatch-dot {
  background: transparent;
  box-shadow: inset 0 0 0 1rpx var(--line-strong);
}

.swatch.locked .swatch-name {
  color: var(--ink-4);
}

.font-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--sp-2) var(--sp-1);
  padding-top: var(--sp-2);
}

.font-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 10rpx 0;
  border-radius: var(--radius-sm);
  transition: background-color var(--t-press), color var(--t-press);
}

.font-row.on {
  background: var(--strong-soft);
  border: 1rpx solid var(--strong);
}

.font-hover {
  background: var(--sink);
}

.font-sample {
  max-width: 100%;
  overflow: hidden;
  white-space: nowrap;
  font-size: var(--fs-hint);
  color: var(--ink);
  letter-spacing: 0;
  line-height: 1.2;
}

.font-name {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  letter-spacing: 1rpx;
  line-height: 1.2;
  text-align: center;
}

.font-row.on .font-name {
  color: var(--strong);
}

.font-row.on .font-sample {
  color: var(--strong);
}

.font-row.locked {
  opacity: .45;
}

.theme-page {
  padding-top: 0;
  background: var(--surface);
}

.theme-page .group-card {
  background: transparent;
}

.theme-page .group-card:first-of-type {
  position: relative;
  z-index: 1;
  margin-top: var(--banner-lead-gap);
}

.page.tall .gap-bottom {
  display: none;
}

.own {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--sp-2) var(--sp-3);
  padding-top: var(--sp-2);
}

.own-pick {
  flex-direction: row;
  min-height: 0;
  gap: var(--sp-2);
}

.own-thumb {
  overflow: hidden;
}

.swatch-dot.has-img {
  border-radius: var(--radius-sm);
}

.own-thumb-img {
  display: block;
  width: 100%;
  height: 100%;
}

.own-acts {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-end;
  gap: var(--sp-2);
  margin-left: auto;
}

.own-note {
  flex: 1 0 100%;
  order: -1;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  letter-spacing: 1rpx;
  line-height: var(--lh-body);
}

.tone {
  padding-top: var(--sp-2);
}

.tone.locked {
  opacity: .45;
}

.tone-row {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
}

.tone-input {
  flex: 1;
  min-width: 0;
  height: var(--h-btn-mini);
  padding: 0 var(--sp-3);
  border-radius: var(--radius-pill);
  background: var(--sink);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: var(--fs-caption);
  color: var(--ink);
  letter-spacing: 1rpx;
  text-align: center;
}

.tone-input-ph {
  color: var(--ink-4);
  letter-spacing: 1rpx;
}

.tone-clear {
  flex: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: var(--h-btn-mini);
  padding: 0 var(--sp-3);
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--line-strong);
  font-size: var(--fs-caption);
  color: var(--ink-4);
  line-height: 1;
  white-space: nowrap;
}

.tone-clear.on {
  color: var(--ink-2);
}

.tone-preview {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  margin-top: var(--sp-3);
  padding: var(--sp-2) var(--sp-3);
  border-radius: var(--radius-pill);
  background: var(--sink);
  transition: background-color var(--t-press);
}

.tone-preview-hover {
  background: var(--line);
}

.tone-preview-title {
  color: var(--strong-text);
  font-size: var(--fs-title);
  letter-spacing: var(--ls-title);
  line-height: 1.2;
}

.tone-preview-btn {
  flex: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: var(--h-btn-mini);
  padding: 0 var(--sp-3);
  border-radius: var(--radius-pill);
  background: var(--strong);
  color: var(--on-ink);
  font-size: var(--fs-caption);
  line-height: 1;
}

.tone-preview-read {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
  text-align: right;
}

.tone-axis {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  margin-top: var(--sp-2);
}

.tone-label {
  flex: none;
  width: 64rpx;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.tone-value {
  flex: none;
  width: 72rpx;
  text-align: right;
}

.tone-value-num {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
  line-height: 1.2;
}

.tone-slider {
  position: relative;
  flex: 1;
  min-width: 0;
}

.tone-band {
  position: relative;
  height: 48rpx;
  border-radius: var(--radius-sm);
  box-shadow: inset 0 0 0 1rpx var(--line-strong);
}

.tone-mark {
  position: absolute;
  top: -2rpx;
  bottom: -2rpx;
  width: 4rpx;
  margin-left: -2rpx;
  border-radius: 2rpx;
  background: var(--ink);
  box-shadow: 0 0 0 2rpx var(--surface);
  pointer-events: none;
}
