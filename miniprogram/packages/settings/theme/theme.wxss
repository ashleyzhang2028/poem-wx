.group-title {
  flex: 1;
  min-width: 0;
  margin-bottom: 0;
}

.swatch-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--sp-2) var(--sp-1);
  padding-top: var(--sp-2);
}

.swatch {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 6rpx 0;
  min-height: 108rpx;
}

.swatch-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--sw-soft);
  box-shadow: inset 0 0 0 1rpx var(--sw);
  transition: background-color var(--t-press), transform var(--t-press);
}

.swatch-hover .swatch-dot,
.swatch-dot:focus,
.swatch.on .swatch-dot {
  background: var(--sw);
}

.swatch-hover .swatch-dot {
  transform: scale(.92);
}

.swatch.on .swatch-dot {
  box-shadow: inset 0 0 0 1rpx var(--sw), 0 0 0 4rpx var(--sw-soft);
}

.swatch-name {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.swatch.on .swatch-name {
  color: var(--ink-2);
}

.swatch.locked .swatch-dot {
  background: transparent;
  box-shadow: inset 0 0 0 1rpx var(--line-strong);
}

.swatch.locked .swatch-name {
  color: var(--ink-4);
}

.font-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--sp-2) var(--sp-1);
  padding-top: var(--sp-2);
}

.font-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 10rpx 0;
  border-radius: var(--radius-sm);
  transition: background-color var(--t-press), color var(--t-press);
}

.font-row.on {
  background: var(--strong-soft);
  border: 1rpx solid var(--strong);
}

.font-hover {
  background: var(--sink);
}

.font-sample {
  max-width: 100%;
  font-family: 'Kuibu Preview', "Songti SC", "STSong", "STZhongsong",
    "Source Han Serif SC", "Noto Serif CJK SC", "SimSun", serif;
  overflow: hidden;
  white-space: nowrap;
  font-size: var(--fs-hint);
  color: var(--ink);
  letter-spacing: 0;
  line-height: 1.2;
}

.font-warm {
  position: absolute;
  top: 0;
  left: 0;
  width: 1px;
  height: 1px;
  overflow: hidden;
  pointer-events: none;
  clip-path: inset(50%);
}

.font-warm-cell {
  font-size: var(--fs-body);
  white-space: nowrap;
}

.font-strip {
  margin-top: var(--sp-1);
  padding-bottom: var(--sp-2);
  border-bottom: 1rpx solid var(--line-2);
  font-size: var(--fs-lead);
  color: var(--ink);
  letter-spacing: 0;
  line-height: 1.4;
  text-align: center;
}

.font-strip.pending {
  opacity: 0;
}

.font-name {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  letter-spacing: 1rpx;
  line-height: 1.2;
  text-align: center;
}

.font-row.on .font-name {
  color: var(--strong);
}

.font-row.on .font-sample {
  color: var(--strong);
}

.font-row.locked {
  opacity: .45;
}

.theme-page {
  position: relative;
  padding-top: 0;
  background: var(--surface);
}

.theme-page .group-card {
  background: transparent;
}

.theme-page .group-card:first-of-type {
  position: relative;
  z-index: 1;
  margin-top: var(--banner-lead-gap);
}

.page.tall .gap-bottom {
  display: none;
}

.own {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--sp-2) var(--sp-3);
  padding-top: var(--sp-2);
}

.own-pick {
  flex-direction: row;
  min-height: 0;
  gap: var(--sp-2);
}

.own-thumb {
  overflow: hidden;
}

.swatch-dot.has-img {
  border-radius: var(--radius-sm);
}

.own-thumb-img {
  display: block;
  width: 100%;
  height: 100%;
}

.own-acts {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-end;
  gap: var(--sp-2);
  margin-left: auto;
}

.own-note {
  flex: 1 0 100%;
  order: -1;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  letter-spacing: 1rpx;
  line-height: var(--lh-body);
}

.tone {
  padding-top: var(--sp-2);
}

.tone.locked {
  opacity: .45;
}

.tone-fold {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: var(--sp-2);
}

.tone-field {
  flex: 1 1 0;
  min-width: 0;
}

.tone-field-hex {
  flex: 3 1 0;
}

.tone-field-rgba {
  flex: 5 1 0;
}

.tone-chip {
  flex: none;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: var(--h-btn-mini);
  padding: 0 var(--sp-3);
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--line-strong);
}

.tone-chip-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: var(--sink);
  box-shadow: inset 0 0 0 1rpx var(--line-strong);
}

.tone-chip.on .tone-chip-dot {
  background: var(--strong);
  box-shadow: inset 0 0 0 1rpx var(--strong);
}

.tone-chip-reset {
  font-size: var(--fs-caption);
  color: var(--ink-4);
  letter-spacing: 1rpx;
  line-height: 1;
  white-space: nowrap;
}

.tone-chip.on .tone-chip-reset {
  color: var(--ink-2);
}

.tone-input {
  display: block;
  box-sizing: border-box;
  width: 100%;
  height: var(--h-btn-mini);
  padding: 0 var(--sp-2);
  border-radius: var(--radius-sm);
  background: var(--surface);
  border: 1rpx solid var(--line-strong);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: var(--fs-caption);
  color: var(--ink);
  letter-spacing: 0;
  line-height: var(--h-btn-mini);
  text-align: left;
}

.tone-input-ph {
  color: var(--ink-4);
  letter-spacing: 1rpx;
}

.tone-read {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-variant-numeric: tabular-nums;
}

.tone-axis {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  margin-top: var(--sp-2);
}

.tone-label {
  flex: none;
  width: 64rpx;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.tone-value {
  flex: none;
  width: 72rpx;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  letter-spacing: 1rpx;
  font-variant-numeric: tabular-nums;
  line-height: 1.2;
  text-align: right;
}

.tone-slider {
  position: relative;
  flex: 1;
  min-width: 0;
}

.tone-band {
  position: relative;
  height: 48rpx;
  border-radius: var(--radius-sm);
  box-shadow: inset 0 0 0 1rpx var(--line-strong);
}

.tone-mark {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 4rpx;
  margin-left: -2rpx;
  border-radius: 2rpx;
  background: var(--ink);
  pointer-events: none;
}
