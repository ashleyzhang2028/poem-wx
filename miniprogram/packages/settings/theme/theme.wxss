.swatch-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: var(--sp-2) var(--sp-1);
  padding-top: var(--sp-2);
}

.swatch {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 6rpx 0;
  min-height: 108rpx;
}

.swatch-hover {
  opacity: .84;
}

.swatch-hover .swatch-dot {
  transform: scale(.92);
}

.swatch-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--sw);

  box-shadow: inset 0 0 0 1rpx var(--line-strong);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform var(--t-press), box-shadow var(--t-press);
}

.swatch.on .swatch-dot {
  box-shadow: 0 0 0 4rpx var(--sw-on), inset 0 0 0 1rpx var(--line-strong);
}

.swatch-tick {
  font-size: var(--fs-hint);
  font-weight: 700;
  color: var(--sw-on);
  line-height: 1;
}

.swatch-name {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.swatch.on .swatch-name {
  color: var(--ink);
  font-weight: 600;
}

.demo-row {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  margin: var(--sp-2) 0;
}

.demo-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: var(--h-btn);
  border-radius: var(--radius-ctl);
  background: var(--strong);
  color: var(--on-ink);
  font-size: var(--fs-title);
  font-weight: 600;
  letter-spacing: var(--ls-title);
}

.demo-btn.ghost {
  background: var(--surface);
  color: var(--ink-2);
  border: 1rpx solid var(--line-strong);
  font-weight: 500;
}

.demo-pill {
  width: 96rpx;
  height: 56rpx;
  border-radius: var(--radius-pill);
  background: var(--sink);
}

.demo-pill.on {
  background: var(--strong);
}

.demo-note {
  font-size: var(--fs-hint);
  color: var(--ink-3);
}
