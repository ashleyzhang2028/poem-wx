.group-head {
  display: flex;
  align-items: baseline;
  min-width: 0;
}

.group-title {
  flex: 1;
  min-width: 0;
  margin-bottom: 0;
}

.swatch-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--sp-2) var(--sp-1);
  padding-top: var(--sp-2);
}

.swatch {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 6rpx 0;
  min-height: 108rpx;
}

.swatch-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--sw-soft);
  box-shadow: inset 0 0 0 1rpx var(--sw);
  transition: background-color var(--t-press), transform var(--t-press);
}

.swatch-hover .swatch-dot,
.swatch-dot:focus,
.swatch.on .swatch-dot {
  background: var(--sw);
}

.swatch-hover .swatch-dot {
  transform: scale(.92);
}

.swatch.on .swatch-dot {
  box-shadow: inset 0 0 0 1rpx var(--sw), 0 0 0 4rpx var(--sw-soft);
}

.swatch-name {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.swatch.on .swatch-name {
  color: var(--ink-2);
}

.swatch.locked .swatch-dot {
  background: transparent;
  box-shadow: inset 0 0 0 1rpx var(--line-strong);
}

.swatch.locked .swatch-name {
  color: var(--ink-4);
}

.font-preview {
  display: block;
  font-size: var(--fs-title);
  line-height: var(--lh-tight);
  color: var(--ink);
  letter-spacing: var(--ls-title);
  text-align: center;
  margin: var(--sp-3) 0 var(--sp-4);
}

.font-list {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--sp-2) var(--sp-1);
}

.font-row {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx 0;
  min-height: 108rpx;
  border-radius: var(--radius);
  transition: background-color var(--t-press), color var(--t-press);
}

.font-row.on {
  background: var(--strong-soft);
}

.font-hover {
  background: var(--sink);
}

.font-name {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  letter-spacing: 1rpx;
  line-height: 1.2;
  text-align: center;
}

.font-row.on .font-name {
  color: var(--ink-2);
}

.font-row.locked {
  opacity: .45;
}

.group-card:first-of-type {
  margin-top: calc(-5 * var(--sp-5));
}
