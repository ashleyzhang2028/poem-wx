<view class="page {{barBelow ? 'has-tabbar' : 'tall'}}" style="{{themeStyle}}">

  <lock-card wx:if="{{locked}}" title="自选背诵" note="登录后才能建集合" mark="选" bind:login="onLogin" />

  <block wx:else>

  <view class="card">
    <view class="card-head">
      <text class="card-title">自选背诵</text>
      <tier-tag wx:if="{{!on}}" tier="{{tier}}" />
    </view>
    <text class="hint coll-lead">把课外阅读或搜索里看到的篇目加入自己的集合，按选定算法跟着背。</text>

    <view class="coll-quota" wx:if="{{on}}">
      <text class="hint">已建 {{count}} / {{cap}} 个 · 每个最多 {{itemsMax}} 首</text>
    </view>

    <button class="btn primary block coll-new" wx:if="{{on}}" bindtap="onCreate">新建集合</button>
  </view>

  <view class="card" wx:if="{{count}}">
    <view class="card-title">我的集合</view>

    <block wx:for="{{collections}}" wx:key="id" wx:for-item="c">
      <view class="coll-head" hover-class="row-hover" hover-stay-time="60"
            data-id="{{c.id}}" bindtap="onToggleList">
        <view class="row-main">
          <text class="row-title poem">{{c.name}}</text>
          <text class="row-sub">{{c.count}} 首 · 已背 {{c.learned}} · 已掌握 {{c.mastered}} · 平均 {{c.avgMastery}}%</text>
          <view class="coll-meter">
            <view class="meter"><view class="meter-fill" style="width:{{c.masteredPercent}}%"></view></view>
            <text class="coll-meter-t">今日 {{c.planned}} 首</text>
          </view>
        </view>
        <text class="all-toggle {{c.open ? 'open' : ''}}"></text>
      </view>

      <view class="inline-btns coll-tools" wx:if="{{c.open}}">
        <button class="btn mini" data-id="{{c.id}}" bindtap="onRename">改名</button>
        <button class="btn mini" data-id="{{c.id}}" bindtap="onAdd">{{searchId === c.id ? '收起搜索' : '加篇目'}}</button>
        <button class="btn mini danger" data-id="{{c.id}}" bindtap="onClear">清空</button>
        <button class="btn mini danger" data-id="{{c.id}}" bindtap="onRemove">删除集合</button>
      </view>

      <view class="coll-count" wx:if="{{c.open}}">
        <text class="hint coll-count-lead">每日计划</text>
        <radio-group class="chip-group compact cols-4" data-id="{{c.id}}" bindchange="onCount">
          <label class="chip compact {{c.dailyCount === item ? 'on' : ''}}" wx:for="{{counts}}" wx:key="*this" wx:for-item="item">
            <radio class="seg-radio" value="{{item}}" checked="{{c.dailyCount === item}}" />
            <text class="chip-t">{{item}} 首</text>
          </label>
        </radio-group>
      </view>

      <view class="coll-search" wx:if="{{c.open && searchId === c.id}}">
        <view class="search">
          <view class="search-icon" style="mask-image:url('{{icons.search}}');-webkit-mask-image:url('{{icons.search}}');"></view>
          <input placeholder="搜篇名 / 作者 / 朝代" value="{{keyword}}" bindinput="onKeyword" confirm-type="search" />
          <view class="clear" hover-class="clear-hover" hover-stay-time="60" wx:if="{{keyword}}" bindtap="onSuggestClear">
            <view class="clear-ico" style="mask-image:url('{{icons.clear}}');-webkit-mask-image:url('{{icons.clear}}');"></view>
          </view>
        </view>

        <view class="coll-found" wx:if="{{found.length}}">
          <view class="coll-found-row" hover-class="row-hover" hover-stay-time="60"
                wx:for="{{found}}" wx:key="id" data-id="{{item.id}}" bindtap="onAddOne">
            <view class="coll-found-btn {{item.on ? 'on' : ''}}">
              <view class="coll-found-ico" style="mask-image:url('{{icons[item.on ? 'added' : 'add']}}');-webkit-mask-image:url('{{icons[item.on ? 'added' : 'add']}}');"></view>
            </view>
            <view class="row-main">
              <text class="row-title row-poem">{{item.title}}</text>
              <text class="row-sub">{{item.meta}}</text>
            </view>
          </view>
        </view>

        <view class="empty coll-empty" wx:if="{{searched && !found.length}}">
          <text class="empty-text">没找到「{{keyword}}」</text>
          <text class="hint empty-tip">换个篇名、作者或朝代试试</text>
        </view>
      </view>

      <block wx:if="{{c.open}}">
        <view class="inline-btns coll-tools" wx:if="{{c.count}}">
          <button class="btn mini" data-id="{{c.id}}" bindtap="onPickAll">全选</button>
          <button class="btn mini" data-id="{{c.id}}" bindtap="onPickNone">取消全选</button>
          <button class="btn mini danger" data-id="{{c.id}}" bindtap="onRemovePicked">移出选中</button>
        </view>

        <view wx:if="{{c.count}}">
          <view class="daily-row" hover-class="row-hover" hover-stay-time="60"
                wx:for="{{c.items}}" wx:key="id" data-id="{{c.id}}" data-pid="{{item.id}}" bindtap="onPick">
            <view class="daily-box {{item.picked ? 'on' : ''}}"><text class="daily-tick">{{item.picked ? '✓' : ''}}</text></view>
            <view class="row-main">
              <text class="row-title row-poem">{{item.title}}</text>
              <text class="row-sub">{{item.meta}}</text>
            </view>
          </view>
        </view>

        <view class="empty coll-empty" wx:else>
          <text class="empty-text">这个集合还是空的</text>
          <text class="hint empty-tip">点「加篇目」去搜索里找</text>
        </view>
      </block>
    </block>
  </view>

  <view class="card" wx:elif="{{on}}">
    <view class="empty">
      <text class="empty-mark">选</text>
      <text class="empty-text say">还没有自选集合</text>
      <text class="hint empty-tip">在上面点「新建集合」开一个</text>
    </view>
  </view>

  <view class="safe-bottom"></view>
  </block>
  <tab-bar id="tabbar" current="4" />
</view>
