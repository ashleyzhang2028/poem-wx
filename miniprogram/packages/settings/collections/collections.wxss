.coll-lead {
  display: block;
}

.coll-quota {
  margin-top: var(--sp-2);
}

.coll-new {
  margin-top: var(--sp-3);
}

.coll-count {
  padding: var(--sp-2) 0 var(--sp-3);
  border-bottom: 1rpx solid var(--line-2);
}

.coll-count-lead {
  display: block;
  margin-bottom: var(--sp-2);
}

.coll-head {
  display: flex;
  align-items: center;
  min-height: var(--h-row);
  padding: var(--sp-2) 0;
  border-bottom: 1rpx solid var(--line-2);
  transition: background-color var(--t-press);
}

.coll-tools {
  flex-wrap: nowrap;
  padding: var(--sp-2) 0;
}

.coll-tools .btn.mini,
.coll-head .row-title,
.coll-head .row-sub {
  font-weight: 400;
}

.coll-empty {
  padding: var(--sp-4) var(--sp-2);
}

.all-toggle {
  flex: none;
  box-sizing: border-box;
  width: 14rpx;
  height: 14rpx;
  margin: 0 var(--sp-1) 6rpx var(--sp-3);
  border-right: 3rpx solid var(--ink-3);
  border-bottom: 3rpx solid var(--ink-3);
  transform: rotate(45deg);
  transition: transform var(--t-move) var(--ease);
}

.all-toggle.open {
  margin-bottom: 0;
  margin-top: 6rpx;
  transform: rotate(-135deg);
}

.daily-row {
  display: flex;
  align-items: center;
  min-height: var(--h-row);
  padding: var(--sp-2) var(--sp-1);
  border-bottom: 1rpx solid var(--line-2);
}

.daily-row:last-child {
  border-bottom: none;
}

.daily-box {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  margin-right: var(--sp-3);
  border: 1rpx solid var(--line-strong);
  border-radius: var(--radius-sm);
  background: var(--surface);
  color: var(--on-ink);
  display: flex;
  align-items: center;
  justify-content: center;
}

.daily-box.on {
  background: var(--strong);
  border-color: var(--strong);
}

.daily-tick {
  font-size: var(--fs-caption);
  line-height: 1;
}

.coll-search {
  padding: var(--sp-2) 0 var(--sp-3);
}

.coll-found {
  margin-top: var(--sp-2);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  overflow: hidden;
}

.coll-found-row {
  display: flex;
  align-items: center;
  min-height: var(--h-row);
  padding: var(--sp-2) var(--sp-3);
  border-bottom: 1rpx solid var(--line-2);
  transition: background-color var(--t-press);
}

.coll-found-row:last-child {
  border-bottom: none;
}

.coll-found-btn {
  flex: none;
  width: 60rpx;
  height: 60rpx;
  margin-right: var(--sp-3);
  border-radius: 50%;
  background: var(--sink);
  color: var(--ink-3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.coll-found-btn.on {
  background: var(--strong);
  color: var(--on-ink);
}

.coll-found-ico {
  width: 32rpx;
  height: 32rpx;
  background-color: currentColor;
  mask-repeat: no-repeat;
  mask-position: center;
  mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-position: center;
  -webkit-mask-size: contain;
}

.coll-meter {
  display: flex;
  align-items: center;
  margin-top: var(--sp-2);
}

.coll-meter .meter {
  flex: 1;
  min-width: 0;
}

.coll-meter-t {
  flex: none;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  padding-left: var(--sp-2);
  font-variant-numeric: tabular-nums;
}
