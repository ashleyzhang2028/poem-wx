<view class="page">
  <view class="page-head">
    <text class="head-title">怎么读</text>
  </view>

  <lock-card wx:if="{{locked}}" title="阅读设置要登录" note="登录后才能改" mark="读" />

  <block wx:else>
  <view class="card" wx:if="{{pinyinOn}}">
    <view class="card-title bar">注音方式</view>
    <!-- 三选一：图标分段。图标说「是哪一档」，选中的那段填墨黑。 -->
    <view class="seg">
      <radio-group class="seg-group" bindchange="onMode">
        <label class="seg-item {{pinyin === item.key ? 'on' : ''}}" wx:for="{{modes}}" wx:key="key">
          <radio class="seg-radio" value="{{item.key}}" checked="{{pinyin === item.key}}"
                 color="#1c1c1e" />
          <view class="seg-icon ic-{{item.icon}}"></view>
          <text class="seg-text">{{item.label}}</text>
        </label>
      </radio-group>
    </view>
    <!-- 试样：改完就看得见效果，不用退回阅读页才知道 -->
    <view class="sample" wx:if="{{pinyin !== 'off'}}">
      <view class="sample-u" wx:for="{{sample}}" wx:key="ch">
        <text class="sample-py">{{item.py}}</text>
        <text class="sample-ch">{{item.ch}}</text>
      </view>
    </view>
  </view>

  <view class="card" wx:else>
    <view class="card-title bar">注音</view>
    <text class="hint note">读音表未就绪</text>
  </view>

  <!-- 答题音效：环境出不了声，这一整块不渲染 -->
  <view class="card" wx:if="{{sfxVisible}}">
    <view class="card-title bar">答题音效</view>
    <view class="row">
      <view class="row-main">
        <text class="row-title">答对答错出声</text>
        <text class="row-sub">题库 · 考试 · 飞花令共用</text>
      </view>
      <switch checked="{{sfxOn}}" bindchange="onSfx" color="#1c1c1e" />
    </view>
    <button class="btn ghost block test-btn" bindtap="onSfxTest">试听一声</button>
  </view>

  <view class="safe-bottom"></view>
  </block>
</view>
