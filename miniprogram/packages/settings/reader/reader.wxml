<view class="page" style="{{themeStyle}}">
  <view class="page-head">
    <text class="head-title">声音</text>
  </view>

  <lock-card wx:if="{{locked}}" title="声音设置要登录" note="登录后才能改" mark="声" />

  <block wx:else>
  <!-- 注音那一栏 2026-10-04 搬到了通用设置的「版式」页。
       对齐 / 注音 / 字号是同一组版式偏好（正文里它们本来就共用一行），
       分在两页改一处要跑两趟 —— 用户那天问：「通用设置版式里有对齐和字号，
       怎么没有注音的设置？」。

       这一页只留**答题音效**：它不是版式，是「答对答错出不出现那一声」，
       题库 / 考试 / 飞花令三处共用。所以这一页的页头也从「阅读」改成
       「声音」——页头说的是这一页装什么，不是它原来装过什么。 -->
  <!-- 答题音效：环境出不了声，这一整块不渲染 -->
  <view class="card" wx:if="{{sfxVisible}}">
    <view class="card-title bar">答题音效</view>
    <view class="row">
      <view class="row-main">
        <text class="row-title">答对答错出声</text>
        <text class="row-sub">题库 · 考试 · 飞花令共用</text>
      </view>
      <switch checked="{{sfxOn}}" bindchange="onSfx" color="{{themeHex}}" />
    </view>
    <button class="btn ghost block test-btn" bindtap="onSfxTest">试听一声</button>
  </view>

  <view class="safe-bottom"></view>
  </block>
</view>
