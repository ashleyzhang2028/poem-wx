<view class="page">
  <view class="card locked-card" wx:if="{{locked}}">
    <view class="card-title">登录后可用</view>
    <text class="hint note">设置项要登录之后才生效 —— 未登录时只有首页目录可看。</text>
    <button class="btn primary block locked-btn" bindtap="onLogin">微信登录</button>
  </view>

  <block wx:else>
  <view class="card" wx:if="{{pinyinOn}}">
    <view class="card-title">注音方式</view>
    <radio-group class="native-group column" bindchange="onMode">
      <label class="opt-row {{pinyin === item.key ? 'active' : ''}}" wx:for="{{modes}}" wx:key="key">
        <radio value="{{item.key}}" checked="{{pinyin === item.key}}" color="#2f6055" />
        <view class="opt-main">
          <text class="opt-name">{{item.label}}</text>
          <text class="opt-desc">{{item.desc}}</text>
        </view>
      </label>
    </radio-group>
    <text class="hint note">多音字按词组取值，词组表里没有才回退单字。</text>
  </view>

  <view class="card" wx:else>
    <view class="card-title">注音</view>
    <text class="hint note">读音表未就绪，注音能力整体关闭，阅读页不会出现注音开关。</text>
  </view>

  <!-- 朗读：不可用整块不渲染（可见但未就绪时显示成待开通，给一句人话） -->
  <view class="card" wx:if="{{speakVisible}}">
    <view class="card-title">朗读</view>

    <block wx:if="{{speakReady}}">
      <view class="sub-title">朗读语速</view>
      <radio-group class="native-group" bindchange="onRate">
        <label class="native-label" wx:for="{{rates}}" wx:key="key">
          <radio value="{{item.key}}" checked="{{speechRate === item.key}}" color="#2f6055" />
          <text>{{item.label}}</text>
        </label>
      </radio-group>

      <view class="row">
        <view class="row-main">
          <text class="row-title">整篇读完停一下</text>
          <text class="row-sub">读完不自作主张跳页，背完自己点下一首</text>
        </view>
        <switch checked="{{speechAutoNext}}" bindchange="onAutoNext" color="#2f6055" />
      </view>

      <!-- 试听：原生 button，只是借边距与 :active 上色，不做自绘按钮 -->
      <button class="btn ghost block test-btn" bindtap="onSpeakTest">试听一声</button>
    </block>

    <text class="hint note" wx:else>{{speakReason}}</text>
  </view>

  <view class="card" wx:else>
    <view class="card-title">朗读</view>
    <text class="hint note">当前没有朗读能力，阅读页不会出现朗读按钮与播放工具栏。这通常是因为：档位不含朗读，或运行环境没有音频接口。</text>
  </view>

  <view class="safe-bottom"></view>
  </block>
</view>
