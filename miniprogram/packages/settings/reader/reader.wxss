.note {
  display: block;
  margin-top: var(--sp-2);
  line-height: var(--lh-body);
}

.note.warn,
.step.warn {
  color: var(--amber);
}

.url-row {
  margin-top: var(--sp-3);
}

.url-label {
  font-size: var(--fs-hint);
  color: var(--ink-2);
}

.url-input {
  height: 84rpx;
  margin-top: 12rpx;
  padding: 0 var(--sp-3);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--bg-soft);
  font-size: var(--fs-body);
  color: var(--ink);
}

.sub-title {
  font-size: var(--fs-hint);
  color: var(--ink-2);
  margin-top: var(--sp-3);
}

.step {
  display: block;
  margin-top: 12rpx;
}

.test-btn {
  margin-top: var(--sp-3);
}

.mode-desc {
  display: block;
  padding: 0 var(--sp-1) var(--sp-1);
}
