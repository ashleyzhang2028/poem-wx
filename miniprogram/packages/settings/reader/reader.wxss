.note {
  display: block;
  margin-top: 16rpx;
  line-height: 1.7;
}

.note.warn,
.step.warn {
  color: var(--amber);
}

.sample {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 6rpx;
  margin-top: 28rpx;
  padding: 24rpx 12rpx;
  border-radius: var(--radius-sm);
  background: var(--bg-soft);
}

.sample-u {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.sample-py {
  font-size: 20rpx;
  color: var(--ink-3);
  line-height: 1.3;
}

.sample-ch {
  font-family: var(--font-poem);
  font-size: 34rpx;
  color: var(--ink);
  line-height: 1.4;
}

.url-row {
  margin-top: 24rpx;
}

.url-label {
  font-size: 25rpx;
  color: var(--ink-2);
}

.url-input {
  height: 80rpx;
  margin-top: 12rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--bg-soft);
  font-size: 26rpx;
  color: var(--ink);
}

.sub-title {
  font-size: 25rpx;
  color: var(--ink-2);
  margin-top: 24rpx;
}

.tts-state {
  margin-top: 20rpx;
  padding: 18rpx 22rpx;
  border-radius: var(--radius-sm);
  font-size: 25rpx;
}

.tts-state.ok {
  color: var(--green);
  background: var(--green-light);
}

.tts-state.no {
  color: var(--amber);
  background: var(--amber-light);
}

.actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.actions .btn {
  flex: 1;
}

.step {
  display: block;
  margin-top: 12rpx;
}

/* 未登录时的那张卡 */
.locked-card .note {
  display: block;
  margin-top: 16rpx;
}

.locked-btn {
  margin-top: 32rpx;
}
