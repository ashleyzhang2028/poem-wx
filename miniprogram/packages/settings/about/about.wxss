.brand {
  text-align: center;
  padding: 56rpx 32rpx;
}

.brand-name {
  display: block;
  font-family: var(--font-poem);
  font-size: 64rpx;
  font-weight: 600;
  color: var(--green);
  letter-spacing: 8rpx;
}

.brand-sub {
  display: block;
  font-size: 25rpx;
  color: var(--ink-3);
  margin-top: 16rpx;
}

.brand-ver {
  display: block;
  font-size: 22rpx;
  color: var(--line);
  margin-top: 24rpx;
}

.stat {
  font-size: 30rpx;
  color: var(--green);
}

.foot {
  display: block;
  text-align: center;
  padding: 24rpx 32rpx 40rpx;
  line-height: 1.8;
}
