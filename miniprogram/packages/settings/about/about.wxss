/* 品牌卡：名字放大、字距放开，下面坠一句出处。
   一屏只有这一处能这么「空」—— 它是这页的脸 */
.brand {
  text-align: center;
  padding: var(--sp-5) var(--sp-4);
  background: linear-gradient(168deg, #fffefb 0%, var(--bg-soft) 62%, #f4ecd8 100%);
}

.brand-name {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-brand);
  font-weight: 600;
  color: var(--green);
  letter-spacing: 10rpx;
}

.brand-sub {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-hint);
  color: var(--ink-3);
  margin-top: var(--sp-2);
  letter-spacing: var(--ls-caption);
}

.brand-ver {
  display: block;
  font-size: var(--fs-caption);
  color: var(--line);
  margin-top: var(--sp-3);
}

/* 数字用宋体、主色 —— 与页面里其它「计数」同一口径 */
.kv-v {
  font-family: var(--font-poem);
  color: var(--green);
}

.foot {
  display: block;
  text-align: center;
  padding: var(--sp-3) var(--sp-4) var(--sp-5);
  line-height: var(--lh-loose);
}
