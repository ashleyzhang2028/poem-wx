<view class="page {{barBelow ? 'has-tabbar' : 'tall'}} {{name}}" style="{{themeStyle}}">
  <view class="card brand">
    <text class="brand-name">跬步</text>
    <text class="brand-sub">积跬步，至千里</text>
    <view class="brand-ver">
      <text>v{{version}}</text>
      <text class="brand-commit" wx:if="{{commit}}">{{commit}}</text>
    </view>
  </view>

  <view class="card">
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onTerms">
      <view class="row-main"><text class="row-title">用户协议</text></view>
      <text class="row-go">›</text>
    </view>
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onPrivacy">
      <view class="row-main"><text class="row-title">隐私政策</text></view>
      <text class="row-go">›</text>
    </view>
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onFeedback">
      <view class="row-main"><text class="row-title">意见建议</text></view>
      <view class="row-dot" wx:if="{{replyDot}}"></view>
      <text class="row-go">›</text>
    </view>
    <view class="row" wx:if="{{faults}}" hover-class="row-hover" hover-stay-time="60" bindtap="onFaults">
      <view class="row-main"><text class="row-title">本机故障记录</text></view>
      <text class="row-go">{{faults}} 条 · 复制</text>
    </view>
    <view class="row" wx:if="{{faults}}" hover-class="row-hover" hover-stay-time="60" bindtap="onFaultsClear">
      <view class="row-main"><text class="row-title">清空故障记录</text></view>
      <text class="row-go">›</text>
    </view>
    <view class="row" wx:if="{{logged}}" hover-class="row-hover" hover-stay-time="60" bindtap="onLogout">
      <view class="row-main"><text class="row-title">退出登录</text></view>
      <text class="row-go">›</text>
    </view>
  </view>

  <view class="safe-bottom"></view>
  <tab-bar id="tabbar" current="4" />
</view>
