<view class="page" style="{{themeStyle}}">
  <view class="card brand">
    <text class="brand-name">跬步</text>
    <text class="brand-sub">不积跬步，无以至千里</text>
    <text class="brand-ver">v{{version}}</text>
  </view>

  <view class="card">
    <view class="card-title bar">本机记录</view>
    <view class="kv">
      <text class="kv-k">已学篇目</text>
      <text class="kv-v">{{stats.learned}}</text>
    </view>
    <view class="kv">
      <text class="kv-k">已掌握</text>
      <text class="kv-v">{{stats.mastered}}</text>
    </view>
    <view class="kv">
      <text class="kv-k">已读篇目</text>
      <text class="kv-v">{{stats.readCount}}</text>
    </view>
  </view>

  <view class="card">
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onTerms">
      <view class="row-main"><text class="row-title">用户协议</text></view>
      <text class="row-go">›</text>
    </view>
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onPrivacy">
      <view class="row-main"><text class="row-title">隐私说明</text></view>
      <text class="row-go">›</text>
    </view>
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onCopyFeedback">
      <view class="row-main"><text class="row-title">意见反馈</text><text class="row-sub">复制联系邮箱</text></view>
      <text class="row-go">›</text>
    </view>
  </view>

  <view class="safe-bottom"></view>
</view>
