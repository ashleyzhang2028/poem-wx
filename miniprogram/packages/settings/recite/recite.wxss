.pool-hint {
  display: block;
  margin-top: var(--sp-3);
  padding-top: var(--sp-2);
  border-top: 1rpx solid var(--line-2);
}

.daily-count {
  display: block;
  margin-bottom: var(--sp-2);
}

.daily-tools {
  margin-bottom: var(--sp-2);
}

.daily-row {
  display: flex;
  align-items: center;
  min-height: var(--h-row);
  padding: var(--sp-2) var(--sp-1);
  border-bottom: 1rpx solid var(--line-2);
}

.daily-row:last-child {
  border-bottom: none;
}

.daily-box {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  margin-right: var(--sp-3);
  border: 1rpx solid var(--line-strong);
  border-radius: var(--radius-sm);
  background: var(--surface);
  color: var(--on-ink);
  display: flex;
  align-items: center;
  justify-content: center;
}

.daily-box.on {
  color: var(--on-ink);
  background: var(--strong);
  border-color: var(--strong);
}

.daily-tick {
  font-size: var(--fs-caption);
  line-height: 1;
}

.algo-group {
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
}

.algo-row {
  position: relative;
  display: block;
  padding: var(--sp-3) var(--pad-opt-x);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  background: var(--surface);
  transition: background-color var(--t-press), border-color var(--t-press);
}

.algo-row.active {
  background: var(--strong-soft);
  border-color: var(--strong);
}

.algo-head {
  display: flex;
  align-items: baseline;
  min-width: 0;
}

.algo-name {
  flex: 0 1 auto;
  min-width: 0;
  font-family: var(--font-poem);
  font-size: var(--fs-body);
  color: var(--ink);
  line-height: var(--lh-tight);
}

.algo-row.active .algo-name {
  color: var(--strong-text);
}

.algo-years {
  flex: 1;
  min-width: 0;
  margin-left: var(--sp-2);
  font-size: var(--fs-caption);
  color: var(--ink-3);
  line-height: var(--lh-tight);
}

.algo-lines {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-top: var(--sp-2);
}

.algo-line {
  font-size: var(--fs-hint);
  color: var(--ink-2);
  line-height: var(--lh-body);
}

.algo-row.active .algo-line {
  color: var(--ink);
}

.algo-row.locked {
  opacity: .45;
}

.self-only-row {
  padding-bottom: 0;
  border-bottom: none;
}

.self-only-row .self-only-note {
  display: block;
}
