.stage-note {
  display: block;
  margin-top: var(--sp-2);
}

.pool-hint {
  display: block;
  margin-top: var(--sp-3);
  padding-top: var(--sp-2);
  border-top: 1rpx dashed var(--line-2);
}

.daily-count {
  display: block;
  margin-bottom: var(--sp-2);
}

.daily-tools {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-2);
  margin-bottom: var(--sp-3);
}

.daily-row {
  display: flex;
  align-items: center;
  min-height: var(--h-row);
  padding: var(--sp-2) var(--sp-1);
  border-bottom: 1rpx solid var(--line-2);
}

.daily-row:last-child {
  border-bottom: none;
}

.daily-box {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  margin-right: var(--sp-3);
  border: 1rpx solid var(--line-strong);
  border-radius: var(--radius-sm);
  background: var(--surface);
  color: var(--on-ink);
  display: flex;
  align-items: center;
  justify-content: center;
}

.daily-box.on {
  background: var(--strong);
  border-color: var(--strong);
}

.daily-tick {
  font-size: var(--fs-caption);
  line-height: 1;
}

.algo.locked {
  opacity: .55;
}

.algo.locked .algo-years {
  color: var(--amber);
}
