.chips {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.chip {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: var(--bg-soft);
  border: 1rpx solid var(--line);
  font-size: 26rpx;
  color: var(--ink-2);
  margin: 0 16rpx 16rpx 0;
}

.chip.active {
  background: var(--green);
  border-color: var(--green);
  color: #fff;
}

.opt {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line-2);
}

.opt:last-of-type {
  border-bottom: none;
}

.opt-label {
  font-size: 29rpx;
  color: var(--ink);
}

.opt-check {
  color: var(--green);
  font-size: 32rpx;
}

.pool-hint {
  display: block;
  padding-top: 12rpx;
}

.algo {
  border: 1rpx solid var(--line-2);
  border-radius: var(--radius-sm);
  padding: 22rpx;
  margin-bottom: 16rpx;
  background: var(--bg-soft);
}

.algo.active {
  border-color: var(--green);
  background: var(--green-light);
}

.algo-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.algo-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.algo-years {
  font-size: 22rpx;
  color: var(--ink-3);
}

.algo-blurb {
  display: block;
  font-size: 25rpx;
  color: var(--ink-2);
  margin-top: 8rpx;
  line-height: 1.7;
}
