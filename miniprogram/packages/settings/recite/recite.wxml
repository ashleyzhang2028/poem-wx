<view class="page">
  <view class="page-head">
    <text class="head-title">今天背什么</text>
    <text class="head-sub">背哪一册 · 每天几首 · 按哪套算法排期</text>
  </view>

  <lock-card wx:if="{{locked}}" title="背诵范围要登录" note="背诵范围要登录之后才生效 —— 未登录时只有首页目录可看。" mark="范" />

  <block wx:else>
  <view class="card">
    <view class="card-title bar">背诵范围</view>

    <!-- 学期与年级都是**等长的一格一个选项**，格子本身已经把「这是一组、
         只能选一个」说清楚了。再给每格塞一个圆点，就出现两个毛病：
         圆点吃掉了横向空间（12 个年级从 3 列涨到 4 列才放得下），
         而且它跟第一行文字对齐、第二行文字缩进 —— 看着像圆点管着半格。
         这里改成「格子 = 一个胶囊」：形状说是控件，填色说选中，
         圆点不再重复这件事。radio 仍在 label 里，点格子就选中。 -->
    <radio-group class="chip-group cols-2" data-k="term" bindchange="onTerm">
      <label class="chip {{term === item.value ? 'on' : ''}}" wx:for="{{terms}}" wx:key="value">
        <radio class="seg-radio" value="{{item.value}}" checked="{{term === item.value}}"
               color="#1c1c1e" />
        <text class="chip-t">{{item.label}}</text>
      </label>
    </radio-group>

    <radio-group class="chip-group cols-4" data-k="grade" bindchange="onGrade">
      <label class="chip {{grade === item.value ? 'on' : ''}}" wx:for="{{grades}}" wx:key="value">
        <radio class="seg-radio" value="{{item.value}}" checked="{{grade === item.value}}"
               color="#1c1c1e" />
        <text class="chip-t">{{item.label}}</text>
      </label>
    </radio-group>
  </view>

  <view class="card">
    <view class="card-title bar">取诗范围</view>
    <radio-group class="native-group column" bindchange="onScope">
      <label class="opt-row {{scope === item.key ? 'active' : ''}}" wx:for="{{scopes}}" wx:key="key">
        <radio value="{{item.key}}" checked="{{scope === item.key}}" color="#1c1c1e" />
        <view class="opt-main">
          <text class="opt-name">{{item.label}}</text>
          <text class="opt-desc" wx:if="{{item.desc}}">{{item.desc}}</text>
        </view>
      </label>
    </radio-group>
    <text class="hint pool-hint">这个范围里有 {{poolSize}} 首</text>
  </view>

  <view class="card">
    <view class="card-title bar">每日首数</view>
    <radio-group class="chip-group cols-4" bindchange="onCount">
      <label class="chip {{dailyCount === item ? 'on' : ''}}" wx:for="{{counts}}" wx:key="*this">
        <radio class="seg-radio" value="{{item}}" checked="{{dailyCount === item}}" color="#1c1c1e" />
        <text class="chip-t">{{item}} 首</text>
      </label>
    </radio-group>
  </view>

  <view class="card">
    <view class="card-title bar">复习算法</view>
    <!-- 换算法不清进度：四套算法的差异只在排期，进度按新算法折算 -->
    <radio-group class="native-group column" bindchange="onAlgo">
      <label class="opt-row {{item.active ? 'active' : ''}} {{item.allowed ? '' : 'locked'}}"
             wx:for="{{algos}}" wx:key="key">
        <radio value="{{item.key}}" checked="{{item.active}}" disabled="{{!item.allowed}}" color="#1c1c1e" />
        <view class="opt-main">
          <text class="opt-name">{{item.name}} · {{item.years}}</text>
          <text class="opt-desc">{{item.allowed ? item.blurb : item.lockHint}}</text>
        </view>
      </label>
    </radio-group>
    <text class="hint pool-hint">换算法不清进度，已有记录会按新算法折算。</text>
  </view>

  <view class="safe-bottom"></view>
  </block>
</view>
