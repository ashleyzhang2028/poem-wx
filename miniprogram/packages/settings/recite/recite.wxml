<view class="page {{barBelow ? 'has-tabbar' : 'tall'}} {{name}}" style="{{themeStyle}}">

  <view class="card">
    <view class="card-title">今日加背</view>

    <view wx:if="{{!daily.length}}" class="hint">暂无加背</view>

    <block wx:else>

      <text class="hint daily-count">今天加了 {{daily.length}} / {{dailyMax}} 首</text>

      <view class="inline-btns daily-tools">
        <button class="btn mini" bindtap="onDailyAll">全选</button>
        <button class="btn mini" bindtap="onDailyNone">取消全选</button>
        <button class="btn mini danger" bindtap="onDailyRemove">移出选中</button>
        <button class="btn mini danger" bindtap="onDailyClear">清空</button>
      </view>

      <checkbox-group bindchange="onDailyPick">
        <label class="daily-row" wx:for="{{daily}}" wx:key="id">
          <checkbox class="opt-radio" value="{{item.id}}" checked="{{item.picked}}" />
          <view class="daily-box {{item.picked ? 'on' : ''}}"><text class="daily-tick">{{item.picked ? '✓' : ''}}</text></view>
          <view class="row-main">
            <text class="row-title row-poem">{{item.title}}</text>
            <text class="row-sub">{{item.meta}}</text>
          </view>
        </label>
      </checkbox-group>
    </block>
  </view>

  <view class="card">
    <view class="card-head">
      <text class="card-title">自选背诵</text>
      <tier-tag wx:if="{{selfOnlyLocked}}" tier="{{selfOnlyTier}}" />
    </view>

    <view class="row">
      <view class="row-main">
        <text class="row-title">只背自选</text>
        <text class="row-sub">今日只排自选集合，课内暂不排</text>
      </view>
      <view class="sw">
        <switch checked="{{selfOnly}}" bindchange="onSelfOnly"
                disabled="{{!selfOnlyOn}}" />
      </view>
    </view>

    <view class="row self-only-row" hover-class="row-hover" hover-stay-time="60" wx:if="{{selfOnlyOn}}" bindtap="onCollections">
      <view class="row-main">
        <text class="hint self-only-note">已建 {{selfOnlyRows}} 个集合 · 共 {{selfOnlyPoems}} 首</text>
      </view>
      <text class="row-go">›</text>
    </view>
  </view>

  <view class="card">
    <view class="card-title">当前学段</view>

    <radio-group class="chip-group cols-3" data-k="stage" bindchange="onStage">
      <label class="chip {{stage === item.key ? 'on' : ''}}" wx:for="{{stages}}" wx:key="key">
        <radio class="seg-radio" value="{{item.key}}" checked="{{stage === item.key}}" />
        <text class="chip-t">{{item.name}}</text>
      </label>
    </radio-group>

    <radio-group class="chip-group cols-3" data-k="grade" bindchange="onGrade">
      <label class="chip {{grade === item.value ? 'on' : ''}}" wx:for="{{grades}}" wx:key="value">
        <radio class="seg-radio" value="{{item.value}}" checked="{{grade === item.value}}" />
        <text class="chip-t">{{item.label}}</text>
      </label>
    </radio-group>

    <radio-group class="chip-group cols-2" data-k="term" bindchange="onTerm">
      <label class="chip {{term === item.value ? 'on' : ''}}" wx:for="{{terms}}" wx:key="value">
        <radio class="seg-radio" value="{{item.value}}" checked="{{term === item.value}}" />
        <text class="chip-t">{{item.label}}</text>
      </label>
    </radio-group>
  </view>

  <view class="card">

    <view class="card-title">背诵范围</view>

    <radio-group class="opt-group inline cols-2" bindchange="onScope">
      <label class="opt-row {{scope === item.key ? 'active' : ''}}" wx:for="{{scopes}}" wx:key="key">
        <radio class="opt-radio" value="{{item.key}}" checked="{{scope === item.key}}" />
        <view class="opt-main">
          <text class="opt-name">{{item.label}}</text>
        </view>
      </label>
    </radio-group>
    <text class="hint pool-hint">{{poolSize}} 首</text>
  </view>

  <view class="card">
    <view class="card-title">每日首数</view>

    <radio-group class="chip-group compact cols-4" bindchange="onCount">
      <label class="chip compact {{dailyCount === item ? 'on' : ''}}" wx:for="{{counts}}" wx:key="*this">
        <radio class="seg-radio" value="{{item}}" checked="{{dailyCount === item}}" />
        <text class="chip-t">{{item}} 首</text>
      </label>
    </radio-group>
  </view>

  <view class="card">
    <view class="card-title">复习算法</view>

    <radio-group class="algo-group" bindchange="onAlgo">
      <label class="algo-row {{item.active ? 'active' : ''}} {{item.allowed ? '' : 'locked'}}"
             wx:for="{{algos}}" wx:key="key">
        <radio class="opt-radio" value="{{item.key}}" checked="{{item.active}}"
               disabled="{{!item.allowed}}" />
        <view class="algo-head">
          <text class="algo-name">{{item.name}}</text>
          <text class="algo-years">{{item.years}}</text>
        </view>
        <view class="algo-lines">
          <text class="algo-line" wx:for="{{item.describe}}" wx:for-item="line" wx:key="*this">{{line}}</text>
        </view>
      </label>
    </radio-group>

  </view>

  <view class="safe-bottom"></view>
  <tab-bar id="tabbar" current="4" />
</view>
