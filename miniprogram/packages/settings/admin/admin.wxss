.kv-v.small {
  font-size: 24rpx;
  max-width: 60%;
  text-align: right;
}

.note {
  display: block;
  margin-top: 16rpx;
  line-height: 1.7;
}

.tier {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line-2);
}

.tier:last-of-type {
  border-bottom: none;
}

.tier-main {
  flex: 1;
}

.tier-name {
  display: block;
  font-size: 32rpx;
  color: var(--ink);
}

.tier.active .tier-name {
  color: var(--green);
  font-weight: 600;
}

.tier-desc {
  display: block;
  font-size: 23rpx;
  color: var(--ink-3);
  margin-top: 6rpx;
}

.tier-check {
  color: var(--green);
  font-size: 32rpx;
}

.reset-btn {
  margin-top: 20rpx;
}

.cap-group {
  display: block;
  font-size: 24rpx;
  color: var(--ink-3);
  margin: 20rpx 0 10rpx;
}

.cap {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.cap-mark {
  width: 40rpx;
  font-size: 26rpx;
}

.cap-mark.on { color: var(--green); }
.cap-mark.off { color: var(--line); }

.cap-name {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
}

.cap-name.dim {
  color: var(--ink-3);
}

.cap-note {
  font-size: 22rpx;
  color: var(--ink-3);
}

.acct {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line-2);
}

.acct:last-child {
  border-bottom: none;
}

.acct-main {
  flex: 1;
  min-width: 0;
}

.acct-name {
  display: block;
  font-size: 29rpx;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.acct-sub {
  display: block;
  font-size: 23rpx;
  color: var(--ink-3);
  margin-top: 6rpx;
}

.acct-act {
  font-size: 25rpx;
  color: var(--green);
  padding-left: 20rpx;
}

.btn.block {
  margin-top: 16rpx;
}
