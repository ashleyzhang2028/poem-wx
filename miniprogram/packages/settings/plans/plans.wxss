.plans-head {
  margin-bottom: 20rpx;
}

.plans-title {
  display: block;
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--green);
}

.plans-sub {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 8rpx;
}

.plans-table {
  border-top: 1rpx solid var(--line-2);
}

.plans-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line-2);
}

.plans-th {
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

.plans-cap {
  flex: 1 1 auto;
  font-size: var(--fs-body);
}

.plans-need {
  flex: 0 0 180rpx;
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

.plans-state {
  flex: 0 0 140rpx;
  text-align: right;
  font-size: var(--fs-caption);
}

.plans-state.on {
  color: var(--green);
}

.plans-state.off {
  color: var(--amber);
}
