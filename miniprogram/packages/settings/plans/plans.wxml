<view class="page" style="{{themeStyle}}">
  <lock-card wx:if="{{!signedIn}}" title="权限说明" note="登录后能力全开" mark="权" />

  <block wx:else>

  <view class="card">
    <view class="card-title bar">能力的门槛</view>
    <view class="plans-table">
      <view class="plans-row plans-th">
        <text class="plans-cap">能力</text>
        <text class="plans-need">门槛</text>
        <text class="plans-state">当前</text>
      </view>
      <view class="plans-row" wx:for="{{rows}}" wx:key="cap">
        <text class="plans-cap">{{item.name}}</text>
        <text class="plans-need">{{item.need}}</text>
        <text class="plans-state {{item.state === '可用' ? 'on' : 'off'}}">{{item.state}}</text>
      </view>
    </view>
  </view>

  <view class="safe-bottom"></view>
  </block>
</view>
