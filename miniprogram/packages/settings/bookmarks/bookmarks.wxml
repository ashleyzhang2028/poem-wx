<view class="page {{barBelow ? 'has-tabbar' : 'tall'}} {{name}}" style="{{themeStyle}}">

  <lock-card wx:if="{{locked}}" title="书签" note="登录后可使用书签" mark="签" bind:login="onLogin" />

  <block wx:else>

  <view class="card">
    <view class="card-head">
      <text class="card-title">书签管理</text>
      <tier-tag wx:if="{{tierLocked}}" tier="{{tier}}" bindtap="onTierGate" />
    </view>
    <text class="hint mark-lead">在诗词详情页点击书签图标收藏，于此统一查看与整理。</text>
    <view class="mark-quota" wx:if="{{on}}">
      <text class="hint">已存 {{count}} / {{cap}} 个 · 超出后自动移出最久的一个</text>
    </view>
  </view>

  <view class="card" wx:if="{{count}}">
    <view class="search mark-search">
      <view class="search-icon" style="mask-image:url('{{icons.search}}');-webkit-mask-image:url('{{icons.search}}');"></view>
      <input placeholder="搜索篇名 / 作者 / 书名" value="{{keyword}}" bindinput="onKeyword" confirm-type="search" />
      <view class="clear" hover-class="clear-hover" hover-stay-time="60" wx:if="{{keyword}}" bindtap="onKeywordClear">
        <view class="clear-ico" style="mask-image:url('{{icons.clear}}');-webkit-mask-image:url('{{icons.clear}}');"></view>
      </view>
    </view>

    <view class="inline-btns mark-tools">
      <button class="btn mini" bindtap="onEdit">{{editing ? '完成' : '编辑'}}</button>
      <button class="btn mini" wx:if="{{editing}}" bindtap="onPickAll">{{picked >= matched ? '取消全选' : '全选'}}</button>
      <button class="btn mini danger" wx:if="{{editing}}" bindtap="onDeletePicked">删除所选{{picked ? ' ' + picked : ''}}</button>
    </view>

    <view class="daily-row" hover-class="row-hover" hover-stay-time="60"
          wx:for="{{rows}}" wx:key="id" data-id="{{item.id}}" bindtap="onRow">
      <view class="daily-box {{item.picked ? 'on' : ''}}" wx:if="{{editing}}"><text class="daily-tick">{{item.picked ? '✓' : ''}}</text></view>
      <view class="row-main mark-line">
        <text class="row-title row-poem mark-title">{{item.title}}</text>
        <text class="row-sub mark-meta" wx:if="{{item.meta}}">{{item.meta}}</text>
      </view>
      <button class="btn mini mark-rename" wx:if="{{editing}}" data-id="{{item.id}}" catchtap="onRename">改名</button>
    </view>

    <view class="empty mark-empty" wx:if="{{!matched}}">
      <text class="empty-text">未找到「{{keyword}}」</text>
    </view>

    <view class="inline-btns mark-pager" wx:if="{{pages > 1}}">
      <button class="btn mini" disabled="{{page <= 1}}" bindtap="onPrev">上一页</button>
      <text class="hint mark-page">第 {{page}} / {{pages}} 页 · 共 {{matched}} 个</text>
      <button class="btn mini" disabled="{{page >= pages}}" bindtap="onNext">下一页</button>
    </view>
  </view>

  <view class="card" wx:elif="{{on}}">
    <view class="empty">
      <text class="empty-mark">签</text>
      <text class="empty-text say">暂无书签</text>
      <text class="hint empty-tip">在诗词详情页点击书签图标即可收藏</text>
    </view>
  </view>

  <view class="safe-bottom"></view>
  </block>
</view>
