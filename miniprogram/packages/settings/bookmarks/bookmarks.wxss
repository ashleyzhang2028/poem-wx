.mark-lead {
  display: block;
}

.mark-line {
  display: flex;
  align-items: baseline;
  gap: var(--sp-2);
}

.mark-quota {
  margin-top: var(--sp-2);
}

.mark-tools {
  flex-wrap: nowrap;
  padding: var(--sp-2) 0;
}

.daily-row {
  display: flex;
  align-items: center;
  min-height: var(--h-row);
  padding: var(--sp-2) var(--sp-1);
  border-top: 1rpx solid var(--line-2);
}

.daily-row:first-child {
  border-top: none;
}

.daily-box {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  margin-right: var(--sp-3);
  border: 1rpx solid var(--line-strong);
  border-radius: var(--radius-sm);
  background: var(--surface);
  color: var(--on-ink);
  display: flex;
  align-items: center;
  justify-content: center;
}

.daily-box.on {
  color: var(--on-ink);
  background: var(--strong);
  border-color: var(--strong);
}

.daily-tick {
  font-size: var(--fs-caption);
  line-height: 1;
}

.mark-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mark-meta {
  flex: none;
  max-width: 40%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mark-rename {
  flex: none;
  margin-left: var(--sp-2);
}

.mark-search {
  margin-bottom: var(--sp-2);
}

.mark-empty {
  padding: var(--sp-3) var(--sp-2);
}

.mark-pager {
  flex-wrap: nowrap;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-3) 0 var(--sp-1);
}

.mark-page {
  flex: 1;
  text-align: center;
}
