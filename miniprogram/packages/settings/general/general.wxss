.pinyin-row {
  margin-top: var(--sp-2);
}

.font-sample {
  margin: 0 calc(-1 * var(--sp-1)) var(--sp-3);
  padding-top: var(--sp-4);
  padding-bottom: var(--sp-4);
  border-bottom: 1rpx solid var(--line-2);
}

.font-slider-row {
  min-height: var(--h-opt-compact);
}

.font-row {
  margin-top: var(--sp-1);
}

.sfx-test {
  margin-left: var(--sp-3);
}

.danger-zone {
  border-color: var(--red-edge);
}

.danger-title {
  color: var(--red);
}

.danger-note {
  display: block;
  margin-bottom: var(--sp-3);
}

.danger-clear {
  margin-top: var(--sp-1);
}
