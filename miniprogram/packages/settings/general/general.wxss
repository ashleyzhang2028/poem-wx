.pinyin-row {
  margin-top: var(--sp-2);
}

.font-row {
  margin-top: var(--sp-2);
}

.font-sample {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: calc(var(--h-opt) * 3);
  margin-bottom: var(--sp-4);
  padding-bottom: var(--sp-3);
  border-bottom: 1rpx solid var(--line-2);
}

.sfx-test {
  margin-left: var(--sp-3);
}

.danger-zone {
  border-color: var(--red-edge);
}

.danger-title {
  color: var(--red);
}

.danger-note {
  display: block;
  margin-bottom: var(--sp-3);
}

.danger-clear {
  margin-top: var(--sp-1);
}
