.font-row {
  display: flex;
  align-items: center;
  margin: 12rpx 0 4rpx;
}

.font-slider {
  flex: 1;
  margin: 0 20rpx;
}

.font-a {
  font-family: var(--font-poem);
  color: var(--ink-3);
  flex: none;
}

.font-a.small {
  font-size: 24rpx;
}

.font-a.big {
  font-size: 36rpx;
}

.sample {
  display: block;
  font-family: var(--font-poem);
  line-height: 1.9;
  padding-top: 16rpx;
}

/* 未登录时的那张卡 */
.locked-card .note {
  display: block;
  margin-top: 16rpx;
}

.locked-btn {
  margin-top: 32rpx;
}
