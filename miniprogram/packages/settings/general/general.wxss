.font-row {
  margin: var(--sp-2) 0 4rpx;
}

.font-sample {
  padding: var(--sp-3) 0 0;
  margin-top: var(--sp-3);
  border-top: 1rpx dashed var(--line-2);
}

.note {
  display: block;
  margin-top: var(--sp-2);
  line-height: var(--lh-body);
}

.sfx-test {
  margin-left: var(--sp-3);
}

.danger-zone {
  border-color: var(--red-edge);
}

.danger-title {
  color: var(--red);
}

.danger-note {
  display: block;
  margin-bottom: var(--sp-3);
}

.danger-clear {
  margin-top: var(--sp-1);
}
