.font-row {
  margin: var(--sp-2) 0 4rpx;
}

.sample {
  display: block;
  font-family: var(--font-poem);
  line-height: var(--lh-loose);
  padding: var(--sp-3) 0 var(--sp-1);
  border-top: 1rpx dashed var(--line-2);
  margin-top: var(--sp-2);
}

.note {
  display: block;
  margin-top: var(--sp-2);
  line-height: var(--lh-body);
}

.test-btn {
  margin-top: var(--sp-3);
}

.swatch-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--sp-2) var(--sp-1);
  padding-top: var(--sp-2);
}

.swatch {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 6rpx 0;
  min-height: 108rpx;
}

.swatch-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--sw-soft);
  box-shadow: inset 0 0 0 1rpx var(--sw);
  transition: background-color var(--t-press), transform var(--t-press);
}

.swatch-hover .swatch-dot,
.swatch-dot:focus,
.swatch.on .swatch-dot {
  background: var(--sw);
}

.swatch-hover .swatch-dot {
  transform: scale(.92);
}

.swatch.on .swatch-dot {
  box-shadow: inset 0 0 0 1rpx var(--sw), 0 0 0 4rpx var(--sw-soft);
}

.swatch-name {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.swatch.on .swatch-name {
  color: var(--ink-2);
}
