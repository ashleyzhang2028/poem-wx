.font-row {
  margin: var(--sp-2) 0 4rpx;
}

.sample {
  display: block;
  font-family: var(--font-poem);
  line-height: var(--lh-loose);
  padding: var(--sp-3) 0 var(--sp-1);
  border-top: 1rpx dashed var(--line-2);
  margin-top: var(--sp-2);
}

.note {
  display: block;
  margin-top: var(--sp-2);
  line-height: var(--lh-body);
}
