<view class="page" style="{{themeStyle}}">
  <lock-card wx:if="{{locked}}" title="设置要登录" note="登录后才能改" mark="设" />

  <block wx:else>
  <view class="card">
    <view class="card-title">正文对齐</view>
    <view class="seg fill">
      <radio-group class="seg-group" bindchange="onAlign">
        <label class="seg-item {{align === item.key ? 'on' : ''}}" wx:for="{{aligns}}" wx:key="key">
          <radio class="seg-radio" value="{{item.key}}" checked="{{align === item.key}}" />
          <view class="seg-icon ic-{{item.icon}}"></view>
          <text class="seg-text">{{item.label}}</text>
        </label>
      </radio-group>
    </view>
  </view>

  <view class="card">
    <view class="card-title">正文字号</view>

    <view class="font-row">
      <text class="font-a small">A</text>
      <slider class="font-slider" min="{{fontMin}}" max="{{fontMax}}" step="1" value="{{fontSize}}"
              block-size="12" backgroundColor="#ececef" activeColor="{{themeColor}}"
              bindchanging="onFontSlide" bindchange="onFontSlide" />
      <text class="font-a big">A</text>
    </view>
    <text class="hint sample" style="font-size:{{30 + fontSize * 3}}rpx">床前明月光，疑是地上霜。</text>
  </view>

  <view class="card">
    <view class="card-title">注音</view>

    <block wx:if="{{pinyinOn}}">
      <view class="seg">
        <radio-group class="seg-group" bindchange="onPinyin">
          <label class="seg-item {{pinyin === item.key ? 'on' : ''}}" wx:for="{{pinyinModes}}" wx:key="key">
            <radio class="seg-radio" value="{{item.key}}" checked="{{pinyin === item.key}}" />
            <view class="seg-icon ic-{{item.icon}}"></view>
            <text class="seg-text">{{item.label}}</text>
          </label>
        </radio-group>
      </view>
    </block>

    <text class="hint note" wx:else>{{pinyinNote}}</text>
  </view>

  <view class="card" wx:if="{{sfxVisible}}">
    <view class="card-title">声音</view>
    <view class="row">
      <view class="row-main">
        <text class="row-title">答对答错出声</text>
        <text class="row-sub">题库 · 考试 · 飞花令共用</text>
      </view>
      <button class="btn mini ghost sfx-test" bindtap="onSfxTest">试听</button>
      <view class="sw">
        <switch checked="{{sfxOn}}" color="{{themeColor}}" bindchange="onSfx" />
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">主题</view>

    <view class="swatch-grid">
      <view class="swatch {{theme === item.key ? 'on' : ''}}"
            wx:for="{{items}}" wx:key="key"
            style="--sw:{{item.rgb}};--sw-soft:{{item.soft}};--sw-on:{{item.on}}"
            hover-class="swatch-hover" hover-stay-time="60"
            data-key="{{item.key}}" bindtap="onPick">
        <view class="swatch-dot"></view>
        <text class="swatch-name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <view class="safe-bottom"></view>
  </block>
</view>
