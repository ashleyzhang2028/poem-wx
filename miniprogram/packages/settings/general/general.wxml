<view class="page">
  <view class="page-head">
    <text class="head-title">版式</text>
  </view>

  <lock-card wx:if="{{locked}}" title="设置要登录" note="登录后才能改" mark="设" />

  <block wx:else>
  <view class="card">
    <view class="card-title bar">正文对齐</view>
    <view class="seg fill">
      <radio-group class="seg-group" bindchange="onAlign">
        <label class="seg-item {{align === item.key ? 'on' : ''}}" wx:for="{{aligns}}" wx:key="key">
          <radio class="seg-radio" value="{{item.key}}" checked="{{align === item.key}}"
                 color="#1c1c1e" />
          <view class="seg-icon ic-{{item.icon}}"></view>
          <text class="seg-text">{{item.label}}</text>
        </label>
      </radio-group>
    </view>
  </view>

  <view class="card">
    <view class="card-title bar">正文字号</view>
    <!-- 字号本来就是连续的，用原生滑动条比两个按钮更贴手感 -->
    <view class="font-row">
      <text class="font-a small">A</text>
      <slider class="font-slider" min="{{fontMin}}" max="{{fontMax}}" step="1" value="{{fontSize}}"
              block-size="22" block-color="#1c1c1e" activeColor="#1c1c1e" backgroundColor="#ececef"
              bindchanging="onFontSlide" bindchange="onFontSlide" />
      <text class="font-a big">A</text>
    </view>
    <text class="hint sample" style="font-size:{{30 + fontSize * 3}}rpx">床前明月光，疑是地上霜。</text>
  </view>

  <view class="card">
    <view class="card-title bar">背诵</view>
    <view class="row">
      <view class="row-main">
        <text class="row-title">背完自动下一首</text>
      </view>
      <switch checked="{{autoNext}}" color="#1c1c1e" bindchange="onAutoNext" />
    </view>
  </view>

  <view class="safe-bottom"></view>
  </block>
</view>
