<view class="page {{barBelow ? 'has-tabbar' : 'tall'}}" style="{{themeStyle}}">
  <lock-card wx:if="{{locked}}" title="设置" note="登录后才能改" mark="设" bind:login="onLogin" />

  <block wx:else>
  <view class="card">
    <view class="card-title">正文排版</view>

    <view class="poem-body align-{{align}} size-{{fontSize}} font-sample">
      <view class="poem-stanza" wx:for="{{sampleTokens}}" wx:key="index" wx:for-item="para">
        <view class="poem-line token-line" wx:for="{{para}}" wx:key="index" wx:for-item="row">
          <view class="poem-clause" wx:for="{{row}}" wx:for-item="cl" wx:key="index">
            <view class="token {{tk.han ? '' : 'punc'}}" wx:for="{{cl.tokens}}" wx:for-item="tk" wx:key="index">
              <text class="tk-py" wx:if="{{tk.mark}}">{{tk.py}}</text>
              <text class="tk-ch">{{tk.ch}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="seg fill">
      <radio-group class="seg-group" bindchange="onAlign">
        <label class="seg-item {{align === item.key ? 'on' : ''}}" wx:for="{{aligns}}" wx:key="key">
          <radio class="seg-radio" value="{{item.key}}" checked="{{align === item.key}}" />
          <view class="seg-icon" style="mask-image:url('{{item.icon}}');-webkit-mask-image:url('{{item.icon}}');"></view>
          <text class="seg-text">{{item.label}}</text>
        </label>
      </radio-group>
    </view>

    <view class="seg fill pinyin-row" wx:if="{{pinyinOn}}">
      <radio-group class="seg-group" bindchange="onPinyin">
        <label class="seg-item {{pinyin === item.key ? 'on' : ''}}" wx:for="{{pinyinModes}}" wx:key="key">
          <radio class="seg-radio" value="{{item.key}}" checked="{{pinyin === item.key}}" />
          <view class="seg-icon" style="mask-image:url('{{item.icon}}');-webkit-mask-image:url('{{item.icon}}');"></view>
          <text class="seg-text">{{item.label}}</text>
        </label>
      </radio-group>
    </view>

    <view class="font-row">
      <text class="font-a small">A</text>
      <slider class="font-slider" min="{{fontMin}}" max="{{fontMax}}" step="1" value="{{fontSize}}"
              block-size="12" backgroundColor="#ececef" activeColor="{{themeColor}}"
              bindchanging="onFontSlide" bindchange="onFontSlide" />
      <text class="font-a big">A</text>
    </view>

  </view>

  <view class="card" wx:if="{{sfxVisible}}">
    <view class="card-title">声音</view>
    <view class="row">
      <view class="row-main">
        <text class="row-title">答对答错出声</text>
        <text class="row-sub">背诵三态 · 题库 · 考试 · 飞花令共用</text>
      </view>
      <button class="btn mini ghost sfx-test" bindtap="onSfxTest">试听</button>
      <view class="sw">
        <switch checked="{{sfxOn}}" color="{{themeColor}}" bindchange="onSfx" />
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-head">
      <text class="card-title">季节限定</text>
      <tier-tag wx:if="{{seasonalLock}}" tier="{{seasonalTier}}" />
    </view>
    <view class="row">
      <view class="row-main">
        <text class="row-title">显示季节限定</text>
        <text class="row-sub">节日前两天与当天、节气周期内列出应景诗词</text>
      </view>
      <view class="sw">
        <switch checked="{{seasonalOn}}" disabled="{{seasonalLock}}" color="{{themeColor}}" bindchange="onSeasonal" />
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">古诗词大会</view>
    <view class="row">
      <view class="row-main">
        <text class="row-title">参与古诗词大会排行榜</text>
        <text class="row-sub">考试与飞花令的成绩记进排行榜，按学段比</text>
      </view>
      <view class="sw">
        <switch checked="{{leagueBoardOn}}" color="{{themeColor}}" bindchange="onLeagueBoard" />
      </view>
    </view>
  </view>

  <view class="card danger-zone">
    <view class="card-title danger-title">危险操作</view>
    <text class="hint danger-note">背诵进度、已读标记、今日加背都会删除，本机与云端的记录一起清，且无法恢复。</text>
    <button class="btn danger block danger-clear" bindtap="onClearData">清空数据</button>
  </view>

  <view class="safe-bottom"></view>
  </block>
  <tab-bar id="tabbar" current="4" />
</view>
