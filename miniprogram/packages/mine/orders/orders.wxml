<view class="page {{barBelow ? 'has-tabbar' : 'tall'}} {{name}}" style="{{themeStyle}}">

  <view class="card od-plan" wx:if="{{logged && plan}}">
    <text class="od-eyebrow">当前档位</text>
    <text class="od-plan-name">{{plan.name}}</text>
    <text class="od-plan-sub" wx:if="{{plan.paid && plan.forever}}">长期有效</text>
    <text class="od-plan-sub" wx:elif="{{plan.paid}}">{{plan.untilText}} 到期 · 还剩 {{plan.days}} 天</text>
    <text class="od-plan-sub" wx:else>开通后可解锁更多功能</text>
    <button class="btn primary block od-go" bindtap="onPricing">{{plan.paid ? '订阅 / 升级' : '开通 Pro / Max'}}</button>
  </view>

  <view class="card" wx:if="{{logged}}">
    <text class="card-title">支付记录</text>

    <text class="hint" wx:if="{{loaded && failed}}">记录没取到，请检查网络后重新进入。</text>
    <text class="hint" wx:elif="{{loaded && !list.length}}">还没有支付记录。</text>

    <view class="row od-row" wx:for="{{list}}" wx:key="outTradeNo">
      <view class="row-main">
        <text class="row-title">{{item.title}}</text>
        <text class="row-sub">{{item.timeText}}</text>
        <text class="row-sub" wx:if="{{item.untilText}}">会员至 {{item.untilText}}</text>
        <text class="row-sub od-id" wx:if="{{item.wxOrderId}}" data-id="{{item.wxOrderId}}" bindtap="onCopy">支付单号 {{item.wxOrderId}}（点按复制）</text>
      </view>
      <view class="od-side">
        <view class="tag od-tag {{item.statusTone}}">{{item.statusText}}</view>
        <text class="od-price">¥{{item.price}}</text>
      </view>
      <view class="inline-btns od-acts" wx:if="{{item.removable}}">
        <button class="btn primary mini" wx:if="{{item.pending}}" disabled="{{busy}}" data-id="{{item.outTradeNo}}" bindtap="onResume">继续支付</button>
        <button class="btn ghost mini" wx:if="{{item.pending}}" disabled="{{busy}}" data-id="{{item.outTradeNo}}" bindtap="onCancel">取消订单</button>
        <button class="btn danger mini" disabled="{{busy}}" data-id="{{item.outTradeNo}}" bindtap="onRemove">删除</button>
      </view>
    </view>
  </view>

  <view class="safe-bottom"></view>
  <tab-bar id="tabbar" current="4" />
</view>
