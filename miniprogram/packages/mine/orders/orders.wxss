.od-eyebrow {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

.od-plan-name {
  display: block;
  margin-top: var(--sp-1);
  font-size: var(--fs-hero);
  color: var(--strong-text);
  line-height: var(--lh-tight);
}

.od-plan-sub {
  display: block;
  margin-top: var(--sp-2);
  font-size: var(--fs-hint);
  color: var(--ink-2);
}

.od-go {
  margin-top: var(--sp-3);
}

.od-row {
  flex-wrap: wrap;
}

.od-side {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  flex: none;
  margin-left: var(--sp-2);
}

.od-tag {
  margin-right: 0;
}

.od-price {
  font-family: var(--font-num);
  font-size: var(--fs-title);
  color: var(--ink-strong);
}

.od-id {
  word-break: break-all;
}

.od-acts {
  flex: 1 1 100%;
  margin-top: var(--sp-2);
}

.od-acts .btn.mini {
  flex: 0 0 calc((100% - 2 * var(--sp-1)) / 3);
  max-width: none;
}
