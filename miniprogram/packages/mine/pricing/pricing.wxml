<view class="page {{barBelow ? 'has-tabbar' : 'tall'}}" style="{{themeStyle}}">

  <view class="card pr-intro">
    <view class="pr-hero">
      <text class="pr-eyebrow">会员</text>
      <text class="pr-title poem">与您共同成长</text>
      <text class="pr-sub" wx:if="{{logged && untilText}}">当前 {{tier === 'max' ? 'Max' : 'Pro'}} · 到期 {{untilText}}</text>
      <text class="pr-sub" wx:elif="{{loadFailed}}">价格没取到，请检查网络后重新进入</text>
      <text class="pr-sub" wx:else>30 / 90 / 180 / 365 天，随时可以续订</text>
    </view>

    <text class="hint pr-note" wx:if="{{sandbox}}">当前是沙箱环境，仅用于测试，不会真实扣款。</text>

    <view class="pr-welcome tier-{{welcome.tier}}" wx:if="{{welcome}}">
      <text class="pr-w-title poem">{{welcome.title}}</text>
      <text class="pr-w-sub">{{welcome.sub}}</text>
    </view>

    <view wx:if="{{!logged}}">
      <text class="hint">请先用微信登录，再选择档位。</text>
      <button class="btn primary block pr-login" bindtap="onLogin">去登录</button>
    </view>
  </view>

  <block wx:if="{{logged}}">
    <view class="seg pr-period">
      <radio-group class="seg-group" bindchange="onPeriod">
        <label class="seg-item {{period === item.key ? 'on' : ''}}" wx:for="{{periods}}" wx:key="key">
          <radio class="seg-radio" value="{{item.key}}" checked="{{period === item.key}}" />
          <text class="seg-text">{{item.name}}</text>
        </label>
      </radio-group>
    </view>

    <view class="pr-grid">
      <view class="card pr-plan {{item.recommended ? 'is-rec' : ''}} {{item.key === 'max' ? 'is-max' : ''}}"
          wx:for="{{plans}}" wx:key="key">
      <view class="pr-head">
        <view class="pr-head-l">
          <text class="pr-name">{{item.name}}</text>
          <text class="pr-tagline">{{item.tagline}}</text>
        </view>
        <text class="tag pr-badge-tag {{item.tone}}" wx:if="{{item.current}}">当前</text>
        <text class="tag pr-badge-tag {{item.tone}}" wx:elif="{{item.recommended}}">推荐</text>
      </view>

      <view class="pr-price">
        <text class="pr-yen">¥</text>
        <text class="pr-num">{{item.priceText}}</text>
        <text class="pr-unit">{{item.unit}}</text>
        <text class="pr-was" wx:if="{{item.originalText}}">{{item.originalText}}</text>
        <text class="pr-save" wx:if="{{item.saveText}}">{{item.saveText}}</text>
      </view>
      <text class="pr-permonth" wx:if="{{item.perMonth}}">{{item.perMonth}}</text>

      <view class="pr-list">
        <text class="pr-inc" wx:if="{{item.includes}}">{{item.includes}}</text>
        <view class="pr-feat" wx:for="{{item.features}}" wx:for-item="f" wx:key="*this">
          <view class="pr-ck" style="mask-image:url('{{yes}}');-webkit-mask-image:url('{{yes}}');"></view>
          <text class="pr-feat-t">{{f}}</text>
        </view>
        <text class="pr-more" wx:if="{{item.more}}">另含 {{item.more}} 项</text>
      </view>

      <button class="btn block pr-buy {{item.buyClass}}" wx:if="{{item.actionText}}"
              disabled="{{item.disabled || busy}}" data-plan="{{item.key}}" bindtap="onBuy">{{item.actionText}}</button>
      </view>
    </view>

    <view class="pr-promise">
      <view class="pr-promise-row" wx:for="{{promises}}" wx:key="*this">
        <view class="pr-ck pr-ck-s" style="mask-image:url('{{yes}}');-webkit-mask-image:url('{{yes}}');"></view>
        <text class="pr-promise-t">{{item}}</text>
      </view>
    </view>

    <view class="card">
      <view class="row row-flush" hover-class="row-hover" hover-stay-time="60" bindtap="onOrders">
        <view class="row-main">
          <text class="row-title poem">支付记录</text>
          <text class="row-sub">每一笔订单 · 金额 · 支付单号</text>
        </view>
        <text class="row-go">›</text>
      </view>
    </view>
  </block>

  <view class="safe-bottom"></view>
  <tab-bar id="tabbar" current="4" />
</view>
