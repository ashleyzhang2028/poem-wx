.pr-hero {
  padding: 0 0 var(--sp-4);
}

.pr-eyebrow {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  letter-spacing: var(--ls-caption);
}

.pr-title {
  display: block;
  margin-top: var(--sp-1);
  font-size: var(--fs-hero);
  color: var(--strong-text);
  line-height: var(--lh-tight);
}

.pr-sub {
  display: block;
  margin-top: var(--sp-2);
  font-size: var(--fs-hint);
  color: var(--ink-2);
  line-height: var(--lh-body);
}

.pr-login {
  margin-top: var(--sp-3);
}

.pr-period {
  margin-bottom: var(--sp-3);
}

.pr-save {
  margin-left: auto;
  padding: 4rpx var(--sp-2);
  border-radius: var(--radius-pill);
  font-size: var(--fs-body);
  font-weight: 600;
  line-height: 1.4;
  color: var(--on-theme);
  background: var(--red);
}

.pr-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--sp-2);
  margin-bottom: var(--sp-2);
}

.pr-grid .pr-plan {
  display: flex;
  flex-direction: column;
  margin-bottom: 0;
  padding: var(--sp-3);
}

.pr-grid .pr-head {
  flex-direction: column;
}

.pr-grid .pr-badge-tag {
  margin-top: var(--sp-1);
}

.pr-grid .pr-price {
  flex-wrap: wrap;
  margin-top: var(--sp-2);
}

.pr-grid .pr-num {
  margin: 0 2rpx;
  font-size: var(--fs-lead);
}

.pr-grid .pr-was {
  flex-basis: 100%;
  margin-left: 0;
  margin-top: 2rpx;
}

.pr-grid .pr-save {
  margin-left: 0;
  margin-top: 4rpx;
}

.pr-grid .pr-list {
  flex: 1;
}

.pr-grid .pr-feat {
  align-items: flex-start;
  margin-bottom: var(--sp-1);
}

.pr-grid .pr-ck {
  width: 24rpx;
  height: 24rpx;
  margin-top: 6rpx;
}

.pr-grid .pr-feat-t {
  font-size: var(--fs-hint);
}

.pr-grid .pr-tagline,
.pr-grid .pr-unit,
.pr-grid .pr-permonth {
  font-size: var(--fs-caption);
}

.pr-grid .pr-buy {
  width: 100%;
  margin-top: var(--sp-2);
  padding: 0 var(--sp-2);
  font-size: var(--fs-hint);
}

.pr-plan.is-rec,
.pr-plan.is-max {
  border: 2rpx solid var(--strong);
  box-shadow: var(--shadow-lift);
}

.pr-plan.is-max {
  border-color: var(--gold);
}

.pr-badge-tag {
  margin-right: 0;
}

.pr-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.pr-head-l {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.pr-name {
  font-size: var(--fs-lead);
  color: var(--ink);
  line-height: var(--lh-tight);
}

.pr-tagline {
  margin-top: var(--sp-1);
  font-size: var(--fs-hint);
  color: var(--ink-2);
}

.pr-price {
  display: flex;
  align-items: baseline;
  margin-top: var(--sp-3);
}

.pr-yen,
.pr-unit {
  font-size: var(--fs-body);
  color: var(--ink-2);
}

.pr-num {
  margin: 0 6rpx;
  font-family: var(--font-num);
  font-size: var(--fs-stat);
  color: var(--strong-text);
  line-height: var(--lh-tight);
}

.pr-was {
  margin-left: var(--sp-3);
  font-family: var(--font-num);
  font-size: var(--fs-hint);
  color: var(--ink-3);
  text-decoration: line-through;
}

.pr-permonth {
  display: block;
  margin-top: var(--sp-1);
  font-size: var(--fs-hint);
  color: var(--ink-2);
}

.pr-list {
  margin-top: var(--sp-3);
  padding-top: var(--sp-3);
  border-top: 1rpx solid var(--line-2);
}

.pr-inc {
  display: block;
  margin-bottom: var(--sp-2);
  font-size: var(--fs-hint);
  color: var(--ink-3);
}

.pr-feat {
  display: flex;
  align-items: center;
  margin-bottom: var(--sp-2);
}

.pr-ck {
  flex: none;
  width: 30rpx;
  height: 30rpx;
  margin-right: var(--sp-2);
  background: var(--strong);
  -webkit-mask-size: contain;
  mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
}

.pr-ck-s {
  width: 26rpx;
  height: 26rpx;
  background: var(--ink-3);
}

.pr-feat-t {
  font-size: var(--fs-body);
  color: var(--ink);
  line-height: var(--lh-body);
}

.pr-more {
  display: block;
  font-size: var(--fs-hint);
  color: var(--ink-3);
}

.pr-buy {
  margin-top: var(--sp-3);
}

.btn.gold {
  background: var(--gold);
  border-color: var(--gold);
  color: var(--ink);
}

.btn.gold.button-hover {
  opacity: .9;
}

.btn.gold[disabled] {
  background: var(--gold-soft);
  border-color: var(--gold-soft);
  color: var(--ink-2);
}

.pr-promise {
  padding: var(--sp-2) var(--card-x) var(--sp-4);
}

.pr-promise-row {
  display: flex;
  align-items: center;
  margin-bottom: var(--sp-1);
}

.pr-promise-t {
  font-size: var(--fs-hint);
  color: var(--ink-2);
  line-height: var(--lh-body);
}

.pr-welcome {
  margin-top: var(--sp-3);
  padding: var(--sp-3);
  border: 2rpx solid var(--strong);
  border-radius: var(--radius);
  background: var(--strong-soft);
}

.pr-welcome.tier-max {
  border-color: var(--gold);
  background: var(--gold-soft);
}

.pr-w-title {
  display: block;
  font-size: var(--fs-lead);
  color: var(--ink);
  line-height: var(--lh-tight);
}

.pr-w-sub {
  display: block;
  margin-top: var(--sp-2);
  font-size: var(--fs-hint);
  color: var(--ink-2);
  line-height: var(--lh-body);
}

.pr-note {
  display: block;
  margin-bottom: var(--sp-3);
  color: var(--amber);
}
