.pr-hero {
  padding: 0 0 var(--sp-4);
}

.pr-eyebrow {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  letter-spacing: var(--ls-caption);
}

.pr-title {
  display: block;
  margin-top: var(--sp-1);
  font-size: var(--fs-hero);
  color: var(--strong-text);
  line-height: var(--lh-tight);
}

.pr-sub {
  display: block;
  margin-top: var(--sp-2);
  font-size: var(--fs-hint);
  color: var(--ink-2);
  line-height: var(--lh-body);
}

.pr-login {
  margin-top: var(--sp-3);
}

.pr-tabs {
  margin-bottom: var(--sp-3);
}

.pr-tab-group {
  display: flex;
  align-items: stretch;
  border-bottom: 1rpx solid var(--line);
}

.pr-tab {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-height: var(--h-opt);
}

.pr-tab-t {
  font-size: var(--fs-body);
  color: var(--ink-2);
  letter-spacing: var(--ls-title);
  transition: color var(--t-press);
}

.pr-tab.on .pr-tab-t {
  color: var(--tier);
  font-weight: 600;
}

.pr-tab.on::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: -1rpx;
  width: var(--tab-under-w);
  height: 4rpx;
  margin-left: calc(-1 * var(--tab-under-w) / 2);
  border-radius: var(--radius-pill);
  background: var(--tier);
}

.pr-save {
  flex: none;
  margin: 0 var(--sp-2);
  padding: 4rpx var(--sp-2);
  border-radius: var(--radius-pill);
  font-size: var(--fs-caption);
  font-weight: 600;
  line-height: 1.4;
  color: var(--on-ink);
  background: var(--strong);
}

.pr-plan .pr-save {
  color: var(--on-ink);
  background: var(--tier);
}

.tier-pro {
  --tier: var(--fei);
  --tier-soft: var(--fei-soft);
}

.tier-max {
  --tier: var(--zi);
  --tier-soft: var(--zi-soft);
}

.tier-pro {
  --tab-under-w: calc(96rpx * var(--ui-scale));
}

.tier-max {
  --tab-under-w: calc(120rpx * var(--ui-scale));
}

.pr-plan {
  border: 2rpx solid var(--tier);
}

.pr-plan .pr-name {
  color: var(--tier);
}

.pr-plan .pr-ck {
  background: var(--tier);
}

.pr-badge-tag {
  margin-right: 0;
}

.pr-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.pr-head-l {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.pr-name {
  font-size: var(--fs-lead);
  color: var(--ink);
  line-height: var(--lh-tight);
}

.pr-tagline {
  margin-top: var(--sp-1);
  font-size: var(--fs-hint);
  color: var(--ink-2);
}

.pr-was {
  margin-left: var(--sp-2);
  font-family: var(--font-num);
  font-size: var(--fs-hint);
  color: var(--ink-3);
  text-decoration: line-through;
}

.pr-opts {
  margin-top: var(--sp-3);
}

.pr-opt {
  display: flex;
  align-items: center;
  margin-bottom: var(--sp-2);
  padding: var(--sp-3);
  border: 2rpx solid var(--line-2);
  border-radius: var(--radius);
}

.pr-opt.on {
  border-color: var(--tier);
  background: var(--tier-soft);
}

.pr-opt-l {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.pr-opt-name {
  font-size: var(--fs-body);
  color: var(--ink);
}

.pr-opt-sub {
  margin-top: 2rpx;
  font-size: var(--fs-caption);
  color: var(--ink-2);
}

.pr-opt-r {
  display: flex;
  flex: none;
  flex-direction: column;
  align-items: flex-end;
}

.pr-opt-price {
  font-family: var(--font-num);
  font-size: var(--fs-lead);
  color: var(--tier);
  line-height: var(--lh-tight);
}

.pr-opt-r .pr-was {
  margin-left: 0;
}

.pr-credit {
  display: block;
  margin-top: var(--sp-1);
  font-size: var(--fs-hint);
  color: var(--ink-2);
  line-height: var(--lh-body);
}

.pr-list {
  margin-top: var(--sp-3);
  padding-top: var(--sp-3);
  border-top: 1rpx solid var(--line-2);
}

.pr-inc {
  display: block;
  margin-bottom: var(--sp-2);
  font-size: var(--fs-hint);
  color: var(--ink-3);
}

.pr-feat {
  display: flex;
  align-items: center;
  margin-bottom: var(--sp-2);
}

.pr-ck {
  flex: none;
  width: 30rpx;
  height: 30rpx;
  margin-right: var(--sp-2);
  background: var(--strong);
  -webkit-mask-size: contain;
  mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
}

.pr-ck-s {
  width: 26rpx;
  height: 26rpx;
  background: var(--ink-3);
}

.pr-feat-t {
  font-size: var(--fs-body);
  color: var(--ink);
  line-height: var(--lh-body);
}

.pr-more {
  display: block;
  font-size: var(--fs-hint);
  color: var(--ink-3);
}

.pr-buy {
  margin-top: var(--sp-3);
}

.btn.pr-buy {
  width: var(--w-btn-wide);
  background: var(--tier);
  border-color: var(--tier);
  color: var(--on-ink);
}

.btn.pr-buy {
  position: relative;
  overflow: hidden;
}

.pr-buy-t {
  position: relative;
  z-index: 1;
}

.pr-buy-badge {
  position: absolute;
  right: -28rpx;
  top: 50%;
  width: 150rpx;
  height: 150rpx;
  margin-top: -75rpx;
  background: var(--on-ink-soft);
  -webkit-mask-size: contain;
  mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
  pointer-events: none;
}

.btn.pr-buy[disabled] .pr-buy-badge {
  display: none;
}

.btn.pr-buy.button-hover {
  opacity: .9;
}

.btn.pr-buy[disabled] {
  background: var(--tier-soft);
  border-color: var(--tier-soft);
  color: var(--ink-2);
  opacity: 1;
}

.pr-promise {
  padding: var(--sp-2) var(--card-x) var(--sp-4);
}

.pr-promise-row {
  display: flex;
  align-items: center;
  margin-bottom: var(--sp-1);
}

.pr-promise-t {
  font-size: var(--fs-hint);
  color: var(--ink-2);
  line-height: var(--lh-body);
}

.pr-welcome {
  margin-top: var(--sp-3);
  padding: var(--sp-3);
  border: 2rpx solid var(--tier);
  border-radius: var(--radius);
  background: var(--tier);
}

.pr-welcome .pr-w-title,
.pr-welcome .pr-w-sub {
  color: var(--on-ink);
}

.pr-w-title {
  display: block;
  font-size: var(--fs-lead);
  color: var(--ink);
  line-height: var(--lh-tight);
}

.pr-w-sub {
  display: block;
  margin-top: var(--sp-2);
  font-size: var(--fs-hint);
  color: var(--ink-2);
  line-height: var(--lh-body);
}

.pr-note {
  display: block;
  margin-bottom: var(--sp-3);
  color: var(--amber);
}
