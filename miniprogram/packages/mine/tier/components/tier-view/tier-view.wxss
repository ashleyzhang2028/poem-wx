.grant {
  margin-top: var(--sp-3);
}

.grant-eyebrow {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  letter-spacing: var(--ls-title);
}

.grant-tier-name {
  display: block;
  margin-top: var(--sp-1);
  font-family: var(--font-ui);
  font-size: var(--fs-hero);
  color: var(--strong-text);
  letter-spacing: var(--ls-title);
  line-height: var(--lh-tight);
}

.guest-note {
  display: block;
  margin-top: var(--sp-1);
  font-size: var(--fs-hint);
  color: var(--ink-3);
  line-height: var(--lh-body);
}

.grant-stat {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: var(--sp-4);
  font-variant-numeric: tabular-nums;
}

.grant-stat-t {
  font-size: var(--fs-hint);
  color: var(--ink-2);
}

.grant-stat-n {
  font-size: var(--fs-hint);
  color: var(--strong-text);
}

.grant-meter {
  margin-top: var(--sp-2);
}

.grant-expiry {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-top: var(--sp-3);
  padding: var(--sp-2) var(--sp-3);
  border-radius: var(--radius-block);
  background: var(--strong-soft);
}

.grant-expiry-t {
  font-size: var(--fs-hint);
  color: var(--strong-text);
}

.grant-expiry-s {
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

.grant-acts {
  display: flex;
  gap: var(--sp-2);
  margin-top: var(--sp-4);
}

.grant-acts .btn {
  margin: 0;
  width: auto;
}

.grant-pay {
  flex: 2;
}

.grant-orders {
  flex: 1;
}

.tier-table {
  margin-top: var(--sp-2);
}

.tier-line {
  display: flex;
  align-items: center;
  padding: var(--sp-2) 0;
  border-top: 1rpx solid var(--line);
}

.tier-line:first-child {
  border-top: 0;
}

.tier-head {
  padding-bottom: var(--sp-1);
}

.tier-head .tier-cap,
.tier-head .tier-cell-t {
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

.tier-cap {
  flex: 0 0 38%;
  min-width: 0;
  padding-right: var(--sp-2);
  font-size: var(--fs-hint);
  color: var(--ink-2);
  line-height: 1.4;
}

.tier-cell {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 0 2rpx;
}

.tier-cell-t {
  font-size: var(--fs-hint);
  color: var(--strong-soft);
  font-variant-numeric: tabular-nums;
}

.tier-cell-t.yes {
  color: var(--ink-2);
}

.tier-cell.is-now .tier-cell-t {
  color: var(--strong-text);
}

.tier-cell-ic {
  width: var(--glyph-round);
  height: var(--glyph-round);
  color: var(--ink-2);
  background-color: currentColor;
  mask-repeat: no-repeat;
  mask-position: center;
  mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-position: center;
  -webkit-mask-size: contain;
}

.tier-cell.is-now .tier-cell-ic {
  color: var(--strong);
}

.tier-head .tier-cell.is-now::after {
  content: "";
  display: block;
  width: 16rpx;
  height: 3rpx;
  margin-top: 4rpx;
  border-radius: var(--radius-pill);
  background: var(--strong);
}

.grant-pay {
  margin-top: var(--sp-3);
}
