<view class="card grant">
  <text class="grant-eyebrow">当前档位</text>
  <text class="grant-tier-name">{{status.label}}</text>
  <text class="guest-note" wx:if="{{!logged}}">未登录 · 暂按 Free</text>
  <text class="guest-note" wx:elif="{{note}}">{{note}}</text>

  <view class="grant-stat">
    <text class="grant-stat-t">已开 {{stats.enabled}} / {{stats.caps}} 项功能</text>
    <text class="grant-stat-n">{{stats.percent}}%</text>
  </view>
  <view class="meter grant-meter">
    <view class="meter-fill" style="width:{{stats.percent}}%"></view>
  </view>

  <view class="grant-expiry" wx:if="{{expiry}}">
    <text class="grant-expiry-t">{{expiry.title}}</text>
    <text class="grant-expiry-s">{{expiry.sub}}</text>
  </view>

  <view class="grant-acts" wx:if="{{logged}}">
    <button class="btn primary grant-pay" bindtap="onPricing">{{paid ? '订阅 / 升级' : '开通 Pro / Max'}}</button>
    <button class="btn ghost grant-orders" wx:if="{{paid}}" bindtap="onOrders">支付记录</button>
  </view>
</view>

<view class="card">
  <view class="card-title">权限对比</view>

  <view class="tier-table">
    <view class="tier-line tier-head">
      <text class="tier-cap">功能</text>
      <view class="tier-cell {{col.now ? 'is-now' : ''}}" wx:for="{{heads}}" wx:for-item="col" wx:key="tier">
        <text class="tier-cell-t">{{col.label}}</text>
      </view>
    </view>

    <view class="tier-line" wx:for="{{compareRows}}" wx:key="cap">
      <text class="tier-cap">{{item.name}}</text>
      <view class="tier-cell {{cell.on && cell.now ? 'is-now' : ''}}" wx:for="{{item.cells}}" wx:for-item="cell" wx:key="tier">
        <text class="tier-cell-t {{cell.cls}}" wx:if="{{cell.text && cell.text !== '不限'}}">{{cell.text}}</text>
        <view class="tier-cell-ic {{cell.cls}}" wx:else
              style="mask-image:url('{{cell.icon}}');-webkit-mask-image:url('{{cell.icon}}');"></view>
      </view>
    </view>
  </view>
</view>
