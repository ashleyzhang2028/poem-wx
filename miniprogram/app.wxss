@import "styles/tokens.wxss";

/* ============================================================
   基座
   页面样式表只管「这一页长什么样」，凡是两页以上都要写的东西，
   一律收在这里。收不住的后果不是难看，是**不一致** ——
   用户说不清哪里别扭，只觉得「一塌糊涂」。
   ============================================================ */

view, text, button, input, textarea {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 20rpx var(--page-x) calc(24rpx + env(safe-area-inset-bottom));
}

/* 底纹：素绢上压一道极淡的竖纹，屏幕大时不会显得空得发飘。
   只给页面最外层，卡片不参与，免得两层纹理打架 */
.page::before {
  content: "";
  position: fixed;
  inset: 0;
  z-index: -1;
  background:
    radial-gradient(120% 60% at 50% 0%, rgba(255, 254, 250, .85) 0%, rgba(255, 254, 250, 0) 60%),
    repeating-linear-gradient(90deg, rgba(74, 58, 38, .022) 0 2rpx, transparent 2rpx 14rpx);
  pointer-events: none;
}

/* ---------- 页头 ----------
   一屏的入口。它回答「我在哪、这里有什么」，
   标题用宋体、副题用黑体小字，一眼分得开层级。 */
.page-head {
  padding: var(--sp-1) var(--sp-1) var(--sp-3);
}

.head-title {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-lead);
  font-weight: 600;
  color: var(--green);
  letter-spacing: var(--ls-title);
  line-height: var(--lh-tight);
}

.head-sub {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  letter-spacing: var(--ls-caption);
  margin-top: var(--sp-1);
}

/* ---------- 卡片 ---------- */
.card {
  background: var(--card);
  border: 1rpx solid var(--line-2);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: var(--sp-4);
  margin-bottom: var(--sp-3);
}

/* 带页头的一屏：第一张卡与页头贴紧一点，不然顶部空一块 */
.page-head + .card {
  margin-top: 0;
}

.card-title {
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--ink);
  margin-bottom: var(--sp-1);
}

/* 卡片小标题带一道左侧短竖线：一屏几张卡时，视线有个落脚点，
   不用靠字号比大小去猜哪一行是标题 */
.card-title.bar {
  display: flex;
  align-items: center;
  font-size: var(--fs-body);
  color: var(--green);
  margin-bottom: var(--sp-2);
}

.card-title.bar::before {
  content: "";
  width: 6rpx;
  height: 26rpx;
  border-radius: 3rpx;
  background: var(--green);
  margin-right: 12rpx;
}

.hint {
  font-size: var(--fs-hint);
  color: var(--ink-3);
  line-height: var(--lh-body);
}

.sub-title {
  display: block;
  font-size: var(--fs-hint);
  color: var(--ink-2);
  margin: var(--sp-3) 0 var(--sp-1);
}

/* 一条淡分隔，比 border 更轻，用在「同一张卡里换话题」的地方 */
.divider {
  height: 1rpx;
  background: var(--line-2);
  margin: var(--sp-3) 0;
}

/* ---------- 空状态 ----------
   一枚淡印章 + 一句人话 + 一个下一步。
   有出处的「没有」比一个孤零零的方块让人安心 —— 用户知道是真没有，
   不是没加载出来。 */
.empty {
  padding: var(--sp-6) var(--sp-3) var(--sp-5);
  text-align: center;
}

.empty-mark {
  display: block;
  width: 104rpx;
  height: 104rpx;
  line-height: 100rpx;
  margin: 0 auto var(--sp-2);
  border-radius: 50%;
  border: 2rpx dashed var(--line);
  background: var(--bg-soft);
  font-family: var(--font-poem);
  font-size: 46rpx;
  color: var(--line);
}

.empty-text {
  display: block;
  font-size: var(--fs-title);
  color: var(--ink-2);
  line-height: var(--lh-loose);
}

.empty-tip {
  display: block;
  margin-top: var(--sp-1);
}

/* ---------- 按钮 ---------- */
.btn {
  height: 88rpx;
  line-height: 84rpx;
  padding: 0 var(--sp-4);
  border-radius: var(--radius-sm);
  background: var(--bg-soft);
  border: 1rpx solid var(--line);
  color: var(--ink);
  font-size: var(--fs-title);
  font-weight: 500;
  letter-spacing: var(--ls-title);
  text-align: center;
  transition: background-color var(--t-press), transform var(--t-press), opacity var(--t-press);
}

.btn::after {
  border: none;
}

.btn.primary {
  background: var(--green);
  border-color: var(--green);
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(47, 96, 85, .22);
}

/* 主按钮按下时压深一档、再缩一点，不然同色相邻时会显得「没点着」 */
.btn.primary.button-hover {
  background: var(--green-dark);
  border-color: var(--green-dark);
  box-shadow: var(--shadow-press);
  transform: scale(.985);
}

.btn.ghost {
  background: transparent;
  color: var(--ink-2);
}

.btn.danger {
  color: var(--red);
  border-color: var(--red-edge);
  background: var(--red-light);
}

.btn.block {
  width: 100%;
}

.btn.block + .btn.block {
  margin-top: var(--sp-2);
}

/* 瘦身版：搜索键、索引开关、名录改档这种「一行里的小按钮」都走它。
   原生 button 自带最小宽度与默认内边距，不收掉就撑得整行走形。 */
.btn.mini {
  display: inline-block;
  width: auto;
  min-width: 0;
  height: 60rpx;
  line-height: 56rpx;
  padding: 0 var(--sp-3);
  font-size: var(--fs-hint);
  border-radius: var(--radius-sm);
}

.btn[disabled] {
  opacity: .5;
  box-shadow: none;
}

.btn.button-hover {
  opacity: .86;
  transform: scale(.985);
}

/* ---------- 列表行 ---------- */
/* 行是导航不是按钮，所以用 hover-class 借原生触碰反馈，不套一层 button */
.row-hover {
  background: var(--green-light);
}

.row {
  display: flex;
  align-items: center;
  padding: var(--sp-3) 0;
  border-bottom: 1rpx solid var(--line-2);
  border-radius: 8rpx;
  transition: background-color var(--t-press);
}

.row:last-child {
  border-bottom: none;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-title {
  font-family: var(--font-poem);
  font-size: var(--fs-title);
  color: var(--ink);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-sub {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 6rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 行尾那个 ›：压低饱和度，它是提示不是内容 */
.row-go {
  color: var(--line);
  font-size: 32rpx;
  padding-left: var(--sp-2);
  line-height: 1;
  flex: none;
}

/* ---------- 标签 ---------- */
.tag {
  display: inline-block;
  font-size: var(--fs-caption);
  line-height: 1.5;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  color: var(--green);
  background: var(--green-light);
  margin-right: 10rpx;
}

.tag.amber {
  color: var(--amber);
  background: var(--amber-light);
}

.tag.red {
  color: var(--red);
  background: var(--red-light);
}

.tag.blue {
  color: var(--blue);
  background: var(--blue-light);
}

.tag.ghost {
  color: var(--ink-3);
  background: var(--line-2);
}

/* ---------- 搜索框 ---------- */
.search {
  display: flex;
  align-items: center;
  background: var(--bg-soft);
  border: 1rpx solid var(--line-2);
  border-radius: var(--radius-pill);
  padding: 0 var(--sp-3);
  height: 84rpx;
  margin-bottom: var(--sp-2);
  box-shadow: inset 0 1rpx 3rpx rgba(74, 58, 38, .05);
}

.search-icon {
  color: var(--ink-3);
  font-size: var(--fs-body);
  margin-right: 12rpx;
}

.search input {
  flex: 1;
  font-size: var(--fs-body);
  color: var(--ink);
}

/* ---------- 文本输入（后端地址这类）---------- */
/* 输入框一律用原生 <input>，样式只统一尺寸与配色 —— 外观改不到它内部，
   这点必须承认，所以只给边框与圆角 */
.field {
  display: flex;
  align-items: center;
  background: var(--bg-soft);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  padding: 0 var(--sp-3);
  height: 84rpx;
  margin: var(--sp-2) 0;
}

.field-input {
  flex: 1;
  font-size: var(--fs-body);
  color: var(--ink);
}

/* ---------- 小程序自有控件的统一口径 ----------
   这一节是「控件用系统的、配色用跬步的」这句话的落点。
   开关 / 单选 / 多选 / 滑动条 / 选择器 / 按钮全部走小程序自带控件：
   行为、无障碍、键盘与读屏由平台保证，我们只负责把它们染成宋代那套颜色。

   原生控件的交互色只能通过组件属性给（color / activeColor / selected-color），
   属性在 WXML 里写；样式表这边只统一尺寸、圆角、字体与间距 ——
   想靠 WXSS 改原生控件的内部结构是不被支持的，所以这里一行都不敢越界。 */

/* 原生的 checkbox / radio 默认 23px 见方，比正文小、点着费劲；
   横向缩放不改它自身尺寸，只放大外观 —— 命中区仍是原生的一整行，所以点着反而更宽松 */
.native-group {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx var(--sp-3);
}

/* 选项多且等长时（年级、学期），排成等宽网格 ——
   靠字宽决定占位会排得参差不齐 */
.native-group.grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0;
}

.native-group.grid .native-label {
  justify-content: flex-start;
}

/* 三列的（学期、每首数） */
.native-group.grid.cols-3 {
  grid-template-columns: repeat(3, 1fr);
}

.native-group.column {
  flex-direction: column;
  gap: 0;
}

.native-label {
  display: flex;
  align-items: center;
  min-height: 64rpx;
  padding: 10rpx 0;
  font-size: var(--fs-body);
  color: var(--ink);
}

/* ---------- 选项行 ----------
   「选一个」的统一长相。行本身是 label[for]，点整行都能选中，
   不用把手指对准那个小圆点。 */
.opt-group {
  display: flex;
  flex-wrap: wrap;
}

.opt-row {
  display: flex;
  align-items: center;
  min-height: 84rpx;
  padding: var(--sp-2) 0;
  border-bottom: 1rpx solid var(--line-2);
  border-radius: 8rpx;
  transition: background-color var(--t-press);
}

.opt-row:last-of-type {
  border-bottom: none;
}

/* 选中：整行左移一道竖线 + 主色字。
   只把字变色太轻，在长列表里扫不出来 */
.opt-row.active {
  background: var(--green-light);
  box-shadow: inset 6rpx 0 0 var(--green);
}

.opt-row.active .opt-name {
  color: var(--green);
  font-weight: 600;
}

.opt-row.locked {
  opacity: .45;
}

.opt-row radio,
.opt-row checkbox {
  transform: scale(.86);
  /* 两行文字的行，圆点要跟着第一行 —— 默认居中会飘到中间 */
  align-self: flex-start;
  margin-top: 10rpx;
}

.opt-main {
  flex: 1;
  min-width: 0;
  padding-left: var(--sp-1);
}

.opt-name {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-title);
  color: var(--ink);
}

.opt-desc {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 6rpx;
  line-height: 1.6;
}

/* 横排的单选项（范围、模式、筛选这种一行放得下的） */
.pref-item {
  display: flex;
  align-items: center;
  min-height: 60rpx;
  font-size: var(--fs-hint);
  color: var(--ink-2);
  padding-right: var(--sp-3);
}

.pref-item radio,
.pref-item checkbox {
  transform: scale(.8);
}

/* 横排筛选条：内容多时横向滚，不折成两行把版式撑乱 */
.chip-row {
  white-space: nowrap;
  margin-bottom: var(--sp-2);
}

.chip-row .pref-item {
  display: inline-flex;
  padding-right: var(--sp-2);
}

/* ---------- 字段行（键值对）---------- */
.kv {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 80rpx;
  padding: var(--sp-2) 0;
  border-bottom: 1rpx solid var(--line-2);
}

.kv:last-child,
.kv:last-of-type {
  border-bottom: none;
}

.kv-k {
  font-size: var(--fs-body);
  color: var(--ink-2);
  flex: none;
  padding-right: var(--sp-2);
}

.kv-v {
  font-size: var(--fs-body);
  color: var(--ink);
  text-align: right;
}

/* ---------- 进度：一横一竖两个共同件 ---------- */
/* 横条说「走到哪了」，环说「几比几」。两个都做，别只做一个 */
.meter {
  height: 10rpx;
  border-radius: 5rpx;
  background: var(--line-2);
  overflow: hidden;
}

.meter-fill {
  height: 100%;
  border-radius: 5rpx;
  background: linear-gradient(90deg, var(--gold) 0%, var(--celadon) 100%);
  transition: width var(--t-move) var(--ease);
}

/* 环：纯 CSS 锥形渐变，不引 canvas、不带图片资源 */
.ring {
  position: relative;
  flex: none;
}

.ring-track,
.ring-fill {
  position: absolute;
  inset: 0;
  border-radius: 50%;
}

.ring-track {
  background: var(--line-2);
}

.ring-fill {
  background: conic-gradient(var(--green) calc(var(--p) * 1%), transparent 0);
  transition: background var(--t-move) var(--ease);
}

.ring::after {
  content: "";
  position: absolute;
  inset: 13%;
  border-radius: 50%;
  background: var(--bg-soft);
  border: 1rpx solid var(--line-2);
}

.ring-text {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-poem);
  color: var(--ink-2);
  z-index: 1;
}

/* ---------- 未登录的那张卡 ---------- */
/* 门禁卡在 14 个页面里各有一份，长相必须是同一个 —— 用户才会认得出
   「这是同一道门」，而不是每页一套说法。 */
.lock-card {
  text-align: center;
  padding: var(--sp-5) var(--sp-4) var(--sp-4);
  background: linear-gradient(168deg, #fffefb 0%, var(--bg-soft) 58%, #f4ecd8 100%);
  overflow: hidden;
  position: relative;
}

.lock-mark {
  display: block;
  width: 116rpx;
  height: 116rpx;
  line-height: 112rpx;
  margin: 0 auto var(--sp-3);
  border-radius: 22rpx;
  border: 3rpx solid rgba(168, 59, 50, .5);
  background: rgba(255, 254, 251, .9);
  font-family: var(--font-poem);
  font-size: 54rpx;
  color: rgba(168, 59, 50, .68);
  transform: rotate(-4deg);
}

.lock-title {
  display: block;
  font-size: var(--fs-lead);
  font-weight: 600;
  color: var(--green);
  font-family: var(--font-poem);
  letter-spacing: var(--ls-title);
}

.lock-note {
  display: block;
  margin-top: var(--sp-2);
  text-align: left;
  line-height: var(--lh-loose);
}

.lock-btn {
  margin-top: var(--sp-4);
}

.lock-foot {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-caption);
  color: var(--ink-3);
  letter-spacing: var(--ls-caption);
  margin-top: var(--sp-3);
}

/* ---------- 底部安全区垫片 ---------- */
.safe-bottom {
  height: calc(24rpx + env(safe-area-inset-bottom));
}

/* 页脚一句：给整屏一个收束，不然最后一张卡下面像被切断 */
.foot {
  text-align: center;
  padding: var(--sp-1) 0 var(--sp-5);
}

.foot .hint {
  letter-spacing: 1rpx;
}
