@import "styles/tokens.wxss";

/* ============================================================
   基座
   页面样式表只管「这一页长什么样」，凡是两页以上都要写的东西，
   一律收在这里。收不住的后果不是难看，是**不一致** ——
   用户说不清哪里别扭，只觉得「一塌糊涂」。

   这一版的层次只有三样：**留白、字重、一道极淡的线**。
   底色是白的、卡片也是白的，靠间隙与描边分开。
   ============================================================ */

view, text, button, input, textarea {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: var(--sp-3) var(--page-x) calc(24rpx + env(safe-area-inset-bottom));
}

/* ---------- 页头 ----------
   一屏的入口，回答「我在哪、这里有什么」。
   参考图里那一屏最上面是一行小字标签 + 一个标题，没有别的装饰 ——
   所以这里也不留底色、不留横线，只有字。

   ⚠️ 页头的大标题不许等于导航栏标题（同屏两行一样的字等于没说）——
   自检里有断言守着。 */
.page-head {
  padding: var(--sp-2) var(--sp-1) var(--sp-4);
}

.head-title {
  display: block;
  font-size: var(--fs-head);
  font-weight: 700;
  color: var(--ink);
  letter-spacing: var(--ls-title);
  line-height: var(--lh-tight);
}

/* 页头这里**是界面在说话**：「今天背什么」「课外阅读」「十七部集子」——
   它和卡片里的篇名（咏鹅 / 将进酒）会同时出现在一屏里。
   篇名走宋体是内容需求，页头若也走宋体，两处就会撞成同一种「雅」，
   反而分不出哪个是书、哪个是书架。所以页头一律黑体，宋体只给诗文。 */
.head-title.poem {
  font-family: var(--font-poem);
}


.head-sub {
  display: block;
  font-size: var(--fs-hint);
  color: var(--ink-3);
  letter-spacing: var(--ls-caption);
  margin-top: var(--sp-2);
}

/* ---------- 卡片 ----------
   白底、一道极淡的描边、一层几乎看不见的投影。
   投影只为了在米白页底上把「这是一张卡」说清楚，
   不再承担「这张卡更重要」这个职责 —— 那是留白的活。 */
.card {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: var(--sp-4);
  margin-bottom: var(--sp-3);
}

/* 带页头的一屏：第一张卡与页头贴紧一点，不然顶部空一块 */
.page-head + .card {
  margin-top: 0;
}

.card-title {
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--ink);
  margin-bottom: var(--sp-1);
}

/* 卡片小标题：不加竖线、不加色 —— 参考图里的小标题就是一行黑字，
   它靠位置（在卡片最上面）和字重说明自己是标题，不靠装饰。 */
.card-title.bar {
  display: flex;
  align-items: center;
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--ink);
  margin-bottom: var(--sp-2);
}

.hint {
  font-size: var(--fs-hint);
  color: var(--ink-3);
  line-height: var(--lh-body);
}

.sub-title {
  display: block;
  font-size: var(--fs-hint);
  color: var(--ink-2);
  margin: var(--sp-3) 0 var(--sp-1);
}

/* ---------- 字段名 ----------
   一张卡里「这一行是什么」那半截字的统一样子。它比 card-title 轻、
   比正文小，因为它不是内容，是标签。

   之前散成四份：搜索页的 .opt-label、飞花令的 .opt-label、
   搜索页的 .section-label、朗读设置里裸写的 .sub-title ——
   四份的字号差 3rpx、颜色一个 ink-2 一个 ink-3，一页里同时出现就露馅。
   现在只有这一处。 */
.field-label {
  display: block;
  font-size: var(--fs-hint);
  color: var(--ink-3);
  letter-spacing: var(--ls-caption);
  line-height: 1.4;
  margin-bottom: 4rpx;
}

/* 一条淡分隔，比 border 更轻，用在「同一张卡里换话题」的地方 */
.divider {
  height: 1rpx;
  background: var(--line-2);
  margin: var(--sp-3) 0;
}

/* ---------- 空状态 ----------
   一枚淡印章 + 一句人话 + 一个下一步。
   有出处的「没有」比一个孤零零的方块让人安心 —— 用户知道是真没有，
   不是没加载出来。 */
.empty {
  padding: var(--sp-6) var(--sp-3) var(--sp-5);
  text-align: center;
}

/* 印章：一枚圆里放一个字。居中也走 flex —— 用「line-height 比 height
   小 4rpx」去凑是同一个坏习惯，圆环一粗就偏，且偏在哪一侧每台机子不一样 */
.empty-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  margin: 0 auto var(--sp-2);
  border-radius: 50%;
  background: var(--sink);
  font-family: var(--font-poem);
  font-size: 46rpx;
  line-height: 1;
  color: var(--ink-4);
}

.empty-text {
  display: block;
  font-size: var(--fs-title);
  color: var(--ink-2);
  line-height: var(--lh-loose);
}

.empty-tip {
  display: block;
  margin-top: var(--sp-1);
}

/* ---------- 按钮 ----------
   三种：**实心墨黑**（一屏的正事）、**白底描边**（并列的另一件事）、
   **纯文字**（最轻的一档，用于行内小动作）。

   按钮文字**垂直居中**靠的是「内容盒 + align-items」，
   不是把 line-height 调成比 height 小几 rpx 去凑 —— 那种写法在字重、
   字号、系统字体任意一个变了之后就会偏，且各页偏的方向还不一样。
   原生 button 默认是 inline-block + 默认行高，这里统一改成 flex 居中。 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: var(--h-btn);
  padding: 0 var(--sp-4);
  border-radius: var(--radius-pill);
  background: var(--surface);
  border: 1rpx solid var(--line-strong);
  color: var(--ink);
  font-size: var(--fs-title);
  font-weight: 500;
  line-height: 1.2;
  letter-spacing: var(--ls-title);
  text-align: center;
  transition: background-color var(--t-press), transform var(--t-press), opacity var(--t-press);
}

.btn::after {
  border: none;
}

/* 一屏的正事：一块干净的墨黑。
   参考图里「手机号快捷注册 / 新增档期」就是这一块 —— 全屏只有它一个。 */
.btn.primary {
  background: var(--ink);
  border-color: var(--ink);
  color: var(--on-ink);
  font-weight: 600;
}

/* 主按钮按下时压深一档、再缩一点，不然同色相邻时会显得「没点着」 */
.btn.primary.button-hover {
  background: var(--ink-strong);
  border-color: var(--ink-strong);
  opacity: .92;
  transform: scale(.985);
}

.btn.ghost {
  background: transparent;
  color: var(--ink-2);
  border-color: var(--line-strong);
}

.btn.danger {
  color: var(--red);
  border-color: var(--red-edge);
  background: var(--red-soft);
}

.btn.block {
  width: 100%;
}

.btn.block + .btn.block {
  margin-top: var(--sp-2);
}

/* 一排并列的按钮（「说一句 / 接不上了」「试听 / 保存」这种）。
   两件事必须一起写：**flex 平分宽度** 与 **align-items: center**。
   少了后者，flex 的默认 stretch 遇上 .btn 的固定 height 会退化成基线对齐 ——
   同一排里主按钮与次要按钮**顶部齐、底部不齐**，看着像一个大一个小。
   两个页面各写过一份，现在收在这里。 */
.actions {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  margin-top: var(--sp-3);
}

.actions .btn {
  flex: 1;
}

/* 瘦身版：搜索键、索引开关、名录改档这种「一行里的小按钮」都走它。
   原生 button 自带最小宽度与默认内边距，不收掉就撑得整行走形。 */
.btn.mini {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-width: 0;
  height: var(--h-btn-mini);
  padding: 0 var(--sp-3);
  font-size: var(--fs-hint);
  line-height: 1.2;
  border-radius: var(--radius-pill);
}

.btn[disabled] {
  opacity: .4;
  box-shadow: none;
}

.btn.button-hover {
  opacity: .86;
  transform: scale(.985);
}

/* ---------- 列表行 ----------
   行是导航不是按钮，所以用 hover-class 借原生触碰反馈，不套一层 button。
   参考图的列表行是「左图标 + 标题/副题 + 右箭头」，行高很松 ——
   一屏五六行就排满了，这是刻意的：手机上一行认不出是什么，点错比点慢更糟。 */
.row-hover {
  background: var(--sink);
}

.row {
  display: flex;
  align-items: center;
  min-height: var(--h-row);
  padding: var(--sp-2) 0;
  border-bottom: 1rpx solid var(--line-2);
  border-radius: var(--radius-sm);
  transition: background-color var(--t-press);
}

.row:last-child {
  border-bottom: none;
}

.row-main {
  flex: 1;
  min-width: 0;
}

/* 列表行的标题。**它不一定是篇名** —— 我的页的「背诵设置」、
   关于页的「用户协议」走的也是这个类，这些是界面功能名，不是诗词名。
   所以这里取 UI 字体；篇名另走 .row-poem（见下），别让宋体漫出来。 */
.row-title {
  font-family: var(--font-ui);
  font-size: var(--fs-title);
  color: var(--ink);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 列表里的**篇名**：宋体只给这一类。咏鹅 / 江南 / 画 是诗词名，
   「意见反馈」「清空本机数据」不是 —— 同一张卡上两种字混排是最扎眼的那种不一致。 */
.row-poem {
  font-family: var(--font-poem);
}

.row-sub {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 6rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 行尾那个 ›：压低饱和度，它是提示不是内容 */
.row-go {
  color: var(--ink-4);
  font-size: 32rpx;
  padding-left: var(--sp-2);
  line-height: 1;
  flex: none;
}

/* 行首图标底：参考图里每行左边有一个浅色小方块（一个 emoji / 一个符号）。
   用 CSS 画一个圆角浅底，里面放一个字 —— 不引图片资源。 */
.row-icon {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  margin-right: var(--sp-3);
  border-radius: var(--radius-sm);
  background: var(--sink);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  line-height: 1;
  color: var(--ink-2);
}

/* ---------- 标签 ----------
   胶囊，浅底，小字。参考图里的「成功 / 提醒 / 错误」三个圆点标签就是这个尺寸。 */
.tag {
  display: inline-flex;
  align-items: center;
  font-size: var(--fs-caption);
  line-height: 1.5;
  padding: 3rpx 14rpx;
  border-radius: var(--radius-pill);
  color: var(--ink-2);
  background: var(--sink);
  margin-right: 10rpx;
}

.tag.amber {
  color: var(--amber);
  background: var(--amber-soft);
}

.tag.red {
  color: var(--red);
  background: var(--red-soft);
}

.tag.blue {
  color: var(--blue);
  background: var(--blue-soft);
}

.tag.green {
  color: var(--green);
  background: var(--green-soft);
}

.tag.ghost {
  color: var(--ink-3);
  background: var(--sink);
}

/* ---------- 搜索框 ----------
   参考图的输入框是「浅底 + 无描边 + 胶囊」：它比页面底深一点点，
   所以看得出是可输入的，又不会因为一道黑边而抢戏。 */
.search {
  display: flex;
  align-items: center;
  background: var(--sink);
  border: 1rpx solid transparent;
  border-radius: var(--radius-pill);
  padding: 0 var(--sp-4);
  height: var(--h-field);
  margin-bottom: var(--sp-2);
}

.search-icon {
  color: var(--ink-3);
  font-size: var(--fs-body);
  margin-right: 12rpx;
}

.search input {
  flex: 1;
  font-size: var(--fs-body);
  color: var(--ink);
}

/* ---------- 文本输入（后端地址这类）---------- */
/* 输入框一律用原生 <input>，样式只统一尺寸与配色 —— 外观改不到它内部，
   这点必须承认，所以只给边框与圆角 */
.field {
  display: flex;
  align-items: center;
  background: var(--sink);
  border: 1rpx solid transparent;
  border-radius: var(--radius-block);
  padding: 0 var(--sp-4);
  height: var(--h-field);
  margin: var(--sp-2) 0;
}

.field-input {
  flex: 1;
  font-size: var(--fs-body);
  color: var(--ink);
}

/* ============================================================
   统计大数字（参考图里最抓眼的一组）
   ============================================================ */
/* 三列并排，每列一个很大的数字 + 一行小标签，中间一道细竖线。

   为什么值得做成共用件：它是参考图里**唯一**一处靠「大」来表达重点的地方。
   上一版表达重点靠的是颜色（主色卡、金边、印章），一屏里好几处在喊，
   结果谁也没被听见。大数字不一样 —— 一屏只有一组，且不用颜色。 */
.stats {
  display: flex;
  align-items: stretch;
}

.stat {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--sp-2) 0;
}

.stat + .stat {
  border-left: 1rpx solid var(--line);
}

.stat-v {
  font-family: var(--font-num);
  font-size: var(--fs-stat);
  font-weight: 600;
  color: var(--ink);
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
  letter-spacing: -1rpx;
}

.stat-k {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: var(--sp-1);
  letter-spacing: var(--ls-caption);
}

/* ============================================================
   小程序自有控件的统一口径
   ============================================================ */
/* 这一节是「控件用系统的、配色用这一版的」这句话的落点。
   开关 / 单选 / 多选 / 滑动条 / 选择器 / 按钮全部走小程序自带控件：
   行为、无障碍、键盘与读屏由平台保证，我们只负责把它们染成这一版的样子。

   原生控件的交互色只能通过组件属性给（color / activeColor / selected-color），
   属性在 WXML 里写；样式表这边只统一尺寸、圆角、字体与间距 ——
   想靠 WXSS 改原生控件的内部结构是不被支持的，所以这里一行都不敢越界。 */

.native-group {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx var(--sp-3);
}

/* 选项多且等长时（年级、学期），排成等宽网格 ——
   靠字宽决定占位会排得参差不齐 */
.native-group.grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0;
}

.native-group.grid .native-label {
  justify-content: flex-start;
}

/* 三列的（学期、每首数） */
.native-group.grid.cols-3 {
  grid-template-columns: repeat(3, 1fr);
}

.native-group.column {
  flex-direction: column;
  gap: 0;
}

/* 选项与它的文字之间**要有默认间距**。
   原生 checkbox / radio 不自带外边距 —— 它只是一块 23px 的方框，
   紧贴文字是浏览器的排法，不是控件的排法。上一版靠 .opt-main 的
   padding-left 兜，只兜住了「两行文字」那一种，单行的那几页就贴在一起了。
   所以间距定在**控件自己**身上：一处生效，十三个页面都跟着对。

   顺手把行高收成一条：原生控件被 transform 缩放后，行盒仍按原尺寸算高度，
   不给 line-height 的话文字基线会跟着控件对齐跑偏。 */
.native-label,
.pref-item,
.opt-row {
  line-height: 1.4;
}

.native-label radio,
.native-label checkbox,
.pref-item radio,
.pref-item checkbox,
.opt-row radio,
.opt-row checkbox {
  margin-right: var(--sp-2);
}

/* 网格里最后那列不留右边距，否则整行会被顶宽 16rpx */
.native-group.grid .native-label radio,
.native-group.grid .native-label checkbox {
  margin-right: var(--sp-1);
}

.native-label {
  display: flex;
  align-items: center;
  min-height: 64rpx;
  padding: 10rpx 0;
  font-size: var(--fs-body);
  color: var(--ink);
}

/* ---------- 选项行 ----------
   「选一个」的统一长相。行本身是 label[for]，点整行都能选中，
   不用把手指对准那个小圆点。 */
.opt-group {
  display: flex;
  flex-wrap: wrap;
}

.opt-row {
  display: flex;
  align-items: center;
  min-height: var(--h-row);
  padding: var(--sp-2) 0;
  border-bottom: 1rpx solid var(--line-2);
  border-radius: var(--radius-sm);
  transition: background-color var(--t-press);
}

.opt-row:last-of-type {
  border-bottom: none;
}

/* 选中：整行左移一道竖线 + 主色字。
   只把字变色太轻，在长列表里扫不出来。

   竖线走 inset box-shadow 而不是 border-left —— 加边框会把整行内容
   往右推 6rpx，选中与未选中之间就出现了**横向跳动**：一行内容在
   两种状态下的起点不一样，看着像整页在抖。inset 画在行内，不占位。 */
.opt-row.active {
  background: var(--sink);
  box-shadow: inset 6rpx 0 0 var(--ink);
}

/* 选中行的圆点不要贴着那道竖线 —— 贴上去之后圆点左半圈被压在竖线底下，
   看着像被切了一刀。给选中行补一道与竖线等宽的内边距。 */
.opt-row.active radio,
.opt-row.active checkbox {
  margin-left: 6rpx;
}

.opt-row.active .opt-name {
  color: var(--ink);
  font-weight: 600;
}

.opt-row.locked {
  opacity: .45;
}

/* opt-row 是「两行文字 + 一个圆点」。两件事要一起办对：

   1. **圆点跟着第一行文字**，不是整行的垂直中心 —— 一行的中心在第一行与
      第二行之间，圆点落在那儿看着像「选了下面那行」。用 align-self 顶到
      行首 + 一点上边距让它与第一行文字的视觉中线齐平。
   2. **缩放要固定原点**。原生圆点在未缩放时是一块 23px 的方框，`scale(.86)`
      默认以中心为原点，那 3px 的溢出**是往左边去的** —— 被卡片的 padding
      裁掉一半，看着就像圆点被切了。`transform-origin: left top` 把它压回框内。 */
/* 圆点与第一行字的中线：这两个数不是拍的，是量出来的。
   `.opt-name` 是 --fs-title、行高 1.4 → 行盒 ≈45rpx；
   原生圆点 23px ≈ 44rpx，缩到 .86 → 38rpx。
   圆心要落在行盒中线上（45 / 2 ≈ 22.5），圆点顶边 = 22.5 - 19 ≈ 3rpx。
   字号或行高改了就一起改这两个数 —— 它们成对出现，不许只调一个。 */
.opt-row radio,
.opt-row checkbox {
  flex: none;
  align-self: flex-start;
  transform: scale(.86);
  transform-origin: left top;
  margin-top: 3rpx;
}

/* 间距由控件自己给（见上面那组规则），这里不再补，
   否则两处叠加会变成 24rpx —— 「一处生效」才是能守住的那种写法 */
.opt-main {
  flex: 1;
  min-width: 0;
}

.opt-name {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-title);
  color: var(--ink);
}

.opt-desc {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 6rpx;
  line-height: 1.6;
}

/* 横排的单选项（范围、模式、筛选这种一行放得下的） */
.pref-item {
  display: flex;
  align-items: center;
  min-height: 60rpx;
  font-size: var(--fs-hint);
  color: var(--ink-2);
  margin-right: var(--sp-3);
}

.pref-item radio,
.pref-item checkbox {
  transform: scale(.8);
}

/* 横排筛选条：内容多时横向滚，不折成两行把版式撑乱 */
.chip-row {
  white-space: nowrap;
  margin-bottom: var(--sp-2);
}

.chip-row .pref-item {
  display: inline-flex;
  margin-right: var(--sp-2);
}

/* ---------- 字段行（键值对）---------- */
.kv {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 80rpx;
  padding: var(--sp-2) 0;
  border-bottom: 1rpx solid var(--line-2);
}

.kv:last-child,
.kv:last-of-type {
  border-bottom: none;
}

.kv-k {
  font-size: var(--fs-body);
  color: var(--ink-2);
  flex: none;
  padding-right: var(--sp-2);
}

.kv-v {
  font-size: var(--fs-body);
  color: var(--ink);
  text-align: right;
}

/* ---------- 进度：一横一竖两个共同件 ---------- */
/* 横条说「走到哪了」，环说「几比几」。两个都做，别只做一个 */
.meter {
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--line);
  overflow: hidden;
}

.meter-fill {
  height: 100%;
  border-radius: 4rpx;
  background: var(--ink);
  transition: width var(--t-move) var(--ease);
}

/* 环：纯 CSS 锥形渐变，不引 canvas、不带图片资源 */
.ring {
  position: relative;
  flex: none;
}

.ring-track,
.ring-fill {
  position: absolute;
  inset: 0;
  border-radius: 50%;
}

.ring-track {
  background: var(--line);
}

.ring-fill {
  background: conic-gradient(var(--ink) calc(var(--p) * 1%), transparent 0);
  transition: background var(--t-move) var(--ease);
}

.ring::after {
  content: "";
  position: absolute;
  inset: 13%;
  border-radius: 50%;
  background: var(--surface);
  border: 1rpx solid var(--line);
}

.ring-text {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-num);
  font-weight: 600;
  color: var(--ink);
  z-index: 1;
}

/* ---------- 未登录的那张卡 ---------- */
/* 门禁卡在 14 个页面里各有一份，长相必须是同一个 —— 用户才会认得出
   「这是同一道门」，而不是每页一套说法。

   参考图里没有这种卡，但它的语言是有的：一块白底、一枚圆标、
   一句人话、一个墨黑的主按钮。这一版就按这个来 —— 去掉渐变与印泥色。 */
.lock-card {
  text-align: center;
  padding: var(--sp-6) var(--sp-4) var(--sp-4);
  background: var(--surface);
  overflow: hidden;
  position: relative;
}

.lock-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  line-height: 1;
  margin: 0 auto var(--sp-3);
  border-radius: 50%;
  background: var(--ink);
  font-family: var(--font-poem);
  font-size: 54rpx;
  color: var(--on-ink);
}

.lock-title {
  display: block;
  font-size: var(--fs-lead);
  font-weight: 700;
  color: var(--ink);
  font-family: var(--font-poem);
  letter-spacing: var(--ls-title);
}

.lock-note {
  display: block;
  margin-top: var(--sp-2);
  text-align: left;
  line-height: var(--lh-loose);
}

.lock-btn {
  margin-top: var(--sp-4);
}

.lock-foot {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-caption);
  color: var(--ink-3);
  letter-spacing: var(--ls-caption);
  margin-top: var(--sp-3);
}

/* ---------- 方字格（飞花令的令字）----------
   一个方格 + 一个字 + 一个原生 radio。两处用到（大会首页、飞花令页），
   所以收在这里定一次。

   ⚠️ 上一版把圆点 absolute 到 `right:-6rpx; top:-6rpx`，理由是「中心留给字」——
   结果圆点**压在字的右上一笔上**：「而」「者」「有」的右上角被盖住半个，
   而且缩到 0.6 之后命中区也移了位，点上去要先对准那个偏出去的小圈。

   现在的做法：格子右上角**留出一块空**（padding-top 让字整体下移一点），
   圆点就落在那块空里，不压任何笔画；命中区仍是整个 label（原生 radio
   在 label 里，点格子任何一处都能选中）。 */
.char {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--line-strong);
  background: var(--surface);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  /* 上下各留一口气：上一版是「整块居中」，
     字 + 小字两行合起来比格子高，贴到了上下边框上 */
  padding: 10rpx 0;
  box-sizing: border-box;
}

.char.active {
  background: var(--ink);
  border-color: var(--ink);
}

/* 令字格里**不再画一个圆点**。
   上一版是 absolute 到右上角、缩到 0.56 的原生圆点：小到看不出能点、
   还压在「而」「者」「有」的笔画上，缩过头之后命中区也跟着偏出格子。
   选中态由格子自己的「底色 + 描边 + 字变色」来说明白，够了。
   radio 仍在 label 里（.seg-radio 视觉隐藏），点格子任何一处都选中。 */

.char-t {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-hero);
  color: var(--ink);
  line-height: 1.1;
}

/* 那一行小字（命中数）：它比字低一档，且不许把格子撑高 ——
   给一条固定行高，格子高度才不会随数字位数变 */
.char-n {
  display: block;
  height: 26rpx;
  font-size: var(--fs-pinyin);
  line-height: 26rpx;
  color: var(--ink-4);
}

.char.active .char-t {
  color: var(--on-ink);
}

.char.active .char-n {
  color: var(--on-ink);
  opacity: .6;
}

/* ============================================================
   垂直居中的一条总口径
   ============================================================ */
/* 小程序里「一行里的东西对不齐」几乎只有两个原因：

   1. 用了 `line-height: <比 height 小几 rpx>` 去凑居中 —— 那不是居中，
      是把偏差摊到每一行文字上，字号一换就露
   2. 靠 `align-items: baseline` 排「文字 + 控件」那一行 ——
      缩放过的原生控件基线不在视觉中心，字就跟着偏

   所以这里只给一件事：**行内元素一律走 flex + center**。
   下面这两个选择器覆盖了「一行文字 + 一个原生控件」的全部场景，页面不用再写。 */

.row,
.kv,
.native-label,
.pref-item,
.opt-row,
.field,
.search,
.pager {
  align-items: center;
}

/* 数字与计数的字宽统一：等宽数字让「几比几」不会随数字变化左右跳 */
.count-num,
.mastery-num,
.ring-text,
.num-v,
.grant-meter-t,
.day-count,
.stage-count,
.exam-progress,
.exam-timer,
.stat-v {
  font-variant-numeric: tabular-nums;
}

/* ---------- 底部安全区垫片 ---------- */
.safe-bottom {
  height: calc(24rpx + env(safe-area-inset-bottom));
}

/* 页脚一句：给整屏一个收束，不然最后一张卡下面像被切断 */
.foot {
  text-align: center;
  padding: var(--sp-1) 0 var(--sp-5);
}

.foot .hint {
  letter-spacing: 1rpx;
}

/* ============================================================
   分段控件（「二选一 / 三选一」的统一长相）
   ============================================================ */
/* 「在哪儿搜」「怎么搜」「左对齐还是居中」「注不注音」——这些都是**互斥的
   少数几个选项**。原来的写法是一排原生单选框：一个空心圆圈 + 两个字。
   圆圈本身没问题（它确实是原生控件），问题是**它不适合这种场合**：

   1. 圆圈与文字挤在一行，两个选项就占掉半屏，一行放不下三个；
   2. 选中态只有「圈里多一个点」，对比度很低，扫不出来；
   3. 「范围」与「方式」两组各排一行圆点，看着像同一组里的六个选项。

   分段控件把「选一个」画成一颗胶囊：选中的那段填墨黑。
   一眼看得出「这组里有几个选项、我选了第几个」。

   底层**仍是原生 radio**：包在 <label> 里、被视觉隐藏。
   点整段就能选中、读屏读得到、键盘走得了 —— 行为全是平台的，
   我们只是换了一张脸。 */
.seg {
  display: flex;
  align-items: center;
}

.seg-group {
  display: flex;
  align-items: stretch;
  border: 1rpx solid transparent;
  border-radius: var(--radius-pill);
  background: var(--sink);
  padding: 4rpx;
  overflow: hidden;
}

/* 一排里只有两段时给它撑满，不然两小段并排看着像被挤在角落 */
.seg.fill .seg-group {
  flex: 1;
}

.seg.fill .seg-item {
  flex: 1;
  justify-content: center;
}

.seg-item {
  position: relative;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 0 22rpx;
  height: 56rpx;
  border-radius: var(--radius-pill);
  transition: background-color var(--t-press), color var(--t-press);
}

/* 选中态**填成墨黑**。只把字变色太轻 —— 一层浅灰底上扫不出选中了哪一段 */
.seg-item.on {
  background: var(--ink);
}

.seg-item.on .seg-text {
  color: var(--on-ink);
  font-weight: 600;
}

/* 图标靠 --ic 取色，选中时整块换成白色 */
.seg-item.on .seg-icon,
.seg-item.on .seg-icon::before,
.seg-item.on .seg-icon::after {
  --ic: var(--on-ink);
}

/* 原生 radio 只留行为、不留外观。
   不用 display:none —— 那会让部分机型的读屏也读不到这一项 */
.seg-radio {
  position: absolute;
  width: 1rpx;
  height: 1rpx;
  opacity: 0;
  pointer-events: none;
}

.seg-text {
  font-size: var(--fs-caption);
  color: var(--ink-2);
  letter-spacing: 1rpx;
  white-space: nowrap;
}

.seg-item.on .seg-text {
  letter-spacing: 1rpx;
}

/* ---------- 等长选项的格子 ----------
   年级（12 个）、学期（2 个）、每日首数（5 个）、题型（5 个）这类：
   选项等长、数量不少，排成网格比排成一列省一半高度。
   每一格是一个胶囊 —— 形状本身说「这是个能点的选项」，填色说「选的是它」。

   为什么不给每格配一个原生圆点/方框：它吃掉横向空间（12 个年级就得多一列），
   还跟第一行文字对齐、第二行缩进，看着像它只管辖半格。
   格子排成矩阵这件事，已经把「一组、选一个（或几个）」说清楚了。 */
.chip-group {
  display: grid;
  gap: var(--sp-1) var(--sp-1);
}

.chip-group.cols-2 {
  grid-template-columns: repeat(2, 1fr);
}

.chip-group.cols-3 {
  grid-template-columns: repeat(3, 1fr);
}

.chip-group.cols-4 {
  grid-template-columns: repeat(4, 1fr);
}

.chip {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  padding: 0 var(--sp-1);
  border: 1rpx solid transparent;
  border-radius: var(--radius-sm);
  background: var(--sink);
  transition: background-color var(--t-press), border-color var(--t-press);
}

.chip.on {
  background: var(--ink);
  border-color: var(--ink);
}

.chip-t {
  font-size: var(--fs-hint);
  color: var(--ink-2);
  line-height: 1.3;
  text-align: center;
}

.chip.on .chip-t {
  color: var(--on-ink);
  font-weight: 600;
}

/* 多选的格子：形状与单选的一样，但**选中态多一个勾** ——
   单选和多选在一屏里同时出现时（题库：范围是单选、题型是多选），
   光看填色分不出来哪个是哪个。那一勾就是「可以多选」的唯一线索，
   所以它必须画出来，不能省。

   勾用两条边框拼（右下角一道 45° 的短折线），不引图标字体。 */
/* 一勾两态：**没选中也要看得见**，否则「这里可以多选」就只在选中后才存在。
   未选中给一个空心方框，选中换成实心的勾 —— 与原生复选框的语义一致，
   只是不再站到选项前面去占地方。 */
.chip.multi::after {
  content: "";
  position: absolute;
  right: 12rpx;
  top: 12rpx;
  width: 14rpx;
  height: 14rpx;
  border: 2rpx solid var(--ink-4);
  border-radius: 3rpx;
}

.chip.multi.on::after {
  width: 16rpx;
  height: 9rpx;
  border: none;
  border-left: 4rpx solid var(--on-ink);
  border-bottom: 4rpx solid var(--on-ink);
  border-radius: 0;
  transform: rotate(-45deg);
}

.chip.multi.on::after {
  border-color: var(--on-ink);
}

/* 小号：一章里连着两组（搜索页）时用，别把卡片撑高 */
.seg-item.mini {
  height: 48rpx;
  padding: 0 16rpx;
}

.seg + .field-label,
.field-label + .seg {
  margin-top: var(--sp-1);
}

/* ---------- 图标：全用 CSS 画 ----------
   一组图标只是为了说「这是哪一个选项」，不值得引图片资源 ——
   主包余量不多。三种笔画足够画出这几个意思。 */
.seg-icon {
  position: relative;
  flex: none;
  width: 26rpx;
  height: 26rpx;
  --ic: var(--ink-2);
}

.seg-icon::before,
.seg-icon::after {
  content: "";
  position: absolute;
  background: var(--ic);
}

/* 左对齐：三道线左端齐、长短不一 */
.ic-left::before {
  left: 0;
  top: 3rpx;
  width: 26rpx;
  height: 3rpx;
  box-shadow: 0 8rpx 0 var(--ic), 0 16rpx 0 var(--ic);
}

.ic-left::after {
  left: 0;
  top: 3rpx;
  width: 15rpx;
  height: 3rpx;
}

/* 居中：三道线都居中、长短不一 */
.ic-center::before {
  left: 0;
  top: 3rpx;
  width: 26rpx;
  height: 3rpx;
  box-shadow: 0 8rpx 0 var(--ic), 0 16rpx 0 var(--ic);
}

.ic-center::after {
  left: 5rpx;
  top: 3rpx;
  width: 15rpx;
  height: 3rpx;
}

/* 不注音：一道斜杠划掉一个圆 */
.ic-off::before {
  left: 3rpx;
  top: 3rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: transparent;
  border: 3rpx solid var(--ic);
}

.ic-off::after {
  left: 1rpx;
  top: 11rpx;
  width: 24rpx;
  height: 3rpx;
  transform: rotate(-45deg);
}

/* 生字：一个字 + 头上一点（「只标几个字」，那一点就是标记） */
.ic-rare::before {
  left: 8rpx;
  top: 9rpx;
  width: 15rpx;
  height: 15rpx;
  border: 3rpx solid var(--ic);
  background: transparent;
}

.ic-rare::after {
  left: 11rpx;
  top: 2rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--ic);
}

/* 全文：三组「字 + 小点」横着排 */
.ic-all::before {
  left: 0;
  top: 4rpx;
  width: 7rpx;
  height: 7rpx;
  background: var(--ic);
  box-shadow: 10rpx 0 0 var(--ic), 20rpx 0 0 var(--ic);
}

.ic-all::after {
  left: 0;
  top: 14rpx;
  width: 26rpx;
  height: 3rpx;
  background: var(--ic);
}

/* 全站 / 课内：地球（圆 + 一道纬线）与 一册书（两页） */
.ic-all-site::before {
  left: 2rpx;
  top: 2rpx;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: transparent;
  border: 3rpx solid var(--ic);
}

.ic-all-site::after {
  left: 2rpx;
  top: 11rpx;
  width: 22rpx;
  height: 3rpx;
}

.ic-course::before {
  left: 1rpx;
  top: 3rpx;
  width: 24rpx;
  height: 20rpx;
  border: 3rpx solid var(--ic);
  background: transparent;
  border-radius: 2rpx;
}

.ic-course::after {
  left: 12rpx;
  top: 4rpx;
  width: 3rpx;
  height: 18rpx;
}

/* 篇名作者 / 正文全文：一行字 与 一整页字 */
.ic-title::before {
  left: 0;
  top: 5rpx;
  width: 26rpx;
  height: 4rpx;
  border-radius: 2rpx;
  box-shadow: 0 9rpx 0 var(--ic), 0 18rpx 0 var(--ic);
}

.ic-full::before {
  left: 0;
  top: 4rpx;
  width: 12rpx;
  height: 3rpx;
  box-shadow: 0 7rpx 0 var(--ic), 0 14rpx 0 var(--ic), 0 21rpx 0 var(--ic);
}

.ic-full::after {
  left: 15rpx;
  top: 4rpx;
  width: 11rpx;
  height: 3rpx;
  box-shadow: 0 7rpx 0 var(--ic), 0 14rpx 0 var(--ic), 0 21rpx 0 var(--ic);
}

/* ============================================================
   分段标题（一屏里分隔两组卡片的那行小字）
   ============================================================ */
/* 参考图里「卡片与数据 / 按钮与页签 / 输入、标签与状态」各是一枚浅灰胶囊，
   独立于上下卡片，说明「下面这组是什么」。它比 card-title 轻，且不占卡片。 */
.section-label {
  display: inline-flex;
  align-items: center;
  font-size: var(--fs-caption);
  color: var(--ink-2);
  letter-spacing: var(--ls-caption);
  background: var(--sink);
  border-radius: var(--radius-pill);
  padding: 8rpx 22rpx;
  margin: var(--sp-2) 0 var(--sp-2);
}
