@import "styles/tokens.wxss";

/* ---------- 排版 ---------- */
page {
  box-sizing: border-box;
}

view, text, button, input, textarea {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
}

/* ---------- 卡片 ---------- */
.card {
  background: var(--card);
  border: 1rpx solid var(--line-2);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 8rpx;
}

/* 卡片小标题带一道左侧短竖线：一屏几张卡时，视线有个落脚点，
   不用靠字号比大小去猜哪一行是标题 */
.card-title.bar {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: var(--green);
  margin-bottom: 16rpx;
}

.card-title.bar::before {
  content: "";
  width: 6rpx;
  height: 26rpx;
  border-radius: 3rpx;
  background: var(--green);
  margin-right: 12rpx;
}

.hint {
  font-size: 25rpx;
  color: var(--ink-3);
  line-height: 1.7;
}

.sub-title {
  display: block;
  font-size: 26rpx;
  color: var(--ink-2);
  margin: 20rpx 0 8rpx;
}

.empty {
  padding: 80rpx 0;
  text-align: center;
  color: var(--ink-3);
  font-size: 28rpx;
}

/* 空状态：一枚淡印章 + 一句人话。
   有出处的「没有」比一个孤零零的方块让人安心 —— 用户知道是真没有，不是没加载出来 */
.empty-mark {
  display: block;
  width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  margin: 0 auto 20rpx;
  border-radius: 50%;
  border: 2rpx solid var(--line-2);
  background: var(--bg-soft);
  font-family: var(--font-poem);
  font-size: 44rpx;
  color: var(--line);
}

.empty-text {
  display: block;
  line-height: 1.8;
}

/* ---------- 按钮 ---------- */
.btn {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 32rpx;
  border-radius: var(--radius-sm);
  background: var(--bg-soft);
  border: 1rpx solid var(--line);
  color: var(--ink);
  font-size: 30rpx;
  text-align: center;
  transition: background-color .1s;
}

.btn::after {
  border: none;
}

.btn.primary {
  background: var(--green);
  border-color: var(--green);
  color: #fff;
}

/* 主按钮按下时压深一档，不然同色相邻时会显得「没点着」 */
.btn.primary.button-hover {
  background: var(--green-dark);
  border-color: var(--green-dark);
}

.btn.ghost {
  background: transparent;
  color: var(--ink-2);
}

.btn.danger {
  color: var(--red);
  border-color: #ecd2cd;
  background: #fbeae7;
}

.btn.block {
  width: 100%;
}

.btn.block + .btn.block {
  margin-top: 16rpx;
}

/* 瘦身版：搜索键、索引开关、名录改档这种「一行里的小按钮」都走它。
   原生 button 自带最小宽度与默认内边距，不收掉就撑得整行走形。 */
.btn.mini {
  display: inline-block;
  width: auto;
  min-width: 0;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
}

.btn[disabled] {
  opacity: .5;
}

/* ---------- 列表行 ---------- */
/* 行是导航不是按钮，所以用 hover-class 借原生触碰反馈，不套一层 button */
.row-hover {
  background: var(--green-light);
}

.row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line-2);
}

.row:last-child {
  border-bottom: none;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-title {
  font-family: var(--font-poem);
  font-size: 32rpx;
  color: var(--ink);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-sub {
  font-size: 24rpx;
  color: var(--ink-3);
  margin-top: 6rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-go {
  color: var(--line);
  font-size: 32rpx;
  padding-left: 16rpx;
}

/* ---------- 标签 ---------- */
.tag {
  display: inline-block;
  font-size: 22rpx;
  line-height: 1.5;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  color: var(--green);
  background: var(--green-light);
  margin-right: 10rpx;
}

.tag.amber {
  color: var(--amber);
  background: var(--amber-light);
}

.tag.red {
  color: var(--red);
  background: var(--red-light);
}

.tag.blue {
  color: var(--blue);
  background: var(--blue-light);
}

.tag.ghost {
  color: var(--ink-3);
  background: var(--line-2);
}

/* ---------- 搜索框 ---------- */
.search {
  display: flex;
  align-items: center;
  background: var(--bg-soft);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  padding: 0 20rpx;
  height: 76rpx;
}

.search-icon {
  color: var(--ink-3);
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search input {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
}

/* ---------- 文本输入（后端地址这类）---------- */
/* 输入框一律用原生 <input>，样式只统一尺寸与配色 —— 外观改不到它内部，
   这点必须承认，所以只给边框与圆角 */
.field {
  display: flex;
  align-items: center;
  background: var(--bg-soft);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  padding: 0 20rpx;
  height: 76rpx;
  margin: 12rpx 0;
}

.field-input {
  flex: 1;
  font-size: 26rpx;
  color: var(--ink);
}

/* ---------- 小程序自有控件的统一口径 ----------
   这一节是「控件用系统的、配色用跬步的」这句话的落点。
   开关 / 单选 / 多选 / 滑动条 / 选择器 / 按钮全部走小程序自带控件：
   行为、无障碍、键盘与读屏由平台保证，我们只负责把它们染成宋代那套颜色。

   原生控件的交互色只能通过组件属性给（color / activeColor / selected-color），
   属性在 WXML 里写；样式表这边只统一尺寸、圆角、字体与间距 ——
   想靠 WXSS 改原生控件的内部结构是不被支持的，所以这里一行都不敢越界。 */

/* 原生的 checkbox / radio 默认 23px 见方，比正文小、点着费劲；
   横向缩放不改它自身尺寸，只放大外观 —— 命中区仍是原生的一整行，所以点着反而更宽松 */
.native-group {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 20rpx;
}

.native-group.column {
  flex-direction: column;
  gap: 0;
}

.native-label {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  font-size: 29rpx;
  color: var(--ink);
}

/* ---------- 单选行（档位、算法这种「选一个」的选择） ----------
   行本身是 label[for]，点整行都能选中，不用把手指对准那个小圆点。 */
.opt-group {
  display: flex;
  flex-wrap: wrap;
}

.opt-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line-2);
}

.opt-row:last-of-type {
  border-bottom: none;
}

.opt-row.locked {
  opacity: .45;
}

.opt-row radio,
.opt-row checkbox {
  transform: scale(.86);
}

.opt-main {
  flex: 1;
  min-width: 0;
  padding-left: 8rpx;
}

.opt-name {
  display: block;
  font-size: 31rpx;
  color: var(--ink);
}

.opt-row.active .opt-name {
  color: var(--green);
  font-weight: 600;
}

.opt-desc {
  display: block;
  font-size: 23rpx;
  color: var(--ink-3);
  margin-top: 6rpx;
  line-height: 1.6;
}

/* 横排的单选项（范围、模式、筛选这种一行放得下的） */
.pref-item {
  display: flex;
  align-items: center;
  font-size: 27rpx;
  color: var(--ink-2);
  padding-right: 20rpx;
}

.pref-item radio {
  transform: scale(.8);
}

/* ---------- 未登录的那张卡 ---------- */
/* 门禁卡在 14 个页面里各有一份，长相必须是同一个 —— 用户才会认得出
   「这是同一道门」，而不是每页一套说法。 */
.lock-card {
  text-align: center;
  padding: 56rpx 28rpx;
  background: linear-gradient(165deg, #fffefb 0%, var(--bg-soft) 100%);
}

.lock-mark {
  display: block;
  width: 108rpx;
  height: 108rpx;
  line-height: 104rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  border: 2rpx solid var(--line);
  background: #fffefb;
  font-family: var(--font-poem);
  font-size: 48rpx;
  color: var(--green);
}

.lock-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--green);
  font-family: var(--font-poem);
}

.lock-note {
  display: block;
  margin-top: 16rpx;
  text-align: left;
  line-height: 1.85;
}

.lock-btn {
  margin-top: 32rpx;
}

/* ---------- 底部安全区垫片 ---------- */
.safe-bottom {
  height: calc(24rpx + env(safe-area-inset-bottom));
}
