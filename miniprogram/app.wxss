@import "styles/tokens.wxss";

/* ============================================================
   基座
   页面样式表只管「这一页长什么样」，凡是两页以上都要写的东西，
   一律收在这里。收不住的后果不是难看，是**不一致** ——
   用户说不清哪里别扭，只觉得「一塌糊涂」。

   这一版的层次只有三样：**留白、字重、一道极淡的线**。
   底色是白的、卡片也是白的，靠间隙与描边分开。
   ============================================================ */

view, text, button, input, textarea {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: var(--sp-3) var(--page-x) calc(24rpx + env(safe-area-inset-bottom));
}

/* 自绘底栏是 fixed 的，不吃平台的安全区与点击区 —— 有底栏的页面
   要自己留出「底栏高度 + 安全区」，否则最后一行被压在底栏下面。
   （原生 tabBar 会由平台自动避让，自绘就得自己来，V21 守着。） */
.page.has-tabbar {
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* 有底栏的页面上，页内那个 .safe-bottom 垫片是**多余的** ——
   .has-tabbar 的底部内边距已经含了安全区与底栏高度，
   再垫一层就是 24rpx 的空白，最后一行离底栏远了半指。 */
.page.has-tabbar .safe-bottom {
  display: none;
}

/* ---------- 页头 ----------
   一屏的入口，回答「我在哪、这里有什么」。
   参考图里那一屏最上面是一行小字标签 + 一个标题，没有别的装饰 ——
   所以这里也不留底色、不留横线，只有字。

   ⚠️ 页头的大标题不许等于导航栏标题（同屏两行一样的字等于没说）——
   自检里有断言守着。 */
.page-head {
  padding: var(--sp-2) var(--sp-1) var(--sp-4);
}

.head-title {
  display: block;
  font-size: var(--fs-head);
  font-weight: 700;
  color: var(--ink);
  letter-spacing: var(--ls-title);
  line-height: var(--lh-tight);
}

/* 页头这里**是界面在说话**：「今天背什么」「课外阅读」「十七部集子」——
   它和卡片里的篇名（咏鹅 / 将进酒）会同时出现在一屏里。
   篇名走宋体是内容需求，页头若也走宋体，两处就会撞成同一种「雅」，
   反而分不出哪个是书、哪个是书架。所以页头一律黑体，宋体只给诗文。 */
.head-title.poem {
  font-family: var(--font-poem);
}


.head-sub {
  display: block;
  font-size: var(--fs-hint);
  color: var(--ink-3);
  letter-spacing: var(--ls-caption);
  margin-top: var(--sp-2);
}

/* ---------- 卡片 ----------
   白底 + 一道极淡的描边，**没有投影**。
   分层靠「描边 + 留白」这两样，够用了。

   投影是刻意去掉的，不是漏了：卡与卡之间只有 --sp-3（24rpx）的缝，
   而投影的模糊半径就有 6rpx，一条缝被两侧的投影共同铺满，
   在浅灰底上会显成一条两头深、中间浅的横带（实测 236 → 245 → 236）。
   首页自上而下七八张卡，就是七八条这样的带子 —— 看着像渲染坏了。
   详见 tokens.wxss 里 --shadow 的注释。 */
.card {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: var(--sp-4);
  margin-bottom: var(--sp-3);
}

/* 带页头的一屏：第一张卡与页头贴紧一点，不然顶部空一块 */
.page-head + .card {
  margin-top: 0;
}

.card-title {
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--ink);
  margin-bottom: var(--sp-1);
}

/* 卡片小标题：不加竖线、不加色 —— 参考图里的小标题就是一行黑字，
   它靠位置（在卡片最上面）和字重说明自己是标题，不靠装饰。 */
.card-title.bar {
  display: flex;
  align-items: center;
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--ink);
  margin-bottom: var(--sp-2);
}

.hint {
  font-size: var(--fs-hint);
  color: var(--ink-3);
  line-height: var(--lh-body);
}

.count-line {
  display: block;
  padding-top: var(--sp-2);
  font-size: var(--fs-hint);
  color: var(--ink-3);
}

.sub-title {
  display: block;
  font-size: var(--fs-hint);
  color: var(--ink-2);
  margin: var(--sp-3) 0 var(--sp-1);
}

/* ---------- 字段名 ----------
   一张卡里「这一行是什么」那半截字的统一样子。它比 card-title 轻、
   比正文小，因为它不是内容，是标签。

   之前散成四份：搜索页的 .opt-label、飞花令的 .opt-label、
   搜索页的 .section-label、阅读设置里裸写的 .sub-title ——
   四份的字号差 3rpx、颜色一个 ink-2 一个 ink-3，一页里同时出现就露馅。
   现在只有这一处。 */
.field-label {
  display: block;
  font-size: var(--fs-hint);
  color: var(--ink-3);
  letter-spacing: var(--ls-caption);
  line-height: 1.4;
  margin-bottom: 4rpx;
}

/* 一条淡分隔，比 border 更轻，用在「同一张卡里换话题」的地方 */
.divider {
  height: 1rpx;
  background: var(--line-2);
  margin: var(--sp-3) 0;
}

/* ---------- 空状态 ----------
   一枚淡印章 + 一句人话 + 一个下一步。
   有出处的「没有」比一个孤零零的方块让人安心 —— 用户知道是真没有，
   不是没加载出来。 */
.empty {
  padding: var(--sp-6) var(--sp-3) var(--sp-5);
  text-align: center;
}

/* 印章：一枚圆里放一个字。居中也走 flex —— 用「line-height 比 height
   小 4rpx」去凑是同一个坏习惯，圆环一粗就偏，且偏在哪一侧每台机子不一样 */
.empty-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  margin: 0 auto var(--sp-2);
  border-radius: 50%;
  background: var(--sink);
  font-family: var(--font-poem);
  font-size: 46rpx;
  line-height: 1;
  color: var(--ink-4);
}

.empty-text {
  display: block;
  font-size: var(--fs-title);
  color: var(--ink-2);
  line-height: var(--lh-loose);
}

.empty-tip {
  display: block;
  margin-top: var(--sp-1);
}

/* ---------- 按钮 ----------
   三种：**实心墨黑**（一屏的正事）、**白底描边**（并列的另一件事）、
   **纯文字**（最轻的一档，用于行内小动作）。

   按钮文字**垂直居中**靠的是「内容盒 + align-items」，
   不是把 line-height 调成比 height 小几 rpx 去凑 —— 那种写法在字重、
   字号、系统字体任意一个变了之后就会偏，且各页偏的方向还不一样。
   原生 button 默认是 inline-block + 默认行高，这里统一改成 flex 居中。 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: var(--h-btn);
  padding: 0 var(--sp-4);
  /* 按钮与选项格**同一档圆角**。上一版这里写的是 --radius-pill（999rpx）——
     高 96rpx 的按钮配 999rpx，渲染出来就是一根胶囊；
     而同一屏里 76rpx 的选项格是 16rpx 的近直角。
     两种圆角、两种「是不是控件」的说法，用户看到的「不统一」就是它。
     现在全站只有两种控件长相（见文件末「两条长相」一节）。 */
  border-radius: var(--radius-ctl);
  background: var(--surface);
  border: 1rpx solid var(--line-strong);
  color: var(--ink);
  font-size: var(--fs-title);
  font-weight: 500;
  line-height: 1.2;
  letter-spacing: var(--ls-title);
  text-align: center;
  transition: background-color var(--t-press), transform var(--t-press), opacity var(--t-press);
}

.btn::after {
  border: none;
}

/* 一屏的正事：一块干净的墨黑。
   参考图里「手机号快捷注册 / 新增档期」就是这一块 —— 全屏只有它一个。 */
.btn.primary {
  background: var(--ink);
  border-color: var(--ink);
  color: var(--on-ink);
  font-weight: 600;
}

/* 主按钮按下时压深一档、再缩一点，不然同色相邻时会显得「没点着」 */
.btn.primary.button-hover {
  background: var(--ink-strong);
  border-color: var(--ink-strong);
  opacity: .92;
  transform: scale(.985);
}

.btn.ghost {
  background: transparent;
  color: var(--ink-2);
  border-color: var(--line-strong);
}

.btn.danger {
  color: var(--red);
  border-color: var(--red-edge);
  background: var(--red-soft);
}

.btn.block {
  width: 100%;
}

.btn.block + .btn.block {
  margin-top: var(--sp-2);
}

/* 一排并列的按钮（「说一句 / 接不上了」「试听 / 保存」这种）。
   两件事必须一起写：**flex 平分宽度** 与 **align-items: center**。
   少了后者，flex 的默认 stretch 遇上 .btn 的固定 height 会退化成基线对齐 ——
   同一排里主按钮与次要按钮**顶部齐、底部不齐**，看着像一个大一个小。
   两个页面各写过一份，现在收在这里。 */
.actions {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  margin-top: var(--sp-3);
}

.actions .btn {
  flex: 1;
}

/* 瘦身版：搜索键、索引开关、名录改档这种「一行里的小按钮」都走它。
   原生 button 自带最小宽度与默认内边距，不收掉就撑得整行走形。 */
.btn.mini {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-width: 0;
  height: var(--h-btn-mini);
  padding: 0 var(--sp-3);
  font-size: var(--fs-hint);
  line-height: 1.2;
  border-radius: var(--radius-pill);
}

.btn[disabled] {
  opacity: .4;
  box-shadow: none;
}

.btn.button-hover {
  opacity: .86;
  transform: scale(.985);
}

/* ---------- 列表行 ----------
   行是导航不是按钮，所以用 hover-class 借原生触碰反馈，不套一层 button。
   参考图的列表行是「左图标 + 标题/副题 + 右箭头」，行高很松 ——
   一屏五六行就排满了，这是刻意的：手机上一行认不出是什么，点错比点慢更糟。 */
.row-hover {
  background: var(--sink);
}

.row {
  display: flex;
  align-items: center;
  min-height: var(--h-row);
  padding: var(--sp-2) 0;
  border-bottom: 1rpx solid var(--line-2);
  border-radius: var(--radius-sm);
  transition: background-color var(--t-press);
}

.row:last-child {
  border-bottom: none;
}

.row-main {
  flex: 1;
  min-width: 0;
}

/* 列表行的标题。**它不一定是篇名** —— 我的页的「背诵设置」、
   关于页的「用户协议」走的也是这个类，这些是界面功能名，不是诗词名。
   所以这里取 UI 字体；篇名另走 .row-poem（见下），别让宋体漫出来。 */
.row-title {
  font-family: var(--font-ui);
  font-size: var(--fs-title);
  color: var(--ink);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 列表里的**篇名**：宋体只给这一类。咏鹅 / 江南 / 画 是诗词名，
   「意见反馈」「清空本机数据」不是 —— 同一张卡上两种字混排是最扎眼的那种不一致。 */
.row-poem {
  font-family: var(--font-poem);
}

.row-sub {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 6rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 行尾那个 ›：压低饱和度，它是提示不是内容 */
.row-go {
  color: var(--ink-4);
  font-size: 32rpx;
  padding-left: var(--sp-2);
  line-height: 1;
  flex: none;
}

/* 行首图标底：参考图里每行左边有一个浅色小方块（一个 emoji / 一个符号）。
   用 CSS 画一个圆角浅底，里面放一个字 —— 不引图片资源。 */
.row-icon {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  margin-right: var(--sp-3);
  border-radius: var(--radius-sm);
  background: var(--sink);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  line-height: 1;
  color: var(--ink-2);
}

/* ---------- 标签 ----------
   胶囊，浅底，小字。参考图里的「成功 / 提醒 / 错误」三个圆点标签就是这个尺寸。 */
.tag {
  display: inline-flex;
  align-items: center;
  font-size: var(--fs-caption);
  line-height: 1.5;
  /* 与选项格同一套内边距口径：上下 --pad-opt-y、左右 --pad-opt-x。
     标签比格子小一号（它没 min-height，是给文字当底），
     但那两条边的比例是一样的 —— 一屏里标签与格子挨着时，
     这一条决定它们是「同一套东西的两个尺寸」还是「两家人的东西」。 */
  padding: var(--pad-opt-y) var(--pad-opt-x);
  border-radius: var(--radius-pill);
  color: var(--ink-2);
  background: var(--sink);
  margin-right: 10rpx;
}

.tag.amber {
  color: var(--amber);
  background: var(--amber-soft);
}

.tag.red {
  color: var(--red);
  background: var(--red-soft);
}

.tag.blue {
  color: var(--blue);
  background: var(--blue-soft);
}

.tag.green {
  color: var(--green);
  background: var(--green-soft);
}

.tag.ghost {
  color: var(--ink-3);
  background: var(--sink);
}

/* ---------- 搜索框 ----------
   参考图的输入框是「浅底 + 无描边 + 胶囊」：它比页面底深一点点，
   所以看得出是可输入的，又不会因为一道黑边而抢戏。 */
.search {
  display: flex;
  align-items: center;
  background: var(--sink);
  border: 1rpx solid transparent;
  border-radius: var(--radius-pill);
  padding: 0 var(--sp-4);
  height: var(--h-field);
  margin-bottom: var(--sp-2);
}

.search-icon {
  color: var(--ink-3);
  font-size: var(--fs-body);
  margin-right: 12rpx;
}

.search input {
  flex: 1;
  font-size: var(--fs-body);
  color: var(--ink);
}

/* ---------- 文本输入（后端地址这类）---------- */
/* 输入框一律用原生 <input>，样式只统一尺寸与配色 —— 外观改不到它内部，
   这点必须承认，所以只给边框与圆角 */
.field {
  display: flex;
  align-items: center;
  background: var(--sink);
  border: 1rpx solid transparent;
  border-radius: var(--radius-block);
  padding: 0 var(--sp-4);
  height: var(--h-field);
  margin: var(--sp-2) 0;
}

.field-input {
  flex: 1;
  font-size: var(--fs-body);
  color: var(--ink);
}

/* ============================================================
   统计大数字（参考图里最抓眼的一组）
   ============================================================ */
/* 三列并排，每列一个很大的数字 + 一行小标签，中间一道细竖线。

   为什么值得做成共用件：它是参考图里**唯一**一处靠「大」来表达重点的地方。
   上一版表达重点靠的是颜色（主色卡、金边、印章），一屏里好几处在喊，
   结果谁也没被听见。大数字不一样 —— 一屏只有一组，且不用颜色。 */
.stats {
  display: flex;
  align-items: stretch;
}

.stat {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--sp-2) 0;
}

.stat + .stat {
  border-left: 1rpx solid var(--line);
}

.stat-v {
  font-family: var(--font-num);
  font-size: var(--fs-stat);
  font-weight: 600;
  color: var(--ink);
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
  letter-spacing: -1rpx;
}

.stat-k {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: var(--sp-1);
  letter-spacing: var(--ls-caption);
}

/* ============================================================
   小程序自有控件的统一口径
   ============================================================ */
/* 这一节是「控件用系统的、配色用这一版的」这句话的落点。
   开关 / 单选 / 多选 / 滑动条 / 选择器 / 按钮全部走小程序自带控件：
   行为、无障碍、键盘与读屏由平台保证，我们只负责把它们染成这一版的样子。

   原生控件的交互色只能通过组件属性给（color / activeColor / selected-color），
   属性在 WXML 里写；样式表这边只统一尺寸、圆角、字体与间距 ——
   想靠 WXSS 改原生控件的内部结构是不被支持的，所以这里一行都不敢越界。

   ## 「选一个」只有一套长相

   Issue #12 前后反复栽在这里：同一屏里并存过**四种**说法 ——
   圆点（原生 radio）、一道左侧竖线、填色的底、填色的格子。
   四种都在说「这几个里选一个」，用户的原话是「选项也不统一」。

   现在收敛成一套，只有两种排布：

   | 排布 | 用在哪 | 类 |
   |---|---|---|
   | **横排分段**：合成一颗胶囊，选中的那段填墨黑 | 两三个互斥项（对齐 / 注音 / 在哪儿搜 / 怎么搜） | `.seg` / `.seg-item` |
   | **等宽格子**：一格一个方块，选中的填墨黑 | 等长的一堆（学期 / 年级 / 每日首数 / 题型） | `.chip-group` / `.chip` |
   | **竖排选项行**：一行一个，选中的填墨黑 | 名字较长、要一行一个（取诗范围 / 复习算法） | `.opt-group` / `.opt-row` |

   三者的**选中态完全一致**：一块墨黑的底 + 白字。
   差的是排布（横向排布 / 等宽网格 / 竖排），不是「长相」。
   底层一律是原生 `<radio>` / `<checkbox>`，视觉隐藏。

   ## 几毫米的规矩

   · 选项与它的文字之间要有默认间距 —— 原生控件不自带外边距，
     紧贴文字是浏览器的排法，不是控件的排法。这条定在控件自己身上。
   · 行高收成一条：原生控件被 transform 缩放后，行盒仍按原尺寸算高度，
     不给 line-height 的话文字基线会跟着控件对齐跑偏。 */
.pref-item {
  line-height: 1.4;
}

.pref-item radio,
.pref-item checkbox {
  margin-right: var(--sp-2);
}

/* ---------- 字号滑块 ----------
   「A —— A」这一排。两处用到：阅读页的偏好条、通用设置的正文字号。

   左边一个小 A、右边一个大 A —— 它们说的不是「两个选项」，是**量程的两头**：
   字号是连续量，光一根滑轨加一颗圆钮，在一排图标里看着就是个孤零零的圆圈，
   既不知道调什么，也不知道往哪边变大。

   两处必须长得一样，所以定在这里一处。上一版各写一份，一边用 ink-4、
   一边用 ink-3，小 A 一边 22rpx、一边 24rpx —— 同一样东西两个样子，
   用户说不清哪里别扭，只觉得「不一样」。 */
.font-row {
  display: flex;
  align-items: center;
}

.font-slider {
  flex: 1;
  min-width: 0;
  margin: 0 var(--sp-3);
}

.font-a {
  flex: none;
  font-family: var(--font-poem);
  color: var(--ink-3);
}

.font-a.small {
  font-size: var(--fs-hint);
}

.font-a.big {
  font-size: var(--fs-lead);
}

/* ---------- 选项行（竖排、多个选项、每个带名字）----------
   「取诗范围」「复习算法」用的是它：一列 4~7 个选项。

   ## 它为什么不该有圆点

   用户 2026-10-02 的原话是「取诗范围我看不出还包括单选框的必要性」。
   对的 —— 圆点在这里是**多余的第二遍**：
   这几种控件（分段、格子、选项行）说的都是同一件事「这几个里选一个」，
   而圆点只在**没有别的选中标志**时才需要。
   格子用「填色」说，分段用「填色」说，选项行却另起一个圆点说 ——
   同一个界面上三种说法，这就是「选项不统一」的来源。

   所以选项行跟格子走同一套：**未选中是白底 + 一道极淡的描边，
   选中是墨底白字 + 右侧一个勾**。勾是给多选留的位子，
   单选这里画的是「已选」——同一枚图形，形状说「这是个控件」，
   填色说「选的是它」。

   ## 破相是怎么来的（上一版在这里栽过两次）

   1. **那道竖线**。上一版选中态是 `inset 6rpx 0 0 var(--ink)` ——
      一条贴左的竖线。inset 阴影**不参与圆角裁切的外沿**，
      而这一行的 `border-radius` 是 14rpx：圆角把竖线的上端切掉一个斜口，
      下端也被切 —— 屏幕上就是一根上不接顶、下不接底、左上还有豁口的黑条。
      现在不画竖线了：整块填色本身就说明了「这一行」，
      不需要再叠一道线。
   2. **选中与未选中的左右起点不一样**。上一版给行加了
      `margin: 0 var(--sp-1)`，而同一张卡里的格子（`.chip-group`）没有 ——
      于是「学期/年级」和「取诗范围」的左边缝差 8rpx，
      竖着扫下来就看得出错位。现在两者都归零：
      卡片自己有 `--page-x` 的呼吸，行不需要再让一次。

   ## 虚线框不画了

   这几行原来还有 `border-bottom` 当行分隔。有了「填色的底」之后
   分隔线是重复的：未选中的行是白底，靠行与行之间的空隙就能分。
   线条越少，选中那块填色越显眼。 */
.opt-group {
  display: flex;
  flex-wrap: wrap;
  gap: var(--pad-opt-x);
}

/* 竖排：一行一条，各占满整行。
   仍在用它的只剩「复习算法」—— 那几行名字后面还带着一句「锁住了」的说明，
   一句话折行是常事，横排会挤。 */
.opt-group.column {
  flex-direction: column;
  gap: var(--pad-opt-y);
}

/* 横排：**一样的格子，一样的缝，只差排法**。
   一行的宽度 = 卡片内容宽（100%）减掉格子之间的缝，除以格数 ——
   所以格数变了不用改任何别的数。

   为什么取诗范围从竖排改回横排：Issue #12 的原话是
   「取诗范围选项 inline 显示 而不是一行一条」。六个选项竖排要吃掉
   六行的高度，一屏里只看得见「取诗范围」这一个设置项，
   而它上面那两组（学期 / 年级）本来就是横排的 —— 同一张卡里两种排法。 */
.opt-group.inline {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
}

.opt-group.inline .opt-row {
  justify-content: center;
  /* 横排时宽度由格子定，文字跟着居中 —— 竖排那种「左对齐、右边留白」在这里
     会看着像没排满。 */
  text-align: center;
}

.opt-group.inline .opt-main {
  flex: none;
  min-width: 0;
  padding: 0;
}

.opt-group.inline .opt-name {
  line-height: 1.25;
}

/* 每多一格就多一列。三格以下用不着写（比如「两个选项」）
   —— 三格是这里的默认，也是取诗范围最窄的那一档。 */
.opt-group.inline.cols-4 {
  grid-template-columns: repeat(4, 1fr);
}

.opt-row {
  position: relative;
  display: flex;
  align-items: center;
  min-height: var(--h-opt);
  padding: var(--pad-opt-y) var(--pad-opt-x);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-ctl);
  background: var(--surface);
  transition: background-color var(--t-press), border-color var(--t-press);
}

/* 选中：填墨黑、白字、边同色。与 .chip.on 一字不差 —— 
   它们本来就该长得一样，各写一遍迟早会漂。 */
.opt-row.active {
  background: var(--ink);
  border-color: var(--ink);
}

.opt-row.active .opt-name {
  color: var(--on-ink);
  font-weight: 600;
}

.opt-row.active .opt-desc {
  color: var(--on-ink-soft);
}

/* 锁住的那几行（权限不够）：透明度压下去，但仍可读 —— 
   整块隐藏会让人以为「这儿本来就没有」，压暗才说的是「有，但你现在用不了」。 */
.opt-row.locked {
  opacity: .45;
}

/* 原生控件只留行为、不留外观：
   点整行都选中、读屏读得到、键盘走得了 —— 换的只是一张脸。
   与 .seg-radio 同一套写法。 */
.opt-radio {
  position: absolute;
  width: 1rpx;
  height: 1rpx;
  opacity: 0;
  pointer-events: none;
}

.opt-main {
  flex: 1;
  min-width: 0;
}

.opt-name {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-title);
  color: var(--ink);
  line-height: 1.4;
}

/* 横排时字号收一档 —— 三列里塞两个字，--fs-title（32rpx）会顶到边框上。
   收到 --fs-hint 后与格子（.chip-t）**同档同色同字重**：
   这才是「inline 的选项行长成了格子」这件事的最后一块拼图。 */
.opt-group.inline .opt-name {
  font-size: var(--fs-hint);
}

.opt-desc {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 6rpx;
  line-height: 1.6;
}

/* 横排的单选项（范围、模式、筛选这种一行放得下的） */
.pref-item {
  display: flex;
  align-items: center;
  min-height: 60rpx;
  font-size: var(--fs-hint);
  color: var(--ink-2);
  margin-right: var(--sp-3);
}

.pref-item radio,
.pref-item checkbox {
  transform: scale(.8);
}

/* 横排筛选条：内容多时横向滚，不折成两行把版式撑乱 */
.chip-row {
  white-space: nowrap;
  margin-bottom: var(--sp-2);
}

.chip-row .pref-item {
  display: inline-flex;
  margin-right: var(--sp-2);
}

/* ---------- 字段行（键值对）---------- */
.kv {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 80rpx;
  padding: var(--sp-2) 0;
  border-bottom: 1rpx solid var(--line-2);
}

.kv:last-child,
.kv:last-of-type {
  border-bottom: none;
}

.kv-k {
  font-size: var(--fs-body);
  color: var(--ink-2);
  flex: none;
  padding-right: var(--sp-2);
}

.kv-v {
  font-size: var(--fs-body);
  color: var(--ink);
  text-align: right;
}

/* ---------- 进度：一横一竖两个共同件 ---------- */
/* 横条说「走到哪了」，环说「几比几」。两个都做，别只做一个 */
.meter {
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--line);
  overflow: hidden;
}

.meter-fill {
  height: 100%;
  border-radius: 4rpx;
  background: var(--ink);
  transition: width var(--t-move) var(--ease);
}

/* 环：纯 CSS 锥形渐变，不引 canvas、不带图片资源 */
.ring {
  position: relative;
  flex: none;
}

.ring-track,
.ring-fill {
  position: absolute;
  inset: 0;
  border-radius: 50%;
}

.ring-track {
  background: var(--line);
}

.ring-fill {
  background: conic-gradient(var(--ink) calc(var(--p) * 1%), transparent 0);
  transition: background var(--t-move) var(--ease);
}

.ring::after {
  content: "";
  position: absolute;
  inset: 13%;
  border-radius: 50%;
  background: var(--surface);
  border: 1rpx solid var(--line);
}

.ring-text {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-num);
  font-weight: 600;
  color: var(--ink);
  z-index: 1;
}

/* ---------- 未登录的那张卡 ---------- */
/* 门禁卡在 14 个页面里各有一份，长相必须是同一个 —— 用户才会认得出
   「这是同一道门」，而不是每页一套说法。

   参考图里没有这种卡，但它的语言是有的：一块白底、一枚圆标、
   一句人话、一个墨黑的主按钮。这一版就按这个来 —— 去掉渐变与印泥色。 */
.lock-card {
  text-align: center;
  padding: var(--sp-6) var(--sp-4) var(--sp-4);
  background: var(--surface);
  overflow: hidden;
  position: relative;
}

.lock-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  line-height: 1;
  margin: 0 auto var(--sp-3);
  border-radius: 50%;
  background: var(--ink);
  font-family: var(--font-poem);
  font-size: 54rpx;
  color: var(--on-ink);
}

.lock-title {
  display: block;
  font-size: var(--fs-lead);
  font-weight: 700;
  color: var(--ink);
  font-family: var(--font-poem);
  letter-spacing: var(--ls-title);
}

.lock-btn {
  margin-top: var(--sp-4);
}

/* ---------- 方字格（飞花令的令字）----------
   一个方格 + 一个字 + 一个原生 radio。两处用到（大会首页、飞花令页），
   所以收在这里定一次。

   ⚠️ 上一版把圆点 absolute 到 `right:-6rpx; top:-6rpx`，理由是「中心留给字」——
   结果圆点**压在字的右上一笔上**：「而」「者」「有」的右上角被盖住半个，
   而且缩到 0.6 之后命中区也移了位，点上去要先对准那个偏出去的小圈。

   现在的做法：格子右上角**留出一块空**（padding-top 让字整体下移一点），
   圆点就落在那块空里，不压任何笔画；命中区仍是整个 label（原生 radio
   在 label 里，点格子任何一处都能选中）。 */
.char {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--line-strong);
  background: var(--surface);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  /* 上下各留一口气：上一版是「整块居中」，
     字 + 小字两行合起来比格子高，贴到了上下边框上 */
  padding: 10rpx 0;
  box-sizing: border-box;
}

.char.active {
  background: var(--ink);
  border-color: var(--ink);
}

/* 令字格里**不再画一个圆点**。
   上一版是 absolute 到右上角、缩到 0.56 的原生圆点：小到看不出能点、
   还压在「而」「者」「有」的笔画上，缩过头之后命中区也跟着偏出格子。
   选中态由格子自己的「底色 + 描边 + 字变色」来说明白，够了。
   radio 仍在 label 里（.seg-radio 视觉隐藏），点格子任何一处都选中。 */

.char-t {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-hero);
  color: var(--ink);
  line-height: 1.1;
}

/* 那一行小字（命中数）：它比字低一档，且不许把格子撑高 ——
   给一条固定行高，格子高度才不会随数字位数变 */
.char-n {
  display: block;
  height: 26rpx;
  font-size: var(--fs-pinyin);
  line-height: 26rpx;
  color: var(--ink-4);
}

.char.active .char-t {
  color: var(--on-ink);
}

.char.active .char-n {
  color: var(--on-ink);
  opacity: .6;
}

/* ============================================================
   垂直居中的一条总口径
   ============================================================ */
/* 小程序里「一行里的东西对不齐」几乎只有两个原因：

   1. 用了 `line-height: <比 height 小几 rpx>` 去凑居中 —— 那不是居中，
      是把偏差摊到每一行文字上，字号一换就露
   2. 靠 `align-items: baseline` 排「文字 + 控件」那一行 ——
      缩放过的原生控件基线不在视觉中心，字就跟着偏

   所以这里只给一件事：**行内元素一律走 flex + center**。
   下面这两个选择器覆盖了「一行文字 + 一个原生控件」的全部场景，页面不用再写。 */

.row,
.kv,
.pref-item,
.opt-row,
.field,
.search,
.pager {
  align-items: center;
}

/* 数字与计数的字宽统一：等宽数字让「几比几」不会随数字变化左右跳 */
.count-num,
.mastery-num,
.ring-text,
.num-v,
.grant-meter-t,
.day-count,
.stage-count,
.exam-progress,
.exam-timer,
.stat-v {
  font-variant-numeric: tabular-nums;
}

/* ---------- 底部安全区垫片 ---------- */
.safe-bottom {
  height: calc(24rpx + env(safe-area-inset-bottom));
}

/* 页脚一句：给整屏一个收束，不然最后一张卡下面像被切断 */
.foot {
  text-align: center;
  padding: var(--sp-1) 0 var(--sp-5);
}

.foot .hint {
  letter-spacing: 1rpx;
}

/* ============================================================
   分段控件（「二选一 / 三选一」的统一长相）
   ============================================================ */
/* 「在哪儿搜」「怎么搜」「左对齐还是居中」「注不注音」——这些都是**互斥的
   少数几个选项**。原来的写法是一排原生单选框：一个空心圆圈 + 两个字。
   圆圈本身没问题（它确实是原生控件），问题是**它不适合这种场合**：

   1. 圆圈与文字挤在一行，两个选项就占掉半屏，一行放不下三个；
   2. 选中态只有「圈里多一个点」，对比度很低，扫不出来；
   3. 「范围」与「方式」两组各排一行圆点，看着像同一组里的六个选项。

   分段控件把「选一个」画成一颗胶囊：选中的那段填墨黑。
   一眼看得出「这组里有几个选项、我选了第几个」。

   底层**仍是原生 radio**：包在 <label> 里、被视觉隐藏。
   点整段就能选中、读屏读得到、键盘走得了 —— 行为全是平台的，
   我们只是换了一张脸。 */
/* 分段控件：**一律撑满可用宽度**。
   上一版只有加了 .fill 的才撑满 —— 于是列表页那条「全部 / 未读」
   缩成一小撮挤在左边，而搜索页的「全站 / 课内」撑满整行，
   同一屏两种宽窄。分段就是一个「二选一」的控件，
   宽窄不该随页面变：撑满时两段的**可点面积**才一样大。 */
.seg {
  display: flex;
  align-items: center;
}

.seg-group {
  display: flex;
  align-items: stretch;
  flex: 1;
  border: 1rpx solid transparent;
  border-radius: var(--radius-pill);
  background: var(--sink);
  padding: 4rpx;
  overflow: hidden;
}

.seg-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  gap: 8rpx;
  padding: 0 var(--sp-2);
  height: 60rpx;
  border-radius: var(--radius-pill);
  transition: background-color var(--t-press), color var(--t-press);
}

/* 选中态**填成墨黑**。只把字变色太轻 —— 一层浅灰底上扫不出选中了哪一段 */
.seg-item.on {
  background: var(--ink);
}

.seg-item.on .seg-text {
  color: var(--on-ink);
  font-weight: 600;
}

/* 图标跟着文字走：段被选中时整段文字变白，图标跟着变白。
   用 currentColor 而不是再写一个 --ic 变量 ——
   变量要在三处（自己 + 两个伪元素）各改一遍，漏一处就出现
   「文字白了、图标还是灰的」。currentColor 只需改父级一处。 */
.seg-item.on .seg-icon {
  color: var(--on-ink);
}

/* 原生 radio 只留行为、不留外观。
   不用 display:none —— 那会让部分机型的读屏也读不到这一项 */
.seg-radio {
  position: absolute;
  width: 1rpx;
  height: 1rpx;
  opacity: 0;
  pointer-events: none;
}

/* 分段的文字：**与格子、选项行同档**（--fs-hint）。
   上一版这里是 --fs-caption（22rpx），比格子小一档 ——
   同一屏里「左对齐」比「一年级」小 3rpx，用户说不出，
   但会觉得「这几个东西不是一套的」。 */
.seg-text {
  font-size: var(--fs-hint);
  color: var(--ink);
  letter-spacing: 1rpx;
  white-space: nowrap;
}

.seg-item.on .seg-text {
  letter-spacing: 1rpx;
}

/* ---------- 等长选项的格子 ----------
   年级（12 个）、学期（2 个）、每日首数（5 个）、题型（5 个）这类：
   选项等长、数量不少，排成网格比排成一列省一半高度。
   每一格是一个胶囊 —— 形状本身说「这是个能点的选项」，填色说「选的是它」。

   为什么不给每格配一个原生圆点/方框：它吃掉横向空间（12 个年级就得多一列），
   还跟第一行文字对齐、第二行缩进，看着像它只管辖半格。
   格子排成矩阵这件事，已经把「一组、选一个（或几个）」说清楚了。 */
.chip-group {
  display: grid;
  /* 行内与行间都是 8rpx —— 格子之间要看着是「一组里的几格」，
     所以缝要小。但**两组之间**必须比组内更松（见下面的 chip-group + chip-group）：
     否则上一组的末格与下一组的首格贴在一起，两格都选中时
     会连成一块竖着的黑条，看着像一个被拉长的格子。 */
  gap: var(--sp-1) var(--sp-1);
}

/* 相邻两组格子之间的间距，要比组内大一档 ——
   「学期」与「年级」本来是两组不同的东西，缝太小就看不出分组。 */
.chip-group + .chip-group {
  margin-top: var(--sp-3);
}

.chip-group.cols-2 {
  grid-template-columns: repeat(2, 1fr);
}

.chip-group.cols-3 {
  grid-template-columns: repeat(3, 1fr);
}

.chip-group.cols-4 {
  grid-template-columns: repeat(4, 1fr);
}

/* 格子与「选项行」是同一套长相：未选中的样子、选中的样子、
   圆角、描边的粗细，全都一样。上一版格子是「浅灰底 + 无描边」、
   选项行是「白底 + 一道描边」—— 同一屏里两种底，用户说的
   「选项也不统一」就是它。

   现在只留一档：**未选中 = 白底 + 一道极淡描边**。
   灰底是留给「凹槽」（输入框、图标底）的，不该占选项的位置 ——
   浅灰底 + 浅灰底，一眼看不出哪块能点。 */
.chip {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--h-opt);
  /* 上下左右各留一口气：纵向由 --pad-opt-y 给（不再是 0），
     横向--pad-opt-x（比原来的 --sp-1 宽一档，两字选项不再顶到边框）。
     两者都走 --ui-scale，整体收放时跟着一起收。 */
  padding: var(--pad-opt-y) var(--pad-opt-x);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-ctl);
  background: var(--surface);
  transition: background-color var(--t-press), border-color var(--t-press);
}

.chip.on {
  background: var(--ink);
  border-color: var(--ink);
}

/* 未选中的文字用**正文色**，不用次级灰。
   「未选中」这件事由**底色**说（白底 / 墨底），不需要文字再灰一次 ——
   灰字 + 灰底会让人以为「这一项不能用」。次级灰留给「说明」，
   不留给「选项的名字」。 */
.chip-t {
  font-size: var(--fs-hint);
  color: var(--ink);
  line-height: 1.3;
  text-align: center;
}

.chip.on .chip-t {
  color: var(--on-ink);
  font-weight: 600;
}

/* 多选的格子：形状与单选的一样，但**选中态多一个勾** ——
   单选和多选在一屏里同时出现时（题库：范围是单选、题型是多选），
   光看填色分不出来哪个是哪个。那一勾就是「可以多选」的唯一线索，
   所以它必须画出来，不能省。

   勾用两条边框拼（右下角一道 45° 的短折线），不引图标字体。 */
/* 一勾两态：**没选中也要看得见**，否则「这里可以多选」就只在选中后才存在。
   未选中给一个空心方框，选中换成实心的勾 —— 与原生复选框的语义一致，
   只是不再站到选项前面去占地方。 */
.chip.multi::after {
  content: "";
  position: absolute;
  right: 12rpx;
  top: 12rpx;
  width: 14rpx;
  height: 14rpx;
  border: 2rpx solid var(--ink-4);
  border-radius: 3rpx;
}

.chip.multi.on::after {
  width: 16rpx;
  height: 9rpx;
  border: none;
  border-left: 4rpx solid var(--on-ink);
  border-bottom: 4rpx solid var(--on-ink);
  border-radius: 0;
  transform: rotate(-45deg);
}

.chip.multi.on::after {
  border-color: var(--on-ink);
}

/* 小号：一章里连着两组（搜索页）时用，别把卡片撑高 */
.seg-item.mini {
  height: 48rpx;
  padding: 0 16rpx;
}

.seg + .field-label,
.field-label + .seg {
  margin-top: var(--sp-1);
}

/* ---------- 图标：全用 CSS 画 ----------
   这一组图标要说清「这一档是什么」，所以它得像图标的样子：
   **同一个网格、同一根线宽、同一个视觉重量**。

   上一版不是这样：三个图标各画各的 ——
   「不注音」是 20rpx 的圆圈加一道斜杠（还戳出圈外），
   「生字」是 15rpx 的小方框顶着一个点，「全文」是一排 6rpx 的实心小方块。
   它们并排出现时：粗的粗、细的细、大的大、小的小，
   连**光学中心**都不在一条线上（圆的溢出比方的多，视觉上会显得更低）。
   用户的原话是「瞎画、不对齐」，说的就是这个。

   这一版定一份网格，所有图标都长在它上面：

     · **画布 24×24rpx**，图形一律内缩 2rpx —— 留出的那一圈是
       「光学边距」：描边图形若顶到画布边缘，会比实心图形看着大一圈。
     · **线宽 2.5rpx**。圆角端点。线宽只有这一种，
       不许某个图标为了「看得清」偷偷加粗。
     · **描边类与实心类不混用**：一个图标要么全描边、要么全实心。
       混着画就会出现「有的深有的浅」，一眼就乱。
     · 需要「这里有个东西」时用**描边**，需要「这里被填满」时用**实心**。

   为什么仍不引图标字体 / 图片：主包余量只剩几百 KB，
   而这组图标只在分段的选项里出现，一共九枚 —— 用 CSS 画得下来。
   代价是每加一枚都要照着网格写，那就照着写。 */
.seg-icon {
  position: relative;
  flex: none;
  width: 24rpx;
  height: 24rpx;
  --ic: currentColor;
  color: var(--ink-2);
  /* 图标与文字同色系：选中时整段变白字，图标跟着白 —— 见 .seg-item.on 那组规则 */
}

.seg-icon::before,
.seg-icon::after {
  content: "";
  position: absolute;
  background: var(--ic);
  border-radius: 2rpx;
}

/* ---------- 对齐（三道线）----------
   左对齐：三行都从左边起，长度递减 —— 「长短不一样」才是对齐的标志，
   三行一样长就只是「三行」。
   居中：三行都居中对齐，长度递减。 */
.ic-left::before {
  left: 2rpx;
  top: 4rpx;
  width: 20rpx;
  height: 2.5rpx;
  box-shadow: 0 7rpx 0 var(--ic), 0 14rpx 0 var(--ic);
}

.ic-left::after {
  left: 2rpx;
  top: 11rpx;
  width: 13rpx;
  height: 2.5rpx;
}

.ic-center::before {
  left: 2rpx;
  top: 4rpx;
  width: 20rpx;
  height: 2.5rpx;
  box-shadow: 0 7rpx 0 var(--ic), 0 14rpx 0 var(--ic);
}

.ic-center::after {
  left: 5.5rpx;
  top: 11rpx;
  width: 13rpx;
  height: 2.5rpx;
}

/* ---------- 注音三档 ----------
   这三枚要一眼分得开，而且**不能跟「对齐」那两枚撞脸**。
   第一版我给「全文」画了三道横线 —— 那正是 `.ic-left` 的样子，
   同一屏里并排出现就是「瞎画、不对齐」的观感来源。

   换一个母题：**「一个字 + 它头上的拼音」**。
   这个母题本身就是注音这件事，三档的差别就落在「有几个」上：

     · **不注音** —— 一个「字 + 拼音」被划掉（圆圈加斜杠，全世界都读「关掉它」）
     · **生字**   —— 只有**一个**：一个字，头上一点拼音
     · **全文**   —— 铺满：两个字并排，各自头上都有拼音

   三点区别同时存在（有没有被划掉 / 一个还是两个 / 头上有没有点），
   任意两点都足以分辨，所以不会看错。 */
.ic-off::before {
  left: 2rpx;
  top: 2rpx;
  width: 20rpx;
  height: 20rpx;
  border: 2.5rpx solid var(--ic);
  border-radius: 50%;
  background: transparent;
  box-sizing: border-box;
}

.ic-off::after {
  left: 4rpx;
  top: 10.5rpx;
  width: 16rpx;
  height: 2.5rpx;
  transform: rotate(-45deg);
}

/* 生字：**一个**「字 + 头上一点」，占不满整行 —— 右边空着一大块，
   「只标几个」这件事由「空着的那块」说，比数点更直观。
   （两个字各顶一个点，和「全文」在 24rpx 里几乎分不出来 —— 那是废图。） */
.ic-rare::before {
  left: 2rpx;
  top: 6rpx;
  width: 8rpx;
  height: 2.5rpx;
}

.ic-rare::after {
  left: 2rpx;
  top: 12rpx;
  width: 8rpx;
  height: 2.5rpx;
}

/* 全文：**三个**「字 + 头上一点」一路排到底，一点都不空 ——
   「全都标了」由「排满」说。 */
.ic-all::before {
  left: 2rpx;
  top: 5rpx;
  width: 5rpx;
  height: 2.5rpx;
  box-shadow: 7.5rpx 0 0 var(--ic), 15rpx 0 0 var(--ic);
}

.ic-all::after {
  left: 2rpx;
  top: 11rpx;
  width: 18rpx;
  height: 2.5rpx;
}

/* ---------- 搜索范围 ----------
   全站：一个**地球** —— 一个圆 + 一道纬线 + 一道经线。
   只画圆加一道横线会读成「⊖（禁止/减号）」，所以必须把**经线**也画出来：
   有经纬两线才像球。上一版就是只画了赤道，和「不注音」的圈几乎是一个东西。
   课内：**一册书** —— 一个长方形 + 中缝。

   两枚都是「描边 + 细线」同一套笔法，线宽同为 2.5rpx。 */
.ic-all-site::before {
  left: 2rpx;
  top: 2rpx;
  width: 20rpx;
  height: 20rpx;
  border: 2.5rpx solid var(--ic);
  border-radius: 50%;
  background: transparent;
  box-sizing: border-box;
}

/* 经线：一道竖着的椭圆（用 border-radius 把一个小方压成椭圆看得见）
   纬线：中间一道横线 */
.ic-all-site::after {
  left: 7rpx;
  top: 5rpx;
  width: 10rpx;
  height: 14rpx;
  border: 2rpx solid var(--ic);
  border-radius: 50%;
  background: transparent;
  box-sizing: border-box;
}

/* 课内的书：外框在此，中缝靠 ::after */
.ic-course::before {
  left: 2rpx;
  top: 3.5rpx;
  width: 20rpx;
  height: 17rpx;
  border: 2.5rpx solid var(--ic);
  border-radius: 2rpx;
  background: transparent;
  box-sizing: border-box;
}

.ic-course::after {
  left: 12rpx;
  top: 5rpx;
  width: 2rpx;
  height: 14rpx;
}

/* ---------- 搜索字段 ----------
   篇名作者：一行字 + 下面一小段（「短，是标题」）。
   正文全文：一整页密排的短行（「密，是正文」）。 */
.ic-title::before {
  left: 2rpx;
  top: 5rpx;
  width: 20rpx;
  height: 2.5rpx;
  box-shadow: 0 6rpx 0 var(--ic);
}

.ic-title::after {
  left: 2rpx;
  top: 14rpx;
  width: 11rpx;
  height: 2.5rpx;
}

.ic-full::before {
  left: 2rpx;
  top: 3rpx;
  width: 8.5rpx;
  height: 2.5rpx;
  box-shadow: 0 5.5rpx 0 var(--ic), 0 11rpx 0 var(--ic), 0 16.5rpx 0 var(--ic);
}

.ic-full::after {
  left: 13.5rpx;
  top: 3rpx;
  width: 8.5rpx;
  height: 2.5rpx;
  box-shadow: 0 5.5rpx 0 var(--ic), 0 11rpx 0 var(--ic), 0 16.5rpx 0 var(--ic);
}

/* ============================================================
   分段标题（一屏里分隔两组卡片的那行小字）
   ============================================================ */
/* 参考图里「卡片与数据 / 按钮与页签 / 输入、标签与状态」各是一枚浅灰胶囊，
   独立于上下卡片，说明「下面这组是什么」。它比 card-title 轻，且不占卡片。 */
.section-label {
  display: inline-flex;
  align-items: center;
  font-size: var(--fs-caption);
  color: var(--ink-2);
  letter-spacing: var(--ls-caption);
  background: var(--sink);
  border-radius: var(--radius-pill);
  padding: 8rpx 22rpx;
  margin: var(--sp-2) 0 var(--sp-2);
}

/* ============================================================
   两条长相，不是三条（Issue #12 的收尾）
   ============================================================
   用户连着三轮问的都是同一件事：「选项也不统一」「能不能确保所有页面
   相同元素界面的一致性」「和这两处的按钮要不要都和课外阅读列表页
   那些集子的选项样式保持一致」。

   查下来，全站的可点块当时有**三种**圆角：格子/选项行 16rpx 的近直角、
   按钮 999rpx 的胶囊、标签 999rpx 的胶囊。三档里前两档都是「能点、能选中」，
   却是两种长相 —— 这就是「不统一」的出处，而且它不在一页里，跨页才看得见。

   现在收成两条：

   ┌────────────────┬──────────────────┬────────────┬──────────┐
   │ 长相            │ 用在哪            │ 圆角        │ 高度      │
   ├────────────────┼──────────────────┼────────────┼──────────┤
   │ **控件**        │ 选项格、选项行、按钮 │ --radius-ctl│ 76 / 96  │
   │ **胶囊**        │ 标签、分段、搜索框   │ 999rpx      │ 56 / 60  │
   └────────────────┴──────────────────┴────────────┴──────────┘

   分界不是「大小」，是**它是什么**：
   · 控件 —— 一格一个选项、一颗按钮。矩形，四个角看得见，填色说中没选中。
   · 胶囊 —— 一行里的一段、一个标记。细长，两端的圆就是它的形状。
   分段（.seg-item）留在胶囊那一档是刻意的：它本来就在一根轨道里，
   一段的圆角等于轨道的圆角才咬得上；把它改成矩形反而像两个按钮。

   守这件事的是 check.js V23：`.btn` / `.chip` / `.opt-row` 的圆角必须
   同为 --radius-ctl，且都不许再写裸值。
   ============================================================ */
