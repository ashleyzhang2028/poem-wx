@import "styles/tokens.wxss";

/* ---------- 排版 ---------- */
page {
  box-sizing: border-box;
}

view, text, button, input, textarea {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
}

/* ---------- 卡片 ---------- */
.card {
  background: var(--card);
  border: 1rpx solid var(--line-2);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 8rpx;
}

.hint {
  font-size: 25rpx;
  color: var(--ink-3);
  line-height: 1.7;
}

.empty {
  padding: 80rpx 0;
  text-align: center;
  color: var(--ink-3);
  font-size: 28rpx;
}

/* ---------- 按钮 ---------- */
.btn {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 32rpx;
  border-radius: var(--radius-sm);
  background: var(--bg-soft);
  border: 1rpx solid var(--line);
  color: var(--ink);
  font-size: 30rpx;
  text-align: center;
}

.btn::after {
  border: none;
}

.btn.primary {
  background: var(--green);
  border-color: var(--green);
  color: #fff;
}

.btn.ghost {
  background: transparent;
  color: var(--ink-2);
}

.btn.danger {
  color: var(--red);
  border-color: #ecd2cd;
  background: #fbeae7;
}

.btn.block {
  width: 100%;
}

/* 瘦身版：搜索键、索引开关、名录改档这种「一行里的小按钮」都走它。
   原生 button 自带最小宽度与默认内边距，不收掉就撑得整行走形。 */
.btn.mini {
  display: inline-block;
  width: auto;
  min-width: 0;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
}

.btn[disabled] {
  opacity: .5;
}

/* ---------- 列表行 ---------- */
/* 行是导航不是按钮，所以用 hover-class 借原生触碰反馈，不套一层 button */
.row-hover {
  background: var(--green-light);
}

.row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line-2);
}

.row:last-child {
  border-bottom: none;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-title {
  font-family: var(--font-poem);
  font-size: 32rpx;
  color: var(--ink);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-sub {
  font-size: 24rpx;
  color: var(--ink-3);
  margin-top: 6rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-go {
  color: var(--line);
  font-size: 32rpx;
  padding-left: 16rpx;
}

/* ---------- 标签 ---------- */
.tag {
  display: inline-block;
  font-size: 22rpx;
  line-height: 1.5;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  color: var(--green);
  background: var(--green-light);
  margin-right: 10rpx;
}

.tag.amber {
  color: var(--amber);
  background: var(--amber-light);
}

.tag.red {
  color: var(--red);
  background: var(--red-light);
}

.tag.blue {
  color: var(--blue);
  background: var(--blue-light);
}

.tag.ghost {
  color: var(--ink-3);
  background: var(--line-2);
}

/* ---------- 搜索框 ---------- */
.search {
  display: flex;
  align-items: center;
  background: var(--bg-soft);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  padding: 0 20rpx;
  height: 76rpx;
}

.search-icon {
  color: var(--ink-3);
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search input {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
}

/* ---------- 小程序自有控件的统一口径 ----------
   这一节是「控件用系统的、配色用跬步的」这句话的落点。
   开关 / 单选 / 多选 / 滑动条 / 选择器 / 按钮全部走小程序自带控件：
   行为、无障碍、键盘与读屏由平台保证，我们只负责把它们染成宋代那套颜色。

   原生控件的交互色只能通过组件属性给（color / activeColor / selected-color），
   属性在 WXML 里写；样式表这边只统一尺寸、圆角、字体与间距 ——
   想靠 WXSS 改原生控件的内部结构是不被支持的，所以这里一行都不敢越界。 */

/* 原生的 checkbox / radio 默认 23px 见方，比正文小、点着费劲；
   横向缩放不改它自身尺寸，只放大外观 —— 命中区仍是原生的一整行，所以点着反而更宽松 */
.native-group {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 20rpx;
}

.native-group.column {
  flex-direction: column;
  gap: 0;
}

.native-label {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  font-size: 29rpx;
  color: var(--ink);
}

/* 只给触碰反馈上色，落地仍是原生 button 的 default 态外观由 btn 类兜底 */
.btn {
  transition: background-color .1s;
}

/* ---------- 单选行（档位、算法这种「选一个」的选择） ----------
   行本身是 label[for]，点整行都能选中，不用把手指对准那个小圆点。 */
.opt-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line-2);
}

.opt-row:last-of-type {
  border-bottom: none;
}

.opt-row.locked {
  opacity: .45;
}

.opt-row radio,
.opt-row checkbox {
  transform: scale(.86);
}

.opt-main {
  flex: 1;
  min-width: 0;
  padding-left: 8rpx;
}

.opt-name {
  display: block;
  font-size: 31rpx;
  color: var(--ink);
}

.opt-row.active .opt-name {
  color: var(--green);
  font-weight: 600;
}

.opt-desc {
  display: block;
  font-size: 23rpx;
  color: var(--ink-3);
  margin-top: 6rpx;
  line-height: 1.6;
}

/* ---------- 底部安全区垫片 ---------- */
.safe-bottom {
  height: calc(24rpx + env(safe-area-inset-bottom));
}
