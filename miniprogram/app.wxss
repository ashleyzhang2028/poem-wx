@import "styles/tokens.wxss";

/* ============================================================
   基座
   页面样式表只管「这一页长什么样」，凡是两页以上都要写的东西，
   一律收在这里。收不住的后果不是难看，是**不一致** ——
   用户说不清哪里别扭，只觉得「一塌糊涂」。

   这一版的层次只有三样：**留白、字重、一道极淡的线**。
   底色是白的、卡片也是白的，靠间隙与描边分开。
   ============================================================ */

view, text, button, input, textarea {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: var(--sp-3) var(--page-x) calc(24rpx + env(safe-area-inset-bottom));
}

/* 有底栏的那四页（背诵 / 课外 / 搜索 / 我的）：底部要多留一截 ——
   自绘底栏是 fixed 的，不参与文档流，不留这一截最后一行会被它压住。
   底栏高 112rpx + 安全区（见 custom-tab-bar/index.wxss），
   这里垫同样的一截；`.safe-bottom` 那 24rpx 仍在，两者相加正好。 */
.page.has-tabbar {
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* 有底栏的页面上，页内那个 .safe-bottom 垫片是**多余的** ——
   .has-tabbar 的底部内边距已经含了安全区与底栏高度，
   再垫一层就是 24rpx 的空白，最后一行离底栏远了半指。 */
.page.has-tabbar .safe-bottom {
  display: none;
}

/* ---------- 页头 ----------
   一屏的入口，回答「我在哪、这里有什么」。
   参考图里那一屏最上面是一行小字标签 + 一个标题，没有别的装饰 ——
   所以这里也不留底色、不留横线，只有字。

   ⚠️ 页头的大标题不许等于导航栏标题（同屏两行一样的字等于没说）——
   自检里有断言守着。 */
.page-head {
  padding: var(--sp-2) var(--sp-1) var(--sp-4);
}

.head-title {
  display: block;
  font-size: var(--fs-head);
  font-weight: 700;
  color: var(--ink);
  letter-spacing: var(--ls-title);
  line-height: var(--lh-tight);
}

/* 页头这里**是界面在说话**：「今天背什么」「课外阅读」「十七部集子」——
   它和卡片里的篇名（咏鹅 / 将进酒）会同时出现在一屏里。
   篇名走宋体是内容需求，页头若也走宋体，两处就会撞成同一种「雅」，
   反而分不出哪个是书、哪个是书架。所以页头一律黑体，宋体只给诗文。 */
.head-title.poem {
  font-family: var(--font-poem);
}


.head-sub {
  display: block;
  font-size: var(--fs-hint);
  color: var(--ink-3);
  letter-spacing: var(--ls-caption);
  margin-top: var(--sp-2);
}

/* ---------- 卡片 ----------
   白底 + 一道极淡的描边，**没有投影**。
   分层靠「描边 + 留白」这两样，够用了。

   投影是刻意去掉的，不是漏了：卡与卡之间只有 --sp-3（24rpx）的缝，
   而投影的模糊半径就有 6rpx，一条缝被两侧的投影共同铺满，
   在浅灰底上会显成一条两头深、中间浅的横带（实测 236 → 245 → 236）。
   首页自上而下七八张卡，就是七八条这样的带子 —— 看着像渲染坏了。
   详见 tokens.wxss 里 --shadow 的注释。 */
.card {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: var(--sp-4);
  margin-bottom: var(--sp-3);
}

/* 带页头的一屏：第一张卡与页头贴紧一点，不然顶部空一块 */
.page-head + .card {
  margin-top: 0;
}

.card-title {
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--ink);
  margin-bottom: var(--sp-1);
}

/* 卡片小标题：不加竖线、不加色 —— 参考图里的小标题就是一行黑字，
   它靠位置（在卡片最上面）和字重说明自己是标题，不靠装饰。 */
.card-title.bar {
  display: flex;
  align-items: center;
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--ink);
  margin-bottom: var(--sp-2);
}

.hint {
  font-size: var(--fs-hint);
  color: var(--ink-3);
  line-height: var(--lh-body);
}

.count-line {
  display: block;
  padding-top: var(--sp-2);
  font-size: var(--fs-hint);
  color: var(--ink-3);
}

.sub-title {
  display: block;
  font-size: var(--fs-hint);
  color: var(--ink-2);
  margin: var(--sp-3) 0 var(--sp-1);
}

/* ---------- 字段名 ----------
   一张卡里「这一行是什么」那半截字的统一样子。它比 card-title 轻、
   比正文小，因为它不是内容，是标签。

   之前散成四份：搜索页的 .opt-label、飞花令的 .opt-label、
   搜索页的 .section-label、阅读设置里裸写的 .sub-title ——
   四份的字号差 3rpx、颜色一个 ink-2 一个 ink-3，一页里同时出现就露馅。
   现在只有这一处。 */
.field-label {
  display: block;
  font-size: var(--fs-hint);
  color: var(--ink-3);
  letter-spacing: var(--ls-caption);
  line-height: 1.4;
  margin-bottom: 4rpx;
}

/* 一条淡分隔，比 border 更轻，用在「同一张卡里换话题」的地方 */
.divider {
  height: 1rpx;
  background: var(--line-2);
  margin: var(--sp-3) 0;
}

/* ---------- 空状态 ----------
   一枚淡印章 + 一句人话 + 一个下一步。
   有出处的「没有」比一个孤零零的方块让人安心 —— 用户知道是真没有，
   不是没加载出来。 */
.empty {
  padding: var(--sp-6) var(--sp-3) var(--sp-5);
  text-align: center;
}

/* 印章：一枚圆里放一个字。居中也走 flex —— 用「line-height 比 height
   小 4rpx」去凑是同一个坏习惯，圆环一粗就偏，且偏在哪一侧每台机子不一样 */
.empty-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  margin: 0 auto var(--sp-2);
  border-radius: 50%;
  background: var(--sink);
  font-family: var(--font-poem);
  font-size: 46rpx;
  line-height: 1;
  color: var(--ink-4);
}

.empty-text {
  display: block;
  font-size: var(--fs-title);
  color: var(--ink-2);
  line-height: var(--lh-loose);
}

.empty-tip {
  display: block;
  margin-top: var(--sp-1);
}

/* ---------- 按钮 ----------
   三种：**实心墨黑**（一屏的正事）、**白底描边**（并列的另一件事）、
   **纯文字**（最轻的一档，用于行内小动作）。

   按钮文字**垂直居中**靠的是「内容盒 + align-items」，
   不是把 line-height 调成比 height 小几 rpx 去凑 —— 那种写法在字重、
   字号、系统字体任意一个变了之后就会偏，且各页偏的方向还不一样。
   原生 button 默认是 inline-block + 默认行高，这里统一改成 flex 居中。 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: var(--h-btn);
  padding: 0 var(--sp-4);
  border-radius: var(--radius-pill);
  background: var(--surface);
  border: 1rpx solid var(--line-strong);
  color: var(--ink);
  font-size: var(--fs-title);
  font-weight: 500;
  line-height: 1.2;
  letter-spacing: var(--ls-title);
  text-align: center;
  transition: background-color var(--t-press), transform var(--t-press), opacity var(--t-press);
}

.btn::after {
  border: none;
}

/* 一屏的正事：一块干净的墨黑。
   参考图里「手机号快捷注册 / 新增档期」就是这一块 —— 全屏只有它一个。 */
.btn.primary {
  background: var(--ink);
  border-color: var(--ink);
  color: var(--on-ink);
  font-weight: 600;
}

/* 主按钮按下时压深一档、再缩一点，不然同色相邻时会显得「没点着」 */
.btn.primary.button-hover {
  background: var(--ink-strong);
  border-color: var(--ink-strong);
  opacity: .92;
  transform: scale(.985);
}

.btn.ghost {
  background: transparent;
  color: var(--ink-2);
  border-color: var(--line-strong);
}

.btn.danger {
  color: var(--red);
  border-color: var(--red-edge);
  background: var(--red-soft);
}

.btn.block {
  width: 100%;
}

.btn.block + .btn.block {
  margin-top: var(--sp-2);
}

/* 一排并列的按钮（「说一句 / 接不上了」「试听 / 保存」这种）。
   两件事必须一起写：**flex 平分宽度** 与 **align-items: center**。
   少了后者，flex 的默认 stretch 遇上 .btn 的固定 height 会退化成基线对齐 ——
   同一排里主按钮与次要按钮**顶部齐、底部不齐**，看着像一个大一个小。
   两个页面各写过一份，现在收在这里。 */
.actions {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  margin-top: var(--sp-3);
}

.actions .btn {
  flex: 1;
}

/* 瘦身版：搜索键、索引开关、名录改档这种「一行里的小按钮」都走它。
   原生 button 自带最小宽度与默认内边距，不收掉就撑得整行走形。 */
.btn.mini {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-width: 0;
  height: var(--h-btn-mini);
  padding: 0 var(--sp-3);
  font-size: var(--fs-hint);
  line-height: 1.2;
  border-radius: var(--radius-pill);
}

.btn[disabled] {
  opacity: .4;
  box-shadow: none;
}

.btn.button-hover {
  opacity: .86;
  transform: scale(.985);
}

/* ---------- 列表行 ----------
   行是导航不是按钮，所以用 hover-class 借原生触碰反馈，不套一层 button。
   参考图的列表行是「左图标 + 标题/副题 + 右箭头」，行高很松 ——
   一屏五六行就排满了，这是刻意的：手机上一行认不出是什么，点错比点慢更糟。 */
.row-hover {
  background: var(--sink);
}

.row {
  display: flex;
  align-items: center;
  min-height: var(--h-row);
  padding: var(--sp-2) 0;
  border-bottom: 1rpx solid var(--line-2);
  border-radius: var(--radius-sm);
  transition: background-color var(--t-press);
}

.row:last-child {
  border-bottom: none;
}

.row-main {
  flex: 1;
  min-width: 0;
}

/* 列表行的标题。**它不一定是篇名** —— 我的页的「背诵设置」、
   关于页的「用户协议」走的也是这个类，这些是界面功能名，不是诗词名。
   所以这里取 UI 字体；篇名另走 .row-poem（见下），别让宋体漫出来。 */
.row-title {
  font-family: var(--font-ui);
  font-size: var(--fs-title);
  color: var(--ink);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 列表里的**篇名**：宋体只给这一类。咏鹅 / 江南 / 画 是诗词名，
   「意见反馈」「清空本机数据」不是 —— 同一张卡上两种字混排是最扎眼的那种不一致。 */
.row-poem {
  font-family: var(--font-poem);
}

.row-sub {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 6rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 行尾那个 ›：压低饱和度，它是提示不是内容 */
.row-go {
  color: var(--ink-4);
  font-size: 32rpx;
  padding-left: var(--sp-2);
  line-height: 1;
  flex: none;
}

/* 行首图标底：参考图里每行左边有一个浅色小方块（一个 emoji / 一个符号）。
   用 CSS 画一个圆角浅底，里面放一个字 —— 不引图片资源。 */
.row-icon {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  margin-right: var(--sp-3);
  border-radius: var(--radius-sm);
  background: var(--sink);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  line-height: 1;
  color: var(--ink-2);
}

/* ---------- 标签 ----------
   胶囊，浅底，小字。参考图里的「成功 / 提醒 / 错误」三个圆点标签就是这个尺寸。 */
.tag {
  display: inline-flex;
  align-items: center;
  font-size: var(--fs-caption);
  line-height: 1.5;
  padding: 3rpx 14rpx;
  border-radius: var(--radius-pill);
  color: var(--ink-2);
  background: var(--sink);
  margin-right: 10rpx;
}

.tag.amber {
  color: var(--amber);
  background: var(--amber-soft);
}

.tag.red {
  color: var(--red);
  background: var(--red-soft);
}

.tag.blue {
  color: var(--blue);
  background: var(--blue-soft);
}

.tag.green {
  color: var(--green);
  background: var(--green-soft);
}

.tag.ghost {
  color: var(--ink-3);
  background: var(--sink);
}

/* ---------- 搜索框 ----------
   参考图的输入框是「浅底 + 无描边 + 胶囊」：它比页面底深一点点，
   所以看得出是可输入的，又不会因为一道黑边而抢戏。 */
.search {
  display: flex;
  align-items: center;
  background: var(--sink);
  border: 1rpx solid transparent;
  border-radius: var(--radius-pill);
  padding: 0 var(--sp-4);
  height: var(--h-field);
  margin-bottom: var(--sp-2);
}

.search-icon {
  color: var(--ink-3);
  font-size: var(--fs-body);
  margin-right: 12rpx;
}

.search input {
  flex: 1;
  font-size: var(--fs-body);
  color: var(--ink);
}

/* ---------- 文本输入（后端地址这类）---------- */
/* 输入框一律用原生 <input>，样式只统一尺寸与配色 —— 外观改不到它内部，
   这点必须承认，所以只给边框与圆角 */
.field {
  display: flex;
  align-items: center;
  background: var(--sink);
  border: 1rpx solid transparent;
  border-radius: var(--radius-block);
  padding: 0 var(--sp-4);
  height: var(--h-field);
  margin: var(--sp-2) 0;
}

.field-input {
  flex: 1;
  font-size: var(--fs-body);
  color: var(--ink);
}

/* ============================================================
   统计大数字（参考图里最抓眼的一组）
   ============================================================ */
/* 三列并排，每列一个很大的数字 + 一行小标签，中间一道细竖线。

   为什么值得做成共用件：它是参考图里**唯一**一处靠「大」来表达重点的地方。
   上一版表达重点靠的是颜色（主色卡、金边、印章），一屏里好几处在喊，
   结果谁也没被听见。大数字不一样 —— 一屏只有一组，且不用颜色。 */
.stats {
  display: flex;
  align-items: stretch;
}

.stat {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--sp-2) 0;
}

.stat + .stat {
  border-left: 1rpx solid var(--line);
}

.stat-v {
  font-family: var(--font-num);
  font-size: var(--fs-stat);
  font-weight: 600;
  color: var(--ink);
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
  letter-spacing: -1rpx;
}

.stat-k {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: var(--sp-1);
  letter-spacing: var(--ls-caption);
}

/* ---------- 字号滑块 ----------
   「A —— A」这一排。两处用到：阅读页的偏好条、通用设置的正文字号。

   左边一个小 A、右边一个大 A —— 它们说的不是「两个选项」，是**量程的两头**：
   字号是连续量，光一根滑轨加一颗圆钮，在一排图标里看着就是个孤零零的圆圈，
   既不知道调什么，也不知道往哪边变大。

   两处必须长得一样，所以定在这里一处。上一版各写一份，一边用 ink-4、
   一边用 ink-3，小 A 一边 22rpx、一边 24rpx —— 同一样东西两个样子，
   用户说不清哪里别扭，只觉得「不一样」。 */
.font-row {
  display: flex;
  align-items: center;
}

.font-slider {
  flex: 1;
  min-width: 0;
  margin: 0 var(--sp-3);
}

.font-a {
  flex: none;
  font-family: var(--font-poem);
  color: var(--ink-3);
}

.font-a.small {
  font-size: var(--fs-hint);
}

.font-a.big {
  font-size: var(--fs-lead);
}

/* ---------- 字段行（键值对）---------- */
.kv {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 80rpx;
  padding: var(--sp-2) 0;
  border-bottom: 1rpx solid var(--line-2);
}

.kv:last-child,
.kv:last-of-type {
  border-bottom: none;
}

.kv-k {
  font-size: var(--fs-body);
  color: var(--ink-2);
  flex: none;
  padding-right: var(--sp-2);
}

.kv-v {
  font-size: var(--fs-body);
  color: var(--ink);
  text-align: right;
}

/* ---------- 进度：一横一竖两个共同件 ---------- */
/* 横条说「走到哪了」，环说「几比几」。两个都做，别只做一个 */
.meter {
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--line);
  overflow: hidden;
}

.meter-fill {
  height: 100%;
  border-radius: 4rpx;
  background: var(--ink);
  transition: width var(--t-move) var(--ease);
}

/* 环：纯 CSS 锥形渐变，不引 canvas、不带图片资源 */
.ring {
  position: relative;
  flex: none;
}

.ring-track,
.ring-fill {
  position: absolute;
  inset: 0;
  border-radius: 50%;
}

.ring-track {
  background: var(--line);
}

.ring-fill {
  background: conic-gradient(var(--ink) calc(var(--p) * 1%), transparent 0);
  transition: background var(--t-move) var(--ease);
}

.ring::after {
  content: "";
  position: absolute;
  inset: 13%;
  border-radius: 50%;
  background: var(--surface);
  border: 1rpx solid var(--line);
}

.ring-text {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-num);
  font-weight: 600;
  color: var(--ink);
  z-index: 1;
}

/* ---------- 未登录的那张卡 ---------- */
/* 门禁卡在 14 个页面里各有一份，长相必须是同一个 —— 用户才会认得出
   「这是同一道门」，而不是每页一套说法。

   参考图里没有这种卡，但它的语言是有的：一块白底、一枚圆标、
   一句人话、一个墨黑的主按钮。这一版就按这个来 —— 去掉渐变与印泥色。 */
.lock-card {
  text-align: center;
  padding: var(--sp-6) var(--sp-4) var(--sp-4);
  background: var(--surface);
  overflow: hidden;
  position: relative;
}

.lock-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  line-height: 1;
  margin: 0 auto var(--sp-3);
  border-radius: 50%;
  background: var(--ink);
  font-family: var(--font-poem);
  font-size: 54rpx;
  color: var(--on-ink);
}

.lock-title {
  display: block;
  font-size: var(--fs-lead);
  font-weight: 700;
  color: var(--ink);
  font-family: var(--font-poem);
  letter-spacing: var(--ls-title);
}

.lock-btn {
  margin-top: var(--sp-4);
}

/* ---------- 方字格（飞花令的令字）----------
   一个方格 + 一个字 + 一个原生 radio。两处用到（大会首页、飞花令页），
   所以收在这里定一次。

   ⚠️ 上一版把圆点 absolute 到 `right:-6rpx; top:-6rpx`，理由是「中心留给字」——
   结果圆点**压在字的右上一笔上**：「而」「者」「有」的右上角被盖住半个，
   而且缩到 0.6 之后命中区也移了位，点上去要先对准那个偏出去的小圈。

   现在的做法：格子右上角**留出一块空**（padding-top 让字整体下移一点），
   圆点就落在那块空里，不压任何笔画；命中区仍是整个 label（原生 radio
   在 label 里，点格子任何一处都能选中）。 */
.char {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--line-strong);
  background: var(--surface);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  /* 上下各留一口气：上一版是「整块居中」，
     字 + 小字两行合起来比格子高，贴到了上下边框上 */
  padding: 10rpx 0;
  box-sizing: border-box;
}

.char.active {
  background: var(--ink);
  border-color: var(--ink);
}

/* 令字格里**不再画一个圆点**。
   上一版是 absolute 到右上角、缩到 0.56 的原生圆点：小到看不出能点、
   还压在「而」「者」「有」的笔画上，缩过头之后命中区也跟着偏出格子。
   选中态由格子自己的「底色 + 描边 + 字变色」来说明白，够了。
   radio 仍在 label 里（.seg-radio 视觉隐藏），点格子任何一处都选中。 */

.char-t {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-hero);
  color: var(--ink);
  line-height: 1.1;
}

/* 那一行小字（命中数）：它比字低一档，且不许把格子撑高 ——
   给一条固定行高，格子高度才不会随数字位数变 */
.char-n {
  display: block;
  height: 26rpx;
  font-size: var(--fs-pinyin);
  line-height: 26rpx;
  color: var(--ink-4);
}

.char.active .char-t {
  color: var(--on-ink);
}

.char.active .char-n {
  color: var(--on-ink);
  opacity: .6;
}

/* ============================================================
   垂直居中的一条总口径
   ============================================================ */
/* 小程序里「一行里的东西对不齐」几乎只有两个原因：

   1. 用了 `line-height: <比 height 小几 rpx>` 去凑居中 —— 那不是居中，
      是把偏差摊到每一行文字上，字号一换就露
   2. 靠 `align-items: baseline` 排「文字 + 控件」那一行 ——
      缩放过的原生控件基线不在视觉中心，字就跟着偏

   所以这里只给一件事：**行内元素一律走 flex + center**。
   下面这两个选择器覆盖了「一行文字 + 一个原生控件」的全部场景，页面不用再写。 */

.row,
.kv,
.field,
.search,
.pager {
  align-items: center;
}

/* 数字与计数的字宽统一：等宽数字让「几比几」不会随数字变化左右跳 */
.count-num,
.mastery-num,
.ring-text,
.num-v,
.grant-meter-t,
.day-count,
.stage-count,
.exam-progress,
.exam-timer,
.stat-v {
  font-variant-numeric: tabular-nums;
}

/* ---------- 底部安全区垫片 ---------- */
.safe-bottom {
  height: calc(24rpx + env(safe-area-inset-bottom));
}

/* 页脚一句：给整屏一个收束，不然最后一张卡下面像被切断 */
.foot {
  text-align: center;
  padding: var(--sp-1) 0 var(--sp-5);
}

.foot .hint {
  letter-spacing: 1rpx;
}

/* ============================================================
   分段控件（「二选一 / 三选一」的统一长相）
   ============================================================ */
/* 「在哪儿搜」「怎么搜」「左对齐还是居中」「注不注音」——这些都是**互斥的
   少数几个选项**。原来的写法是一排原生单选框：一个空心圆圈 + 两个字。
   圆圈本身没问题（它确实是原生控件），问题是**它不适合这种场合**：

   1. 圆圈与文字挤在一行，两个选项就占掉半屏，一行放不下三个；
   2. 选中态只有「圈里多一个点」，对比度很低，扫不出来；
   3. 「范围」与「方式」两组各排一行圆点，看着像同一组里的六个选项。

   分段控件把「选一个」画成一颗胶囊：选中的那段填墨黑。
   一眼看得出「这组里有几个选项、我选了第几个」。

   底层**仍是原生 radio**：包在 <label> 里、被视觉隐藏。
   点整段就能选中、读屏读得到、键盘走得了 —— 行为全是平台的，
   我们只是换了一张脸。 */
.seg {
  display: flex;
  align-items: center;
}

.seg-group {
  display: flex;
  align-items: stretch;
  border: 1rpx solid transparent;
  border-radius: var(--radius-pill);
  background: var(--sink);
  padding: 4rpx;
  overflow: hidden;
}

/* 一排里只有两段时给它撑满，不然两小段并排看着像被挤在角落 */
.seg.fill .seg-group {
  flex: 1;
}

.seg.fill .seg-item {
  flex: 1;
  justify-content: center;
}

.seg-item {
  position: relative;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 0 22rpx;
  height: var(--h-opt-seg);
  border-radius: var(--radius-pill);
  transition: background-color var(--t-press), color var(--t-press);
}

/* 选中态**填成墨黑**。只把字变色太轻 —— 一层浅灰底上扫不出选中了哪一段 */
.seg-item.on {
  background: var(--ink);
}

.seg-item.on .seg-text {
  color: var(--on-ink);
  font-weight: 600;
}

/* 图标靠 --ic 取色，选中时整块换成白色 */
.seg-item.on .seg-icon,
.seg-item.on .seg-icon::before,
.seg-item.on .seg-icon::after {
  --ic: var(--on-ink);
}

/* 原生 radio 只留行为、不留外观。
   不用 display:none —— 那会让部分机型的读屏也读不到这一项 */
.seg-radio {
  position: absolute;
  width: 1rpx;
  height: 1rpx;
  opacity: 0;
  pointer-events: none;
}

.seg-text {
  font-size: var(--fs-caption);
  color: var(--ink-2);
  letter-spacing: 1rpx;
  white-space: nowrap;
}

.seg-item.on .seg-text {
  letter-spacing: 1rpx;
}

/* ---------- 等长选项的格子 ----------
   年级（12 个）、学期（2 个）、每日首数（5 个）、题型（5 个）这类：
   选项等长、数量不少，排成网格比排成一列省一半高度。
   每一格是一个胶囊 —— 形状本身说「这是个能点的选项」，填色说「选的是它」。

   为什么不给每格配一个原生圆点/方框：它吃掉横向空间（12 个年级就得多一列），
   还跟第一行文字对齐、第二行缩进，看着像它只管辖半格。
   格子排成矩阵这件事，已经把「一组、选一个（或几个）」说清楚了。 */
.chip-group {
  display: grid;
  /* 行内与行间都是 8rpx —— 格子之间要看着是「一组里的几格」，
     所以缝要小。但**两组之间**必须比组内更松（见下面的 chip-group + chip-group）：
     否则上一组的末格与下一组的首格贴在一起，两格都选中时
     会连成一块竖着的黑条，看着像一个被拉长的格子。 */
  gap: var(--sp-1) var(--sp-1);
}

/* 相邻两组格子之间的间距，要比组内大一档 ——
   「学期」与「年级」本来是两组不同的东西，缝太小就看不出分组。 */
.chip-group + .chip-group {
  margin-top: var(--sp-3);
}

.chip-group.cols-2 {
  grid-template-columns: repeat(2, 1fr);
}

.chip-group.cols-3 {
  grid-template-columns: repeat(3, 1fr);
}

.chip-group.cols-4 {
  grid-template-columns: repeat(4, 1fr);
}

.chip {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--h-opt);
  padding: 0 var(--sp-1);
  border: 1rpx solid transparent;
  border-radius: var(--radius-sm);
  background: var(--sink);
  transition: background-color var(--t-press), border-color var(--t-press);
}

.chip.on {
  background: var(--ink);
  border-color: var(--ink);
}

.chip-t {
  font-size: var(--fs-hint);
  color: var(--ink-2);
  line-height: 1.3;
  text-align: center;
}

.chip.on .chip-t {
  color: var(--on-ink);
  font-weight: 600;
}

/* ---------- 竖排的胶囊格（一格一行、占满宽度）----------
   「取诗范围」「复习算法」这两组：选项比学期/年级长（「小学+初中随机」
   「艾宾浩斯遗忘曲线」），排成网格会挤成两行、每格宽度不一。
   但它们**仍然是同一件事**（选一个），所以形状不能变 ——
   仍旧是一格一颗胶囊，只是这一组竖着排、每格占满一行。

   为什么不留原生圆点那一版：它和上面的胶囊格是**两种长相**，
   同一页里「背诵范围」是胶囊、「取诗范围」是圆点，用户说的
   「很多选项是胶囊样式了，但背诵范围和题型等等选项又不是胶囊样式」
   就是这一处。现在一页里只有一种零件，只是排法不同。 */
.chip-group.list {
  grid-template-columns: 1fr;
  gap: var(--sp-1);
}

/* 竖排格：文字靠左，高度**与网格格一模一样**（同为 --h-opt）。
   它做成 column 是为了能带一行小字（锁住的算法写「差在哪一档」）；
   不带小字时，column + center 排出来仍是垂直居中、与网格格等高。

   ⚠️ 上下**不加内边距** —— 只靠 min-height 撑。加了内边距它就比网格格
   高出一截，同一页里两种高度（用户问的「高度、大小、padding 是不是一致」
   正是这一处）。带小字那格让它自然长高，这是唯一允许的例外。 */
.chip-group.list .chip {
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  padding: 0 var(--sp-4);
  min-height: var(--h-opt);
}

/* 竖排格里文字靠左；选中态同样填墨黑，与网格格一致 */
.chip-group.list .chip-t {
  text-align: left;
}

.chip-sub {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 4rpx;
  line-height: 1.4;
}

.chip.on .chip-sub {
  color: var(--on-ink);
  opacity: .7;
}

/* 锁住的那一格（能力不够，点了也没用）：整格压暗，且**不给按下反馈** */
.chip.locked {
  opacity: .45;
}

/* 多选的格子：形状与单选的一样，但**选中态多一个勾** ——
   单选和多选在一屏里同时出现时（题库：范围是单选、题型是多选），
   光看填色分不出来哪个是哪个。那一勾就是「可以多选」的唯一线索，
   所以它必须画出来，不能省。

   勾用两条边框拼（右下角一道 45° 的短折线），不引图标字体。 */
/* 一勾两态：**没选中也要看得见**，否则「这里可以多选」就只在选中后才存在。
   未选中给一个空心方框，选中换成实心的勾 —— 与原生复选框的语义一致，
   只是不再站到选项前面去占地方。 */
.chip.multi::after {
  content: "";
  position: absolute;
  right: 10rpx;
  top: 10rpx;
  width: 12rpx;
  height: 12rpx;
  border: 2rpx solid var(--ink-4);
  border-radius: 3rpx;
}

/* 选中：空心方框换成实心勾。
   勾由两条边拼出来（左 + 下，再转 -45°），所以它的**尺寸要比方框小一点**、
   位置也要往右下挪一点 —— 旋转是绕中心转的，不挪的话勾尖会翘出格子角。
   它是「这一格可多选」的唯一线索，所以未选中时那个方框也必须画出来。 */
.chip.multi.on::after {
  right: 12rpx;
  top: 13rpx;
  width: 15rpx;
  height: 8rpx;
  border: none;
  border-left: 3rpx solid var(--on-ink);
  border-bottom: 3rpx solid var(--on-ink);
  border-radius: 0;
  transform: rotate(-45deg);
}

/* 小号：一章里连着两组（搜索页）时用，别把卡片撑高 */
.seg-item.mini {
  height: 48rpx;
  padding: 0 16rpx;
}

.seg + .field-label,
.field-label + .seg {
  margin-top: var(--sp-1);
}

/* ---------- 图标：全用 CSS 画 ----------
   一组图标只是为了说「这是哪一个选项」，不值得引图片资源 ——
   主包余量不多。三种笔画足够画出这几个意思。 */
.seg-icon {
  position: relative;
  flex: none;
  width: 26rpx;
  height: 26rpx;
  --ic: var(--ink-2);
}

.seg-icon::before,
.seg-icon::after {
  content: "";
  position: absolute;
  background: var(--ic);
}

/* 左对齐：三道线左端齐、长短不一 */
.ic-left::before {
  left: 0;
  top: 3rpx;
  width: 26rpx;
  height: 3rpx;
  box-shadow: 0 8rpx 0 var(--ic), 0 16rpx 0 var(--ic);
}

.ic-left::after {
  left: 0;
  top: 3rpx;
  width: 15rpx;
  height: 3rpx;
}

/* 居中：三道线都居中、长短不一 */
.ic-center::before {
  left: 0;
  top: 3rpx;
  width: 26rpx;
  height: 3rpx;
  box-shadow: 0 8rpx 0 var(--ic), 0 16rpx 0 var(--ic);
}

.ic-center::after {
  left: 5rpx;
  top: 3rpx;
  width: 15rpx;
  height: 3rpx;
}

/* 不注音：一道斜杠划掉一个圆 */
.ic-off::before {
  left: 3rpx;
  top: 3rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: transparent;
  border: 3rpx solid var(--ic);
}

.ic-off::after {
  left: 1rpx;
  top: 11rpx;
  width: 24rpx;
  height: 3rpx;
  transform: rotate(-45deg);
}

/* 生字：一个字 + 头上一点（「只标几个字」，那一点就是标记） */
.ic-rare::before {
  left: 8rpx;
  top: 9rpx;
  width: 15rpx;
  height: 15rpx;
  border: 3rpx solid var(--ic);
  background: transparent;
}

.ic-rare::after {
  left: 11rpx;
  top: 2rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--ic);
}

/* 全文：三组「字 + 小点」横着排 */
.ic-all::before {
  left: 0;
  top: 4rpx;
  width: 7rpx;
  height: 7rpx;
  background: var(--ic);
  box-shadow: 10rpx 0 0 var(--ic), 20rpx 0 0 var(--ic);
}

.ic-all::after {
  left: 0;
  top: 14rpx;
  width: 26rpx;
  height: 3rpx;
  background: var(--ic);
}

/* 全站 / 课内：地球（圆 + 一道纬线）与 一册书（两页） */
.ic-all-site::before {
  left: 2rpx;
  top: 2rpx;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: transparent;
  border: 3rpx solid var(--ic);
}

.ic-all-site::after {
  left: 2rpx;
  top: 11rpx;
  width: 22rpx;
  height: 3rpx;
}

.ic-course::before {
  left: 1rpx;
  top: 3rpx;
  width: 24rpx;
  height: 20rpx;
  border: 3rpx solid var(--ic);
  background: transparent;
  border-radius: 2rpx;
}

.ic-course::after {
  left: 12rpx;
  top: 4rpx;
  width: 3rpx;
  height: 18rpx;
}

/* 篇名作者 / 正文全文：一行字 与 一整页字 */
.ic-title::before {
  left: 0;
  top: 5rpx;
  width: 26rpx;
  height: 4rpx;
  border-radius: 2rpx;
  box-shadow: 0 9rpx 0 var(--ic), 0 18rpx 0 var(--ic);
}

.ic-full::before {
  left: 0;
  top: 4rpx;
  width: 12rpx;
  height: 3rpx;
  box-shadow: 0 7rpx 0 var(--ic), 0 14rpx 0 var(--ic), 0 21rpx 0 var(--ic);
}

.ic-full::after {
  left: 15rpx;
  top: 4rpx;
  width: 11rpx;
  height: 3rpx;
  box-shadow: 0 7rpx 0 var(--ic), 0 14rpx 0 var(--ic), 0 21rpx 0 var(--ic);
}

/* ============================================================
   分段标题（一屏里分隔两组卡片的那行小字）
   ============================================================ */
/* 参考图里「卡片与数据 / 按钮与页签 / 输入、标签与状态」各是一枚浅灰胶囊，
   独立于上下卡片，说明「下面这组是什么」。它比 card-title 轻，且不占卡片。 */
.section-label {
  display: inline-flex;
  align-items: center;
  font-size: var(--fs-caption);
  color: var(--ink-2);
  letter-spacing: var(--ls-caption);
  background: var(--sink);
  border-radius: var(--radius-pill);
  padding: 8rpx 22rpx;
  margin: var(--sp-2) 0 var(--sp-2);
}
