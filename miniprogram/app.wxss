@import "styles/tokens.wxss";

view, text, button, input, textarea {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: var(--sp-3) var(--page-x) calc(24rpx + env(safe-area-inset-bottom));
}

.page.has-tabbar {
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.page.has-tabbar .safe-bottom {
  display: none;
}

.page-head {
  padding: var(--sp-2) var(--sp-1) var(--sp-4);
}

.head-title {
  display: block;
  font-size: var(--fs-head);
  font-weight: 700;
  color: var(--strong-text);
  letter-spacing: var(--ls-title);
  line-height: var(--lh-tight);
}

.head-title.poem {
  font-family: var(--font-poem);
}

.head-sub {
  display: block;
  font-size: var(--fs-hint);
  color: var(--ink-3);
  letter-spacing: var(--ls-caption);
  margin-top: var(--sp-2);
}

.card {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: var(--sp-4);
  margin-bottom: var(--sp-3);
}

.page-head + .card {
  margin-top: 0;
}

.card-title {
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--strong-text);
  margin-bottom: var(--sp-1);
}

.card-title.bar {
  display: flex;
  align-items: center;
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--strong-text);
  margin-bottom: var(--sp-2);
}

.hint {
  font-size: var(--fs-hint);
  color: var(--ink-3);
  line-height: var(--lh-body);
}

.count-line {
  display: block;
  padding-top: var(--sp-2);
  font-size: var(--fs-hint);
  color: var(--ink-3);
}

.sub-title {
  display: block;
  font-size: var(--fs-hint);
  color: var(--ink-2);
  margin: var(--sp-3) 0 var(--sp-1);
}

.field-label {
  display: block;
  font-size: var(--fs-hint);
  color: var(--ink-3);
  letter-spacing: var(--ls-caption);
  line-height: 1.4;
  margin-bottom: 4rpx;
}

.divider {
  height: 1rpx;
  background: var(--line-2);
  margin: var(--sp-3) 0;
}

.empty {
  padding: var(--sp-6) var(--sp-3) var(--sp-5);
  text-align: center;
}

.empty-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  margin: 0 auto var(--sp-2);
  border-radius: 50%;
  background: var(--sink);
  font-family: var(--font-poem);
  font-size: 46rpx;
  line-height: 1;
  color: var(--ink-4);
}

.empty-text {
  display: block;
  font-size: var(--fs-title);
  color: var(--ink-2);
  line-height: var(--lh-loose);
}

.empty-tip {
  display: block;
  margin-top: var(--sp-1);
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: var(--h-btn);
  padding: 0 var(--sp-4);

  border-radius: var(--radius-ctl);
  background: var(--surface);
  border: 1rpx solid var(--line-strong);
  color: var(--ink);
  font-size: var(--fs-title);
  font-weight: 500;
  line-height: 1.2;
  letter-spacing: var(--ls-title);
  text-align: center;
  transition: background-color var(--t-press), transform var(--t-press), opacity var(--t-press);
}

.btn::after {
  border: none;
}

.btn.primary {
  background: var(--strong);
  border-color: var(--strong);
  color: var(--on-ink);
  font-weight: 600;
}

.btn.primary.button-hover {
  background: var(--ink-strong);
  border-color: var(--ink-strong);
  opacity: .92;
  transform: scale(.985);
}

.btn.ghost {
  background: transparent;
  color: var(--ink-2);
  border-color: var(--line-strong);
}

.btn.danger {
  color: var(--red);
  border-color: var(--red-edge);
  background: var(--red-soft);
}

.btn.block {
  width: 100%;
}

.btn.block + .btn.block {
  margin-top: var(--sp-2);
}

.actions {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  margin-top: var(--sp-3);
}

.actions .btn {
  flex: 1;
}

.btn.mini {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-width: 0;
  height: var(--h-btn-mini);
  padding: 0 var(--sp-3);
  font-size: var(--fs-hint);
  line-height: 1.2;
  border-radius: var(--radius-pill);
}

.btn[disabled] {
  opacity: .4;
  box-shadow: none;
}

.btn.button-hover {
  opacity: .86;
  transform: scale(.985);
}

.row-hover {
  background: var(--sink);
}

.row {
  display: flex;
  align-items: center;
  min-height: var(--h-row);
  padding: var(--sp-2) 0;
  border-bottom: 1rpx solid var(--line-2);
  border-radius: var(--radius-sm);
  transition: background-color var(--t-press);
}

.row:last-child {
  border-bottom: none;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-title {
  font-family: var(--font-ui);
  font-size: var(--fs-title);
  color: var(--strong-text);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-poem {
  font-family: var(--font-poem);

  color: var(--ink);
}

.row-sub {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 6rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-go {
  color: var(--ink-4);
  font-size: 32rpx;
  padding-left: var(--sp-2);
  line-height: 1;
  flex: none;
}

.row-icon {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  margin-right: var(--sp-3);
  border-radius: var(--radius-sm);
  background: var(--sink);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  line-height: 1;
  color: var(--ink-2);
}

.tag {
  display: inline-flex;
  align-items: center;

  flex: none;
  white-space: nowrap;
  font-size: var(--fs-caption);
  line-height: 1.5;

  padding: var(--pad-opt-y) var(--pad-opt-x);
  border-radius: var(--radius-pill);
  color: var(--ink-2);
  background: var(--sink);
  margin-right: 10rpx;
}

.tag.amber {
  color: var(--amber);
  background: var(--amber-soft);
}

.tag.red {
  color: var(--red);
  background: var(--red-soft);
}

.tag.blue {
  color: var(--blue);
  background: var(--blue-soft);
}

.tag.green {
  color: var(--green);
  background: var(--green-soft);
}

.tag.ghost {
  color: var(--ink-3);
  background: var(--sink);
}

.tag.gold {
  color: var(--amber);
  background: var(--gold-soft);
}

.search {
  display: flex;
  align-items: center;
  background: var(--sink);
  border: 1rpx solid transparent;
  border-radius: var(--radius-pill);
  padding: 0 var(--sp-4);
  height: var(--h-field);
  margin-bottom: var(--sp-2);
}

.search-icon {
  color: var(--ink-3);
  font-size: var(--fs-body);
  margin-right: 12rpx;
}

.search input {
  flex: 1;
  font-size: var(--fs-body);
  color: var(--ink);
}

.field {
  display: flex;
  align-items: center;
  background: var(--sink);
  border: 1rpx solid transparent;
  border-radius: var(--radius-block);
  padding: 0 var(--sp-4);
  height: var(--h-field);
  margin: var(--sp-2) 0;
}

.field-input {
  flex: 1;
  font-size: var(--fs-body);
  color: var(--ink);
}

.stats {
  display: flex;
  align-items: stretch;
}

.stat {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--sp-2) 0;
}

.stat + .stat {
  border-left: 1rpx solid var(--line);
}

.stat-v {
  font-family: var(--font-num);
  font-size: var(--fs-stat);
  font-weight: 600;
  color: var(--strong-text);
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
  letter-spacing: -1rpx;
}

.stat-k {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: var(--sp-1);
  letter-spacing: var(--ls-caption);
}

.pref-item {
  line-height: 1.4;
}

.pref-item radio,
.pref-item checkbox {
  margin-right: var(--sp-2);
}

.font-row {
  display: flex;
  align-items: center;
}

.font-slider {
  flex: 1;
  min-width: 0;
  margin: 0 var(--sp-3);
}

.font-a {
  flex: none;
  font-family: var(--font-poem);
  color: var(--ink-3);
}

.font-a.small {
  font-size: var(--fs-hint);
}

.font-a.big {
  font-size: var(--fs-lead);
}

.opt-group {
  display: flex;
  flex-wrap: wrap;

  column-gap: var(--pad-opt-x);
  row-gap: var(--pad-opt-y);
}

.opt-group.column {
  flex-direction: column;
  gap: var(--pad-opt-y);
}

.opt-group.inline {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
}

.opt-group.inline .opt-row {
  justify-content: center;

  text-align: center;
}

.opt-group.inline .opt-main {
  flex: none;
  min-width: 0;
  padding: 0;
}

.opt-group.inline .opt-name {
  line-height: 1.25;
}

.opt-group.inline.cols-2 {
  grid-template-columns: repeat(2, 1fr);
}

.opt-group.inline.cols-4 {
  grid-template-columns: repeat(4, 1fr);
}

.opt-row {
  position: relative;
  display: flex;
  align-items: center;
  min-height: var(--h-opt);
  padding: var(--pad-opt-y) var(--pad-opt-x);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-ctl);
  background: var(--surface);
  transition: background-color var(--t-press), border-color var(--t-press);
}

.opt-row.active {
  background: var(--strong);
  border-color: var(--strong);
}

.opt-row.active .opt-name {
  color: var(--on-ink);
  font-weight: 600;
}

.opt-row.active .opt-desc {
  color: var(--on-ink-soft);
}

.opt-row.locked {
  opacity: .45;
}

.opt-radio {
  position: absolute;
  width: 1rpx;
  height: 1rpx;
  opacity: 0;
  pointer-events: none;
}

.opt-main {
  flex: 1;
  min-width: 0;
}

.opt-name {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-title);
  color: var(--ink);
  line-height: 1.4;
}

.opt-group.inline .opt-name {
  font-size: var(--fs-hint);
}

.opt-desc {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 6rpx;
  line-height: 1.6;
}

.pref-item {
  display: flex;
  align-items: center;
  min-height: 60rpx;
  font-size: var(--fs-hint);
  color: var(--ink-2);
  margin-right: var(--sp-3);
}

.pref-item radio,
.pref-item checkbox {
  transform: scale(.8);
}

.chip-row {
  white-space: nowrap;
  margin-bottom: var(--sp-2);
}

.chip-row .pref-item {
  display: inline-flex;
  margin-right: var(--sp-2);
}

.kv {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 80rpx;
  padding: var(--sp-2) 0;
  border-bottom: 1rpx solid var(--line-2);
}

.kv:last-child,
.kv:last-of-type {
  border-bottom: none;
}

.kv-k {
  font-size: var(--fs-body);
  color: var(--ink-2);
  flex: none;
  padding-right: var(--sp-2);
}

.kv-v {
  font-size: var(--fs-body);

  color: var(--ink);
  text-align: right;
}

.meter {
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--line);
  overflow: hidden;
}

.meter-fill {
  height: 100%;
  border-radius: 4rpx;
  background: var(--strong);
  transition: width var(--t-move) var(--ease);
}

.ring {
  position: relative;
  flex: none;
}

.ring-track,
.ring-fill {
  position: absolute;
  inset: 0;
  border-radius: 50%;
}

.ring-track {
  background: var(--line);
}

.ring-fill {
  background: conic-gradient(var(--strong) calc(var(--p) * 1%), transparent 0);
  transition: background var(--t-move) var(--ease);
}

.ring::after {
  content: "";
  position: absolute;
  inset: 13%;
  border-radius: 50%;
  background: var(--surface);
  border: 1rpx solid var(--line);
}

.ring-text {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-num);
  font-weight: 600;
  color: var(--strong-text);
  z-index: 1;
}

.lock-card {
  text-align: center;
  padding: var(--sp-6) var(--sp-4) var(--sp-4);
  background: var(--surface);
  overflow: hidden;
  position: relative;
}

.lock-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  line-height: 1;
  margin: 0 auto var(--sp-3);
  border-radius: 50%;
  background: var(--strong);
  font-family: var(--font-poem);
  font-size: 54rpx;
  color: var(--on-ink);
}

.lock-title {
  display: block;
  font-size: var(--fs-lead);
  font-weight: 700;
  color: var(--ink);
  font-family: var(--font-poem);
  letter-spacing: var(--ls-title);
}

.lock-note {
  display: block;
  margin-top: var(--sp-2);
  font-size: var(--fs-hint);
  line-height: 1.5;
  color: var(--ink-3);
}

.lock-btn {
  margin-top: var(--sp-4);
}

.char {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--line-strong);
  background: var(--surface);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  padding: 10rpx 0;
  box-sizing: border-box;
}

.char.active {
  background: var(--strong);
  border-color: var(--strong);
}

.char-t {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-hero);
  color: var(--ink);
  line-height: 1.1;
}

.char-n {
  display: block;
  height: 26rpx;
  font-size: var(--fs-pinyin);
  line-height: 26rpx;
  color: var(--ink-4);
}

.char.active .char-t {
  color: var(--on-ink);
}

.char.active .char-n {
  color: var(--on-ink);
  opacity: .6;
}

.row,
.kv,
.pref-item,
.opt-row,
.field,
.search,
.pager {
  align-items: center;
}

.count-num,
.mastery-num,
.ring-text,
.num-v,
.grant-meter-t,
.day-count,
.stage-count,
.exam-progress,
.exam-timer,
.stat-v {
  font-variant-numeric: tabular-nums;
}

.safe-bottom {
  height: calc(24rpx + env(safe-area-inset-bottom));
}

.foot {
  text-align: center;
  padding: var(--sp-1) 0 var(--sp-5);
}

.foot .hint {
  letter-spacing: 1rpx;
}

.seg {
  display: flex;
  align-items: center;
}

.seg-group {
  display: flex;
  align-items: stretch;
  flex: 1;
  border: 1rpx solid transparent;
  border-radius: var(--radius-pill);
  background: var(--sink);
  padding: 4rpx;
  overflow: hidden;
}

.seg-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  gap: 8rpx;
  padding: 0 var(--sp-2);
  height: 60rpx;
  border-radius: var(--radius-pill);
  transition: background-color var(--t-press), color var(--t-press);
}

.seg-item.on {
  background: var(--strong);
}

.seg-item.on .seg-text {
  color: var(--on-ink);
  font-weight: 600;
}

.seg-item.on .seg-icon {
  color: var(--on-ink);
}

.seg-radio {
  position: absolute;
  width: 1rpx;
  height: 1rpx;
  opacity: 0;
  pointer-events: none;
}

.seg-text {
  font-size: var(--fs-hint);
  color: var(--ink);
  letter-spacing: 1rpx;
  white-space: nowrap;
}

.seg-item.on .seg-text {
  letter-spacing: 1rpx;
}

.chip-group {
  display: grid;

  gap: var(--sp-1) var(--sp-1);
}

.chip-group + .chip-group {
  margin-top: var(--sp-3);
}

.chip-group.cols-2 {
  grid-template-columns: repeat(2, 1fr);
}

.chip-group.cols-3 {
  grid-template-columns: repeat(3, 1fr);
}

.chip-group.cols-4 {
  grid-template-columns: repeat(4, 1fr);
}

.chip {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--h-opt);

  padding: var(--pad-opt-y) var(--pad-opt-x);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-ctl);
  background: var(--surface);
  transition: background-color var(--t-press), border-color var(--t-press);
}

.chip.on {
  background: var(--strong);
  border-color: var(--strong);
}

.chip.multi:not(.on) {
  background: var(--sink);
}

.chip-t {
  font-size: var(--fs-hint);
  color: var(--ink);
  line-height: 1.3;
  text-align: center;
}

.chip.on .chip-t {
  color: var(--on-ink);
  font-weight: 600;
}

.chip.multi {

  padding-left: var(--pad-opt-x);
  padding-right: var(--pad-opt-x);
}

.seg-item.mini {
  height: 48rpx;
  padding: 0 16rpx;
}

.seg + .field-label,
.field-label + .seg {
  margin-top: var(--sp-1);
}

.seg-icon {
  position: relative;
  flex: none;
  width: 24rpx;
  height: 24rpx;
  --ic: currentColor;
  color: var(--ink-2);

}

.seg-icon::before,
.seg-icon::after {
  content: "";
  position: absolute;
  background: var(--ic);
  border-radius: 2rpx;
}

.ic-left::before {
  left: 2rpx;
  top: 4rpx;
  width: 20rpx;
  height: 2.5rpx;
  box-shadow: 0 7rpx 0 var(--ic), 0 14rpx 0 var(--ic);
}

.ic-left::after {
  left: 2rpx;
  top: 11rpx;
  width: 13rpx;
  height: 2.5rpx;
}

.ic-center::before {
  left: 2rpx;
  top: 4rpx;
  width: 20rpx;
  height: 2.5rpx;
  box-shadow: 0 7rpx 0 var(--ic), 0 14rpx 0 var(--ic);
}

.ic-center::after {
  left: 5.5rpx;
  top: 11rpx;
  width: 13rpx;
  height: 2.5rpx;
}

.ic-off::before {
  left: 2rpx;
  top: 2rpx;
  width: 20rpx;
  height: 20rpx;
  border: 2.5rpx solid var(--ic);
  border-radius: 50%;
  background: transparent;
  box-sizing: border-box;
}

.ic-off::after {
  left: 4rpx;
  top: 10.5rpx;
  width: 16rpx;
  height: 2.5rpx;
  transform: rotate(-45deg);
}

.ic-rare::before {
  left: 2rpx;
  top: 6rpx;
  width: 8rpx;
  height: 2.5rpx;
}

.ic-rare::after {
  left: 2rpx;
  top: 12rpx;
  width: 8rpx;
  height: 2.5rpx;
}

.ic-all::before {
  left: 2rpx;
  top: 5rpx;
  width: 5rpx;
  height: 2.5rpx;
  box-shadow: 7.5rpx 0 0 var(--ic), 15rpx 0 0 var(--ic);
}

.ic-all::after {
  left: 2rpx;
  top: 11rpx;
  width: 18rpx;
  height: 2.5rpx;
}

.section-label {
  display: inline-flex;
  align-items: center;
  font-size: var(--fs-caption);
  color: var(--ink-2);
  letter-spacing: var(--ls-caption);
  background: var(--sink);
  border-radius: var(--radius-pill);
  padding: 8rpx 22rpx;
  margin: var(--sp-2) 0 var(--sp-2);
}

.poem-head {
  text-align: center;
  padding: var(--sp-2) 0 var(--sp-3);
}

.poem-title {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-hero);
  font-weight: 600;
  color: var(--ink);
  letter-spacing: var(--ls-title);
  line-height: 1.45;
}

.poem-meta-row {
  display: flex;
  align-items: center;
  justify-content: center;

  flex-wrap: nowrap;
  margin-top: var(--sp-2);
}

.poem-meta {
  font-size: var(--fs-caption);
  color: var(--ink-2);

  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.poem-meta.stage {
  color: var(--ink-3);
}

.poem-dot {
  font-size: var(--fs-caption);
  color: var(--ink-4);
  padding: 0 12rpx;
}

.poem-note {

  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: nowrap;
  margin-top: var(--sp-1);
}

.poem-note-t {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  white-space: nowrap;
}

.poem-note-dot {
  font-size: var(--fs-caption);
  color: var(--ink-4);
  padding: 0 12rpx;
}

.prefs {
  display: flex;
  align-items: center;

  flex-wrap: nowrap;
  justify-content: center;
  padding: var(--sp-1) 0 var(--sp-2);
}

.pref-seg {
  display: flex;
  align-items: center;
  flex: none;
}

.pref-rule {
  flex: none;
  width: 1rpx;
  height: 20rpx;
  margin: 0 var(--sp-1);
  background: var(--line-strong);
}

.pref-opt {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  height: 40rpx;
  padding: 0 var(--sp-1);
  border-radius: var(--radius-sm);
  transition: background-color var(--t-press);
}

.pref-opt.on {
  background: var(--strong);
}

.pref-t {
  font-size: var(--fs-caption);
  color: var(--ink);
  letter-spacing: 1rpx;
  white-space: nowrap;
}

.pref-opt.on .pref-t {
  color: var(--on-ink);
  font-weight: 600;
}

.pref-size {
  display: flex;
  align-items: center;
  flex: none;
}

.pref-opt.mini {
  padding: 0 var(--sp-1);
}

.pref-opt.off .pref-t {
  color: var(--ink-4);
}

.pref-opt-hover {
  background: var(--sink);
}

.pref-opt .opt-radio,
.pref-opt radio {
  position: absolute;
  width: 1rpx;
  height: 1rpx;
  opacity: 0;
  pointer-events: none;
}

.pref-plus {
  margin-left: var(--sp-3);
  min-width: 44rpx;
  border: 1rpx solid var(--line-strong);
}

.pref-plus.on {
  background: var(--strong);
  border-color: var(--strong);
}

.pref-plus.on .pref-t {
  color: var(--on-ink);
}

.poem-body {
  padding: 0 var(--sp-1) var(--sp-2);
  font-family: var(--font-poem);

  line-height: 1.95;
}

.poem-body.align-center {
  text-align: center;
}

.poem-body.align-left {
  text-align: left;
}

.poem-stanza + .poem-stanza {
  margin-top: var(--sp-3);
}

.poem-line {
  display: block;
  font-size: var(--fs-poem);
  color: var(--ink);
  letter-spacing: 2rpx;
}

.poem-body.size--2 .poem-line { font-size: 30rpx; }
.poem-body.size--1 .poem-line { font-size: 33rpx; }
.poem-body.size-0 .poem-line { font-size: 36rpx; }
.poem-body.size-1 .poem-line { font-size: 39rpx; }
.poem-body.size-2 .poem-line { font-size: 42rpx; }
.poem-body.size-3 .poem-line { font-size: 46rpx; }
.poem-body.size-4 .poem-line { font-size: 52rpx; }

.poem-body.align-left .poem-line {
  padding-left: var(--sp-2);
  border-left: 3rpx solid transparent;
}

.token-line {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: flex-end;
  width: 100%;
  border-radius: var(--radius-sm);
  transition: background-color var(--t-move);
  height: var(--py-line);
  line-height: 1;
}

.poem-line.token-line {
  line-height: 1;
}

.poem-body.align-left .token-line {
  justify-content: flex-start;
}

.token {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  width: var(--py-box);
  height: var(--py-box);
  margin: 0 var(--py-gap);

  vertical-align: bottom;
}

.token.punc {
  width: calc(var(--py-box) / 2);
}

.tk-py {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  width: 100%;
  height: var(--py-slot);
  font-family: var(--font-ui);
  font-size: var(--fs-pinyin);
  color: var(--celadon);
  line-height: 1;
  white-space: nowrap;
}

.tk-ch {
  color: var(--ink);
  line-height: 1;
}

.poem-body.size--2 { --py-box: 34rpx; --py-slot: 34rpx; --py-line: 72rpx; font-size: 30rpx; }
.poem-body.size--1 { --py-box: 37rpx; --py-slot: 34rpx; --py-line: 75rpx; font-size: 33rpx; }
.poem-body.size-0  { --py-box: 40rpx; --py-slot: 34rpx; --py-line: 78rpx; font-size: 36rpx; }
.poem-body.size-1  { --py-box: 44rpx; --py-slot: 34rpx; --py-line: 82rpx; font-size: 39rpx; }
.poem-body.size-2  { --py-box: 47rpx; --py-slot: 34rpx; --py-line: 85rpx; font-size: 42rpx; }
.poem-body.size-3  { --py-box: 51rpx; --py-slot: 34rpx; --py-line: 89rpx; font-size: 46rpx; }
.poem-body.size-4  { --py-box: 58rpx; --py-slot: 34rpx; --py-line: 96rpx; font-size: 52rpx; }

.token {
  letter-spacing: 0;
}
.poem-body .token-line {
  letter-spacing: 0;
}

.trans-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-1) 0;
  border-radius: var(--radius-sm);
  transition: background-color var(--t-press);
}

.trans-head.closed {
  min-height: var(--h-btn-mini);
}

.trans-hover {
  background: var(--green-light);
}

.trans-head .card-title {
  margin-bottom: 0;
}

.trans-toggle {
  font-size: var(--fs-hint);
  color: var(--ink-2);
  flex: none;
  padding-left: var(--sp-2);
}

.trans-text {
  display: block;
  font-size: var(--fs-body);
  color: var(--ink-2);
  line-height: var(--lh-loose);
  padding-top: var(--sp-2);
}

.trans-src {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: var(--sp-2);
  padding-top: var(--sp-2);
  border-top: 1rpx solid var(--line-2);
}
