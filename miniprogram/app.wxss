@import "styles/tokens.wxss";

view, text, button, input, textarea {
  box-sizing: border-box;
}

button, textarea {
  font-weight: 400;
}

button, input, textarea {
  font-family: inherit;
}

.page {
  font-family: var(--font-ui);
  min-height: 100vh;
  padding: var(--sp-3) var(--sp-3);
}

.page.has-tabbar {
  padding-bottom: var(--pad-tab);
}

.page.has-tabbar .safe-bottom {
  display: none;
}

.page.tall {
  padding-bottom: var(--pad-tab);
}

.page-head {
  padding: var(--sp-2) var(--sp-1) var(--sp-4);
}

.head-title {
  display: block;
  font-size: var(--fs-head);
  font-weight: 400;
  color: var(--strong-text);
  letter-spacing: var(--ls-title);
  line-height: var(--lh-tight);
}

.head-title.poem {
  font-family: var(--font-poem);
}

.head-sub {
  display: block;
  font-size: var(--fs-hint);
  color: var(--ink-3);
  letter-spacing: var(--ls-caption);
  margin-top: var(--sp-2);
}

.poem {
  font-family: var(--font-poem);
}

.card {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: var(--card-y) var(--card-x);
  margin-bottom: var(--sp-2);
}

/* 没有标题行的卡片，顶上由卡片自己留白 —— 标题那份下间距不会各减一半 */
.card:not(:has(> .card-title)) {
  padding-top: var(--sp-4);
}

.page + .card,
.page-head + .card {
  margin-top: 0;
}

.card-title {
  display: block;
  font-size: var(--fs-title);
  font-weight: 400;
  color: var(--strong-text);
  line-height: var(--lh-tight);
  margin-bottom: var(--card-title-gap);
}

.card-open > .card-title {
  margin-bottom: 0;
}

.card-head > .card-title {
  margin-bottom: 0;
}

.card-open > .card-title {
  padding: var(--card-row-pad) 0;
}

.card-open > .card-sub {
  padding: var(--card-row-pad) 0;
}

.card-open > .row-go,
.card-open > .all-count {
  align-self: center;
}

.card-title.plain {
  font-weight: 400;
}

.hint {
  font-size: var(--fs-hint);
  color: var(--ink-3);
  line-height: var(--lh-body);
}

.count-line {
  display: block;
  padding-top: var(--sp-2);
  font-size: var(--fs-hint);
  color: var(--ink-3);
}

.sub-title {
  display: block;
  font-size: var(--fs-hint);
  color: var(--ink-2);
  margin: var(--sp-3) 0 var(--sp-1);
}

.field-label {
  display: block;
  font-size: var(--fs-hint);
  color: var(--ink-3);
  letter-spacing: var(--ls-caption);
  line-height: 1.4;
  margin-bottom: 4rpx;
}

.divider {
  height: 1rpx;
  background: var(--line-2);
  margin: 0 0 var(--card-title-gap);
}

.empty {
  padding: var(--sp-6) var(--sp-3) var(--sp-5);
  text-align: center;
}

.empty-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  margin: 0 auto var(--sp-2);
  border-radius: 50%;
  background: var(--sink);
  font-family: var(--font-poem);
  font-size: 46rpx;
  line-height: 1;
  color: var(--ink-4);
}

.empty-text {
  display: block;
  font-size: var(--fs-title);
  color: var(--ink-2);
  letter-spacing: var(--ls-title);
  line-height: var(--lh-loose);
}

.empty-text.say {
  font-family: var(--font-poem);
}

.empty-tip {
  display: block;
  margin-top: var(--sp-1);
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: var(--h-btn);
  padding: 0 var(--sp-4);

  border-radius: var(--radius-pill);
  background: var(--surface);
  border: 1rpx solid var(--line-strong);
  color: var(--ink);
  font-size: var(--fs-title);
  line-height: 1.2;
  letter-spacing: var(--ls-title);
  text-align: center;
  white-space: nowrap;
  min-width: 0;
  transition: background-color var(--t-press), transform var(--t-press), opacity var(--t-press);
}

.btn::after {
  border: none;
}

.btn.primary {
  background: var(--strong);
  border-color: var(--strong);
  color: var(--on-ink);
}

.btn.primary.button-hover {
  background: var(--ink-strong);
  border-color: var(--ink-strong);
  opacity: .92;
  transform: scale(.985);
}

.btn.ghost {
  background: transparent;
  color: var(--ink-2);
  border-color: var(--line-strong);
}

.btn.ghost.button-hover {
  opacity: .7;
}

.btn.danger {
  color: var(--red);
  border-color: var(--red-edge);
  background: var(--red-soft);
}

.btn.block {
  width: var(--w-btn);
  margin-left: auto;
  margin-right: auto;
}

.btn.block + .btn.block {
  margin-top: var(--sp-2);
}

.actions {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  margin-top: var(--sp-3);
}

.stack {
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
  margin-bottom: var(--sp-2);
}

.stack .card {
  margin-bottom: 0;
}

.inline-btns {
  display: flex;
  flex-wrap: nowrap;
  gap: var(--sp-1);
}

.btn.mini {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-width: 0;
  height: var(--h-btn-mini);
  padding: 0 var(--sp-3);
  font-size: var(--fs-caption);
  line-height: 1.2;
  border-radius: var(--radius-pill);
  white-space: nowrap;
}

.actions .btn,
.inline-btns .btn.mini {
  flex: 1;
  padding: 0;
  max-width: var(--w-btn);
}

.btn[disabled] {
  opacity: .4;
  box-shadow: none;
}

.btn.button-hover {
  opacity: .86;
  transform: scale(.985);
}

.row-hover {
  background: var(--sink);
}

.row-main-tap {
  border-radius: var(--radius-sm);
  transition: opacity var(--t-press);
}

.row-main-hover {
  opacity: .55;
}

.row {
  display: flex;
  align-items: center;
  min-height: var(--h-row);
  padding: var(--sp-2) 0;
  border-bottom: 1rpx solid var(--line-2);
  transition: background-color var(--t-press);
}

.row:last-child {
  border-bottom: none;
}

.row-flush {
  padding-left: 0;
  padding-right: 0;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-title {
  font-family: var(--font-ui);
  font-size: var(--fs-title);
  color: var(--strong-text);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.gc-name {
  display: block;
  flex: 1;
  min-width: 0;
  font-family: var(--font-poem);
  font-size: var(--fs-lead);
  font-weight: 400;
  color: var(--strong-text);
  letter-spacing: var(--ls-title);
}

.seq {
  flex: none;
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 48rpx;
  height: 36rpx;
  padding: 0 var(--sp-1);
  margin-right: var(--sp-2);
  border-radius: var(--radius-pill);
  background: var(--sink);
  font-family: var(--font-num);
  font-size: var(--fs-caption);
  font-variant-numeric: tabular-nums;
  line-height: 1;
  color: var(--ink-3);
}

.seq.on {
  background: var(--strong-soft);
  color: var(--strong-text);
}

.read-dot {
  flex: none;
  font-size: var(--fs-caption);
  color: var(--strong-text);
  padding: var(--pad-opt-y) var(--sp-2);
  border-radius: var(--radius-pill);
  background: var(--strong-soft);
  margin-right: var(--sp-1);
}

.row-poem {
  font-family: var(--font-poem);

  color: var(--ink);
}

.row-sub {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 6rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-sub:has(.tag) {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
}

.row-sub-t {
  display: block;
  flex: 0 1 auto;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-star {
  display: block;
  flex: none;
  width: 36rpx;
  height: 36rpx;
  margin: 0 var(--sp-1);
  background-color: currentColor;
  color: var(--ink-4);
  mask-repeat: no-repeat;
  mask-position: center;
  mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-position: center;
  -webkit-mask-size: contain;
}

.row-star.on {
  color: var(--strong-text);
}

.row-star-hover {
  opacity: .7;
}

.row-dot {
  flex: none;
  width: 16rpx;
  height: 16rpx;
  margin-left: var(--sp-2);
  border-radius: 50%;
  background: var(--theme);
}

.row-go {
  color: var(--ink-4);
  font-size: 32rpx;
  padding-left: var(--sp-2);
  line-height: 1;
  flex: none;
}

.row-icon {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  margin-right: var(--sp-3);
  border-radius: var(--radius-sm);
  background: var(--sink);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  line-height: 1;
  color: var(--ink-2);
}

.sw {
  position: relative;
  flex: none;
  width: var(--w-switch);
  height: var(--h-switch);
  margin-left: var(--sp-3);
}

.sw switch {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(var(--switch-scale));
  transform-origin: center;
}

.tag {
  display: inline-flex;
  align-items: center;

  flex: none;
  white-space: nowrap;
  font-size: var(--fs-caption);
  line-height: 1.5;

  padding: var(--pad-opt-y) var(--pad-opt-x);
  border-radius: var(--radius-pill);
  color: var(--ink-2);
  background: var(--sink);
  margin-right: 10rpx;
}

.tag.theme {
  color: var(--strong);
  background: var(--strong-soft);
}

.tag.row-tag {
  margin-right: 0;
  margin-left: 10rpx;
}

.pill {
  display: inline-flex;
  align-items: center;
  flex: none;
  white-space: nowrap;
  font-size: var(--fs-caption);
  line-height: 1.5;
  padding: var(--pad-opt-y) var(--pad-opt-x);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-pill);
  color: var(--ink-2);
}

.pill.on {
  color: var(--strong-text);
  background: var(--strong-soft);
  border-color: var(--strong);
}

.tag.amber {
  color: var(--amber);
  background: var(--amber-soft);
}

.tag.red {
  color: var(--red);
  background: var(--red-soft);
}

.tag.blue {
  color: var(--blue);
  background: var(--blue-soft);
}

.tag.green {
  color: var(--green);
  background: var(--green-soft);
}

.tag.ghost {
  color: var(--ink-3);
  background: var(--sink);
}

.tag.gold {
  color: var(--amber);
  background: var(--gold-soft);
}

.tag.fei {
  color: var(--fei);
  background: var(--fei-soft);
}

.tint-pro,
.tint-max {
  --on-theme: #ffffff;
  --on-theme-soft: rgba(255, 255, 255, .7);
  --on-ink: #ffffff;
  --on-ink-soft: rgba(255, 255, 255, .7);
}

.tint-pro {
  --theme: var(--fei);
  --theme-deep: var(--fei);
  --strong: var(--fei);
  --strong-soft: var(--fei-soft);
  --strong-text: var(--fei);
  --ink-strong: var(--fei);
  --mark: var(--fei);
  --depth: var(--fei);
}

.tint-max {
  --theme: var(--zi);
  --theme-deep: var(--zi);
  --strong: var(--zi);
  --strong-soft: var(--zi-soft);
  --strong-text: var(--zi);
  --ink-strong: var(--zi);
  --mark: var(--zi);
  --depth: var(--zi);
}

.tag.zi {
  color: var(--zi);
  background: var(--zi-soft);
}

.tag.course {
  color: var(--strong-text);
  background: var(--strong-soft);
}

.tag.own {
  color: var(--ink-3);
  background: var(--sink);
}

.search {
  display: flex;
  align-items: center;
  background: var(--sink);
  border: 1rpx solid var(--line-strong);
  border-radius: var(--radius-pill);
  padding: 0 var(--sp-4);
  height: var(--h-field);
  margin-bottom: var(--sp-2);
}

.search-icon {
  display: inline-block;
  flex: none;
  width: 34rpx;
  height: 34rpx;
  margin-right: 14rpx;
  background-color: currentColor;
  color: var(--ink-3);
  mask-repeat: no-repeat;
  mask-position: center;
  mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-position: center;
  -webkit-mask-size: contain;
}

.clear {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 44rpx;
  height: 44rpx;
  color: var(--ink-3);
}

.clear-hover {
  opacity: .55;
}

.clear-ico {
  width: 32rpx;
  height: 32rpx;
  background-color: currentColor;
  mask-repeat: no-repeat;
  mask-position: center;
  mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-position: center;
  -webkit-mask-size: contain;
}

.search input {
  flex: 1;
  font-size: var(--fs-body);
  color: var(--ink);
}

.field {
  display: flex;
  align-items: center;
  background: var(--sink);
  border: 1rpx solid transparent;
  border-radius: var(--radius-block);
  padding: 0 var(--sp-4);
  height: var(--h-field);
  margin: var(--sp-2) 0;
}

.field-input {
  flex: 1;
  font-size: var(--fs-body);
  color: var(--ink);
}

.stats {
  display: flex;
  align-items: stretch;
}

.stat {
  flex: 1;
  min-width: 0;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--sp-2) 0;
}

.stat + .stat::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 1rpx;
  height: 75%;
  background: var(--line);
}

.stat-v {
  font-family: var(--font-num);
  font-size: var(--fs-stat);
  font-weight: 400;
  color: var(--strong-text);
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
  letter-spacing: -1rpx;
}

.stat-k {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: var(--sp-1);
  letter-spacing: var(--ls-caption);
}

.pref-item {
  line-height: 1.4;
}

.pref-item radio,
.pref-item checkbox {
  margin-right: var(--sp-2);
}

.card-open {
  display: flex;
  align-items: baseline;
}

.card-open > .card-title,
.card-head > .card-title {
  flex: 1;
  min-width: 0;
}

.card-open > .card-sub {
  flex: none;
  font-size: var(--fs-caption);
  font-weight: 400;
  color: var(--ink-3);
  padding: var(--card-row-pad) 0 var(--card-row-pad) var(--sp-2);
}

.card-head {
  display: flex;
  align-items: baseline;
  min-width: 0;
  margin-bottom: var(--card-title-gap);
}

.card-hover {
  background: var(--sink);
}

.opt-group {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-2);
}

.opt-group.column {
  flex-direction: column;
  gap: var(--sp-2);
}

.opt-group.inline {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--sp-2);
}

.opt-group.inline .opt-row {
  justify-content: center;

  text-align: center;
}

.opt-group.inline .opt-main {
  flex: none;
  min-width: 0;
  padding: 0;
}

.opt-group.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--sp-2);
}

.opt-group.grid .opt-row {
  justify-content: center;
  min-height: var(--h-opt-tight);
  padding-left: var(--sp-2);
  padding-right: var(--sp-2);
  text-align: center;
}

.opt-group.grid .opt-main {
  flex: none;
  min-width: 0;
  padding: 0;
}

.opt-group.inline.cols-2 {
  grid-template-columns: repeat(2, 1fr);
}

.opt-group.inline.cols-4 {
  grid-template-columns: repeat(4, 1fr);
}

.opt-group.inline.tight .opt-row {
  min-height: var(--h-opt-tight);
  padding-left: var(--sp-2);
  padding-right: var(--sp-2);
}

.opt-row {
  position: relative;
  display: flex;
  align-items: center;
  min-height: var(--h-opt);
  padding: var(--pad-opt-y) var(--pad-opt-x);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-pill);
  background: var(--surface);
  transition: background-color var(--t-press), border-color var(--t-press);
}

.opt-row.active {
  background: var(--strong);
  border-color: var(--strong);
}

.opt-row.active .opt-name {
  color: var(--on-ink);
}

.opt-row.active .opt-desc {
  color: var(--on-ink-soft);
}

.opt-row.locked {
  opacity: .45;
}

.opt-radio {
  position: absolute;
  width: 1rpx;
  height: 1rpx;
  opacity: 0;
  pointer-events: none;
}

.opt-main {
  flex: 1;
  min-width: 0;
}

.opt-name {
  display: block;
  font-family: var(--font-ui);
  font-size: var(--fs-hint);
  color: var(--ink);
  line-height: 1.3;
}

.opt-desc {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 6rpx;
  line-height: 1.6;
}

.pref-item {
  display: flex;
  align-items: center;
  min-height: 60rpx;
  font-size: var(--fs-hint);
  color: var(--ink-2);
  margin-right: var(--sp-3);
}

.pref-item radio,
.pref-item checkbox {
  transform: scale(.8);
}

.chip-row {
  white-space: nowrap;
  margin-bottom: var(--sp-2);
}

.chip-row .pref-item {
  display: inline-flex;
  margin-right: var(--sp-2);
}

.mastery-num {
  font-size: var(--fs-hint);
  color: var(--ink-3);
}

.meter {
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--line);
  overflow: hidden;
}

.meter-fill {
  height: 100%;
  border-radius: 2rpx;
  background: var(--strong);
  transition: width var(--t-move) var(--ease);
}

.ring {
  position: relative;
  flex: none;
  width: var(--ring-size);
  height: var(--ring-size);
}

.ring-track,
.ring-fill {
  position: absolute;
  inset: 0;
  border-radius: 50%;
}

.ring-track {
  background: var(--line);
}

.ring-fill {
  background: conic-gradient(var(--strong) calc(var(--p) * 1%), transparent 0);
  transition: background var(--t-move) var(--ease);
}

.ring::after {
  content: "";
  position: absolute;
  inset: var(--ring-w);
  border-radius: 50%;
  background: var(--surface);
  border: 1rpx solid var(--line);
}

.ring-text {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-num);
  font-size: var(--fs-caption);
  color: var(--strong-text);
  z-index: 1;
}

.ring-cap {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ring-cap .ring {
  margin-bottom: var(--sp-1);
}

.lock-card {
  text-align: center;
  padding: var(--sp-6) var(--sp-4) var(--sp-4);
  background: var(--surface);
  overflow: hidden;
  position: relative;
}

.lock-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  line-height: 1;
  margin: 0 auto var(--sp-3);
  border-radius: 50%;
  background: var(--strong);
  font-family: var(--font-poem);
  font-size: 54rpx;
  color: var(--on-ink);
}

.lock-title {
  display: block;
  font-size: var(--fs-lead);
  color: var(--ink);
  font-family: var(--font-poem);
  letter-spacing: var(--ls-title);
}

.lock-note {
  display: block;
  margin-top: var(--sp-2);
  font-size: var(--fs-hint);
  line-height: 1.5;
  color: var(--ink-3);
}

.lock-btn {
  margin-top: var(--sp-4);
}

.char {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--line-strong);
  background: var(--surface);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  padding: 10rpx 0;
  box-sizing: border-box;
}

.char.active {
  background: var(--strong);
  border-color: var(--strong);
}

.char-t {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-hero);
  color: var(--ink);
  line-height: 1.1;
}

.char-n {
  display: block;
  height: 26rpx;
  font-size: var(--fs-pinyin);
  line-height: 26rpx;
  color: var(--ink-4);
}

.char.active .char-t {
  color: var(--on-ink);
}

.char.active .char-n {
  color: var(--on-ink);
  opacity: .6;
}

.row,
.pref-item,
.opt-row,
.field,
.search,
.pager {
  align-items: center;
}

.count-num,
.mastery-num,
.ring-text,
.num-v,
.day-count,
.stage-count,
.exam-progress,
.exam-timer,
.stat-v {
  font-variant-numeric: tabular-nums;
}

.safe-bottom {
  height: var(--pad-tab);
}

.foot {
  text-align: center;
  padding: var(--sp-1) 0 var(--sp-5);
}

.foot .hint {
  letter-spacing: 1rpx;
}

.seg {
  display: flex;
  align-items: center;
}

.seg-group {
  display: flex;
  align-items: stretch;
  flex: 1;
  border: 1rpx solid transparent;
  border-radius: var(--radius-pill);
  background: var(--sink);
  padding: 4rpx;
  overflow: hidden;
}

.seg-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  gap: 8rpx;
  padding: 0 var(--sp-2);
  min-height: var(--h-opt);
  border-radius: var(--radius-pill);
  transition: background-color var(--t-press), color var(--t-press);
}

.seg-item.on {
  background: var(--strong);
}

.seg-item.on .seg-text {
  color: var(--on-ink);
}

.seg-item.on .seg-icon {
  color: var(--on-ink);
}

.seg-radio {
  position: absolute;
  width: 1rpx;
  height: 1rpx;
  opacity: 0;
  pointer-events: none;
}

.seg-text {
  font-family: var(--font-ui);
  font-size: var(--fs-hint);
  font-weight: 400;
  color: var(--ink);
  letter-spacing: 1rpx;
  white-space: nowrap;
}

.chip-group {
  display: grid;
  gap: var(--sp-2);
}

.chip-group + .chip-group {
  margin-top: var(--sp-2);
}

.chip-group.cols-2 {
  grid-template-columns: repeat(2, 1fr);
}

.chip-group.cols-3 {
  grid-template-columns: repeat(3, 1fr);
}

.chip-group.cols-4 {
  grid-template-columns: repeat(4, 1fr);
}

.chip {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--h-opt);

  padding: var(--pad-opt-y) var(--pad-opt-x);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-pill);
  background: var(--surface);
  transition: background-color var(--t-press), border-color var(--t-press);
}

.chip.on {
  background: var(--strong-soft);
  border-color: var(--strong);
}

.chip.bad,
.chip.fuzzy,
.chip.good {
  color: var(--on-ink);
  background: var(--depth);
  border-color: var(--depth);
}

.chip.bad .chip-t, .chip.fuzzy .chip-t, .chip.good .chip-t {
  color: inherit;
}

.chip.bad .glyph, .chip.fuzzy .glyph, .chip.good .glyph {
  color: inherit;
  background-color: currentColor;
}

.chip.multi:not(.on) {
  background: var(--sink);
}

.chip .glyph {
  margin-right: var(--sp-1);
}

.chip-t {
  font-family: var(--font-ui);
  font-size: var(--fs-hint);
  font-weight: 400;
  color: var(--ink);
  line-height: 1.3;
  text-align: center;
}

.chip.on .chip-t {
  color: var(--strong-text);
}

.chip-hover {
  filter: brightness(.94);
}

.chip.multi {
  padding-left: var(--pad-opt-x);
  padding-right: var(--pad-opt-x);
}

.chip.compact {
  min-height: var(--h-opt-compact);
}

.seg + .field-label,
.field-label + .seg {
  margin-top: var(--sp-1);
}

.glyph,
.seg-icon {
  display: inline-block;
  flex: none;
  width: 40rpx;
  height: 40rpx;
  vertical-align: middle;
  background-color: currentColor;
  color: var(--ink-2);
  mask-repeat: no-repeat;
  mask-position: center;
  mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-position: center;
  -webkit-mask-size: contain;
}

.section-label {
  display: inline-flex;
  align-items: center;
  font-size: var(--fs-caption);
  color: var(--ink-2);
  letter-spacing: var(--ls-caption);
  background: var(--sink);
  border-radius: var(--radius-pill);
  padding: 8rpx 22rpx;
  margin: var(--sp-2) 0 var(--sp-2);
}

.poem-head {
  text-align: center;
  padding: var(--sp-2) 0 var(--sp-2);
}

.poem-head-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  min-width: 0;
}

.poem-head-row > .poem-title {
  min-width: 0;
}

.poem-title {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-hero);
  font-weight: 400;
  color: var(--ink);
  letter-spacing: var(--ls-title);
  line-height: 1.45;
}

.poem-meta-row {
  display: flex;
  align-items: center;
  justify-content: center;

  flex-wrap: nowrap;
  margin-top: var(--sp-1);
}

.poem-meta {
  font-family: var(--font-poem);
  font-size: var(--fs-hint);
  font-weight: 400;
  color: var(--ink-2);

  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.poem-dot {
  font-size: var(--fs-hint);
  color: var(--ink-2);
  padding: 0 8rpx;
  flex: none;
}

.poem-note {
  margin-top: 4rpx;
  text-align: center;
}

.poem-note-t {
  font-family: var(--font-poem);
  font-size: var(--fs-hint);
  color: var(--ink-3);
  white-space: nowrap;
}

.prefs {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  flex-wrap: nowrap;
  justify-content: center;
  padding: var(--sp-1) 0 var(--sp-2);
}


.pref-seg,
.pref-size,
.pref-act {
  display: flex;
  align-items: center;
  flex: none;
  box-sizing: border-box;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  overflow: hidden;
}

.pref-opt {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  height: 40rpx;
  padding: 0 var(--sp-1);
  margin: 0 2rpx;
  border-radius: var(--radius-sm);
  transition: background-color var(--t-press);
}

.pref-opt.on {
  background: var(--strong);
}

.pref-opt.in-seg {
  height: 52rpx;
  padding: 0 var(--sp-2);
  margin: 0;
  border-radius: 0;
}

.pref-size .pref-opt.ic {
  width: 64rpx;
  height: 52rpx;
  margin: 0;
  border-radius: 0;
}

.pref-act .pref-opt.ic {
  margin: 0;
  border-radius: 0;
}

.pref-opt.ic {
  position: relative;
  width: 52rpx;
  height: 52rpx;
}

.pref-opt .glyph {
  color: var(--ink-4);
}

.pref-opt.on .glyph {
  color: var(--strong-text);
}

.pref-opt.ic.on {
  background: var(--strong-soft);
}

.pref-opt.in-seg.on {
  background: var(--strong-soft);
}

.pref-opt-hover {
  background: var(--sink);
}

.round-btn {
  flex: none;
  box-sizing: border-box;
  width: var(--h-round);
  height: var(--h-round);
  border: 1rpx solid transparent;
  border-radius: 50%;
  background: var(--sink);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color var(--t-press), border-color var(--t-press), color var(--t-press);
}

.round-btn .glyph {
  width: var(--h-round-ico);
  height: var(--h-round-ico);
}

.round-btn.on {
  background: var(--strong-soft);
  border-color: var(--strong);
}

.round-btn.on .glyph {
  color: var(--strong-text);
}

.round-btn-hover {
  transform: scale(.94);
}

.pref-opt .opt-radio,
.pref-opt radio {
  position: absolute;
  width: 1rpx;
  height: 1rpx;
  opacity: 0;
  pointer-events: none;
}

.poem-body {
  padding: 0 var(--sp-1) var(--sp-2);
  font-family: var(--font-poem);
}

.poem-body.align-center {
  text-align: center;
}

.poem-body.align-left {
  text-align: left;
}

.poem-stanza + .poem-stanza {
  margin-top: var(--sp-3);
}

.poem-line {
  display: block;
  font-size: var(--poem-fs);
  line-height: calc(var(--poem-fs) * var(--lh-poem) + var(--poem-fold));
  color: var(--ink);
  letter-spacing: 0;
}

.poem-line:not(.token-line) + .poem-line:not(.token-line) {
  margin-top: calc(-1 * var(--poem-fold));
}

.poem-line.token-line + .poem-line.token-line {
  margin-top: calc(var(--py-slot) * -0.2 + (var(--lh-poem) - 1.4) * var(--poem-fs));
}

.md-table {
  width: 100%;
  margin: var(--sp-3) 0;
}

.md-row {
  display: flex;
  align-items: stretch;
}

.md-cell {
  flex: 1 1 0;
  min-width: 0;
  box-sizing: border-box;
  padding: var(--sp-1) calc(8rpx * var(--ui-scale));
  border-right: 1rpx solid var(--line-strong);
  border-bottom: 1rpx solid var(--line-strong);
  font-family: var(--font-ui);
  font-size: var(--fs-hint);
  line-height: 1.5;
  color: var(--ink);
  white-space: normal;
  word-break: break-word;
}

.md-row:first-child .md-cell {
  border-top: 1rpx solid var(--line-strong);
  color: var(--ink-2);
}

.md-cell:first-child {
  border-left: 1rpx solid var(--line-strong);
}

.md-line {
  display: inline;
}

.poem-body.align-left .poem-line {
  padding-left: var(--sp-2);
  border-left: 3rpx solid transparent;
}

.token-line {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: flex-end;
  width: 100%;
  border-radius: var(--radius-sm);
  transition: background-color var(--t-move);
  height: auto;
  line-height: 1;
}

.poem-clause {
  display: flex;
  align-items: flex-end;
  min-width: 0;
}

.poem-line.token-line {
  line-height: 1;
}

.poem-body.align-left .token-line {
  justify-content: flex-start;
}

.token {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  width: var(--py-box);
  height: calc(var(--py-slot) + var(--poem-fs));
  margin: 0 var(--py-gap);
  flex: none;

  vertical-align: bottom;
}

.token.punc {
  width: calc(var(--py-box) / 2);
}

.tk-py {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  width: 100%;
  height: var(--py-slot);
  font-family: var(--font-ui);
  font-size: var(--fs-pinyin);
  color: var(--strong-text);
  line-height: 1;
  white-space: nowrap;
}

.tk-ch {
  color: var(--ink);
  line-height: 1;
}

.poem-body.gap--5 { --lh-poem: 0.9; }
.poem-body.gap--4 { --lh-poem: 1.0; }
.poem-body.gap--3 { --lh-poem: 1.1; }
.poem-body.gap--2 { --lh-poem: 1.2; }
.poem-body.gap--1 { --lh-poem: 1.3; }
.poem-body.gap-1  { --lh-poem: 1.5; }
.poem-body.gap-2  { --lh-poem: 1.6; }
.poem-body.gap-3  { --lh-poem: 1.7; }

.poem-body.size--2 { --py-box: 34rpx; --py-line: 72rpx; --poem-fs: 30rpx; }
.poem-body.size--1 { --py-box: 37rpx; --py-line: 75rpx; --poem-fs: 33rpx; }
.poem-body.size-0  { --py-box: 40rpx; --py-line: 78rpx; --poem-fs: 36rpx; }
.poem-body.size-1  { --py-box: 44rpx; --py-line: 82rpx; --poem-fs: 39rpx; }
.poem-body.size-2  { --py-box: 47rpx; --py-line: 85rpx; --poem-fs: 42rpx; }
.poem-body.size-3  { --py-box: 51rpx; --py-line: 89rpx; --poem-fs: 46rpx; }
.poem-body.size-4  { --py-box: 58rpx; --py-line: 96rpx; --poem-fs: 52rpx; }
.poem-body.size-5  { --py-box: 64rpx; --py-line: 102rpx; --poem-fs: 58rpx; }
.poem-body.size-6  { --py-box: 70rpx; --py-line: 108rpx; --poem-fs: 64rpx; }

.token {
  letter-spacing: 0;
}
.poem-body .token-line {
  letter-spacing: 0;
}

.recite-head {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  margin-top: var(--sp-4);
}

.recite-label {
  flex: none;
  font-size: var(--fs-hint);
  color: var(--ink-2);
  line-height: var(--lh-tight);
}

.mastery-bar {
  flex: 1;
  min-width: 0;
}

.hint-line {
  display: block;
  text-align: center;
  padding-top: var(--sp-2);
}

.gloss-card {
  margin-bottom: var(--sp-2);
}

.gloss-row {
  display: flex;
  align-items: flex-start;
}

.gloss-row.gap {
  margin-top: var(--sp-2);
}

.gloss-cell {
  flex: 1 1 0;
  min-width: 0;
  padding-right: var(--sp-2);
  word-break: break-word;
}

.gloss-w {
  display: block;
  font-size: var(--fs-hint);
  color: var(--strong-text);
  line-height: var(--lh-tight);
}

.gloss-d {
  display: block;
  margin-top: var(--sp-1);
  font-size: var(--fs-hint);
  color: var(--ink-2);
  line-height: var(--lh-body);
}

.trans-head {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: var(--sp-1) 0;
  border-radius: var(--radius-sm);
  transition: background-color var(--t-press);
}

.trans-head.closed {
  min-height: var(--h-btn-mini);
}

.trans-hover {
  background: var(--strong-soft);
}

.trans-toggle {
  font-size: var(--fs-hint);
  color: var(--ink-2);
  flex: none;
}

.trans-text {
  display: block;
  font-size: var(--fs-body);
  color: var(--ink-2);
  line-height: var(--lh-body);
}

.trans-src {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: var(--sp-2);
}

.ellipsis {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.flash.yes {
  animation: flash-yes .42s var(--ease);
}

.flash.no {
  animation: flash-no .56s var(--ease);
}

@keyframes flash-yes {
  0% { background: var(--strong-soft); }
  100% { background: transparent; }
}

@keyframes flash-no {
  0%, 40% { transform: translateX(-8rpx); }
  20%, 60% { transform: translateX(8rpx); }
  80%, 100% { transform: translateX(0); }
}

.combo {
  display: inline-flex;
  align-items: center;
  height: var(--h-btn-mini);
  padding: 0 var(--sp-3);
  border-radius: var(--radius-pill);
  font-size: var(--fs-caption);
  letter-spacing: var(--ls-title);
  color: var(--strong-text);
  background: var(--strong-soft);
  font-variant-numeric: tabular-nums;
}

.combo.hot {
  color: var(--on-ink);
  background: var(--strong);
}

.dots {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: var(--sp-1);
}

.dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--line-strong);
  background: var(--surface);
  color: var(--ink-3);
  font-family: var(--font-num);
  font-size: var(--fs-caption);
  font-variant-numeric: tabular-nums;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dot.on {
  border-color: var(--strong);
  background: var(--strong);
  color: var(--on-ink);
}

.dot.now {
  border-color: var(--strong);
  color: var(--strong-text);
}

.dot-hover {
  opacity: .7;
}

.fb-pick {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--sp-2);
}

.fb-pick-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--h-opt);
  padding: var(--pad-opt-y) var(--sp-1);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-pill);
  background: var(--surface);
  transition: background-color var(--t-press), border-color var(--t-press);
}

.fb-pick-item.on {
  background: var(--strong-soft);
  border-color: var(--strong);
}

.fb-pick-t {
  font-family: var(--font-ui);
  font-size: var(--fs-hint);
  color: var(--ink);
  line-height: 1.3;
  white-space: nowrap;
}

.fb-pick-item.on .fb-pick-t {
  color: var(--strong-text);
}

.fb-pick-radio {
  position: absolute;
  width: 1rpx;
  height: 1rpx;
  opacity: 0;
  pointer-events: none;
}

.fb-input,
.fb-area {
  width: 100%;
  box-sizing: border-box;
  background: var(--sink);
  border: 1rpx solid transparent;
  border-radius: var(--radius-block);
  padding: var(--sp-2) var(--sp-4);
  font-family: var(--font-ui);
  font-size: var(--fs-body);
  color: var(--ink);
  line-height: var(--lh-body);
}

.fb-input {
  height: var(--h-field);
}

.fb-area {
  min-height: calc(var(--h-field) * 2.4);
}

.fb-count {
  display: block;
  text-align: right;
  padding-top: var(--sp-1);
  font-family: var(--font-num);
  font-size: var(--fs-caption);
  color: var(--ink-4);
  font-variant-numeric: tabular-nums;
}

.fb-thread {
  padding: var(--sp-3) var(--card-x);
  margin: 0 calc(-1 * var(--card-x));
  border-bottom: 1rpx solid var(--line-2);
  transition: background-color var(--t-press);
}

.fb-thread-head {
  display: flex;
  align-items: center;
  gap: var(--sp-1);
}

.fb-thread-title {
  flex: 1;
  min-width: 0;
  font-family: var(--font-poem);
  font-size: var(--fs-lead);
  color: var(--strong-text);
  letter-spacing: var(--ls-title);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fb-thread-meta {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  gap: var(--sp-1);
  margin-top: var(--sp-1);
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

.fb-thread-meta .fb-meta-t {
  flex: none;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fb-thread-body {
  display: block;
  margin-top: var(--sp-2);
  font-size: var(--fs-body);
  color: var(--ink-2);
  line-height: var(--lh-body);
  word-break: break-word;
}

.fb-talk {
  margin-top: var(--sp-3);
  padding-top: var(--sp-2);
  border-top: 1rpx solid var(--line-2);
}

.fb-said {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-bottom: var(--sp-2);
}

.fb-said.mine {
  align-items: flex-end;
}

.fb-said-who {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  letter-spacing: var(--ls-caption);
  margin-bottom: 6rpx;
}

.fb-bubble {
  max-width: 84%;
  padding: var(--sp-2) var(--sp-3);
  border-radius: var(--radius-block);
  background: var(--sink);
  font-size: var(--fs-hint);
  color: var(--ink);
  line-height: var(--lh-body);
  word-break: break-word;
}

.fb-said.mine .fb-bubble {
  background: var(--strong-soft);
  color: var(--strong-text);
}

.fb-said-stamp {
  display: block;
  margin-top: 6rpx;
  font-family: var(--font-num);
  font-size: var(--fs-caption);
  color: var(--ink-4);
  font-variant-numeric: tabular-nums;
}

.fb-reply {
  display: flex;
  align-items: flex-end;
  gap: var(--sp-2);
  margin-top: var(--sp-2);
}

.fb-reply .fb-input {
  flex: 1;
  min-width: 0;
}

.fb-reply .btn {
  flex: none;
  align-self: flex-end;
  width: auto;
  height: var(--h-field);
  padding: 0 var(--sp-4);
}

.fb-group-head {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  margin-bottom: var(--card-title-gap);
}

.fb-group-head .card-title {
  flex: 1;
  min-width: 0;
  margin-bottom: 0;
}

.fb-card {
  display: flex;
  flex-direction: column;
  padding: var(--sp-3) var(--card-x);
  margin: 0 calc(-1 * var(--card-x));
  border-bottom: 1rpx solid var(--line-2);
  transition: background-color var(--t-press);
}

.fb-card:last-of-type {
  border-bottom: none;
}

.fb-card-top {
  display: flex;
  align-items: center;
  gap: var(--sp-1);
}

.fb-card-title {
  flex: 1;
  min-width: 0;
  font-family: var(--font-poem);
  font-size: var(--fs-title);
  color: var(--strong-text);
  letter-spacing: var(--ls-title);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fb-card-foot {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  gap: var(--sp-1);
  margin-top: var(--sp-1);
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

.fb-card-user,
.fb-card-stamp {
  flex: none;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fb-card-user {
  flex: 0 1 auto;
}

.fb-card-stamp {
  margin-left: auto;
  font-family: var(--font-num);
  font-variant-numeric: tabular-nums;
}

.fb-rows {
  display: flex;
  flex-direction: column;
  gap: var(--sp-1);
  margin-bottom: var(--sp-3);
}

.fb-kv {
  display: flex;
  align-items: baseline;
  gap: var(--sp-2);
  font-size: var(--fs-hint);
}

.fb-kv-k {
  flex: none;
  width: 6em;
  color: var(--ink-3);
  letter-spacing: var(--ls-caption);
}

.fb-kv-v {
  flex: 1;
  min-width: 0;
  color: var(--ink);
  word-break: break-word;
}

.fb-acts {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  margin-top: var(--sp-3);
}

.fb-acts .btn {
  flex: 1;
  padding: 0;
}

.log-card {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  margin-top: var(--sp-2);
  padding: var(--sp-3);
}

.log-hover {
  transform: scale(.985);
}

.log-glyph {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--gold-soft);
  color: var(--amber);
  font-family: var(--font-poem);
  font-size: var(--fs-title);
}

.log-main {
  flex: 1;
  min-width: 0;
}

.log-head {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
}

.log-sub {
  display: block;
  margin-top: var(--sp-1);
  font-size: var(--fs-caption);
  color: var(--ink-3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
