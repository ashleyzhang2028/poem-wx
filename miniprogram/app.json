{
  "pages": [
    "pages/home/home",
    "pages/list/list",
    "pages/reader/reader",
    "pages/library/library",
    "pages/search/search",
    "pages/mine/mine"
  ],
  "subPackages": [
    {
      "root": "packages/settings",
      "name": "settings",
      "pages": [
        "general/general",
        "recite/recite",
        "reader/reader",
        "about/about",
        "plans/plans"
      ]
    },
    {
      "root": "packages/game",
      "name": "game",
      "pages": [
        "index/index",
        "exam/exam"
      ]
    },
    {
      "root": "packages/progress",
      "name": "progress",
      "pages": [
        "index/index"
      ]
    }
  ],
  "preloadRule": {
    "pages/home/home": {
      "network": "all",
      "packages": [
        "settings",
        "progress"
      ]
    },
    "pages/library/library": {
      "network": "all",
      "packages": [
        "game"
      ]
    }
  },
  "window": {
    "navigationBarBackgroundColor": "#2f6055",
    "navigationBarTextStyle": "white",
    "navigationBarTitleText": "跬步",
    "backgroundColor": "#f6f1e3",
    "backgroundTextStyle": "dark",
    "enablePullDownRefresh": false
  },
  "tabBar": {
    "color": "#8a7a68",
    "selectedColor": "#2f6055",
    "backgroundColor": "#fcfaf3",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/home/home",
        "text": "背诵"
      },
      {
        "pagePath": "pages/library/library",
        "text": "课外"
      },
      {
        "pagePath": "pages/search/search",
        "text": "搜索"
      },
      {
        "pagePath": "pages/mine/mine",
        "text": "我的"
      }
    ]
  },
  "style": "v2",
  "lazyCodeLoading": "requiredComponents",
  "sitemapLocation": "sitemap.json"
}