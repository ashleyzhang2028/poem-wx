{
  "pages": [
    "pages/home/home",
    "pages/list/list",
    "pages/reader/reader",
    "pages/library/library",
    "pages/search/search",
    "pages/mine/mine"
  ],
  "subPackages": [
    {
      "root": "packages/settings",
      "name": "settings",
      "pages": [
        "general/general",
        "recite/recite",
        "reader/reader",
        "about/about"
      ]
    },
    {
      "root": "packages/game",
      "name": "game",
      "pages": [
        "index/index",
        "quiz/quiz",
        "feihua/feihua",
        "exam/exam"
      ]
    },
    {
      "root": "packages/progress",
      "name": "progress",
      "pages": [
        "index/index"
      ]
    },
    {
      "root": "packages/admin",
      "name": "admin",
      "pages": [
        "index/index"
      ]
    }
  ],
  "preloadRule": {
    "pages/home/home": {
      "network": "all",
      "packages": [
        "settings",
        "progress"
      ]
    },
    "pages/library/library": {
      "network": "all",
      "packages": [
        "game"
      ]
    }
  },
  "window": {
    "navigationBarBackgroundColor": "#ffffff",
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "跬步",
    "backgroundColor": "#f5f5f7",
    "backgroundTextStyle": "dark",
    "enablePullDownRefresh": false
  },
  "tabBar": {
    "color": "#9ca3af",
    "selectedColor": "#1c1c1e",
    "backgroundColor": "#ffffff",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/home/home",
        "text": "背诵"
      },
      {
        "pagePath": "pages/library/library",
        "text": "课外"
      },
      {
        "pagePath": "pages/search/search",
        "text": "搜索"
      },
      {
        "pagePath": "pages/mine/mine",
        "text": "我的"
      }
    ]
  },
  "style": "v2",
  "lazyCodeLoading": "requiredComponents",
  "sitemapLocation": "sitemap.json",
  "usingComponents": {
    "lock-card": "/components/lock-card/lock-card",
    "skeleton": "/components/skeleton/skeleton"
  }
}
