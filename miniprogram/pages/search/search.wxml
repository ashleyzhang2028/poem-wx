<view class="page">
  <view class="card locked-card" wx:if="{{locked}}">
    <view class="card-title">登录后可用</view>
    <text class="hint note">全站搜索要微信登录之后才能用。</text>
    <button class="btn primary block locked-btn" bindtap="onLogin">微信登录</button>
  </view>

  <block wx:else>
  <view class="search">
    <text class="search-icon">⌕</text>
    <input placeholder="搜篇名 / 作者 / 朝代 / 出处 / 正文" value="{{keyword}}" bindinput="onInput"
           confirm-type="search" bindconfirm="doSearch" focus="{{true}}" />
    <text class="clear" wx:if="{{keyword}}" bindtap="onClear">✕</text>
    <button class="btn mini primary go-btn" bindtap="doSearch">搜索</button>
  </view>

  <!-- 范围与模式都是「选一个」：原生 radio，不再自绘分段控件 -->
  <radio-group class="opt-group scope-group" bindchange="onScope">
    <label class="pref-item" wx:for="{{scopes}}" wx:key="key">
      <radio value="{{item.key}}" checked="{{scope === item.key}}" color="#2f6055" />
      <text>{{item.label}}</text>
    </label>
  </radio-group>

  <!-- 全文索引没生成时，模式切换整块不显示，搜索退回索引字段 -->
  <radio-group class="opt-group mode-group" wx:if="{{fullOn}}" bindchange="onMode">
    <label class="pref-item" wx:for="{{modes}}" wx:key="key">
      <radio value="{{item.key}}" checked="{{mode === item.key}}" color="#2f6055" />
      <text>{{item.label}}</text>
    </label>
  </radio-group>

  <text class="hint count" wx:if="{{searching}}">正在翻正文…</text>

  <view class="card" wx:if="{{searched && results.length}}">
    <view class="row" hover-class="row-hover" hover-stay-time="60"
            wx:for="{{results}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpen">
      <view class="row-main">
        <text class="row-title">{{item.title}}</text>
        <text class="row-sub">{{item.dynasty}} · {{item.author}} · {{item.bookName}}</text>
        <view class="hit" wx:if="{{item.lines.length}}">
          <text class="hit-line" wx:for="{{item.lines}}" wx:for-item="l" wx:key="*this">{{l}}</text>
        </view>
      </view>
      <text class="row-go">›</text>
    </view>
  </view>

  <view class="empty" wx:if="{{searched && !results.length}}">没有匹配的篇目</view>

  <view class="hot" wx:if="{{!searched && !searching}}">
    <text class="hint">试试</text>
    <view class="hot-tags">
      <button class="tag tag-btn" wx:for="{{hot}}" wx:key="*this" data-k="{{item}}" bindtap="onHot">{{item}}</button>
    </view>
    <text class="hint hot-note">
      篇名作者搜的是索引字段；正文全文走倒排索引，先定位相关分片再精确定位，不把 23MB 正文读进内存。
    </text>
  </view>
  </block>
</view>
