<view class="page">
  <lock-card wx:if="{{locked}}" title="搜索要登录" note="全站搜索要微信登录之后才能用 —— 它能搜遍 5575 篇正文，是本机算力在做的事。" mark="寻" />

  <block wx:else>
  <view class="search">
    <text class="search-icon">⌕</text>
    <input placeholder="搜篇名 / 作者 / 朝代 / 出处 / 正文" value="{{keyword}}" bindinput="onInput"
           confirm-type="search" bindconfirm="doSearch" focus="{{true}}" />
    <text class="clear" wx:if="{{keyword}}" bindtap="onClear">✕</text>
    <button class="btn mini primary go-btn" bindtap="doSearch">搜索</button>
  </view>

  <!-- 范围与模式都是「选一个」：原生 radio，不再自绘分段控件 -->
  <view class="opt-block">
    <text class="field-label">范围</text>
    <radio-group class="opt-group scope-group" bindchange="onScope">
      <label class="pref-item" wx:for="{{scopes}}" wx:key="key">
        <radio value="{{item.key}}" checked="{{scope === item.key}}" color="#2f6055" />
        <text>{{item.label}}</text>
      </label>
    </radio-group>

    <!-- 全文索引没生成时，模式切换整块不显示，搜索退回索引字段 -->
    <block wx:if="{{fullOn}}">
      <text class="field-label">方式</text>
      <radio-group class="opt-group mode-group" bindchange="onMode">
        <label class="pref-item" wx:for="{{modes}}" wx:key="key">
          <radio value="{{item.key}}" checked="{{mode === item.key}}" color="#2f6055" />
          <text>{{item.label}}</text>
        </label>
      </radio-group>
    </block>
  </view>

  <!-- 结果统计：搜完给一句「命中几条、在哪儿搜的」，
       不然一屏结果看完也不知道是不是全量 -->
  <view class="result-bar" wx:if="{{searched && results.length}}">
    <view class="result-head">
      <text class="result-count">命中 {{total}} 篇</text>
      <text class="hint result-where">{{resultWhere}}</text>
    </view>
    <!-- 截断了就直说。上一版这里永远等于列出的条数，
         「只给你 80 条」被写成了「全站只有 80 条」 -->
    <text class="hint result-more" wx:if="{{total > results.length}}">列表只到前 {{results.length}} 篇 · 缩小范围或换个词能看得更细</text>
  </view>

  <view class="card" wx:if="{{searched && results.length}}">
    <view class="row hit-row" hover-class="row-hover" hover-stay-time="60"
            wx:for="{{results}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpen">
      <view class="row-main">
        <text class="row-title">{{item.title}}</text>
        <text class="row-sub">{{item.dynasty}} · {{item.author}} · {{item.bookName}}</text>
        <view class="hit" wx:if="{{item.lines.length}}">
          <text class="hit-line" wx:for="{{item.lines}}" wx:for-item="l" wx:key="*this">{{l}}</text>
        </view>
      </view>
      <text class="row-go">›</text>
    </view>
  </view>

  <view class="empty" wx:if="{{searched && !results.length}}">
    <text class="empty-mark">无</text>
    <text class="empty-text">「{{keyword}}」没有匹配的篇目</text>
    <text class="hint empty-tip" wx:if="{{mode === 'index' && fullOn}}">试试切到「正文全文」，正文里的句子也搜得着</text>
  </view>

  <view class="hot" wx:if="{{!searched}}">
    <text class="field-label">试试</text>
    <view class="hot-tags">
      <button class="tag tag-btn" wx:for="{{hot}}" wx:key="*this" data-k="{{item}}" bindtap="onHot">{{item}}</button>
    </view>
    <text class="hint hot-note">
      篇名作者搜的是索引字段；正文全文走倒排索引，先定位相关分片再精确定位，不把 23MB 正文读进内存。
    </text>
  </view>

  <view class="safe-bottom"></view>
  </block>
</view>
