<view class="page {{barBelow ? 'has-tabbar' : 'tall'}}" style="{{themeStyle}}">
  <lock-card wx:if="{{locked}}" title="搜索" note="登录后才能搜" mark="寻" bind:login="onLogin" />

  <block wx:else>
  <view class="card search-card">
    <view class="search search-page">
      <view class="search-icon" style="mask-image:url('{{icons.search}}');-webkit-mask-image:url('{{icons.search}}');"></view>
      <input placeholder="搜篇名 / 作者 / 正文" value="{{keyword}}" bindinput="onInput"
             confirm-type="search" bindconfirm="doSearch" focus="{{true}}" />
      <view class="clear" hover-class="clear-hover" hover-stay-time="60" wx:if="{{keyword}}" bindtap="onClear">
        <view class="clear-ico" style="mask-image:url('{{icons.clear}}');-webkit-mask-image:url('{{icons.clear}}');"></view>
      </view>
      <button class="btn mini primary go-btn" bindtap="doSearch">搜索</button>
    </view>

    <view class="hot-tags" wx:if="{{!searched}}">
      <button class="tag tag-btn" wx:for="{{hot}}" wx:key="*this" data-k="{{item}}" bindtap="onHot">{{item}}</button>
    </view>
  </view>

  <view class="result-bar" wx:if="{{searched && results.length}}">
    <view class="result-head">
      <text class="result-count">命中 {{total}} 篇</text>
      <text class="hint result-where">{{resultWhere}}</text>
    </view>
  </view>

  <view class="card" wx:if="{{searched && results.length}}">
    <view class="row hit-row" hover-class="row-hover" hover-stay-time="60"
            wx:for="{{results}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpen">
      <view class="row-main">
        <text class="row-title row-poem">{{item.title}}</text>
        <text class="row-sub">{{item.dynasty}} · {{item.author}} · {{item.bookName}}</text>
        <view class="hit" wx:if="{{item.lines.length}}">
          <text class="hit-line" wx:for="{{item.lines}}" wx:for-item="l" wx:key="*this">{{l}}</text>
        </view>
      </view>
      <view class="row-star {{item.picked ? 'on' : ''}}" hover-class="row-star-hover" hover-stay-time="60"
            style="mask-image:url('{{icons.playlist}}');-webkit-mask-image:url('{{icons.playlist}}');"
            data-id="{{item.id}}" catchtap="onPick"></view>
      <text class="row-go">›</text>
    </view>
    <text class="hint more-tip" wx:if="{{more}}">往下拉，再接 20 篇</text>
    <text class="hint more-tip" wx:else>共 {{total}} 篇</text>
  </view>

  <view class="empty" wx:if="{{searched && !results.length}}">
    <text class="empty-mark">无</text>
    <text class="empty-text">「{{keyword}}」没有匹配的篇目</text>
    <text class="hint empty-tip">换一个字或一位作者再试</text>
  </view>

  <view class="card author-entry">
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onAuthors">
      <view class="row-main">
        <text class="gc-name">作者索引</text>
        <text class="row-sub">按朝代排，点一位读他的全部作品</text>
      </view>
      <text class="row-go">›</text>
    </view>
  </view>

  <view class="safe-bottom"></view>
  </block>
</view>
