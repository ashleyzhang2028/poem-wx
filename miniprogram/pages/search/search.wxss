.clear {
  color: var(--ink-3);
  padding: 0 var(--sp-2);
  font-size: var(--fs-hint);
}

.go-btn {
  flex: none;
}

.result-bar {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  padding: 4rpx var(--sp-4) var(--sp-2);
}

.result-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--sp-2);
}

.result-more {
  font-size: var(--fs-caption);
}

.result-count {
  flex: none;
  font-size: var(--fs-body);
  color: var(--ink);
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.result-where {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: var(--fs-caption);
}

.hot .field-label {
  padding-bottom: var(--sp-1);
}

.hot {
  padding: var(--sp-4) var(--sp-1);
}

.hot-tags {
  display: flex;
  flex-wrap: wrap;
  margin: var(--sp-2) 0;
}

.hot-tags .tag-btn {
  width: auto;
  min-width: 0;
  display: inline-block;
  padding: 12rpx var(--sp-4);
  font-size: var(--fs-hint);
  line-height: 1.5;
  margin: 0 var(--sp-2) var(--sp-2) 0;
}

.hot-tags .tag-btn::after {
  border: none;
}

.hit {
  margin-top: 10rpx;
}

.hit-line {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-hint);
  color: var(--ink-2);
  line-height: 1.75;
  letter-spacing: 1rpx;
}

.hit-line:first-child {
  padding-left: 14rpx;
  border-left: 4rpx solid var(--line-strong);
}

.empty-tip {
  display: block;
  margin-top: var(--sp-2);
}

.hit-row {
  align-items: flex-start;
  padding: var(--sp-3) var(--sp-1);
}
