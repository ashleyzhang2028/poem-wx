.clear {
  color: var(--ink-3);
  padding: 0 16rpx;
  font-size: 26rpx;
}

/* 搜索键是原生 button：只压小尺寸，颜色照旧是那身雨过天青 */
.go-btn {
  flex: none;
}

.scope-group {
  margin: 24rpx 0 8rpx;
}

.mode-group {
  margin-bottom: 16rpx;
}

/* 一行里的两组选项之间那道细线：不说「这是两个问题」，
   用户会以为六个选项是一组 */
.scope-group + .mode-group {
  padding-top: 12rpx;
  border-top: 1rpx dashed var(--line-2);
}

.result-bar {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 4rpx 4rpx 16rpx;
}

.result-count {
  font-size: 26rpx;
  color: var(--green);
  font-weight: 600;
}

.result-where {
  font-size: 23rpx;
}

.section-label {
  display: block;
  font-size: 25rpx;
  color: var(--ink-3);
  letter-spacing: 2rpx;
}

.hot {
  padding: 32rpx 4rpx;
}

.hot-tags {
  display: flex;
  flex-wrap: wrap;
  margin: 20rpx 0;
}

/* 热搜词是对 <button> 的瘦身：原生按钮有最小宽度、有 ::after 边框、有默认内边距，
   三样都要按跬步的样子收一遍 */
.hot-tags .tag-btn {
  width: auto;
  min-width: 0;
  display: inline-block;
  padding: 10rpx 24rpx;
  font-size: 26rpx;
  line-height: 1.5;
  margin: 0 16rpx 16rpx 0;
}

.hot-tags .tag-btn::after {
  border: none;
}

.hot-note {
  display: block;
  line-height: 1.8;
}

.hit {
  margin-top: 10rpx;
}

.hit-line {
  display: block;
  font-family: var(--font-poem);
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.75;
  letter-spacing: 1rpx;
}

/* 命中句加一道左边线：和上方「篇名作者」那行拉开层次，
   一眼能分出哪句是正文里捞出来的 */
.hit-line:first-child {
  padding-left: 14rpx;
  border-left: 4rpx solid var(--line-2);
}

.empty-tip {
  display: block;
  margin-top: 16rpx;
}
