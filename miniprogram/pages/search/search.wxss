.search-page.search {
  padding: 0 var(--sp-2) 0 var(--sp-3);
  margin-bottom: 0;
}

.result-bar {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  padding: 4rpx var(--sp-4) var(--sp-2);
}

.result-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--sp-2);
}

.result-count {
  flex: none;
  font-size: var(--fs-body);
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}

.result-where {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: var(--fs-caption);
}

.hot-tags {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  padding-top: var(--sp-4);
}

.hot-tags .tag-btn {
  width: auto;
  min-width: 0;
  display: inline-block;
  padding: var(--sp-1) var(--sp-3);
  font-size: var(--fs-hint);
  line-height: 1.5;
  font-weight: 400;
  margin: 0 var(--sp-2) var(--sp-2) 0;
}

.hot-tags .tag-btn::after {
  border: none;
}

.hit {
  margin-top: var(--sp-1);
}

.hit-line {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-hint);
  color: var(--ink-2);
  line-height: 1.75;
  letter-spacing: 1rpx;
}

.hit-line:first-child {
  padding-left: var(--sp-2);
  border-left: 4rpx solid var(--line-strong);
}

.empty-tip {
  display: block;
  margin-top: var(--sp-2);
}

.hit-row {
  align-items: center;
  padding: var(--sp-3) var(--sp-1);
}

.hit-row .row-main {
  padding-right: var(--sp-2);
}

.more-tip {
  display: block;
  text-align: center;
  padding: var(--sp-3) 0 var(--sp-2);
  font-size: var(--fs-caption);
}
