.clear {
  color: var(--ink-3);
  padding: 0 16rpx;
  font-size: 26rpx;
}

.go {
  color: var(--green);
  font-size: 28rpx;
  padding-left: 16rpx;
  border-left: 1rpx solid var(--line-2);
}

.scope-seg {
  margin: 20rpx 0;
}

.hot {
  padding: 32rpx 4rpx;
}

.hot-tags {
  display: flex;
  flex-wrap: wrap;
  margin: 20rpx 0;
}

.hot-tags .tag {
  padding: 10rpx 24rpx;
  font-size: 26rpx;
  margin: 0 16rpx 16rpx 0;
}

.hot-note {
  display: block;
  line-height: 1.8;
}
.scope-seg {
  margin-top: 20rpx;
}

.search-clear {
  font-size: 26rpx;
  color: var(--ink-3);
  padding-left: 12rpx;
}

.hot {
  margin-top: 24rpx;
}

.hot-label {
  font-size: 24rpx;
  color: var(--ink-3);
}

.hot-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.hot-item {
  font-size: 25rpx;
  color: var(--green);
  background: var(--green-light);
  border-radius: 10rpx;
  padding: 8rpx 18rpx;
}

.idx-hint {
  display: block;
  padding: 0 8rpx 20rpx;
}

.row-hit {
  display: block;
  font-family: var(--font-poem);
  font-size: 26rpx;
  color: var(--amber);
  line-height: 1.7;
  margin-top: 8rpx;
}
