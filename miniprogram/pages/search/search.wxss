.clear {
  color: var(--ink-3);
  padding: 0 16rpx;
  font-size: 26rpx;
}

/* 搜索键是原生 button：只压小尺寸，颜色照旧是那身雨过天青 */
.go-btn {
  flex: none;
}

.opt-group {
  display: flex;
}

.scope-group {
  margin: 20rpx 0;
}

.mode-group {
  margin-bottom: 20rpx;
}

.pref-item {
  display: flex;
  align-items: center;
  font-size: 27rpx;
  color: var(--ink-2);
  padding-right: 16rpx;
}

.pref-item radio {
  transform: scale(.8);
}

.hot {
  padding: 32rpx 4rpx;
}

.hot-tags {
  display: flex;
  flex-wrap: wrap;
  margin: 20rpx 0;
}

/* 热搜词是对 <button> 的瘦身：原生按钮有最小宽度、有 ::after 边框、有默认内边距，
   三样都要按跬步的样子收一遍 */
.hot-tags .tag-btn {
  width: auto;
  min-width: 0;
  display: inline-block;
  padding: 10rpx 24rpx;
  font-size: 26rpx;
  line-height: 1.5;
  margin: 0 16rpx 16rpx 0;
}

.hot-tags .tag-btn::after {
  border: none;
}

.hot-note {
  display: block;
  line-height: 1.8;
}

.count {
  display: block;
  padding: 0 4rpx 16rpx;
}

.hit {
  margin-top: 8rpx;
}

.hit-line {
  display: block;
  font-family: var(--font-poem);
  font-size: 25rpx;
  color: var(--ink-2);
  line-height: 1.7;
}
