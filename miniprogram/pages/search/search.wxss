.clear {
  color: var(--ink-3);
  padding: 0 var(--sp-2);
  font-size: var(--fs-hint);
}

/* 搜索键是原生 button：只压小尺寸，配色照旧走令牌 */
.go-btn {
  flex: none;
}

/* ---------- 搜索条件 ----------
   两个问题（在哪儿搜 / 怎么搜）摆在同一张卡上，
   带小标题分开 —— 否则四个选项排两行（两组各两个），用户会当成一组。 */
.opt-block {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: var(--sp-2) var(--sp-4) var(--sp-3);
  margin-bottom: var(--sp-3);
}

/* .field-label 在 app.wxss 里定一次；这里只补这张卡自己的上边距 */
.opt-block .field-label {
  padding-top: var(--sp-1);
}

.scope-group,
.mode-group {
  display: flex;
  flex-wrap: wrap;
}

.mode-group {
  padding-top: 4rpx;
  border-top: 1rpx dashed var(--line-2);
  margin-top: var(--sp-1);
}

/* 命中统计那一条：左右各留一道与卡片同宽的边距。
   上一版只给了 sp-1 的左侧内边距，右边那句「篇名作者 · 全站」贴到屏幕边，
   在窄屏上直接被切掉半截 —— 一行里右边那半截是「在哪儿搜的」，
   它被切了就等于没写。 */
.result-bar {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  padding: 4rpx var(--sp-4) var(--sp-2);
}

/* 「命中 N 篇」与「在哪儿搜的」同处一行：一个是结论、一个是出处，
   读的时候是一口气，拆成两行反而断了 */
.result-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--sp-2);
}

/* 截断提示自成一行，压在结论下面 —— 它是补充说明，不该跟出处抢位置 */
.result-more {
  font-size: var(--fs-caption);
}

.result-count {
  flex: none;
  font-size: var(--fs-body);
  color: var(--ink);
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.result-where {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: var(--fs-caption);
}

.hot .field-label {
  padding-bottom: var(--sp-1);
}

.hot {
  padding: var(--sp-4) var(--sp-1);
}

.hot-tags {
  display: flex;
  flex-wrap: wrap;
  margin: var(--sp-2) 0;
}

/* 热搜词是对 <button> 的瘦身：原生按钮有最小宽度、有 ::after 边框、有默认内边距，
   三样都要按跬步的样子收一遍 */
.hot-tags .tag-btn {
  width: auto;
  min-width: 0;
  display: inline-block;
  padding: 12rpx var(--sp-4);
  font-size: var(--fs-hint);
  line-height: 1.5;
  margin: 0 var(--sp-2) var(--sp-2) 0;
}

.hot-tags .tag-btn::after {
  border: none;
}

/* 命中句：从正文里捞出来的那一句，用宋体 + 左引线单独起一行。
   一行列表里出现两种字体，眼睛立刻分得清「哪句是我搜的」 */
.hit {
  margin-top: 10rpx;
}

.hit-line {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-hint);
  color: var(--ink-2);
  line-height: 1.75;
  letter-spacing: 1rpx;
}

.hit-line:first-child {
  padding-left: 14rpx;
  border-left: 4rpx solid var(--line-strong);
}

.empty-tip {
  display: block;
  margin-top: var(--sp-2);
}

/* 命中行：比普通列表行多一口气，因为里面还带着正文那一句 */
.hit-row {
  align-items: flex-start;
  padding: var(--sp-3) var(--sp-1);
}
