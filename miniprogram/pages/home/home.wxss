.home {
  padding: var(--sp-3);
  padding-top: 0;
  position: relative;
  overflow: hidden;
  background: var(--surface);
}

.home .de {
  margin-bottom: var(--sp-2);
}

.home .hero-lead {
  position: relative;
  margin-top: var(--banner-lead-gap);
  background: transparent;
}

.hero-eyebrow {
  display: block;
  font-size: var(--fs-caption);
  letter-spacing: var(--ls-caption);
  color: var(--ink-3);
  margin-bottom: var(--sp-2);
}

.extra-search {
  margin-bottom: var(--sp-2);
}

.hero-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
}

.hero-title {
  display: block;
  flex: none;
  font-family: var(--font-poem);
  font-size: var(--fs-head);
  font-weight: 400;
  color: var(--strong-text);
  letter-spacing: var(--ls-title);
  line-height: var(--lh-tight);
}

.hero-pills {
  display: flex;
  flex: none;
  gap: var(--sp-1);
  margin-left: auto;
}

.hero-sub {
  display: block;
  font-size: var(--fs-hint);
  color: var(--ink-3);
  margin-top: var(--sp-2);
}

.hero-stats {
  margin-top: var(--sp-2);
}

.hero-stats .stat-ring {
  padding: 0;
}

.ring-hover {
  opacity: .82;
}

.tag.row-state {
  color: var(--ink-3);
  margin-right: 0;
}

.tag.row-state.on {
  color: var(--ink-2);
}

.faces {
  flex: none;
  display: flex;
  align-items: center;
  padding-left: var(--sp-3);
}

.face {
  width: 48rpx;
  height: 48rpx;
  margin-left: var(--sp-3);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: background-color var(--t-press);
}

.face-ico {
  width: 40rpx;
  height: 40rpx;
  background-color: currentColor;
  color: var(--ink-4);
  mask-repeat: no-repeat;
  mask-position: center;
  mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-position: center;
  -webkit-mask-size: contain;
}

.face-hover {
  background: var(--sink);
}

.face.on .face-ico {
  color: var(--strong-text);
}

.all-title {
  flex: 1;
  min-width: 0;
  margin-bottom: 0;
}

.all-count {
  flex: none;
  font-family: var(--font-num);
  font-size: var(--fs-caption);
  color: var(--ink-3);
  padding-left: var(--sp-2);
  font-variant-numeric: tabular-nums;
}

.row-end {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: nowrap;
  padding-left: var(--sp-2);
}

.empty-btn {
  margin-top: var(--sp-3);
}

.guest-note {
  display: block;
  margin-top: var(--sp-2);
  text-align: center;
}

.login-lead {
  height: var(--h-field);
  margin-top: var(--sp-4);
}


.finish {
  padding: var(--sp-5) var(--sp-3) var(--sp-4);
  text-align: center;
}

.card-done {
  margin-top: var(--sp-3);
  padding-top: var(--sp-4);
  text-align: center;
}

.card-done:first-child {
  margin-top: 0;
}

.finish-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  margin: 0 auto var(--sp-2);
  border-radius: 50%;
  background: var(--strong-soft);
  border: 1rpx solid var(--strong);
}

.finish-ico {
  width: 52rpx;
  height: 52rpx;
  background-color: currentColor;
  color: var(--strong-text);
  mask-repeat: no-repeat;
  mask-position: center;
  mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-position: center;
  -webkit-mask-size: contain;
}

.finish-text {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-title);
  color: var(--ink-2);
  letter-spacing: var(--ls-title);
  line-height: var(--lh-loose);
}

.finish-tip {
  display: block;
  margin-top: var(--sp-2);
}

.daily-poem .daily-refresh {
  width: 56rpx;
  height: 56rpx;
  margin: 0 calc(-1 * var(--sp-2)) 0 auto;
}

.daily-poem .daily-refresh-hover {
  background: var(--sink);
}

.daily-refresh .glyph {
  width: 30rpx;
  height: 30rpx;
  color: var(--line-strong);
}

.daily-body {
  margin-top: var(--sp-2);
  padding-bottom: var(--sp-2);
  text-align: center;
}

.daily-title {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-lead);
  color: var(--strong-text);
  letter-spacing: var(--ls-title);
}

.daily-meta {
  display: block;
  margin: var(--sp-1) 0 var(--sp-3);
  font-family: var(--font-poem);
  font-weight: 400;
  font-size: var(--fs-hint);
  color: var(--ink-3);
}

.daily-line {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-title);
  line-height: var(--lh-body);
  color: var(--ink);
}

.daily-tip {
  display: block;
}
