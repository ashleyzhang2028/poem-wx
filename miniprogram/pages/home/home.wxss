.home {
  padding: var(--sp-3);
  padding-top: 0;
  position: relative;
}

.banner {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: calc(var(--status-h) + var(--nav-h) + (100vw / 1.875));
  overflow: hidden;
  background: var(--surface);
}

.banner-img {
  display: block;
  width: 100%;
  height: auto;
}

.banner-space {
  pointer-events: none;
}

.home .de {
  margin-bottom: var(--sp-2);
}

.hero {
  padding: var(--sp-3) var(--sp-3);
}

.home .hero-lead {
  position: relative;
  z-index: 1;
  margin-top: calc(-1 * var(--sp-5));
}

.hero-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-left {
  flex: 1;
  min-width: 0;
  padding-right: var(--sp-2);
}

.hero-eyebrow {
  display: block;
  font-size: var(--fs-caption);
  letter-spacing: var(--ls-caption);
  color: var(--ink-3);
  margin-bottom: var(--sp-2);
}

.extra-search {
  padding: 0 var(--card-x);
  margin-bottom: var(--sp-2);
}

.hero-title {
  display: block;
  font-family: var(--font-poem);
  font-weight: 700;
  color: var(--strong-text);
  letter-spacing: var(--ls-title);
  line-height: var(--lh-tight);
}

.hero-sub {
  display: block;
  font-size: var(--fs-hint);
  color: var(--ink-3);
  margin-top: var(--sp-2);
}

.hero-stats {
  margin-top: var(--sp-4);
}

.hero-stats .stat-ring {
  padding: 0;
}

.stat-dash {
  color: var(--ink-4);
}

.seal {
  flex: none;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--strong);
  display: flex;
  align-items: center;
  justify-content: center;
}

.seal-t {
  font-family: var(--font-poem);
  font-size: var(--fs-mark);
  color: var(--on-ink);
}

.ring-hover {
  opacity: .82;
}

.row-line {
  display: flex;
  align-items: center;
}

.row-line .row-title {
  flex: 0 1 auto;

  min-width: 0;
  margin-right: var(--sp-1);
}

.row-lock,
.row-state {
  flex: none;
  margin-left: var(--sp-1);
  font-size: var(--fs-caption);
  letter-spacing: var(--ls-caption);
  color: var(--ink-3);
  padding: 4rpx 16rpx;
  border-radius: var(--radius-ctl);
  background: var(--sink);
  white-space: nowrap;
}

.row-state.on {
  color: var(--ink-2);
}

.all-title {
  flex: 1;
  min-width: 0;
}

.all-count {
  flex: none;
  font-family: var(--font-num);
  font-size: var(--fs-caption);
  color: var(--ink-3);
  padding-left: var(--sp-2);
  font-variant-numeric: tabular-nums;
}

.all-toggle {
  flex: none;
  box-sizing: border-box;
  width: 14rpx;
  height: 14rpx;
  margin: 0 var(--sp-1) 6rpx var(--sp-3);
  border-right: 2rpx solid var(--ink-3);
  border-bottom: 2rpx solid var(--ink-3);
  transform: rotate(45deg);
  transition: transform var(--t-move) var(--ease);
}

.all-toggle.open {
  margin-bottom: 0;
  margin-top: 6rpx;
  transform: rotate(-135deg);
}

.row-end {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: nowrap;
  padding-left: var(--sp-2);
}

.empty-btn {
  margin-top: var(--sp-3);
}

.guest-bar {
  display: flex;
  flex-direction: column;
  margin: var(--sp-3) 0;
  padding: var(--sp-3) var(--sp-3);
  border-radius: var(--radius);
  background: var(--amber-light);
  border: 1rpx solid var(--amber-edge);
}

.guest-bar-hover {
  opacity: .88;
}

.guest-title {
  font-size: var(--fs-hint);
  color: var(--amber);
}

.guest-sub {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: var(--sp-1);
  line-height: 1.6;
}
