.home {
  padding-top: var(--sp-2);
}

/* ---------- 首屏那张卡 ----------
   它承载「今天做什么」，值得比别的卡多一点分量：
   一道纵向微光打底，右上角一枚缃色光晕，压得住下面那张列表。 */
.hero {
  position: relative;
  overflow: hidden;
  padding: var(--sp-4) var(--sp-4) var(--sp-4);
  margin-bottom: var(--sp-3);
  background: linear-gradient(160deg, #fffefb 0%, var(--bg-soft) 58%, #f4ecd8 100%);
  border-color: rgba(240, 205, 124, .5);
  box-shadow: var(--shadow-lift);
}

/* 光晕：给卡面一点「纸背透光」的意思，比纯色块耐看，也不抢字 */
.hero::after {
  content: "";
  position: absolute;
  right: -120rpx;
  top: -140rpx;
  width: 340rpx;
  height: 340rpx;
  border-radius: 50%;
  background: radial-gradient(circle, var(--gold-soft) 0%, rgba(240, 205, 124, 0) 70%);
}

.hero-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-left {
  flex: 1;
  min-width: 0;
  padding-right: var(--sp-2);
}

.hero-eyebrow {
  display: block;
  font-size: var(--fs-caption);
  letter-spacing: var(--ls-caption);
  color: var(--ink-3);
  margin-bottom: 10rpx;
}

.hero-title {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-hero);
  font-weight: 600;
  color: var(--green);
  letter-spacing: var(--ls-title);
  line-height: var(--lh-tight);
}

.hero-sub {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 10rpx;
}

.hero-metric {
  margin-top: var(--sp-3);
}

.hero-btn {
  position: relative;
  z-index: 1;
  margin-top: var(--sp-4);
}

.hero-note {
  position: relative;
  z-index: 1;
  display: block;
  text-align: center;
  font-family: var(--font-poem);
  font-size: var(--fs-caption);
  letter-spacing: var(--ls-title);
  color: var(--ink-3);
  margin-top: var(--sp-3);
}

/* 细进度条：环给比例，这条给「还剩多少」 */
.hero-meter {
  position: relative;
  z-index: 1;
  margin-top: var(--sp-3);
}

.hero-meter-t {
  position: relative;
  z-index: 1;
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 10rpx;
}

/* 未登录那张卡的印章 */
.seal {
  flex: none;
  width: 104rpx;
  height: 104rpx;
  border-radius: 18rpx;
  border: 3rpx solid rgba(168, 59, 50, .5);
  background: rgba(255, 254, 251, .8);
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(-4deg);
}

.seal-t {
  font-family: var(--font-poem);
  font-size: var(--fs-mark);
  color: rgba(168, 59, 50, .68);
}

/* ---------- 进度环 ---------- */
.ring-hover {
  opacity: .82;
}

.hero-ring {
  width: 136rpx;
  height: 136rpx;
}

.hero-ring .ring-text {
  font-size: var(--fs-body);
}

/* ---------- 今日安排 ---------- */
/* 每行前面留一道状态槽：序号与勾共用一格，行首就对齐了 */
.plan-row {
  display: flex;
  align-items: center;
  padding: var(--sp-2) var(--sp-1);
  border-bottom: 1rpx solid var(--line-2);
  border-radius: 10rpx;
  transition: background-color var(--t-press);
}

.plan-row:last-child {
  border-bottom: none;
}

/* 序号：等宽字 + 固定槽。序号是「第几首」，它旁边是会换行的标题，
   所以它必须是那条不动的竖线 —— 位数变了也占同一格 */
.seq {
  width: 52rpx;
  flex: none;
  font-size: var(--fs-caption);
  font-variant-numeric: tabular-nums;
  color: var(--ink-3);
  text-align: center;
}

.seq.done {
  color: var(--green);
}

.row-line {
  display: flex;
  align-items: center;
}

.row-line .row-title {
  flex: 0 1 auto;
  margin-right: 12rpx;
}

/* 完成标记：一个空圆变实底圆。
   用「有没有」而不是「一个勾两个颜色」——扫一眼就分得清哪几首还没动 */
.tick {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  margin-left: var(--sp-2);
  border-radius: 50%;
  border: 2rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color var(--t-press), border-color var(--t-press);
}

.tick.on {
  background: var(--green);
  border-color: var(--green);
}

.tick-t {
  font-size: var(--fs-caption);
  color: #fff;
  line-height: 1;
}

/* ---------- 未登录那张目录 ---------- */
.toc-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--sp-1);
}

.toc-head .card-title {
  margin-bottom: 0;
}

.toc-hint {
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

.toc-row {
  display: flex;
  align-items: center;
  padding: var(--sp-2) var(--sp-1);
  border-bottom: 1rpx solid var(--line-2);
  border-radius: 10rpx;
  transition: background-color var(--t-press);
}

.toc-row:last-child {
  border-bottom: none;
}

/* 未登录时的行尾：写「登录」而不是一把小锁图标 ——
   图标要人猜，字不用 */
.row-lock {
  flex: none;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  padding: 4rpx 14rpx;
  border-radius: var(--radius-pill);
  background: var(--line-2);
}

.empty-btn {
  margin-top: var(--sp-3);
}
