.home {
  padding-top: var(--sp-1);
}

/* ---------- 首屏那张卡 ----------
   一屏一件事：上面一行日期，中间一个大标题，下面三个大数字，
   最后是这一屏唯一的一颗墨黑按钮。

   上一版这张卡是一道金色微光渐变 + 一枚缃色光晕 + 一个进度环 ——
   三样东西都在说「我很重要」，谁也没说清「今天背几首」。
   这一版把「重要」交给三件事：留白、字号差、唯一性。 */
.hero {
  padding: var(--sp-5) var(--sp-4) var(--sp-4);
}

.hero-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-left {
  flex: 1;
  min-width: 0;
  padding-right: var(--sp-2);
}

/* 小字在上、大字在下 —— 参考图里「9:41 / 我的 / 当前积分余额」就是这个次第 */
.hero-eyebrow {
  display: block;
  font-size: var(--fs-caption);
  letter-spacing: var(--ls-caption);
  color: var(--ink-3);
  margin-bottom: var(--sp-2);
}

.hero-title {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-head);
  font-weight: 700;
  color: var(--strong-text);
  letter-spacing: var(--ls-title);
  line-height: var(--lh-tight);
}

.hero-sub {
  display: block;
  font-size: var(--fs-hint);
  color: var(--ink-3);
  margin-top: var(--sp-2);
}

/* 三个大数字之间留得很松 —— 它是这一屏唯一的「大」，
   抠着留白就白做了 */
.hero-stats {
  margin-top: var(--sp-4);
}

.hero-btn {
  margin-top: var(--sp-4);
}

/* 细进度条：数字给「几首」，这条给「走到哪了」 */
.hero-meter {
  margin-top: var(--sp-3);
}

/* 「按什么排的」那行说明 —— 参考图里「档位定义 / 4 个档位 · 颜色用于月历标记」
   就在卡片底部这个位置：一行灰字，右边一个箭头，说明「这里还能点进去」。 */
.hero-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 76rpx;
  margin-top: var(--sp-3);
  padding-top: var(--sp-3);
  border-top: 1rpx solid var(--line-2);
  border-radius: var(--radius-sm);
}

.hero-foot-t {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-foot-go {
  flex: none;
  color: var(--ink-4);
  font-size: var(--fs-title);
  line-height: 1;
  padding-left: var(--sp-2);
}

/* 未登录那张卡的印章：一枚墨黑圆标。
   上一版是朱砂方印旋转 4 度 —— 那是网页版的语言，不是参考图的。 */
.seal {
  flex: none;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--strong);
  display: flex;
  align-items: center;
  justify-content: center;
}

.seal-t {
  font-family: var(--font-poem);
  font-size: var(--fs-mark);
  color: var(--on-ink);
}

/* ---------- 进度环（复习设置等处仍用）---------- */
.ring-hover {
  opacity: .82;
}

/* ---------- 今日安排 ---------- */
/* 每行前面留一道状态槽：序号与勾共用一格，行首就对齐了 */
.plan-row {
  display: flex;
  align-items: center;
  min-height: var(--h-row);
  padding: var(--sp-2) var(--sp-1);
  border-bottom: 1rpx solid var(--line-2);
  border-radius: var(--radius-sm);
  transition: background-color var(--t-press);
}

.plan-row:last-child {
  border-bottom: none;
}

/* 序号：等宽字 + 固定槽。序号是「第几首」，它旁边是会换行的标题，
   所以它必须是那条不动的竖线 —— 位数变了也占同一格 */
.seq {
  width: 52rpx;
  flex: none;
  font-size: var(--fs-caption);
  font-variant-numeric: tabular-nums;
  color: var(--ink-3);
  text-align: center;
}

.seq.done {
  color: var(--green);
}

.row-line {
  display: flex;
  align-items: center;
}

.row-line .row-title {
  flex: 0 1 auto;
  margin-right: 12rpx;
}

/* 完成标记：一个空圆变实底圆。
   用「有没有」而不是「一个勾两个颜色」——扫一眼就分得清哪几首还没动 */
.tick {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  margin-left: var(--sp-2);
  border-radius: 50%;
  border: 2rpx solid var(--line-strong);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color var(--t-press), border-color var(--t-press);
}

.tick.on {
  background: var(--strong);
  border-color: var(--strong);
}

.tick-t {
  font-size: var(--fs-caption);
  color: var(--on-ink);
  line-height: 1;
}

/* ---------- 未登录那张目录 ---------- */
.toc-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--sp-1);
}

.toc-head .card-title {
  margin-bottom: 0;
}

.toc-row {
  display: flex;
  align-items: center;
  min-height: var(--h-row);
  padding: var(--sp-2) var(--sp-1);
  border-bottom: 1rpx solid var(--line-2);
  border-radius: var(--radius-sm);
  transition: background-color var(--t-press);
}

.toc-row:last-child {
  border-bottom: none;
}

/* ---------- 行尾槽 ----------
   一行最后那一格。未登录时放「登录」胶囊，登录后放完成勾 ——
   两者一个宽一个窄，**但槽本身的宽度是固定的**。

   不固定会怎样：未登录的胶囊比勾宽一圈，于是标题栏被挤窄一截，
   同一份目录在两态下右端参差，一登录整列字都往右挪了位。
   宽度按宽的那个（「登录」胶囊）取，两种状态共用。 */
.row-end {
  flex: none;
  width: 112rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

/* 未登录时的行尾：写「登录」而不是一把小锁图标 ——
   图标要人猜，字不用 */
.row-lock {
  flex: none;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  padding: 4rpx 16rpx;
  border-radius: var(--radius-pill);
  background: var(--sink);
}

.empty-btn {
  margin-top: var(--sp-3);
}
