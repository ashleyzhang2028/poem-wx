.home {
  padding: var(--sp-3);
}

.hero {
  padding: var(--sp-3) var(--sp-3);
}

.hero-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-left {
  flex: 1;
  min-width: 0;
  padding-right: var(--sp-2);
}

.hero-eyebrow {
  display: block;
  font-size: var(--fs-caption);
  letter-spacing: var(--ls-caption);
  color: var(--ink-3);
  margin-bottom: var(--sp-2);
}

.hero-title {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-head);
  font-weight: 700;
  color: var(--strong-text);
  letter-spacing: var(--ls-title);
  line-height: var(--lh-tight);
}

.hero-sub {
  display: block;
  font-size: var(--fs-hint);
  color: var(--ink-3);
  margin-top: var(--sp-2);
}

.hero-stats {
  margin-top: var(--sp-4);
}

.hero-stats .stat-ring {
  padding: 0;
}

.stat-dash {
  color: var(--ink-4);
}

.seal {
  flex: none;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--strong);
  display: flex;
  align-items: center;
  justify-content: center;
}

.seal-t {
  font-family: var(--font-poem);
  font-size: var(--fs-mark);
  color: var(--on-ink);
}

.ring-hover {
  opacity: .82;
}

.seq {
  width: 52rpx;
  flex: none;
  font-size: var(--fs-caption);
  font-variant-numeric: tabular-nums;
  color: var(--ink-3);
  text-align: center;
}

.seq.done {
  color: var(--green);
}

.row-line {
  display: flex;
  align-items: center;
}

.row-line .row-title {
  flex: 0 1 auto;

  min-width: 0;
  margin-right: 12rpx;
}

.row-lock,
.row-state {
  flex: none;
  margin-left: var(--sp-2);
  font-size: var(--fs-caption);
  letter-spacing: var(--ls-caption);
  color: var(--ink-3);
  padding: 4rpx 16rpx;
  border-radius: var(--radius-pill);
  background: var(--sink);
  white-space: nowrap;
}

.row-state.on {
  color: var(--ink-2);
  font-weight: 600;
}

.all-title {
  flex: 1;
  min-width: 0;
}

.all-count {
  flex: none;
  font-family: var(--font-num);
  font-size: var(--fs-caption);
  color: var(--ink-3);
  padding-left: var(--sp-2);
  font-variant-numeric: tabular-nums;
}

.all-toggle {
  flex: none;
  font-size: var(--fs-lead);
  line-height: 1;
  color: var(--ink-3);
  padding-left: var(--sp-2);
}

.row-end {
  flex: none;
  width: 112rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.empty-btn {
  margin-top: var(--sp-3);
}

.guest-bar {
  display: flex;
  flex-direction: column;
  margin: var(--sp-3) 0;
  padding: var(--sp-3) var(--sp-3);
  border-radius: var(--radius);
  background: var(--amber-light);
  border: 1rpx solid var(--amber-edge);
}

.guest-bar-hover {
  opacity: .88;
}

.guest-title {
  font-size: var(--fs-hint);
  font-weight: 600;
  color: var(--amber);
}

.guest-sub {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 8rpx;
  line-height: 1.6;
}
