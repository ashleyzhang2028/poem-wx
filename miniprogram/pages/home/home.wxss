.home {
  padding: var(--sp-3);
  padding-top: 0;
  position: relative;
  background: var(--surface);
}

.banner {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: calc(var(--status-h) + var(--nav-h) + min(100vw / 1.875, 360px));
  overflow: hidden;
  background: var(--surface);
}

.banner-img {
  display: block;
  width: 100%;
  height: auto;
}

.banner-space {
  pointer-events: none;
}

.home .de {
  margin-bottom: var(--sp-2);
}

.hero {
  padding: var(--sp-3) var(--sp-3);
  background: transparent;
}

.home .hero-lead {
  position: relative;
  z-index: 1;
  margin-top: calc(-5 * var(--sp-5));
}

.hero-eyebrow {
  display: block;
  font-size: var(--fs-caption);
  letter-spacing: var(--ls-caption);
  color: var(--ink-3);
  margin-bottom: var(--sp-2);
}

.extra-search {
  margin-bottom: var(--sp-2);
}

.hero-title {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-head);
  font-weight: 400;
  color: var(--strong-text);
  letter-spacing: var(--ls-title);
  line-height: var(--lh-tight);
}

.hero-sub {
  display: block;
  font-size: var(--fs-hint);
  color: var(--ink-3);
  margin-top: var(--sp-2);
}

.hero-stats {
  margin-top: var(--sp-4);
}

.hero-cheer {
  display: block;
  font-size: var(--fs-hint);
  color: var(--ink-2);
  margin-top: var(--sp-3);
}

.hero-stats .stat-ring {
  padding: 0;
}

.ring-hover {
  opacity: .82;
}

.tag.row-state {
  color: var(--ink-3);
  margin-right: 0;
}

.tag.row-state.on {
  color: var(--ink-2);
}

.faces {
  flex: none;
  display: flex;
  align-items: center;
  padding-left: var(--sp-3);
}

.face {
  width: 48rpx;
  height: 48rpx;
  margin-left: var(--sp-3);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: background-color var(--t-press);
}

.face-ico {
  width: 40rpx;
  height: 40rpx;
  background-color: currentColor;
  color: var(--ink-4);
  mask-repeat: no-repeat;
  mask-position: center;
  mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-position: center;
  -webkit-mask-size: contain;
}

.face-hover {
  background: var(--sink);
}

.face.on.bad .face-ico {
  color: var(--red);
}

.face.on.fuzzy .face-ico {
  color: var(--amber);
}

.face.on.good .face-ico {
  color: var(--strong);
}

.all-title {
  flex: 1;
  min-width: 0;
  margin-bottom: 0;
}

.all-count {
  flex: none;
  font-family: var(--font-num);
  font-size: var(--fs-caption);
  color: var(--ink-3);
  padding-left: var(--sp-2);
  font-variant-numeric: tabular-nums;
}

.all-toggle {
  flex: none;
  box-sizing: border-box;
  width: 14rpx;
  height: 14rpx;
  margin: 0 var(--sp-1) 6rpx var(--sp-3);
  border-right: 2rpx solid var(--ink-3);
  border-bottom: 2rpx solid var(--ink-3);
  transform: rotate(45deg);
  transition: transform var(--t-move) var(--ease);
}

.all-toggle.open {
  margin-bottom: 0;
  margin-top: 6rpx;
  transform: rotate(-135deg);
}

.row-end {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: nowrap;
  padding-left: var(--sp-2);
}

.empty-btn {
  margin-top: var(--sp-3);
}


.finish {
  padding: var(--sp-5) var(--sp-3) var(--sp-4);
  text-align: center;
}

.finish-self {
  border-top: 1px solid var(--line-2);
}

.card-done {
  margin-top: var(--sp-3);
  padding-top: var(--sp-4);
  text-align: center;
  border-top: 1px solid var(--line-2);
}

.finish-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  margin: 0 auto var(--sp-2);
  border-radius: 50%;
  background: var(--sink);
}

.finish-ico {
  width: 52rpx;
  height: 52rpx;
  background-color: currentColor;
  color: var(--strong-text);
  mask-repeat: no-repeat;
  mask-position: center;
  mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-position: center;
  -webkit-mask-size: contain;
}

.finish-text {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-title);
  color: var(--ink-2);
  letter-spacing: var(--ls-title);
  line-height: var(--lh-loose);
}

.finish-tip {
  display: block;
  margin-top: var(--sp-2);
}

.seasonal-list {
  margin-top: var(--sp-2);
}

.seasonal-btns {
  flex: none;
  display: flex;
  align-items: center;
  gap: var(--sp-2);
}

.de-btn {
  flex: none;
  width: 60rpx;
  height: 60rpx;
  box-sizing: border-box;
  border: 1rpx solid transparent;
  border-radius: 50%;
  background: var(--sink);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color var(--t-press), border-color var(--t-press), color var(--t-press);
}

.de-btn .glyph {
  color: var(--ink-2);
}

.de-btn.on {
  background: var(--strong-soft);
  border-color: var(--strong);
}

.de-btn.on .glyph {
  color: var(--strong-text);
}

.de-btn-hover {
  transform: scale(.94);
}
