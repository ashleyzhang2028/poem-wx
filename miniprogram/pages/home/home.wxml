<view class="page home">
  <!-- 未登录：一屏目录，看得到、点不进 -->
  <block wx:if="{{guest}}">
    <view class="card today">
      <view class="today-head">
        <view class="today-left">
          <text class="today-title">{{gradeName}}</text>
          <text class="today-sub">{{scopeName}} · {{catalogCount}} 首</text>
        </view>
      </view>
      <button class="btn primary block today-start" bindtap="onLogin">微信登录后开始背</button>
      <text class="hint foot">不登录只能看目录。登录之后：每日计划、注音朗读、进度跨设备</text>
    </view>

    <view class="card">
      <view class="row" hover-class="row-hover" hover-stay-time="60"
            wx:for="{{catalog}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpen">
        <view class="row-main">
          <view class="row-line">
            <text class="row-title">{{item.title}}</text>
          </view>
          <text class="row-sub">{{item.dynasty}} · {{item.author}}</text>
        </view>
        <view class="row-state lock">›</view>
      </view>
    </view>
  </block>

  <!-- 登录后：今日计划 -->
  <block wx:else>
    <view class="card today">
      <view class="today-head">
        <view class="today-left">
          <text class="today-title">今日背诵</text>
          <text class="today-sub">{{gradeName}} · {{scopeName}}</text>
        </view>
        <!-- 进度环整块可点，进背诵设置；点的是「看进度」，不是「点按钮」 -->
        <view class="ring" hover-class="ring-hover" hover-stay-time="80" bindtap="onSettings">
          <view class="ring-track"></view>
          <view class="ring-fill" style="--p:{{percent}}"></view>
          <text class="ring-text">{{doneCount}}/{{total}}</text>
        </view>
      </view>

      <button class="btn primary block today-start" bindtap="onStart" wx:if="{{total}}">
        {{doneCount >= total ? '今天背完了 · 再练一遍' : '开始背'}}
      </button>
      <button class="btn ghost block today-start" bindtap="onBrowseAll" wx:else>看看课内 251 首</button>
    </view>

    <view class="card">
      <view class="row" hover-class="row-hover" hover-stay-time="60"
            wx:for="{{plan}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpen">
        <view class="row-main">
          <view class="row-line">
            <text class="row-title">{{item.title}}</text>
            <text class="tag {{item.reasonKey === 'review' ? 'amber' : 'ghost'}}">{{item.reason}}</text>
          </view>
          <text class="row-sub">{{item.dynasty}} · {{item.author}} · {{item.stage}}</text>
        </view>
        <view class="row-state {{item.read ? 'done' : ''}}">{{item.read ? '✓' : '›'}}</view>
      </view>
      <view class="empty" wx:if="{{!total}}">今天的计划还没排出来，去「我的」看看背诵范围</view>
    </view>

    <view class="hint foot">进度只存在这台手机上 · 断网也能背</view>
  </block>
</view>
