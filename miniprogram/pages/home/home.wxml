<view class="page home {{barBelow ? 'has-tabbar' : 'tall'}}" style="{{themeStyle}}">

  <page-banner src="{{banner}}" />

  <block wx:if="{{guest}}">
    <view class="card hero hero-lead">
      <text class="hero-eyebrow">今日</text>
      <text class="hero-title">{{gradeName}}</text>
      <text class="hero-sub">{{scopeName}} · 共 {{catalogCount}} 首</text>
    </view>

    <view class="card">
      <view class="card-open">
        <text class="card-title">今日背诵</text>
      </view>

      <view class="row row-flush" hover-class="row-hover" hover-stay-time="60"
            wx:for="{{catalog}}" wx:key="id" data-id="{{item.id}}" bindtap="onGuestOpen">
        <view class="row-main">
          <text class="row-title row-poem">{{item.title}}</text>
          <text class="row-sub">{{item.dynasty}} · {{item.author}}</text>
        </view>

        <view class="row-end">
          <text class="tag idle">未背</text>
          <text class="row-go">›</text>
        </view>
      </view>

      <view class="empty" wx:if="{{!loading && !catalogCount}}">
        <text class="empty-mark">诗</text>
        <text class="empty-text">{{catalogLead}}</text>
        <text class="hint empty-tip">{{catalogMiss}}</text>
      </view>
    </view>

    <button class="btn primary block login-lead" bindtap="onLoginTapped">登录</button>

    <view class="safe-bottom"></view>
  </block>

  <block wx:else>

    <view class="card hero hero-lead">
      <text class="hero-eyebrow">{{todayLabel}}</text>
      <text class="hero-title">今日背诵</text>
      <text class="hero-sub" wx:if="{{selfOnly}}">只背自选 · 课内暂停</text>
      <text class="hero-sub" wx:else>{{gradeName}} · {{scopeName}}</text>

      <view class="stats hero-stats">
        <view class="stat">
          <text class="stat-v">{{stats.today}}</text>
          <text class="stat-k">今日</text>
        </view>
        <view class="stat">
          <text class="stat-v">{{doneCount}}</text>
          <text class="stat-k">已背</text>
        </view>
        <view class="stat">
          <text class="stat-v">{{stats.left}}</text>
          <text class="stat-k">待背</text>
        </view>
        <view class="stat stat-ring">
          <view class="ring-cap">
            <view class="ring">
              <view class="ring-track"></view>
              <view class="ring-fill" style="--p:{{percent}}"></view>
              <text class="ring-text">{{percent}}%</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="card seasonal" wx:if="{{seasonal}}">
      <view class="card-open">
        <text class="card-title seasonal-title">季节限定</text>
        <text class="all-count">{{seasonal.rows.length}}</text>
        <view class="seasonal-refresh" hover-class="seasonal-refresh-hover" hover-stay-time="60"
              wx:if="{{seasonal.refresh}}" catchtap="onSeasonalRefresh" aria-label="换一批">
          <view class="glyph" style="mask-image:url('{{icons.refresh}}');-webkit-mask-image:url('{{icons.refresh}}');"></view>
        </view>
      </view>

      <view class="seasonal-list">
        <view class="row row-flush seasonal-row" hover-class="row-hover" hover-stay-time="60"
              wx:for="{{seasonal.rows}}" wx:key="id" data-id="{{item.id}}" bindtap="onSeasonalOpen">
          <text class="seq {{item.recited ? 'on' : ''}}">{{item.seq}}</text>
          <view class="row-main">
            <text class="row-title row-poem">{{item.title}}</text>
            <view class="row-sub">
              <text class="row-sub-t">{{item.dynasty}}{{item.author ? ' · ' + item.author : ''}}</text>
              <text class="tag row-tag row-cat theme" wx:if="{{seasonal.tag}}">{{seasonal.tag}}</text>
            </view>
          </view>
          <view class="seasonal-btns">
            <view class="round-btn {{item.daily ? 'on' : ''}}" hover-class="round-btn-hover" hover-stay-time="60"
                  data-id="{{item.id}}" catchtap="onSeasonalAdd"
                  aria-label="{{item.daily ? '移出今日加背' : '加入今日加背'}}">
              <view class="glyph" style="mask-image:url('{{icons[item.daily ? 'added' : 'add']}}');-webkit-mask-image:url('{{icons[item.daily ? 'added' : 'add']}}');"></view>
            </view>
            <view class="round-btn {{item.collected ? 'on' : ''}}" hover-class="round-btn-hover" hover-stay-time="60"
                  data-id="{{item.id}}" catchtap="onSeasonalCollect"
                  aria-label="{{item.collected ? '移出自选集' : '加入自选集'}}">
              <view class="glyph" style="mask-image:url('{{icons.playlist}}');-webkit-mask-image:url('{{icons.playlist}}');"></view>
            </view>
          </view>
        </view>
      </view>

    </view>

    <view class="extra-search">
      <view class="search">
        <view class="search-icon" style="mask-image:url('{{icons.search}}');-webkit-mask-image:url('{{icons.search}}');"></view>

        <input placeholder="今日加背 · 搜篇名 / 作者 / 朝代" value="{{extraKeyword}}" bindinput="onExtraInput"
               confirm-type="search" bindconfirm="onExtraSearch" />
        <view class="clear" hover-class="clear-hover" hover-stay-time="60" wx:if="{{extraKeyword}}" bindtap="onExtraClear">
          <view class="clear-ico" style="mask-image:url('{{icons.clear}}');-webkit-mask-image:url('{{icons.clear}}');"></view>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="card-open">
        <text class="card-title">{{selfOnly ? '今日加背' : '今日课内'}}</text>
        <text class="all-count" wx:if="{{!selfOnly}}">{{baseCount ? doneCount + '/' + baseCount : total + ' 首'}}</text>
      </view>

      <daily-extra id="extra" theme-style="{{themeStyle}}" bind:change="onExtraChange" />

      <skeleton rows="3" wx:if="{{loading}}" />
      <block wx:else>
        <view class="row row-flush" hover-class="row-hover" hover-stay-time="60"
              wx:for="{{selfOnly ? coursePlan : plan}}" wx:key="id">
          <text class="seq {{item.recited ? 'on' : ''}}">{{item.seq}}</text>
          <view class="row-main row-main-tap" hover-class="row-main-hover" hover-stay-time="60" data-id="{{item.id}}" bindtap="onOpen">
            <text class="row-title row-poem">{{item.title}}</text>
            <view class="row-sub">
              <text class="row-sub-t">{{item.dynasty}} · {{item.author}}{{item.stage ? ' · ' + item.stage : ''}}</text>
              <text class="tag row-tag row-cat {{item.source === '课内' ? 'course' : 'own'}}">{{item.source}}</text>
              <text class="tag row-tag {{item.tagCls}}" wx:if="{{item.reasonOn}}">{{item.reason}}</text>
            </view>
          </view>
          <view class="faces">
            <view class="face {{item.picked === face.key ? 'on ' + face.cls : ''}}" hover-class="face-hover" hover-stay-time="60"
                  wx:for="{{faces}}" wx:for-item="face" wx:key="key"
                  data-id="{{item.id}}" data-key="{{face.key}}" bindtap="onFace">
              <view class="face-ico" style="mask-image:url('{{face.icon}}');-webkit-mask-image:url('{{face.icon}}');"></view>
            </view>
          </view>
        </view>
      </block>

      <view class="empty" wx:if="{{!loading && !(selfOnly ? coursePlan.length : total)}}">
        <text class="empty-mark">诗</text>
        <text class="empty-text">{{selfOnly ? '今天没有加背' : '今日未排计划'}}</text>

        <button class="btn ghost mini empty-btn" bindtap="onSettings">设置</button>
      </view>

      <view class="card-done" wx:if="{{allDone}}">
        <view class="finish-mark">
          <view class="finish-ico" style="mask-image:url('{{icons.checked}}');-webkit-mask-image:url('{{icons.checked}}');"></view>
        </view>
        <text class="finish-text">{{praise}}</text>
        <text class="hint finish-tip">想多背一首，搜今日加背</text>
      </view>
    </view>

    <view class="card" wx:if="{{!collectionCount}}">
      <text class="card-title">自选背诵</text>
      <text class="hint">还没有自选集合，在课外阅读或搜索里看到好诗，加入自己的集合</text>
    </view>

    <block wx:if="{{collectionOn}}">
      <view class="card" wx:for="{{collections}}" wx:key="id" wx:for-item="coll">
        <view class="card-open" hover-class="card-hover" hover-stay-time="60" data-id="{{coll.id}}" bindtap="onProgress">
          <text class="card-title">{{coll.title}}</text>
          <text class="all-count">{{coll.planned ? coll.done + '/' + coll.planned : coll.count + ' 首'}}</text>
          <view class="coll-dot" style="background:{{coll.color}}"></view>
          <text class="row-go">›</text>
        </view>

        <view class="row row-flush" hover-class="row-hover" hover-stay-time="60"
              wx:for="{{coll.rows}}" wx:key="id">
          <text class="seq {{item.recited ? 'on' : ''}}">{{item.seq}}</text>
          <view class="row-main row-main-tap" hover-class="row-main-hover" hover-stay-time="60" data-id="{{item.id}}" data-coll="{{coll.id}}" bindtap="onOpenCollection">
            <text class="row-title row-poem">{{item.title}}</text>
            <view class="row-sub">
              <text class="row-sub-t">{{item.dynasty}} · {{item.author}}{{item.stage ? ' · ' + item.stage : ''}}</text>
              <text class="tag row-tag row-cat {{item.source === '课内' ? 'course' : 'own'}}">{{item.source}}</text>
              <text class="tag row-tag {{item.tagCls}}" wx:if="{{item.reasonOn}}">{{item.reason}}</text>
            </view>
          </view>
          <view class="faces">
            <view class="face {{item.picked === face.key ? 'on ' + face.cls : ''}}" hover-class="face-hover" hover-stay-time="60"
                  wx:for="{{faces}}" wx:for-item="face" wx:key="key"
                  data-id="{{item.id}}" data-key="{{face.key}}" bindtap="onFace">
              <view class="face-ico" style="mask-image:url('{{face.icon}}');-webkit-mask-image:url('{{face.icon}}');"></view>
            </view>
          </view>
        </view>

        <view class="card-done" wx:if="{{coll.doneToday}}">
          <view class="finish-mark">
            <view class="finish-ico" style="mask-image:url('{{icons.checked}}');-webkit-mask-image:url('{{icons.checked}}');"></view>
          </view>
          <text class="finish-text">{{coll.praise}}</text>
        </view>

        <view class="empty" wx:if="{{!coll.rows.length}}">
          <text class="empty-mark">选</text>
          <text class="empty-text">这个集合还是空的</text>
          <text class="hint empty-tip">在课外阅读或搜索里看到好诗，加进自己的集合</text>
        </view>
      </view>
    </block>

    <view class="card" wx:if="{{allCount}}">
      <view class="card-open" hover-class="card-hover" hover-stay-time="60" bindtap="onToggleAll">
        <text class="card-title all-title">{{allLabel}}</text>
        <text class="all-count">{{allCount}}</text>
        <view class="all-toggle {{allOpen ? 'open' : ''}}"></view>
      </view>

      <block wx:if="{{allOpen}}">
        <view class="row row-flush" hover-class="row-hover" hover-stay-time="60"
              wx:for="{{allRows}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpenAll">
          <text class="seq {{item.recited ? 'on' : ''}}">{{item.seq}}</text>
          <view class="row-main">
            <text class="row-title row-poem">{{item.title}}</text>
            <text class="row-sub">{{item.dynasty}}{{item.author ? ' · ' + item.author : ''}}{{item.place ? ' · ' + item.place : ''}} · {{item.stage}}</text>
          </view>
          <view class="row-end">
            <text class="tag row-state {{item.stateCls}}">{{item.stateText}}</text>
          </view>
        </view>
      </block>
    </view>

    <collect-picker id="collect" theme-style="{{themeStyle}}" bind:done="onCollectDone" bind:goCreate="onGoCollections" />

    <recite-sheet id="sheet" queue="{{sheetRows}}" theme-style="{{themeStyle}}"
                    bind:open="onSheetOpen" bind:finish="onSheetFinish"
                    bind:change="onExtraChange" bind:defer="onDeferChange" />

    <view class="safe-bottom"></view>
  </block>
</view>
