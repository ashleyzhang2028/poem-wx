<view class="page home has-tabbar" style="{{themeStyle}}">
  <!-- 未登录：一屏目录，看得到、点不进 -->
  <block wx:if="{{guest}}">
    <view class="card hero">
      <view class="hero-head">
        <view class="hero-left">
          <text class="hero-eyebrow">今日</text>
          <text class="hero-title">{{gradeName}}</text>
          <text class="hero-sub">{{scopeName}} · 共 {{catalogCount}} 首</text>
        </view>
        <view class="seal"><text class="seal-t">跬</text></view>
      </view>
      <button class="btn primary block hero-btn" bindtap="onLogin">微信登录</button>
    </view>

    <view class="card toc">
      <view class="toc-head">
        <text class="card-title bar">课本目录</text>
      </view>
      <!-- 行尾一律写「登录」而不是一把小锁：图标要人猜，字不用 -->
      <view class="toc-row" hover-class="row-hover" hover-stay-time="60"
            wx:for="{{catalog}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpen">
        <text class="seq">{{item.seq}}</text>
        <view class="row-main">
          <text class="row-title row-poem">{{item.title}}</text>
          <text class="row-sub">{{item.dynasty}} · {{item.author}}</text>
        </view>
        <!-- 行尾这一格是**共用槽**：未登录放「登录」胶囊，登录后放勾。
             槽宽固定，两态下列表标题栏的右端才落在同一条竖线上 ——
             否则同一份目录，登录前登录后标题宽度不一样，一登录整列字都挪位。 -->
        <view class="row-end"><text class="row-lock">登录</text></view>
      </view>
    </view>

    <view class="safe-bottom"></view>
  </block>

  <!-- 登录后：今日计划 -->
  <block wx:else>
    <!-- 一屏一件事：这张卡只回答「今天背什么」。
         上面一行日期小字，中间一个大标题，下面是三个大数字，
         最后是这一屏唯一的一颗墨黑按钮 —— 与参考图同一套层次。 -->
    <view class="card hero">
      <text class="hero-eyebrow">{{todayLabel}}</text>
      <text class="hero-title">今日背诵</text>
      <text class="hero-sub">{{gradeName}} · {{scopeName}}</text>

      <!-- 三个大数字：今日要背几首、已经背了几首、还剩几首。
           中间一道细竖线分开 —— 它就是「这一屏的第一眼」 -->
      <view class="stats hero-stats">
        <view class="stat">
          <text class="stat-v">{{stats.today}}</text>
          <text class="stat-k">今日</text>
        </view>
        <view class="stat">
          <text class="stat-v">{{stats.done}}</text>
          <text class="stat-k">已背</text>
        </view>
        <view class="stat">
          <text class="stat-v">{{stats.left}}</text>
          <text class="stat-k">还剩</text>
        </view>
      </view>

      <!-- 一条细进度：数字说「几首」，这条说「走到哪了」 -->
      <view class="meter hero-meter" wx:if="{{total}}">
        <view class="meter-fill" style="width:{{percent}}%"></view>
      </view>

      <button class="btn primary block hero-btn" bindtap="onStart" wx:if="{{total}}">
        {{doneCount >= total ? '再练一遍' : '开始背'}}
      </button>
      <button class="btn ghost block hero-btn" bindtap="onBrowseAll" wx:else>看课内 251 首</button>

      <!-- 「怎么排的」这件事不能藏起来：它决定明天背什么，用户得找得到入口 -->
      <view class="hero-foot" hover-class="row-hover" hover-stay-time="60" bindtap="onSettings">
        <text class="hero-foot-t">背诵设置</text>
        <text class="hero-foot-go">›</text>
      </view>
    </view>

    <view class="card">
      <view class="card-title bar">今日安排</view>
      <skeleton rows="3" wx:if="{{loading}}" />
      <block wx:else>
        <view class="plan-row" hover-class="row-hover" hover-stay-time="60"
              wx:for="{{plan}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpen">
          <text class="seq {{item.read ? 'done' : ''}}">{{item.seq}}</text>
          <view class="row-main">
            <view class="row-line">
              <text class="row-title row-poem">{{item.title}}</text>
              <text class="tag {{item.reasonKey === 'review' ? 'amber' : (item.reasonKey === 'new' ? 'blue' : 'ghost')}}">{{item.reason}}</text>
            </view>
            <text class="row-sub">{{item.dynasty}} · {{item.author}}{{item.stage ? ' · ' + item.stage : ''}}</text>
          </view>
          <view class="row-end">
            <view class="tick {{item.read ? 'on' : ''}}">
              <text class="tick-t">{{item.read ? '✓' : ''}}</text>
            </view>
          </view>
        </view>
      </block>

      <view class="empty" wx:if="{{!loading && !total}}">
        <text class="empty-mark">诗</text>
        <text class="empty-text">今天还没排计划</text>
        <button class="btn ghost mini empty-btn" bindtap="onSettings">去设置</button>
      </view>
    </view>

    <!-- 背诵弹层：点篇名、点「开始背」都从底部弹这张卡上来。
         它挂在页面根节点上而不是某张卡里 —— 它是 fixed 的整屏浮层，
         放进卡片会被卡片的层叠上下文裁掉。 -->
    <recite-sheet id="sheet" queue="{{plan}}" theme-style="{{themeStyle}}"
                    bind:open="onSheetOpen" bind:finish="onSheetFinish" />

    <view class="safe-bottom"></view>
  </block>
</view>
