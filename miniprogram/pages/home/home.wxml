<view class="page home has-tabbar" style="{{themeStyle}}">

  <block wx:if="{{guest}}">
    <view class="card hero">
      <view class="hero-head">
        <view class="hero-left">
          <text class="hero-eyebrow">今日</text>
          <text class="hero-title">{{gradeName}}</text>
          <text class="hero-sub">{{scopeName}} · 共 {{catalogCount}} 首</text>
        </view>
        <view class="seal"><text class="seal-t">跬</text></view>
      </view>
      <button class="btn primary block hero-btn" bindtap="onLogin">登录</button>
    </view>

    <view class="guest-bar" hover-class="guest-bar-hover" hover-stay-time="60" bindtap="onLogin">
      <text class="guest-title">游客模式</text>
    </view>

    <view class="card">
      <view class="card-open">
        <text class="card-title bar">今日背诵</text>
      </view>

      <view class="row row-flush" hover-class="row-hover" hover-stay-time="60"
            wx:for="{{catalog}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpen">
        <view class="row-main">
          <text class="row-title row-poem">{{item.title}}</text>
          <text class="row-sub">{{item.dynasty}} · {{item.author}}</text>
        </view>

        <view class="row-end"><text class="row-lock">未背</text></view>
      </view>

      <view class="empty" wx:if="{{!loading && !catalogCount}}">
        <text class="empty-mark">诗</text>
        <text class="empty-text">{{catalogLead}}</text>
        <text class="hint empty-tip">{{catalogMiss}}</text>
      </view>
    </view>

    <view class="safe-bottom"></view>
  </block>

  <block wx:else>

    <view class="card hero">
      <text class="hero-eyebrow">{{todayLabel}}</text>
      <text class="hero-title">今日背诵</text>
      <text class="hero-sub" wx:if="{{selfOnly}}">只背自选 · 课内暂停</text>
      <text class="hero-sub" wx:else>{{gradeName}} · {{scopeName}}</text>

      <view class="stats hero-stats">
        <view class="stat">
          <text class="stat-v">{{stats.today}}</text>
          <text class="stat-k">今日</text>
        </view>
        <view class="stat">
          <text class="stat-v">{{stats.done}}</text>
          <text class="stat-k">已背</text>
        </view>
        <view class="stat" wx:if="{{stats.self}}">
          <text class="stat-v">{{stats.self}}</text>
          <text class="stat-k">自选</text>
        </view>
        <view class="stat stat-ring">
          <view class="ring-cap" wx:if="{{percent}}">
            <view class="ring">
              <view class="ring-track"></view>
              <view class="ring-fill" style="--p:{{percent}}"></view>
              <text class="ring-text">{{percent}}%</text>
            </view>
          </view>
          <text class="stat-v stat-dash" wx:else>—</text>
        </view>
      </view>

    </view>

    <view class="card">
      <daily-extra id="extra" theme-style="{{themeStyle}}" bind:change="onExtraChange" />
    </view>

    <view class="card">
      <skeleton rows="3" wx:if="{{loading}}" />
      <block wx:else>
        <view class="row row-flush" hover-class="row-hover" hover-stay-time="60"
              wx:for="{{plan}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpen">
          <text class="seq {{item.recited ? 'on' : ''}}">{{item.seq}}</text>
          <view class="row-main">
            <view class="row-line">
              <text class="row-title row-poem">{{item.title}}</text>
              <text class="tag {{item.tagCls}}">{{item.reason}}</text>
            </view>
            <text class="row-sub">{{item.dynasty}} · {{item.author}}{{item.stage ? ' · ' + item.stage : ''}}</text>
          </view>
          <view class="row-end">
            <text class="row-state {{item.recited ? 'on' : ''}}">{{item.recited ? '已背' : '未背'}}</text>
            <text class="row-state" wx:if="{{!item.read}}">未读</text>
          </view>
        </view>
      </block>

      <view class="empty" wx:if="{{!loading && !total}}">
        <text class="empty-mark">诗</text>
        <text class="empty-text">{{selfOnly ? '今天没有加背' : '今日未排计划'}}</text>
        <text class="hint empty-tip" wx:if="{{selfOnly}}">自选的今日份在下面那张卡里</text>

        <button class="btn ghost mini empty-btn" bindtap="onSettings">设置</button>
      </view>
    </view>


    <view class="card" wx:if="{{collectionOn || collectionCount || collectionHint}}">
      <view class="card-open">
        <text class="card-title bar">自选背诵</text>
        <text class="all-count" wx:if="{{collectionCount}}">{{collectionCount}} 个</text>
      </view>

      <text class="hint coll-hint" wx:if="{{collectionHint}}">{{collectionHint}}</text>

      <block wx:if="{{collectionCount}}">
        <view class="row row-flush" hover-class="row-hover" hover-stay-time="60"
              wx:for="{{collections}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpenCollection">
          <view class="row-main">
            <view class="row-line">
              <text class="row-title">{{item.name}}</text>
            </view>
            <text class="row-sub">{{item.count}} 首 · 已背 {{item.learned}} · 今日 {{item.planned}}</text>
          </view>
          <view class="row-end">
            <text class="row-state {{item.done ? 'on' : ''}}">{{item.done}}/{{item.planned}}</text>
            <view class="coll-edit" hover-class="coll-edit-hover" hover-stay-time="60"
                  data-id="{{item.id}}" catchtap="onCollectionRename">改</view>
          </view>
        </view>
      </block>

      <view class="empty coll-empty" wx:elif="{{collectionOn}}">
        <text class="empty-mark">选</text>
        <text class="empty-text">还没有自选集子</text>
        <text class="hint empty-tip">在课外阅读或搜索里看到好诗，加进自己的集子</text>
      </view>

      <button class="btn ghost mini coll-btn" wx:if="{{collectionOn}}" bindtap="onManageCollections">管理自选背诵</button>
    </view>

    <view class="card" wx:if="{{allCount}}">
      <view class="card-open" hover-class="card-hover" hover-stay-time="60" bindtap="onToggleAll">
        <text class="card-title bar plain all-title">{{allLabel}}</text>
        <text class="all-count">{{allCount}}</text>
        <view class="all-toggle {{allOpen ? 'open' : ''}}"></view>
      </view>

      <block wx:if="{{allOpen}}">
        <view class="row row-flush" hover-class="row-hover" hover-stay-time="60"
              wx:for="{{allRows}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpenAll">
          <text class="seq {{item.recited ? 'on' : ''}}">{{item.seq}}</text>
          <view class="row-main">
            <text class="row-title row-poem">{{item.title}}</text>
            <text class="row-sub">{{item.dynasty}}{{item.author ? ' · ' + item.author : ''}}{{item.place ? ' · ' + item.place : ''}} · {{item.stage}}</text>
          </view>
          <text class="row-state" wx:if="{{!item.read}}">未读</text>
          <text class="row-go">›</text>
        </view>
      </block>
    </view>

    <recite-sheet id="sheet" queue="{{sheetRows}}" theme-style="{{themeStyle}}"
                    bind:open="onSheetOpen" bind:finish="onSheetFinish"
                    bind:change="onExtraChange" />

    <view class="safe-bottom"></view>
  </block>
</view>
