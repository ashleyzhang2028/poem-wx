<view class="page {{barBelow ? 'has-tabbar' : 'tall'}} {{name}}" style="{{themeStyle}}">
  <lock-card wx:if="{{locked}}" title="课内阅读" note="登录后查看" mark="目" bind:login="onLogin" />

  <block wx:else>

  <corpus-state state="{{corpusState}}" bind:retry="onCorpusRetry" />

  <block wx:if="{{!corpusState}}">

  <view class="card book-head">
    <text class="head-title">{{bookName}}</text>
    <text class="head-sub">{{groupCount > 1 ? groupCount + ' 组 · ' : ''}}{{sortLabel}}</text>
    <text class="head-sub" wx:if="{{last}}" bindtap="onContinue">上次读到：{{last.title}} ›</text>
  </view>

  <view class="card index-card" wx:if="{{groups.length > 1}}">
    <view class="card-open">
      <text class="card-title">索引</text>
      <button class="btn mini index-toggle" bindtap="onToggleIndex">{{collapsed ? '展开' : '收起'}}</button>
    </view>
    <view class="index-grid" wx:if="{{!collapsed}}">
      <view class="index-cell" hover-class="row-hover" hover-stay-time="60"
            wx:for="{{groups}}" wx:key="group" data-g="{{index}}" bindtap="onJump">
        <text class="index-name">{{item.group || '未分组'}}</text>
        <text class="index-count">{{item.items.length}}</text>
      </view>
    </view>
  </view>

  <view class="card filter-card">
    <view class="search">
      <view class="search-icon" style="mask-image:url('{{icons.search}}');-webkit-mask-image:url('{{icons.search}}');"></view>
      <input placeholder="搜索篇名 / 作者 / 朝代" value="{{keyword}}" bindinput="onSearch" confirm-type="search" />
    </view>

    <view class="seg filter-group">
      <radio-group class="seg-group" bindchange="onFilter">
        <label class="seg-item {{filter === item.key ? 'on' : ''}}" wx:for="{{filters}}" wx:key="key">
          <radio class="seg-radio" value="{{item.key}}" checked="{{filter === item.key}}" />
          <text class="seg-text">{{item.label}}</text>
        </label>
      </radio-group>
    </view>
  </view>

  <view class="count hint">共 {{matched}} {{unit}}{{matched < total ? '（全部 ' + total + ' ' + unit + '）' : ''}}</view>

  <view class="card" wx:for="{{groups}}" wx:key="group" id="g-{{index}}">
    <view class="group-head" wx:if="{{item.group}}">
      <text class="group-name">{{item.group}}</text>
      <text class="group-count">{{item.items.length}}</text>
    </view>
    <view class="row" hover-class="row-hover" hover-stay-time="60"
            wx:for="{{item.items}}" wx:for-item="p" wx:key="id" data-id="{{p.id}}" bindtap="onOpen">
      <text class="seq">{{p.seq}}</text>
      <view class="row-main">
        <view class="row-head">
          <text class="row-title row-poem">{{p.title}}</text>
          <text class="tag row-tag course" wx:if="{{p.inCourse}}">课内</text>
        </view>
        <text class="row-sub">{{p.dynasty ? p.dynasty + ' · ' : ''}}{{p.author || '佚名'}}</text>
      </view>
      <text class="read-dot" wx:if="{{p.read}}">已读</text>
      <view class="row-star {{p.picked ? 'on' : ''}}" hover-class="row-star-hover" hover-stay-time="60"
            style="mask-image:url('{{icons.playlist}}');-webkit-mask-image:url('{{icons.playlist}}');"
            data-id="{{p.id}}" data-title="{{p.title}}" catchtap="onPick"></view>
      <text class="row-go">›</text>
    </view>
  </view>

  <view class="pager" wx:if="{{pages > 1}}">
    <button class="btn mini" disabled="{{page <= 1}}" bindtap="onPrev">上一页</button>
    <text class="hint pager-text">第 {{page}} / {{pages}} 页</text>
    <button class="btn mini" disabled="{{page >= pages}}" bindtap="onNext">下一页</button>
  </view>

  <view class="empty" wx:if="{{!groups.length}}">
    <text class="empty-mark">空</text>
    <text class="empty-text">{{keyword ? '无匹配篇目' : '此部暂无篇目'}}</text>
    <text class="hint empty-tip" wx:if="{{keyword}}">请更换关键词或切换至「全部」</text>
  </view>

  <collect-picker id="collect" theme-style="{{themeStyle}}" bind:done="onCollectDone" />

  <view class="safe-bottom"></view>
  </block>
  </block>
  <tab-bar id="tabbar" current="1" />
</view>
