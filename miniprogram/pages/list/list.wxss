.index-card {
  padding: var(--sp-3) var(--sp-4);
}

.index-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.index-head .card-title {
  margin-bottom: 0;
}

.index-toggle {
  flex: none;
  color: var(--ink-2);
  border-color: var(--line-strong);
}

.index-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: var(--sp-2);
  border-top: 1rpx solid var(--line-2);
}

.index-cell {
  width: 50%;
  min-height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-2) 12rpx var(--sp-2) 0;
  border-bottom: 1rpx solid var(--line-2);
  border-radius: var(--radius-sm);
  transition: background-color var(--t-press);
}

.index-name {
  font-size: var(--fs-hint);
  color: var(--ink-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.index-count {
  font-family: var(--font-num);
  font-size: var(--fs-caption);
  color: var(--ink-3);
  padding-left: 12rpx;
  flex: none;
}

.filter-group {
  margin: 0 0 var(--sp-2);
}

.count {
  padding: 0 var(--sp-1) var(--sp-2);
}

.group-head {
  display: flex;
  align-items: baseline;
  padding-bottom: var(--sp-2);
  border-bottom: 1rpx solid var(--line-2);
  margin-bottom: 4rpx;
}

.group-name {
  font-family: var(--font-poem);
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--strong-text);
  letter-spacing: var(--ls-title);
}

.group-count {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  padding-left: 12rpx;
  font-variant-numeric: tabular-nums;
}

.seq {
  width: 56rpx;
  flex: none;
  font-size: var(--fs-caption);
  font-variant-numeric: tabular-nums;
  color: var(--ink-3);
  text-align: center;
}

.read-dot {
  flex: none;
  font-size: var(--fs-caption);
  color: var(--green);
  padding: 2rpx 14rpx;
  border-radius: var(--radius-pill);
  background: var(--green-soft);
  margin-right: var(--sp-1);
}
