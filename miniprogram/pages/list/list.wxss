/* ---------- 索引卡 ----------
   长集子的第一屏往往不知道从哪看起，所以索引摆在最上面：
   按组跳，比一直往下滚省事。 */
.index-card {
  padding: var(--sp-3) var(--sp-4);
}

.index-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.index-head .card-title {
  margin-bottom: 0;
}

.index-toggle {
  flex: none;
  color: var(--green);
  border-color: var(--line);
}

.index-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: var(--sp-2);
  border-top: 1rpx solid var(--line-2);
}

.index-cell {
  width: 50%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-2) 12rpx var(--sp-2) 0;
  border-bottom: 1rpx solid var(--line-2);
  border-radius: 8rpx;
  transition: background-color var(--t-press);
}

.index-name {
  font-size: var(--fs-hint);
  color: var(--ink-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.index-count {
  font-family: var(--font-poem);
  font-size: var(--fs-caption);
  color: var(--ink-3);
  padding-left: 12rpx;
  flex: none;
}

/* 筛选行留一点上下呼吸 */
.filter-group {
  margin: 0 0 var(--sp-2);
}

.count {
  padding: 0 var(--sp-1) var(--sp-2);
}

/* ---------- 分组标题 ----------
   组名用宋体、左边一道短竖线，和「卡片标题」是同一套语言 */
.group-head {
  display: flex;
  align-items: baseline;
  padding-bottom: var(--sp-2);
  border-bottom: 1rpx solid var(--line-2);
  margin-bottom: 4rpx;
}

.group-name {
  font-family: var(--font-poem);
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--green);
  letter-spacing: 1rpx;
}

.group-count {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  padding-left: 12rpx;
}

.seq {
  width: 56rpx;
  flex: none;
  font-size: var(--fs-caption);
  font-variant-numeric: tabular-nums;
  color: var(--ink-3);
  text-align: center;
}

.read-dot {
  flex: none;
  font-size: var(--fs-caption);
  color: var(--green);
  padding: 2rpx 12rpx;
  border-radius: var(--radius-pill);
  background: var(--green-light);
  margin-right: var(--sp-1);
}
