.book-head .head-title {
  font-family: var(--font-poem);
  font-size: var(--fs-lead);
  font-weight: 400;
}

.book-head .head-sub {
  margin-top: var(--sp-1);
  letter-spacing: 0;
}

.filter-card .search {
  margin-bottom: var(--sp-3);
}

.index-toggle {
  flex: none;
  color: var(--ink-2);
  border-color: var(--line-strong);
}

.index-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: var(--card-title-gap);
  border-top: 1rpx solid var(--line-2);
}

.index-cell {
  width: 50%;
  min-height: var(--h-opt);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-2) var(--sp-2) var(--sp-2) 0;
  border-bottom: 1rpx solid var(--line-2);
  transition: background-color var(--t-press);
}

.index-name {
  font-size: var(--fs-hint);
  color: var(--ink-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.index-count {
  font-family: var(--font-num);
  font-size: var(--fs-caption);
  color: var(--ink-3);
  padding-left: var(--sp-2);
  flex: none;
}

.filter-group {
  margin: 0;
}

.count {
  padding: 0 var(--sp-1) var(--sp-2);
}

.group-head {
  display: flex;
  align-items: baseline;
  padding-bottom: var(--sp-2);
  border-bottom: 1rpx solid var(--line-2);
  margin-bottom: 4rpx;
}

.group-name {
  font-family: var(--font-poem);
  font-size: var(--fs-title);
  color: var(--strong-text);
  letter-spacing: var(--ls-title);
}

.group-count {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  padding-left: var(--sp-2);
  font-variant-numeric: tabular-nums;
}
