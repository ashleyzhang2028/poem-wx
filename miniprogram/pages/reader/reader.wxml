<view class="page reader">
  <!-- 未登录：整页只有一句话和去登录的按钮，正文一个字都不渲染 -->
  <lock-card wx:if="{{locked}}" title="{{lockTitle}}" note="{{lockNote}}" mark="阅" />

  <block wx:else>
  <view class="card poem-card">
    <view class="poem-head">
      <text class="poem-title">{{title}}</text>
      <view class="poem-meta-row">
        <text class="poem-meta">{{dynasty}}</text>
        <text class="poem-dot">·</text>
        <text class="poem-meta">{{author}}</text>
      </view>
      <text class="poem-source" wx:if="{{source}}">{{source}}</text>
      <!-- 记忆阶段做成小签，摆在标题下面：这是「我背到哪了」，
           属于这首诗的一部分，不该混在下面那排操作里 -->
      <text class="tag stage-tag">{{stage}}</text>
    </view>

    <!-- 阅读偏好。
         「对齐」「注音」原来是一排原生单选框：一个空心圆圈 + 两个字，
         三个选项并排占掉半屏，而两件事都是**看一眼图标就懂的开关** ——
         文字在这里是多余的负担。
         现在换成图标分段控件：图标说「是什么」，按下态说「选没选」。
         底层仍是原生 <radio>，行为、无障碍、键盘都是平台的，只是不再露面。 -->
    <view class="prefs">
      <view class="seg" wx:if="{{pinyinOn}}">
        <radio-group class="seg-group" bindchange="onPinyin">
          <label class="seg-item {{pinyinMode === item.key ? 'on' : ''}}"
                 wx:for="{{pinyinModes}}" wx:key="key">
            <radio class="seg-radio" value="{{item.key}}" checked="{{pinyinMode === item.key}}"
                   color="#1c1c1e" />
            <view class="seg-icon ic-{{item.key}}"></view>
            <text class="seg-text">{{item.label}}</text>
          </label>
        </radio-group>
      </view>

      <!-- 字号：连续量，滑块比「A－/A＋」两粒按钮更贴手感 -->
      <view class="pref-font">
        <slider class="pref-slider" min="{{fontMin}}" max="{{fontMax}}" step="1" value="{{fontSize}}"
                block-size="20" block-color="#1c1c1e" activeColor="#1c1c1e" backgroundColor="#ececef"
                bindchanging="onFontSlide" bindchange="onFontSlide" />
      </view>

      <!-- 朗读不可用时这一格不出现；就绪与否只影响它灰不灰，不影响在不在 -->
      <button class="btn mini speak-entry {{speakReady ? 'on' : 'off'}}" wx:if="{{speakVisible}}"
              disabled="{{!speakReady}}" bindtap="onSpeak">{{speakLabel}}</button>
    </view>

    <!-- 对齐：两个图标，边距本身就是答案（左对齐 = 左边齐的排线，居中 = 两边齐） -->
    <view class="seg seg-align">
      <radio-group class="seg-group" bindchange="onAlign">
        <label class="seg-item {{align === item.key ? 'on' : ''}}" wx:for="{{aligns}}" wx:key="key">
          <radio class="seg-radio" value="{{item.key}}" checked="{{align === item.key}}" color="#1c1c1e" />
          <view class="seg-icon ic-{{item.key}}"></view>
          <text class="seg-text">{{item.label}}</text>
        </label>
      </radio-group>
    </view>

    <view class="rule">
      <text class="rule-t">正文</text>
    </view>

    <!-- 正文。
         版式（哪一句单占一行、哪几句连着一行、段落断在哪）由语料层
         `corpus.layout()` 决定 —— 页面只管照着排。理由写在那儿：
         七绝律诗一句一行是作者排的；《琵琶行》的序、《左传》的长句
         折开之后一句一行才读得下去。

         注音与正文同形同序（「段落 → 行 → 句」），所以换模式不会跳版。
         标点留在句尾 —— 排版本该把它挤出去，inline 块做不到，只能容忍。 -->
    <view class="poem-body align-{{align}} size-{{fontSize}}">
      <block wx:if="{{!pinyinOn}}">
        <view class="poem-stanza" wx:for="{{paras}}" wx:key="index" wx:for-item="para">
          <text class="poem-line" wx:for="{{para}}" wx:key="index" wx:for-item="row">
            <text class="poem-clause" wx:for="{{row}}" wx:key="index" wx:for-item="cl">{{cl}}</text>
          </text>
        </view>
      </block>
      <block wx:else>
        <!-- 注音这条路要逐字排，所以「行」是 flex 容器、「句」是它中间的一段。
             每一句带 `i`（第几句）—— 正在读的那行按它高亮；点行也是从这句起播 -->
        <view class="poem-stanza" wx:for="{{tokens}}" wx:key="index" wx:for-item="para">
          <view class="poem-line token-line {{speakVisible && speakTotal && speakLoop[speakIndex] === row[0].i ? 'reading' : ''}}"
                hover-class="{{speakVisible ? 'token-line-tap' : ''}}" hover-stay-time="60"
                wx:for="{{para}}" wx:key="index" wx:for-item="row"
                data-i="{{row[0].i}}" bindtap="onSpeakToggle">
            <view class="poem-clause" wx:for="{{row}}" wx:for-item="cl" wx:key="index">
              <view class="token" wx:for="{{cl.tokens}}" wx:for-item="tk" wx:key="index">
                <text class="tk-py" wx:if="{{tk.mark}}">{{tk.py}}</text>
                <text class="tk-ch">{{tk.ch}}</text>
              </view>
            </view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <!-- 背诵：把「读」和「记」分开，两件事不该挤在一张卡里 -->
  <view class="card recite-card">
    <view class="recite-head">
      <text class="card-title bar">背得怎么样</text>
      <text class="mastery-num">{{mastery}}%</text>
    </view>
    <view class="meter mastery-bar">
      <view class="meter-fill" style="width:{{mastery}}%"></view>
    </view>

    <view class="actions">
      <view class="act {{item.cls}}" wx:for="{{results}}" wx:key="key"
            data-r="{{item.key}}" bindtap="onResult">
        <text class="act-label">{{item.label}}</text>
      </view>
    </view>

    <text class="hint hint-line" wx:if="{{hint}}">{{hint}}</text>
  </view>

  <!-- 播放工具栏：只在朗读可见时存在 -->
  <view class="card speak-bar" wx:if="{{speakVisible}}">
    <view class="speak-head">
      <text class="card-title bar">朗读</text>
      <text class="speak-state {{speakReady ? '' : 'off'}}">{{speakReady ? '就绪' : '待开通'}}</text>
    </view>

    <text class="hint note" wx:if="{{!speakReady}}">{{speakReason}}</text>

    <block wx:else>
      <!-- 进度条就是原生 slider：拖到哪句就从哪句起播，比一个只读的细条多一件事可做 -->
      <view class="speak-progress" wx:if="{{speakTotal}}">
        <text class="sp-text">{{speakIndex + 1}} / {{speakTotal}} 句</text>
        <slider class="sp-slider" min="0" max="{{speakTotal - 1}}" step="1" value="{{speakIndex}}"
                block-size="20" block-color="#1c1c1e" activeColor="#1c1c1e" backgroundColor="#ececef"
                bindchange="onSpeakSeek" />
      </view>
      <view class="speak-ctrl">
        <button class="btn mini" bindtap="onSpeakPrev">上一句</button>
        <button class="btn mini primary sp-main" bindtap="onSpeak">
          {{speakLoading ? '准备中' : (speakPlaying ? '暂停' : '播放')}}
        </button>
        <button class="btn mini" bindtap="onSpeakNext">下一句</button>
        <button class="btn mini" bindtap="onSpeakStop">停止</button>
      </view>
    </block>
  </view>

  <view class="card trans-card" wx:if="{{hasTranslation}}">
    <view class="trans-head" hover-class="trans-hover" hover-stay-time="60" bindtap="onToggleTranslation">
      <text class="card-title bar">白话译文</text>
      <text class="trans-toggle">{{showTranslation ? '收起' : '展开'}}</text>
    </view>
    <view wx:if="{{showTranslation}}">
      <text class="trans-text">{{translation}}</text>
      <text class="trans-src" wx:if="{{translationSource}}">{{translationSource}}</text>
    </view>
  </view>

  <view class="safe-bottom"></view>
  </block>
</view>
