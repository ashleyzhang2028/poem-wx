<view class="page reader {{barBelow ? 'has-tabbar' : 'tall'}}" style="{{themeStyle}}">

  <lock-card wx:if="{{locked}}" title="{{lockTitle}}" note="{{lockNote}}" mark="阅" />

  <block wx:else>

  <view class="card poem-card" wx:if="{{loadFailed}}">
    <view class="poem-head">
      <text class="poem-title">{{title}}</text>
    </view>
    <view class="empty">
      <text class="empty-mark">文</text>
      <text class="empty-text">{{failText}}</text>
      <button class="btn primary mini empty-btn" bindtap="onRetryText">重试</button>
    </view>
  </view>
  <view class="card poem-card" wx:else>
    <view class="poem-head">
      <text class="poem-title">{{title}}</text>

      <view class="poem-meta-row">
        <text class="poem-meta">{{dynasty}}</text>
        <text class="poem-dot">·</text>
        <text class="poem-meta">{{author}}</text>
        <block wx:if="{{source}}">
          <text class="poem-dot">·</text>
          <text class="poem-meta">{{source}}</text>
        </block>
        <block wx:if="{{selection}}">
          <text class="poem-dot">·</text>
          <text class="poem-meta">选自{{selection}}</text>
        </block>
        <block wx:if="{{reciteMode}}">
          <text class="poem-dot">·</text>
          <text class="poem-meta stage">{{stage}}</text>
        </block>
      </view>

      <view class="poem-note" wx:if="{{aliasText}}">
        <text class="poem-note-t">{{aliasText}}</text>
      </view>

      <view class="poem-loading" wx:if="{{loadingText}}"></view>
    </view>

    <view class="prefs">
      <radio-group class="pref-seg" bindchange="onAlign">
        <label class="pref-opt in-seg {{align === item.key ? 'on' : ''}}"
               wx:for="{{aligns}}" wx:key="key" aria-label="{{item.label}}">
          <radio class="opt-radio" value="{{item.key}}" checked="{{align === item.key}}" />
          <view class="glyph" style="mask-image:url('{{item.icon}}');-webkit-mask-image:url('{{item.icon}}');"></view>
        </label>
      </radio-group>

      <radio-group class="pref-seg" bindchange="onPinyin">
        <label class="pref-opt in-seg {{pinyinMode === item.key ? 'on' : ''}}"
               wx:for="{{pinyinModes}}" wx:key="key" aria-label="{{item.label}}">
          <radio class="opt-radio" value="{{item.key}}" checked="{{pinyinMode === item.key}}" />
          <view class="glyph" style="mask-image:url('{{item.icon}}');-webkit-mask-image:url('{{item.icon}}');"></view>
        </label>
      </radio-group>

      <view class="pref-size">
        <view class="pref-opt ic {{fontDown ? '' : 'off'}}"
              hover-class="pref-opt-hover" hover-stay-time="60" bindtap="onFontDown" aria-label="减小字号">
          <view class="glyph" style="mask-image:url('{{icons.zoomOut}}');-webkit-mask-image:url('{{icons.zoomOut}}');"></view>
        </view>
        <view class="pref-opt ic {{fontUp ? '' : 'off'}}"
              hover-class="pref-opt-hover" hover-stay-time="60" bindtap="onFontUp" aria-label="加大字号">
          <view class="glyph" style="mask-image:url('{{icons.zoomIn}}');-webkit-mask-image:url('{{icons.zoomIn}}');"></view>
        </view>
      </view>

      <view class="pref-opt ic pref-plus {{dailyOn ? 'on' : ''}}"
            hover-class="pref-opt-hover" hover-stay-time="60" bindtap="onToggleDaily"
            aria-label="{{dailyOn ? '移出今日背诵' : '加入今日背诵'}}">
        <view class="glyph" style="mask-image:url('{{icons[dailyOn ? 'added' : 'add']}}');-webkit-mask-image:url('{{icons[dailyOn ? 'added' : 'add']}}');"></view>
      </view>

      <view class="pref-opt ic pref-plus {{pickOn ? 'on' : ''}}"
            hover-class="pref-opt-hover" hover-stay-time="60" bindtap="onAddToCollection"
            aria-label="加入自选集合">
        <view class="glyph" style="mask-image:url('{{icons.playlist}}');-webkit-mask-image:url('{{icons.playlist}}');"></view>
      </view>
    </view>

    <view class="poem-body align-{{align}} size-{{fontSize}}">
      <block wx:if="{{blocksOn}}">
        <block wx:for="{{blocks}}" wx:key="key" wx:for-item="blk">
          <view class="poem-stanza" wx:if="{{blk.k === 'p'}}">
            <text class="poem-line" wx:for="{{blk.rows}}" wx:key="index" wx:for-item="para">
              <text class="poem-clause" wx:for="{{para}}" wx:key="index" wx:for-item="cl">{{cl}}</text>
            </text>
          </view>
          <view class="md-table" wx:else>
            <view class="md-row" wx:for="{{blk.table.rows}}" wx:key="index" wx:for-item="tr">
              <view class="md-cell" wx:for="{{tr.cells}}" wx:key="index" wx:for-item="cell"
                    style="flex-grow:{{blk.table.widths[index]}}">
                <text class="md-line" wx:for="{{cell.text}}" wx:for-item="ln" wx:key="index">{{ln}}</text>
              </view>
            </view>
          </view>
        </block>
      </block>
      <block wx:elif="{{pinyinOn}}">
        <view class="poem-stanza" wx:for="{{tokens}}" wx:key="index" wx:for-item="para">
          <view class="poem-line token-line" wx:for="{{para}}" wx:key="index" wx:for-item="row">
            <view class="poem-clause" wx:for="{{row}}" wx:for-item="cl" wx:key="index">
              <view class="token {{tk.han ? '' : 'punc'}}" wx:for="{{cl.tokens}}" wx:for-item="tk" wx:key="index">
                <text class="tk-py" wx:if="{{tk.mark}}">{{tk.py}}</text>
                <text class="tk-ch">{{tk.ch}}</text>
              </view>
            </view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <view class="card">
    <view class="row row-flush" hover-class="row-hover" hover-stay-time="60" bindtap="onPermissions">
      <view class="row-main">
        <text class="row-title">用户权限</text>
        <text class="row-sub">免费能读能看，背诵与自选要登录并升档</text>
      </view>
      <text class="row-go">›</text>
    </view>
  </view>

  <view class="card recite-card" wx:if="{{reciteMode}}">
    <radio-group class="chip-group cols-3 actions" bindchange="onResult">
      <label class="chip {{item.cls}}" wx:for="{{results}}" wx:key="key">
        <radio class="seg-radio" value="{{item.key}}" checked="{{item.cls === 'on'}}" />
        <text class="chip-t">{{item.label}}</text>
      </label>
    </radio-group>

    <view class="recite-head">
      <text class="card-title">掌握度</text>
      <text class="mastery-num">{{mastery}}%</text>
    </view>
    <view class="meter mastery-bar">
      <view class="meter-fill" style="width:{{mastery}}%"></view>
    </view>

    <text class="hint hint-line" wx:if="{{hint}}">{{hint}}</text>
  </view>

  <view class="card trans-card" wx:if="{{hasTranslation}}">
    <view class="trans-head {{showTranslation ? '' : 'closed'}}" hover-class="trans-hover" hover-stay-time="60" bindtap="onToggleTranslation">
      <text class="trans-toggle">{{showTranslation ? '译文收起' : '译文打开'}}</text>
    </view>
    <view wx:if="{{showTranslation}}">
      <text class="trans-text">{{translation}}</text>
      <text class="trans-src" wx:if="{{translationSource}}">{{translationSource}}</text>
    </view>
  </view>

  <view class="safe-bottom"></view>
  </block>
</view>
