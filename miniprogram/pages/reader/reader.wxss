.poem-card {
  padding: 36rpx 28rpx 16rpx;
}

.poem-head {
  text-align: center;
  padding: 8rpx 0 28rpx;
}

.poem-title {
  display: block;
  font-family: var(--font-poem);
  font-size: 46rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 2rpx;
  line-height: 1.5;
}

.poem-meta-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 14rpx;
}

.poem-meta {
  font-size: 26rpx;
  color: var(--ink-2);
}

.poem-dot {
  font-size: 26rpx;
  color: var(--line);
  padding: 0 12rpx;
}

.poem-source {
  display: block;
  font-size: 22rpx;
  color: var(--ink-3);
  margin-top: 10rpx;
}

.stage-tag {
  margin: 18rpx 0 0;
}

/* 阅读偏好一行：原生 radio（对齐）+ 原生 slider（字号）+ 原生 button（朗读） */
.prefs {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--line-2);
}

.pref-group {
  display: flex;
  flex: none;
}

.pref-item {
  display: flex;
  align-items: center;
  font-size: 27rpx;
  color: var(--ink-2);
  padding-right: 12rpx;
}

.pref-item radio {
  transform: scale(.8);
}

.pref-font {
  flex: 1;
  min-width: 0;
}

.pref-slider {
  margin: 0 8rpx;
}

/* 朗读那格借的是原生 button，只压小尺寸与去掉原生最小宽度 */
.poem-body {
  padding: 40rpx 8rpx 28rpx;
  font-family: var(--font-poem);
  line-height: 2.05;
}

.poem-body.align-center {
  text-align: center;
}

.poem-body.align-left {
  text-align: left;
}

.poem-line {
  display: block;
  font-size: 36rpx;
  color: var(--ink);
  letter-spacing: 2rpx;
}

/* 字号七档。写作 size--2 而不是 size-2，是为了让「负档」在类名上就不会
   与正档混淆 —— 曾经把 size--1 写成 size-1，两档撞在一起过 */
.poem-body.size--2 .poem-line { font-size: 30rpx; }
.poem-body.size--1 .poem-line { font-size: 33rpx; }
.poem-body.size-1 .poem-line { font-size: 39rpx; }
.poem-body.size-2 .poem-line { font-size: 42rpx; }
.poem-body.size-3 .poem-line { font-size: 46rpx; }
.poem-body.size-4 .poem-line { font-size: 52rpx; }

.trans-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.trans-toggle {
  font-size: 26rpx;
  color: var(--green);
  flex: none;
  padding-left: 16rpx;
}

.trans-text {
  display: block;
  font-size: 29rpx;
  color: var(--ink-2);
  line-height: 1.9;
}

.trans-src {
  display: block;
  font-size: 22rpx;
  color: var(--ink-3);
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line-2);
}

/* ---------- 掌握程度 ---------- */
.recite-status {
  display: flex;
  align-items: center;
  margin-bottom: 4rpx;
}

.recite-stage {
  font-size: 25rpx;
  color: var(--ink-3);
  flex: none;
  padding-right: 16rpx;
}

.mastery-bar {
  flex: 1;
  height: 12rpx;
  border-radius: 6rpx;
  background: var(--line-2);
  overflow: hidden;
}

.mastery-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--gold) 0%, var(--celadon) 100%);
  border-radius: 6rpx;
  transition: width .35s ease;
}

.mastery-num {
  flex: none;
  font-size: 23rpx;
  color: var(--ink-3);
  padding-left: 16rpx;
  min-width: 68rpx;
  text-align: right;
}

/* 一句问话，把那排按钮的用途说出来 —— 三个词摆在那里，
   没人告诉用户点下去会发生什么 */
.recite-ask {
  display: block;
  font-size: 25rpx;
  color: var(--ink-3);
  padding: 24rpx 0 16rpx;
}

.actions {
  display: flex;
  gap: 16rpx;
}

.act {
  flex: 1;
  height: 104rpx;
  line-height: 104rpx;
  text-align: center;
  border-radius: var(--radius-sm);
  font-size: 31rpx;
  border: 1rpx solid var(--line);
  background: var(--bg-soft);
  color: var(--ink-2);
  transition: transform .1s;
}

/* 三档按钮的按下反馈：只靠颜色差别太小，压一下更明确 */
.act:active {
  transform: scale(.97);
}

.act.bad {
  color: var(--red);
  background: var(--red-light);
  border-color: #ecd2cd;
}

.act.fuzzy {
  color: var(--amber);
  background: var(--amber-light);
  border-color: #ecd9c0;
}

.act.good {
  color: #fff;
  background: var(--green);
  border-color: var(--green);
}

.hint-line {
  display: block;
  text-align: center;
  padding-top: 24rpx;
}

/* ---------- 注音 ---------- */
/* 注音模式：原生 radio 排一行 */
.pinyin-group {
  display: flex;
  padding: 16rpx 0 8rpx;
}

.token-line {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  padding: 6rpx 0;
  border-radius: var(--radius-sm);
  transition: background-color .2s;
}

.poem-body.align-left .token-line {
  justify-content: flex-start;
}

.token {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  min-width: 34rpx;
  margin: 0 2rpx;
}

.tk-py {
  font-family: var(--font-ui);
  font-size: 18rpx;
  color: var(--ink-3);
  line-height: 1.3;
  height: 26rpx;
  white-space: nowrap;
}

.tk-ch {
  font-size: 36rpx;
  color: var(--ink);
  line-height: 1.5;
}

/* 注音模式下字号跟着正文走，逐档对齐 poem-body.size-* */
.poem-body.size--2 .tk-ch { font-size: 30rpx; }
.poem-body.size--1 .tk-ch { font-size: 33rpx; }
.poem-body.size-1 .tk-ch { font-size: 39rpx; }
.poem-body.size-2 .tk-ch { font-size: 42rpx; }
.poem-body.size-3 .tk-ch { font-size: 46rpx; }
.poem-body.size-4 .tk-ch { font-size: 52rpx; }

/* 正在读的那一行：底色 + 左侧一道主线，弱网下也能看出读到哪了 */
.token-line.reading {
  background: var(--green-light);
}

/* 注音模式下点一行就是从那一句起播，所以要有按下反馈。
   朗读不可用时 hover-class 是空串，等于没有 —— 那时点它只是提示去开通 */
.token-line-tap {
  background: var(--green-light);
}

.poem-body.align-left .token-line.reading {
  border-left: 4rpx solid var(--green);
}

/* ---------- 朗读 ---------- */
.speak-entry.off,
.speak-entry[disabled] {
  color: var(--ink-3);
}

.speak-entry.on {
  color: var(--green);
}

.speak-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.speak-state {
  font-size: 22rpx;
  color: var(--green);
  flex: none;
  padding-left: 16rpx;
}

.speak-state.off {
  color: var(--ink-3);
}

.speak-progress {
  display: flex;
  align-items: center;
  padding: 8rpx 0 4rpx;
}

/* 进度条是原生 slider：它能拖，比一条只读的细线多一个作用 */
.sp-slider {
  flex: 1;
  margin: 0 8rpx 0 4rpx;
}

.sp-text {
  font-size: 24rpx;
  color: var(--ink-3);
  flex: none;
  padding-right: 12rpx;
}

.speak-ctrl {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.speak-ctrl .btn {
  flex: 1;
}

/* 播放是这一排里的主操作，给它多一点宽度 */
.speak-ctrl .sp-main {
  flex: 1.4;
}

.note {
  display: block;
  padding-top: 8rpx;
}
