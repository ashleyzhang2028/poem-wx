.poem-card {
  padding: var(--sp-4) var(--sp-3) var(--sp-3);
}

.actions {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
}

.act {
  flex: 1;
  height: var(--h-act);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-pill);
  font-size: var(--fs-title);
  border: 1rpx solid var(--line-strong);
  background: var(--surface);
  color: var(--ink-2);
  transition: transform var(--t-press), background-color var(--t-press);
}

.act:active {
  transform: scale(.97);
}

.act.bad {
  color: var(--red);
  background: var(--red-soft);
  border-color: transparent;
}

.act.fuzzy {
  color: var(--amber);
  background: var(--amber-soft);
  border-color: transparent;
}

.act.good {
  color: var(--on-ink);
  background: var(--strong);
  border-color: var(--strong);
}

.act-label {
  letter-spacing: var(--ls-title);
}

.recite-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--sp-4);
  margin-bottom: var(--sp-2);
}

.recite-head .card-title {
  margin-bottom: 0;
}

.mastery-bar {
  margin-bottom: 0;
}

.mastery-num {
  font-size: var(--fs-hint);
  color: var(--ink-3);
}

.hint-line {
  display: block;
  text-align: center;
  padding-top: var(--sp-3);
}

