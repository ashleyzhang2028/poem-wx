.poem-card .empty-btn {
  margin: var(--sp-3) auto 0;
}

.poem-card {
  padding-top: var(--sp-4);
}

.poem-loading {
  position: relative;
  height: 2rpx;
  margin-top: var(--sp-2);
  border-radius: var(--radius-pill);
  background: var(--line);
  overflow: hidden;
}

.poem-loading::after {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 40%;
  height: 100%;
  border-radius: var(--radius-pill);
  background: var(--strong);
  animation: poem-loading 1.1s var(--ease) infinite;
}

@keyframes poem-loading {
  from { transform: translateX(-100%); }
  to { transform: translateX(250%); }
}
