.reader {
  --read-gap: var(--sp-5);
  background: var(--read-bg);
}

.poem-card .empty-btn {
  margin: var(--sp-3) auto 0;
}

.poem-loading {
  position: relative;
  height: 2rpx;
  margin-top: var(--sp-2);
  border-radius: var(--radius-pill);
  background: var(--line);
  overflow: hidden;
}

.poem-loading::after {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 40%;
  height: 100%;
  border-radius: var(--radius-pill);
  background: var(--strong);
  animation: poem-loading 1.1s var(--ease) infinite;
}

@keyframes poem-loading {
  from { transform: translateX(-100%); }
  to { transform: translateX(250%); }
}

.sheet {
  padding: var(--sp-5) 0 0;
}

.sheet + .sheet {
  margin-top: var(--read-gap);
  padding-top: var(--sp-4);
}

.reader .sheet .card-title {
  position: relative;
  padding-left: var(--sp-3);
  letter-spacing: var(--ls-caption);
}

.reader .sheet .card-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  width: 6rpx;
  height: 1em;
  margin-top: -.5em;
  border-radius: var(--radius-pill);
  background: var(--strong);
}

.reader .poem-card {
  padding-top: var(--sp-4);
}

.reader .poem-card .poem-head {
  padding-bottom: 0;
}

.reader .poem-card .poem-title {
  letter-spacing: .12em;
}

.poem-rule {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--sp-2);
  margin-top: var(--sp-3);
}

.poem-rule::before,
.poem-rule::after {
  content: "";
  width: 72rpx;
  height: 1rpx;
  background: var(--line-strong);
}

.poem-rule-dot {
  width: 10rpx;
  height: 10rpx;
  background: var(--strong);
  transform: rotate(45deg);
}

.reader .poem-card .poem-body {
  padding: var(--read-gap) 0 0;
}

.reader .poem-card .poem-body .poem-line {
  letter-spacing: .06em;
}

.pager {
  display: flex;
  gap: var(--sp-3);
  margin: var(--read-gap) 0 var(--sp-4);
  padding-top: var(--sp-4);
}

.pager-cell {
  flex: 1;
  min-width: 0;
  padding: var(--sp-2) 0;
  text-align: left;
  transition: opacity var(--t-press);
}

.pager-cell.next {
  text-align: right;
}

.pager-cell.off {
  visibility: hidden;
}

.pager-hover {
  opacity: .55;
}

.pager-dir {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  letter-spacing: var(--ls-caption);
}

.pager-name {
  display: block;
  margin-top: var(--sp-1);
  font-size: var(--fs-title);
  color: var(--strong-text);
  letter-spacing: var(--ls-title);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fold-arrow {
  flex: none;
  align-self: center;
  width: 14rpx;
  height: 14rpx;
  margin: 0 var(--sp-2) 0 var(--sp-3);
  border-right: 3rpx solid var(--strong-text);
  border-bottom: 3rpx solid var(--strong-text);
  box-sizing: border-box;
  transform: rotate(45deg);
  transition: transform var(--t-move) var(--ease);
}

.fold-arrow.open {
  transform: rotate(-135deg);
}

.reader .poem-link-hover {
  opacity: .6;
}