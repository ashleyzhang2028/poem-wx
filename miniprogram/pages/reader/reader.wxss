.poem-card .empty-btn {
  margin: var(--sp-3) auto 0;
  width: 240rpx;
}

.poem-card {
  padding-top: var(--sp-4);
}

.recite-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--sp-4);
  margin-bottom: var(--sp-2);
}

.recite-head .card-title {
  margin-bottom: 0;
}

.mastery-bar {
  margin-bottom: 0;
}

.mastery-num {
  font-size: var(--fs-hint);
  color: var(--ink-3);
}

.hint-line {
  display: block;
  text-align: center;
  padding-top: var(--sp-3);
}

