.poem-card .empty-btn {
  margin: var(--sp-3) auto 0;
}

.poem-loading {
  position: relative;
  height: 2rpx;
  margin-top: var(--sp-2);
  border-radius: var(--radius-pill);
  background: var(--line);
  overflow: hidden;
}

.poem-loading::after {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 40%;
  height: 100%;
  border-radius: var(--radius-pill);
  background: var(--strong);
  animation: poem-loading 1.1s var(--ease) infinite;
}

@keyframes poem-loading {
  from { transform: translateX(-100%); }
  to { transform: translateX(250%); }
}

.pager {
  display: flex;
  gap: var(--sp-2);
  margin: var(--sp-3) 0 var(--sp-4);
}

.pager-cell {
  flex: 1;
  min-width: 0;
  padding: var(--sp-3);
  border-radius: var(--radius);
  background: var(--surface);
  text-align: left;
}

.pager-cell.next {
  text-align: right;
}

.pager-cell.off {
  visibility: hidden;
}

.pager-hover {
  background: var(--sink);
}

.pager-dir {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  letter-spacing: var(--ls-title);
}

.pager-name {
  display: block;
  margin-top: var(--sp-1);
  font-size: var(--fs-body);
  color: var(--strong-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.reader .card.poem-card {
  padding-top: var(--sp-6);
  padding-bottom: var(--sp-6);
}

.reader .poem-card .prefs {
  padding-bottom: 0;
}

.reader .poem-card .poem-body {
  padding-top: var(--sp-4);
  padding-bottom: 0;
}

.reader .poem-link {
  text-decoration: underline;
  text-decoration-color: var(--line-strong);
  text-underline-offset: 6rpx;
}

.reader .poem-link-hover {
  opacity: .6;
}

.reader .poem-body .token-line.token-wrap {
  line-height: calc(var(--poem-fs) + var(--poem-gap));
}

.reader .poem-body .token-line.token-wrap .token {
  margin-bottom: var(--poem-gap-py);
}
