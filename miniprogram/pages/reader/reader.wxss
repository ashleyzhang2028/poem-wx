.poem-card {
  padding-bottom: 16rpx;
}

.poem-head {
  text-align: center;
  padding: 8rpx 0 24rpx;
}

.poem-title {
  display: block;
  font-family: var(--font-poem);
  font-size: 44rpx;
  font-weight: 600;
  color: var(--ink);
}

.poem-meta {
  display: block;
  font-size: 26rpx;
  color: var(--ink-2);
  margin-top: 12rpx;
}

.poem-source {
  display: block;
  font-size: 22rpx;
  color: var(--ink-3);
  margin-top: 8rpx;
}

/* 阅读偏好一行：原生 radio（对齐）+ 原生 slider（字号）+ 原生 button（朗读） */
.prefs {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--line-2);
}

.pref-group {
  display: flex;
  flex: none;
}

.pref-item {
  display: flex;
  align-items: center;
  font-size: 27rpx;
  color: var(--ink-2);
  padding-right: 12rpx;
}

.pref-item radio {
  transform: scale(.8);
}

.pref-font {
  flex: 1;
  min-width: 0;
}

.pref-slider {
  margin: 0 8rpx;
}

/* 朗读那格借的是原生 button，只压小尺寸与去掉原生最小宽度 */
.poem-body {
  padding: 36rpx 8rpx 24rpx;
  font-family: var(--font-poem);
  line-height: 2;
}

.poem-body.align-center {
  text-align: center;
}

.poem-body.align-left {
  text-align: left;
}

.poem-line {
  display: block;
  font-size: 36rpx;
  color: var(--ink);
}

.poem-body.size--2 .poem-line { font-size: 30rpx; }
.poem-body.size--1 .poem-line { font-size: 33rpx; }
.poem-body.size-1 .poem-line { font-size: 39rpx; }
.poem-body.size-2 .poem-line { font-size: 42rpx; }
.poem-body.size-3 .poem-line { font-size: 46rpx; }
.poem-body.size-4 .poem-line { font-size: 52rpx; }

.trans-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.trans-toggle {
  font-size: 26rpx;
  color: var(--green);
}

.trans-text {
  display: block;
  font-size: 29rpx;
  color: var(--ink-2);
  line-height: 1.9;
  margin-top: 16rpx;
}

.trans-src {
  display: block;
  font-size: 22rpx;
  color: var(--ink-3);
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line-2);
}

.recite-status {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.recite-stage {
  font-size: 26rpx;
  color: var(--ink-2);
  width: 260rpx;
  flex: none;
}

.mastery-bar {
  flex: 1;
  height: 12rpx;
  border-radius: 6rpx;
  background: var(--line-2);
  overflow: hidden;
}

.mastery-fill {
  height: 100%;
  background: var(--gold);
  border-radius: 6rpx;
  transition: width .3s;
}

.actions {
  display: flex;
  gap: 16rpx;
}

.act {
  flex: 1;
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  border-radius: var(--radius-sm);
  font-size: 30rpx;
  border: 1rpx solid var(--line);
  background: var(--bg-soft);
  color: var(--ink-2);
}

.act.bad {
  color: var(--red);
  background: var(--red-light);
  border-color: #ecd2cd;
}

.act.fuzzy {
  color: var(--amber);
  background: var(--amber-light);
  border-color: #ecd9c0;
}

.act.good {
  color: #fff;
  background: var(--green);
  border-color: var(--green);
}

.hint-line {
  display: block;
  text-align: center;
  padding-top: 24rpx;
}

/* ---------- 注音 ---------- */
/* 注音模式：原生 radio 排一行 */
.pinyin-group {
  display: flex;
  padding: 16rpx 0 8rpx;
}

.token-line {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  padding: 6rpx 0;
}

.poem-body.align-left .token-line {
  justify-content: flex-start;
}

.token {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  min-width: 34rpx;
  margin: 0 2rpx;
}

.tk-py {
  font-family: var(--font-ui);
  font-size: 18rpx;
  color: var(--ink-3);
  line-height: 1.3;
  height: 26rpx;
  white-space: nowrap;
}

.tk-ch {
  font-size: 36rpx;
  color: var(--ink);
  line-height: 1.5;
}

/* 注音模式下字号跟着正文走，逐档对齐 poem-body.size-* */
.poem-body.size--2 .tk-ch { font-size: 30rpx; }
.poem-body.size--1 .tk-ch { font-size: 33rpx; }
.poem-body.size-1 .tk-ch { font-size: 39rpx; }
.poem-body.size-2 .tk-ch { font-size: 42rpx; }
.poem-body.size-3 .tk-ch { font-size: 46rpx; }
.poem-body.size-4 .tk-ch { font-size: 52rpx; }

.token-line.reading {
  background: var(--green-light);
  border-radius: var(--radius-sm);
}

/* ---------- 朗读 ---------- */
.speak-entry.off,
.speak-entry[disabled] {
  color: var(--ink-3);
}

.speak-entry.on {
  color: var(--green);
}

.speak-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.speak-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.speak-state {
  font-size: 22rpx;
  color: var(--green);
}

.speak-state.off {
  color: var(--ink-3);
}

.speak-progress {
  display: flex;
  align-items: center;
  padding: 20rpx 0 4rpx;
}

/* 进度条是原生 slider：它能拖，比一条只读的细线多一个作用 */
.sp-slider {
  flex: 1;
  margin: 0 8rpx 0 4rpx;
}

.sp-text {
  font-size: 24rpx;
  color: var(--ink-3);
  flex: none;
  padding-right: 12rpx;
}

.speak-ctrl {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
}

.speak-ctrl .btn {
  flex: 1;
}

.speak-ctrl .sp-main {
  flex: 1.4;
}

/* 未登录时的那张卡：整页只有它 */
.locked-card .note {
  display: block;
  margin-top: 16rpx;
}

.locked-btn {
  margin-top: 32rpx;
}
