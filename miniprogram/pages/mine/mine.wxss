.account {
  padding-top: var(--sp-4);
  padding-bottom: var(--sp-4);
}

.identity {
  display: flex;
  align-items: center;
}

.grant-lead {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  margin-top: var(--sp-3);
  padding-top: var(--sp-3);
  border-top: 1rpx solid var(--line-2);
}

.grant-lead-text {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  line-height: var(--lh-loose);
}

.avatar-wrap {
  position: relative;
  width: 112rpx;
  height: 112rpx;
  flex: none;
  border-radius: 50%;
  overflow: hidden;
  box-shadow: 0 0 0 2rpx var(--line);
}

.avatar-btn {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  background: transparent;
  line-height: normal;
  overflow: hidden;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  position: absolute;
  top: 0;
  left: 0;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
}

.avatar-fallback {
  position: absolute;
  top: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--sink);
  font-family: var(--font-poem);
  font-size: var(--fs-mark);
  line-height: var(--lh-tight);
  color: var(--ink-2);
}

.identity-main {
  padding-left: var(--sp-3);
  min-width: 0;
  flex: 1;
}

.identity-name {
  display: block;
  font-size: var(--fs-lead);
  font-weight: 700;
  color: var(--ink);
  letter-spacing: var(--ls-title);
}

.identity-input {
  display: block;
  width: 320rpx;
  height: calc(46rpx * var(--ui-scale));
  min-height: 0;
  padding: 0;
  font-size: var(--fs-lead);
  font-weight: 700;
  color: var(--ink);
  letter-spacing: var(--ls-title);
  border-radius: 0;
}

.identity-ph {
  color: var(--ink-3);
  font-weight: 400;
}

.identity-sub-row {
  display: flex;
  align-items: baseline;
  gap: var(--sp-2);
  margin-top: var(--sp-1);
}

.identity-sub {
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

.tier-chip {
  flex: none;
  line-height: 1.4;
  font-size: var(--fs-caption);
  color: var(--ink-2);
  background: var(--surface);
  border: 1rpx solid var(--line-strong);
  border-radius: var(--radius-pill);
  padding: 6rpx 20rpx;
  letter-spacing: 1rpx;
}

.tier-chip-hover {
  background: var(--line-2);
}

.login-row {
  margin-top: var(--sp-4);
}

.danger-text {
  color: var(--red);
}

.logout {
  display: flex;
  width: 100%;
  text-align: center;
  margin-top: var(--sp-4);
}

.row-icon.danger {
  color: var(--red);
}

