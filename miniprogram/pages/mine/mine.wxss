.account {
  padding: 32rpx;
}

.identity {
  display: flex;
  align-items: center;
}

/* chooseAvatar 必须挂在 button 上；button 只当头像的壳，点它换头像 */
.avatar-btn {
  width: 112rpx;
  height: 112rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  background: transparent;
  line-height: normal;
  flex: none;
  overflow: hidden;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  flex: none;
  background: var(--green-light);
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-poem);
  font-size: 48rpx;
  color: var(--green);
}

.identity-main {
  padding-left: 24rpx;
  min-width: 0;
}

.identity-name {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
}

.identity-sub {
  display: block;
  font-size: 24rpx;
  color: var(--ink-3);
  margin-top: 8rpx;
}

.login-row {
  margin-top: 28rpx;
}

.login-row .hint {
  display: block;
  text-align: center;
  margin-top: 16rpx;
}

.profile-row {
  margin-top: 28rpx;
}

.nick-input {
  margin-top: 16rpx;
  height: 80rpx;
  padding: 0 24rpx;
  background: var(--bg-soft);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  font-size: 28rpx;
}

.kv {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line-2);
}

.kv:last-child {
  border-bottom: none;
}

.kv-k {
  font-size: 28rpx;
  color: var(--ink-2);
}

.kv-v {
  font-size: 28rpx;
  color: var(--ink);
}

.danger-text {
  color: var(--red);
}
