.account {
  padding: var(--sp-4);
}

/* 首屏那张身份卡：给一层很淡的主色渐变，
   与首页的今日卡同一套语言 —— 一屏里最该先看的那张，都会亮一点 */
.account-lead {
  background: linear-gradient(160deg, #fffefb 0%, var(--bg-soft) 60%, #eef4f0 100%);
  border-color: var(--green-edge);
  box-shadow: var(--shadow-lift);
}

/* ---------- 身份行 ---------- */
.identity {
  display: flex;
  align-items: center;
}

/* chooseAvatar 必须挂在 button 上；button 只当头像的壳，点它换头像 */
.avatar-btn {
  width: 112rpx;
  height: 112rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  background: transparent;
  line-height: normal;
  flex: none;
  overflow: hidden;
  box-shadow: 0 0 0 2rpx var(--line-2);
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  flex: none;
  background: var(--green-light);
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-poem);
  font-size: var(--fs-mark);
  color: var(--green);
}

.identity-main {
  padding-left: var(--sp-3);
  min-width: 0;
  flex: 1;
}

.identity-name {
  display: block;
  font-size: var(--fs-lead);
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 1rpx;
}

.identity-sub {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: var(--sp-1);
}

/* 档位芯片挂在头像行右端：这是「我是谁」的一部分，
   放在下面的表格里要滚一屏才看得到 */
.tier-chip {
  flex: none;
  font-size: var(--fs-caption);
  color: var(--green);
  background: var(--green-light);
  border: 1rpx solid var(--green-edge);
  border-radius: var(--radius-pill);
  padding: 6rpx 20rpx;
  letter-spacing: 1rpx;
}

.login-row {
  margin-top: var(--sp-4);
}

.login-note {
  display: block;
  text-align: left;
  margin-top: var(--sp-2);
  line-height: var(--lh-loose);
}

.profile-row {
  margin-top: var(--sp-4);
}

.nick-input {
  margin-top: var(--sp-2);
  height: 84rpx;
  padding: 0 var(--sp-3);
  background: var(--bg-soft);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  font-size: var(--fs-body);
}

.danger-text {
  color: var(--red);
}

/* 退出登录：原生 button，只留一点间距与字色 */
.logout {
  display: block;
  width: 100%;
  text-align: center;
  font-size: var(--fs-hint);
  color: var(--ink-3);
  margin-top: var(--sp-3);
}

.kv-note {
  display: block;
  text-align: right;
  padding-top: var(--sp-1);
  line-height: var(--lh-body);
}
