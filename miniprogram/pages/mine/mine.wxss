.mine.guest {
  display: flex;
  flex-direction: column;
  padding-top: 0;
  padding-bottom: 0;
}

.mine.guest .mine-main {
  display: flex;
  flex-direction: column;
  justify-content: center;
  flex: 1;
  min-height: 100vh;
  margin-top: calc(var(--pad-tab) * -1);
  padding: calc(var(--pad-tab) / 2) 0;
}

.mine.guest .mine-main > .login-lead {
  margin-bottom: var(--sp-2);
}

.mine.guest .safe-bottom {
  display: none;
}
