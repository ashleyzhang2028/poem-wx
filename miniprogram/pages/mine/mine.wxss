.account {
  padding: var(--sp-4);
}

/* 首屏那张身份卡：它是这一屏的第一眼，但它**不靠颜色**说这句话 ——
   靠的是它下面那块留白（.login-row / .profile-row 的 margin-top）。
   上一版给这张卡加了一层主色渐变 + 一圈主色描边，那是「用颜色说重要」；
   一块白卡夹在两段留白里，一样是第一眼，而且不必抢后面的颜色。 */
.account-lead {
  background: var(--surface);
}

/* ---------- 身份行 ---------- */
.identity {
  display: flex;
  align-items: center;
}

/* chooseAvatar 必须挂在 button 上；button 只当头像的壳，点它换头像 */
.avatar-btn {
  width: 112rpx;
  height: 112rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  background: transparent;
  line-height: normal;
  flex: none;
  overflow: hidden;
  box-shadow: 0 0 0 2rpx var(--line);
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  flex: none;
  background: var(--sink);
}

/* 没有头像时：一枚浅灰圆底 + 一个字。
   参考图里的头像底就是一整块浅灰 —— 它不强调「缺图」，只是先占住位置 */
.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-poem);
  font-size: var(--fs-mark);
  color: var(--ink-2);
}

.identity-main {
  padding-left: var(--sp-3);
  min-width: 0;
  flex: 1;
}

.identity-name {
  display: block;
  font-size: var(--fs-lead);
  font-weight: 700;
  color: var(--ink);
  letter-spacing: var(--ls-title);
}

.identity-sub {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: var(--sp-1);
}

/* 档位芯片挂在头像行右端：这是「我是谁」的一部分，
   放在下面的表格里要滚一屏才看得到。
   长相照参考图右上那枚编号（WFA381）：白底、一道细边、一颗胶囊。 */
.tier-chip {
  flex: none;
  font-size: var(--fs-caption);
  color: var(--ink-2);
  background: var(--surface);
  border: 1rpx solid var(--line-strong);
  border-radius: var(--radius-pill);
  padding: 6rpx 20rpx;
  letter-spacing: 1rpx;
}

.login-row {
  margin-top: var(--sp-4);
}

.login-note {
  display: block;
  text-align: left;
  margin-top: var(--sp-3);
  line-height: var(--lh-loose);
}

.profile-row {
  margin-top: var(--sp-4);
}

.nick-input {
  margin-top: var(--sp-2);
  height: var(--h-field);
  padding: 0 var(--sp-4);
  background: var(--sink);
  border: 1rpx solid transparent;
  border-radius: var(--radius-block);
  font-size: var(--fs-body);
}

.danger-text {
  color: var(--red);
}

/* 退出登录：一档最轻的按钮，满宽但不着色 */
.logout {
  display: flex;
  width: 100%;
  text-align: center;
  margin-top: var(--sp-3);
}

.kv-note {
  display: block;
  text-align: right;
  padding-top: var(--sp-1);
  line-height: var(--lh-body);
}

/* 清空数据那行：图标底也跟着变淡，别让它看着像个普通入口 */
.row-icon.danger {
  color: var(--red);
}
