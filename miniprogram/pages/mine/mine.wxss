.account {
  padding-top: var(--sp-4);
  padding-bottom: var(--sp-4);
}

.identity {
  display: flex;
  align-items: center;
}

.avatar-wrap {
  position: relative;
  width: 112rpx;
  height: 112rpx;
  flex: none;
  border-radius: 50%;
  overflow: hidden;
  box-shadow: 0 0 0 2rpx var(--line);
}

.avatar {
  position: absolute;
  top: 0;
  left: 0;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
}

.avatar-hit-active {
  opacity: 0.84;
}

.wechat-sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 60;
  display: flex;
  align-items: flex-end;
  background: rgba(28, 21, 15, .38);
  animation: sheet-fade .2s var(--ease);
}

.wechat-sheet {
  width: 100%;
  box-sizing: border-box;
  padding: var(--sp-4) var(--sp-3) calc(var(--sp-3) + env(safe-area-inset-bottom));
  background: var(--surface);
  border-radius: var(--radius-block) var(--radius-block) 0 0;
  animation: sheet-up .26s var(--ease);
}

.wechat-sheet-title {
  display: block;
  font-size: var(--fs-title);
  color: var(--ink);
  letter-spacing: var(--ls-title);
}

.wechat-sheet-sub {
  display: block;
  margin-top: var(--sp-1);
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

.wechat-sheet-item {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: var(--h-btn);
  margin-top: var(--sp-2);
  padding: 0 var(--pad-opt-x);
  border-radius: var(--radius-ctl);
  background: var(--sink);
  line-height: normal;
}

.wechat-sheet-item.button-hover {
  background: var(--line);
}

.wechat-sheet-item::after {
  border: none;
}

.wechat-sheet-t {
  font-size: var(--fs-body);
  color: var(--ink);
}

.wechat-sheet-item.quiet {
  margin-top: var(--sp-3);
  background: transparent;
  border: 1rpx solid var(--line-strong);
}

.wechat-sheet-item.quiet.button-hover {
  background: var(--sink);
}

.wechat-sheet-t.quiet {
  color: var(--ink-2);
}

@keyframes sheet-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes sheet-up {
  from { transform: translateY(40rpx); opacity: .4; }
  to { transform: none; opacity: 1; }
}

.avatar-fallback {
  position: absolute;
  top: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--sink);
  font-family: var(--font-poem);
  font-size: var(--fs-mark);
  line-height: var(--lh-tight);
  color: var(--ink-2);
}

.identity-main {
  padding-left: var(--sp-3);
  min-width: 0;
  flex: 1;
}

.identity-name {
  display: block;
  font-size: var(--fs-lead);
  color: var(--ink);
  letter-spacing: var(--ls-title);
}

.identity-input {
  display: block;
  width: 320rpx;
  height: calc(46rpx * var(--ui-scale));
  min-height: 0;
  padding: 0;
  font-size: var(--fs-lead);
  color: var(--ink);
  letter-spacing: var(--ls-title);
  border-radius: 0;
}

.identity-ph {
  color: var(--ink-3);
  font-weight: 400;
}

.identity-sub-row {
  display: flex;
  align-items: baseline;
  gap: var(--sp-2);
  margin-top: var(--sp-1);
}

.identity-sub {
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

.tier-chip {
  flex: none;
  line-height: 1.4;
  font-size: var(--fs-caption);
  color: var(--ink-2);
  background: var(--surface);
  border: 1rpx solid var(--line-strong);
  border-radius: var(--radius-pill);
  padding: var(--pad-opt-y) var(--pad-opt-x);
  letter-spacing: 1rpx;
}

.tier-chip-hover {
  background: var(--line);
}

.login-row {
  margin-top: var(--sp-3);
}

.logout {
  display: flex;
  width: 100%;
  text-align: center;
  margin-top: var(--sp-3);
  font-weight: 400;
}

.row-icon.danger {
  color: var(--red);
}

