<view class="page has-tabbar" style="{{themeStyle}}">

  <view class="card account">
    <view class="identity">

      <view class="avatar-wrap">
        <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onAvatarChoose"
                wx:if="{{logged}}">
          <image class="avatar" wx:if="{{avatarUrl}}" src="{{avatarUrl}}" mode="aspectFill" />
        </button>
        <view class="avatar-btn" wx:else></view>
        <view class="avatar-fallback" wx:if="{{!avatarUrl}}">{{avatarChar}}</view>
      </view>

      <view class="identity-main">
        <block wx:if="{{logged}}">
          <input class="identity-input" type="nickname" value="{{nickname}}" maxlength="12"
                 placeholder="填一个昵称" placeholder-class="identity-ph"
                 confirm-type="done" bindblur="onNickname" bindconfirm="onNickname" />
          <view class="identity-sub-row">
            <text class="identity-sub">{{identitySub}}</text>
          </view>
        </block>

        <block wx:else>
          <text class="identity-name">{{nickname}}</text>
          <view class="identity-sub-row">
            <text class="identity-sub">{{identitySub}}</text>
          </view>
        </block>
      </view>
      <view class="tier-chip" wx:if="{{logged}}" hover-class="tier-chip-hover" hover-stay-time="60"
            bindtap="onTier">{{tierLabel}}</view>
    </view>

    <view class="grant-lead" wx:if="{{grantLead}}">
      <view class="grant-lead-text">头像与昵称用微信的：点头像挑微信头像，点名字那一格确认微信昵称</view>
      <button class="btn ghost mini" bindtap="onGrantLeadSkip">先不用</button>
    </view>

    <block wx:if="{{!logged}}">
      <view class="login-row">
        <button class="btn primary block" bindtap="onLogin">登录</button>
      </view>
    </block>

    <block wx:else>
      <button class="btn ghost mini logout" bindtap="onLogout">退出</button>
    </block>
  </view>

  <view class="card">
    <view class="card-title bar">背诵概况</view>
    <view class="stats">
      <view class="stat">
        <text class="stat-v">{{stats.learned}}</text>
        <text class="stat-k">已学</text>
      </view>
      <view class="stat">
        <text class="stat-v">{{stats.mastered}}</text>
        <text class="stat-k">已掌握</text>
      </view>
      <view class="stat">
        <text class="stat-v">{{stats.readCount}}</text>
        <text class="stat-k">已读篇目</text>
      </view>
    </view>
    <view class="divider"></view>
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onScope">
      <view class="row-main">
        <text class="row-title">背诵范围</text>
        <text class="row-sub">{{gradeName}} · {{scopeName}}</text>
      </view>
      <text class="row-go">›</text>
    </view>
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onDaily">
      <view class="row-main">
        <text class="row-title">每日首数</text>
        <text class="row-sub">{{dailyCount}} 首</text>
      </view>
      <text class="row-go">›</text>
    </view>
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onAlgo">
      <view class="row-main">
        <text class="row-title">复习算法</text>
        <text class="row-sub">{{algoName}}</text>
      </view>
      <text class="row-go">›</text>
    </view>
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onProgress">
      <view class="row-main">
        <text class="row-title">背诵进度</text>
        <text class="row-sub">七天排期 · 记忆阶段</text>
      </view>
      <text class="row-go">›</text>
    </view>
  </view>

  <view class="card" wx:if="{{logged}}">
    <view class="card-title bar">设置</view>
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onRecite">
      <view class="row-icon">背</view>
      <view class="row-main">
        <text class="row-title">背诵设置</text>
        <text class="row-sub">范围 · 首数 · 算法</text>
      </view>
      <text class="row-go">›</text>
    </view>
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onSettings">
      <view class="row-icon">设</view>
      <view class="row-main">
        <text class="row-title">通用设置</text>
        <text class="row-sub">对齐 · 注音 · 字号</text>
      </view>
      <text class="row-go">›</text>
    </view>

    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onTheme">
      <view class="row-icon">色</view>
      <view class="row-main">
        <text class="row-title">主题</text>
        <text class="row-sub">{{themeName}}</text>
      </view>
      <text class="row-go">›</text>
    </view>
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onReader"
          wx:if="{{sfxVisible}}">
      <view class="row-icon">读</view>
      <view class="row-main">
        <text class="row-title">声音</text>
        <text class="row-sub">答题音效</text>
      </view>
      <text class="row-go">›</text>
    </view>
  </view>

  <view class="card">
    <view class="card-title bar">数据与账号</view>
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onTier">
      <view class="row-icon">档</view>
      <view class="row-main">
        <text class="row-title">档位与权限</text>
        <text class="row-sub">{{tierLabel}} · 能力对照</text>
      </view>
      <text class="row-go">›</text>
    </view>
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onSync" wx:if="{{logged}}">
      <view class="row-icon">云</view>
      <view class="row-main">
        <text class="row-title">同步</text>
        <text class="row-sub">{{syncSub}}</text>
      </view>
      <text class="row-go">›</text>
    </view>
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onAbout">
      <view class="row-icon">问</view>
      <view class="row-main"><text class="row-title">关于</text></view>
      <text class="row-go">›</text>
    </view>
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onAdmin" wx:if="{{isAdmin}}">
      <view class="row-icon">名</view>
      <view class="row-main">
        <text class="row-title">用户名录</text>
        <text class="row-sub">改档 · 改角色</text>
      </view>
      <text class="row-go">›</text>
    </view>
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onClear">
      <view class="row-icon">删</view>
      <view class="row-main"><text class="row-title danger-text">清空背诵数据</text></view>
      <text class="row-go">›</text>
    </view>
  </view>

  <view class="safe-bottom"></view>
</view>
