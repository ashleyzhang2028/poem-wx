<view class="page has-tabbar" style="{{themeStyle}}">
  <!-- 身份卡：回答「我是谁、我这一档能做什么」。
       头像就是微信头像 —— 点头像走 chooseAvatar，弹出来的第一项就是当前微信头像。
       它**只存在这台手机上**，不上传、不落对象存储：
       平台没有任何一条「静默拿微信头像」的 API，而头像又不值得为它养一个存储桶。 -->
  <view class="card account {{focusLogin && !logged ? 'account-lead' : ''}}">
    <view class="identity">
      <!-- 头像那一圈**定尺寸的壳**（.avatar-wrap）。
           ⚠️ 里面那个带 open-type="chooseAvatar" 的是原生 button，而原生 button
           自带 display:block 与 width:100%，真机上这一条**盖过**页面样式表里的
           width:112rpx —— 于是头像被撑成整行宽，配上 border-radius:50% 就是一枚
           又扁又长的椭圆（用户 2026-10-04 报的那个）。尺寸只能定在**壳**上，
           按钮去填满壳，与原生默认怎么算无关。游客态那个 view 同理。 -->
      <view class="avatar-wrap">
        <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onAvatarChoose"
                wx:if="{{logged}}">
          <image class="avatar" wx:if="{{avatarUrl}}" src="{{avatarUrl}}" mode="aspectFill" />
          <view class="avatar avatar-fallback" wx:else>{{avatarChar}}</view>
        </button>
        <view class="avatar-btn" wx:else>
          <view class="avatar avatar-fallback">{{avatarChar}}</view>
        </view>
      </view>
      <!-- 名字**就地可改**：这一格就是输入框，改完立刻显示。
           它原来是只显示的一行字，能改的那处在下面「昵称」那一行里 ——
           同一个值摆两处，一能改、一只显示，看着像两个身份。
           现在收成一处，下面那一行整个撤了（V37 守着「只有一处」）。
           ⚠️ 不许把「子」什么的那类词写进界面文案：家庭成员是小程序端
           刻意不做的能力，parity.js 会把它当成界面上多了个入口。 -->
      <view class="identity-main">
        <block wx:if="{{logged}}">
          <!-- maxlength 取 12：这一行右边还挂着档位芯片，再长的名字会把它挤走 -->
          <input class="identity-input" type="nickname" value="{{nickname}}" maxlength="12"
                 placeholder="填一个昵称" placeholder-class="identity-ph"
                 confirm-type="done" bindblur="onNickname" bindconfirm="onNickname" />
        </block>
        <!-- 未登录时这里仍是只显示的字：没登录，也就没有名字可改 -->
        <text class="identity-name" wx:else>{{nickname}}</text>
        <!-- 副题只说一件事：「我是谁」。不再解释这张头像哪来的 ——
             它现在只有一个来源（微信那张），说来源等于说一句用户不需要懂的话。 -->
        <view class="identity-sub-row">
          <text class="identity-sub">{{identitySub}}</text>
        </view>
      </view>
      <text class="tier-chip" wx:if="{{logged}}">{{tierLabel}}</text>
    </view>

    <view class="login-row" wx:if="{{!logged}}">
      <button class="btn primary block" bindtap="onLogin">微信登录</button>
    </view>

    <block wx:else>
      <button class="btn ghost mini logout" bindtap="onLogout">退出登录</button>
    </block>
  </view>

  <!-- 背诵概况：三个大数字。一屏最容易被扫到的地方，放三个能一眼比出大小的数。

       标题原来叫「本机数据」—— 用户 2026-10-04 的话是「没有人关心或者需要知道
       这个数据在本机还是云端」。他说得对：这个位置写的是「我背得怎么样」，
       数据存在哪儿是系统的内务，不该上屏。见 docs/design-system.md「文案」一节。 -->
  <view class="card">
    <view class="card-title bar">背诵概况</view>
    <view class="stats">
      <view class="stat">
        <text class="stat-v">{{stats.learned}}</text>
        <text class="stat-k">已学</text>
      </view>
      <view class="stat">
        <text class="stat-v">{{stats.mastered}}</text>
        <text class="stat-k">已掌握</text>
      </view>
      <view class="stat">
        <text class="stat-v">{{stats.readCount}}</text>
        <text class="stat-k">已读篇目</text>
      </view>
    </view>
    <view class="divider"></view>
    <view class="kv">
      <text class="kv-k">背诵范围</text>
      <text class="kv-v">{{gradeName}} · {{scopeName}}</text>
    </view>
    <view class="kv">
      <text class="kv-k">每日首数</text>
      <text class="kv-v">{{dailyCount}} 首</text>
    </view>
    <view class="kv">
      <text class="kv-k">复习算法</text>
      <text class="kv-v">{{algoName}}</text>
    </view>
  </view>

  <!-- 学习：登录后是入口清单；未登录整块不出现 ——
       一张只有一句「登录后会出现…」的卡，占位置不办事 -->
  <view class="card" wx:if="{{logged}}">
    <view class="card-title bar">学习</view>
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onProgress">
      <view class="row-icon">进</view>
      <view class="row-main">
        <text class="row-title">背诵进度</text>
        <text class="row-sub">七天排期 · 记忆阶段</text>
      </view>
      <text class="row-go">›</text>
    </view>
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onGame">
      <view class="row-icon">令</view>
      <view class="row-main">
        <text class="row-title">古诗词大会</text>
        <text class="row-sub">飞花令 · 题库 · 考试</text>
      </view>
      <text class="row-go">›</text>
    </view>
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onRecite">
      <view class="row-icon">背</view>
      <view class="row-main">
        <text class="row-title">背诵设置</text>
        <text class="row-sub">范围 · 首数 · 算法</text>
      </view>
      <text class="row-go">›</text>
    </view>
    <!-- 版式三件事（对齐 · 注音 · 字号）同在一页。注音原来单开一页，
         与对齐字号分家 —— 2026-10-04 用户问「通用设置里怎么没有注音的设置」
         之后并回去了（见 docs/design-system.md「背诵设置里没有阅读偏好」）。 -->
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onSettings">
      <view class="row-icon">设</view>
      <view class="row-main">
        <text class="row-title">通用设置</text>
        <text class="row-sub">对齐 · 注音 · 字号</text>
      </view>
      <text class="row-go">›</text>
    </view>
    <!-- 答题音效仍在自己那一页（它 @所属题库/考试/飞花令 共用，不是版式）。
         环境出不了声时整行不出现 —— 一个点不动的入口比没有更糟。 -->
    <view class="row" hover-class="row-hover" hover-stay-time="60"
          bindtap="onReader" wx:if="{{sfxVisible}}">
      <view class="row-icon">读</view>
      <view class="row-main">
        <text class="row-title">声音</text>
        <text class="row-sub">答题音效</text>
      </view>
      <text class="row-go">›</text>
    </view>
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onTheme">
      <view class="row-icon">色</view>
      <view class="row-main">
        <text class="row-title">主题色</text>
        <text class="row-sub">{{themeName}}</text>
      </view>
      <text class="row-go">›</text>
    </view>
  </view>

  <!-- 权限说明：与「能力」那张卡同一张表（E.matrix），逐条对照。
       登录后那五项设置入口都在上面的「学习」卡里，这一张只管「我能用什么」。 -->
  <view class="card" wx:if="{{logged}}">
    <view class="card-title bar">能力</view>
    <view class="cap-row" wx:for="{{caps}}" wx:key="cap">
      <text class="cap-name">{{item.name}}</text>
      <text class="cap-state {{item.ok ? 'on' : 'off'}}">{{item.hint}}</text>
    </view>
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onPlans">
      <view class="row-main">
        <text class="row-title">权限说明</text>
        <text class="row-sub">{{lockedCount ? lockedCount + ' 项未解锁' : '全部可用'}} · 逐条对照</text>
      </view>
      <text class="row-go">›</text>
    </view>
  </view>

  <view class="card">
    <view class="card-title bar">数据与账号</view>
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onExport" wx:if="{{logged}}">
      <view class="row-icon">出</view>
      <view class="row-main"><text class="row-title">导出备份</text><text class="row-sub">复制成 JSON</text></view>
      <text class="row-go">›</text>
    </view>
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onSync" wx:if="{{logged}}">
      <view class="row-icon">云</view>
      <view class="row-main">
        <text class="row-title">同步进度</text>
        <text class="row-sub">{{syncSub}}</text>
      </view>
      <text class="row-go">›</text>
    </view>
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onAdmin" wx:if="{{logged}}">
      <view class="row-icon">权</view>
      <view class="row-main">
        <text class="row-title">用户与权限</text>
        <text class="row-sub">档位 · 能力</text>
      </view>
      <text class="row-go">›</text>
    </view>
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onAbout">
      <view class="row-icon">问</view>
      <view class="row-main"><text class="row-title">关于与反馈</text></view>
      <text class="row-go">›</text>
    </view>
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onClear">
      <view class="row-icon">删</view>
      <view class="row-main"><text class="row-title danger-text">清空背诵数据</text></view>
      <text class="row-go">›</text>
    </view>
  </view>

  <view class="safe-bottom"></view>
</view>
