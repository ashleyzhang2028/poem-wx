<view class="page {{barBelow ? 'has-tabbar' : 'tall'}}" style="{{themeStyle}}">

  <view class="card account">
    <view class="identity">

      <view class="avatar-wrap">
        <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onAvatarChoose"
                wx:if="{{logged}}">
          <image class="avatar" wx:if="{{avatarUrl}}" src="{{avatarUrl}}" mode="aspectFill" />
        </button>
        <view class="avatar-btn" wx:else></view>
        <view class="avatar-fallback" wx:if="{{!avatarUrl}}">{{avatarChar}}</view>
        <view class="avatar-hit" wx:if="{{logged}}" hover-class="avatar-hit-active"
              hover-stay-time="60" bindtap="onAvatarTap"></view>
      </view>

      <view class="identity-main">
        <block wx:if="{{logged}}">
          <input class="identity-input" type="nickname" value="{{nickname}}" maxlength="12"
                 placeholder="填一个昵称" placeholder-class="identity-ph"
                 confirm-type="done" bindblur="onNickname" bindconfirm="onNickname" />
          <view class="identity-sub-row">
            <text class="identity-sub">{{identitySub}}</text>
          </view>
        </block>

        <block wx:else>
          <text class="identity-name">{{nickname}}</text>
          <view class="identity-sub-row">
            <text class="identity-sub">{{identitySub}}</text>
          </view>
        </block>
      </view>
      <view class="tier-chip" wx:if="{{logged}}" hover-class="tier-chip-hover" hover-stay-time="60"
            bindtap="onTier">{{tierLabel}}</view>
    </view>

    <view class="wechat-picks" wx:if="{{logged}}">
      <view class="wechat-pick" hover-class="wechat-pick-hover" hover-stay-time="60"
            bindtap="onUseWechatAvatar">
        <text class="wechat-pick-title">用微信头像</text>
        <text class="wechat-pick-sub">头像换成微信那张</text>
      </view>
      <view class="wechat-pick" hover-class="wechat-pick-hover" hover-stay-time="60"
            bindtap="onUseWechatIdentity">
        <text class="wechat-pick-title">用微信头像和昵称</text>
        <text class="wechat-pick-sub">两样都换成微信的</text>
      </view>
    </view>

    <block wx:if="{{!logged}}">
      <view class="login-row">
        <button class="btn primary block" bindtap="onLogin">登录</button>
      </view>
    </block>

    <block wx:else>
      <button class="btn ghost mini logout" bindtap="onLogout">退出</button>
    </block>
  </view>

  <view class="card">
    <view class="stats">
      <view class="stat">
        <text class="stat-v">{{stats.learned}}</text>
        <text class="stat-k">已学</text>
      </view>
      <view class="stat">
        <text class="stat-v">{{stats.mastered}}</text>
        <text class="stat-k">已掌握</text>
      </view>
      <view class="stat">
        <text class="stat-v">{{stats.readCount}}</text>
        <text class="stat-k">已读篇目</text>
      </view>
    </view>
    <view class="divider"></view>
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onRecite">
      <view class="row-main">
        <text class="row-title">背诵选项</text>
        <text class="row-sub">{{gradeName}} · {{scopeName}} · 每日 {{dailyCount}} 首 · {{algoName}}</text>
      </view>
      <text class="row-go">›</text>
    </view>
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onProgress">
      <view class="row-main">
        <text class="row-title">背诵进度</text>
        <text class="row-sub">概要 · 到期日历 · 掌握度</text>
      </view>
      <text class="row-go">›</text>
    </view>
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onCollections">
      <view class="row-main">
        <text class="row-title">自选背诵</text>
        <text class="row-sub">自己加的集合 · 改名 · 增删篇目</text>
      </view>
      <text class="row-go">›</text>
    </view>
  </view>

  <view class="card" wx:if="{{logged}}">
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onSettings">
      <view class="row-icon">设</view>
      <view class="row-main">
        <text class="row-title">设置</text>
        <text class="row-sub">版式 · 主题 · 声音</text>
      </view>
      <text class="row-go">›</text>
    </view>
  </view>

  <view class="card">
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onTier">
      <view class="row-icon">档</view>
      <view class="row-main">
        <text class="row-title">用户权限</text>
        <text class="row-sub">自己那一档 · 能力对照</text>
      </view>
      <text class="row-go">›</text>
    </view>
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onManage" wx:if="{{manageOn}}">
      <view class="row-icon">管</view>
      <view class="row-main">
        <text class="row-title">后台管理</text>
        <text class="row-sub">用户列表 · 改档位</text>
      </view>
      <text class="row-go">›</text>
    </view>
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onSync" wx:if="{{logged}}">
      <view class="row-icon">云</view>
      <view class="row-main">
        <text class="row-title">同步</text>
        <text class="row-sub">{{syncSub}}</text>
      </view>
      <text class="row-go">›</text>
    </view>
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onPrivacy">
      <view class="row-icon">私</view>
      <view class="row-main">
        <text class="row-title">隐私政策</text>
        <text class="row-sub">收集什么 · 存哪 · 怎么删</text>
      </view>
      <text class="row-go">›</text>
    </view>
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onClear">
      <view class="row-icon">删</view>
      <view class="row-main"><text class="row-title clear-text">清空背诵数据</text></view>
      <text class="row-go">›</text>
    </view>
  </view>

  <view class="safe-bottom"></view>
</view>
