<view class="page">
  <view class="card account">
    <view class="identity">
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onAvatarChoose">
        <image class="avatar" wx:if="{{avatarUrl}}" src="{{avatarUrl}}" mode="aspectFill" />
        <view class="avatar avatar-fallback" wx:else>{{nickname[0]}}</view>
      </button>
      <view class="identity-main">
        <text class="identity-name">{{nickname}}</text>
        <text class="identity-sub">{{logged ? '已登录 · 进度可跨设备同步' : '点这里用微信登录'}}</text>
      </view>
    </view>

    <view class="login-row" wx:if="{{!logged}}">
      <button class="btn primary block" bindtap="onLogin">微信登录</button>
      <text class="hint">不登录也能用全部功能 —— 本机数据只属于本机，登录是为了换手机不丢进度</text>
    </view>

    <view class="profile-row" wx:else>
      <button class="btn ghost" bindtap="onProfile">从微信取昵称头像</button>
      <!-- type=nickname 是小程序给的「昵称填写」能力，不是普通文本框 -->
      <input class="nick-input" type="nickname" placeholder="也可以自己填一个昵称"
             confirm-type="done" bindblur="onNickname" bindconfirm="onNickname" />
    </view>
  </view>

  <view class="card">
    <view class="card-title">本机数据</view>
    <view class="kv">
      <text class="kv-k">背诵范围</text>
      <text class="kv-v">{{gradeName}} · {{scopeName}}</text>
    </view>
    <view class="kv">
      <text class="kv-k">每日首数</text>
      <text class="kv-v">{{dailyCount}} 首</text>
    </view>
    <view class="kv">
      <text class="kv-k">当前档位</text>
      <text class="kv-v">{{tierLabel}}</text>
    </view>
    <view class="kv">
      <text class="kv-k">复习算法</text>
      <text class="kv-v">{{algoName}}</text>
    </view>
    <view class="kv">
      <text class="kv-k">已学 / 已掌握</text>
      <text class="kv-v">{{stats.learned}} / {{stats.mastered}}</text>
    </view>
    <view class="kv">
      <text class="kv-k">已读篇目</text>
      <text class="kv-v">{{stats.readCount}}</text>
    </view>
  </view>

  <view class="card">
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onProgress">
      <view class="row-main"><text class="row-title">背诵进度</text></view>
      <text class="row-go">›</text>
    </view>
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onGame">
      <view class="row-main"><text class="row-title">古诗词大会</text><text class="row-sub">飞花令 · 题库 · 模拟考试</text></view>
      <text class="row-go">›</text>
    </view>
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onRecite">
      <view class="row-main"><text class="row-title">背诵设置</text></view>
      <text class="row-go">›</text>
    </view>
    <!-- 朗读与注音都不可用时，这一行没有存在的意义，直接不渲染 -->
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onReader" wx:if="{{speakVisible || pinyinVisible}}">
      <view class="row-main">
        <text class="row-title">阅读与朗读</text>
        <text class="row-sub">{{speakVisible ? '朗读 · 注音' : '注音'}}</text>
      </view>
      <text class="row-go">›</text>
    </view>
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onSettings">
      <view class="row-main"><text class="row-title">通用设置</text></view>
      <text class="row-go">›</text>
    </view>
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onAbout">
      <view class="row-main"><text class="row-title">关于与反馈</text></view>
      <text class="row-go">›</text>
    </view>
  </view>

  <view class="card">
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onExport">
      <view class="row-main"><text class="row-title">导出备份</text><text class="row-sub">复制成 JSON，换手机时导回去</text></view>
      <text class="row-go">›</text>
    </view>
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onSync">
      <view class="row-main">
        <text class="row-title">云端同步</text>
        <text class="row-sub">{{syncReady ? syncText : '后端未就绪 · 已攒 ' + syncPending + ' 条'}}</text>
      </view>
      <text class="row-go">›</text>
    </view>
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onAdmin">
      <view class="row-main">
        <text class="row-title">用户与权限</text>
        <text class="row-sub">分层设置 · 兑换授权</text>
      </view>
      <text class="row-go">›</text>
    </view>
    <view class="row" hover-class="row-hover" hover-stay-time="60" bindtap="onClear">
      <view class="row-main"><text class="row-title danger-text">清空本机数据</text></view>
      <text class="row-go">›</text>
    </view>
  </view>

  <view class="safe-bottom"></view>
</view>
