<view class="page">
  <view class="card account">
    <view class="identity">
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onAvatarChoose">
        <image class="avatar" wx:if="{{avatarUrl}}" src="{{avatarUrl}}" mode="aspectFill" />
        <view class="avatar avatar-fallback" wx:else>{{nickname[0]}}</view>
      </button>
      <view class="identity-main">
        <view class="identity-line">
          <text class="identity-name">{{nickname}}</text>
          <text class="tag">{{tierLabel}}</text>
        </view>
        <text class="identity-sub">{{syncState}}</text>
      </view>
    </view>

    <view class="login-row" wx:if="{{!logged}}">
      <button class="btn primary block" bindtap="onLogin">微信登录</button>
      <text class="hint">不登录也能用全部功能，登录只为了把进度存到云端</text>
    </view>

    <view class="profile-row" wx:else>
      <input class="nick-input" type="nickname" placeholder="填一个昵称" bindblur="onNickname" />
    </view>
  </view>

  <view class="card notice" wx:if="{{upgradeNotice}}" bindtap="onDismissNotice">
    <text class="notice-t">层级已升到 {{upgradeNotice.to}}</text>
    <text class="notice-s">点这里收下</text>
  </view>

  <view class="card">
    <view class="card-title">本机数据</view>
    <view class="kv">
      <text class="kv-k">背诵范围</text>
      <text class="kv-v">{{gradeName}} · {{scopeName}}</text>
    </view>
    <view class="kv">
      <text class="kv-k">每日首数</text>
      <text class="kv-v">{{dailyCount}} 首</text>
    </view>
    <view class="kv">
      <text class="kv-k">复习算法</text>
      <text class="kv-v">{{algoName}}</text>
    </view>
    <view class="kv">
      <text class="kv-k">已学 / 已掌握</text>
      <text class="kv-v">{{stats.learned}} / {{stats.mastered}}</text>
    </view>
    <view class="kv">
      <text class="kv-k">已读篇目</text>
      <text class="kv-v">{{stats.readCount}}</text>
    </view>
    <view class="kv">
      <text class="kv-k">朗读服务</text>
      <text class="kv-v">{{ttsName}}</text>
    </view>
  </view>

  <view class="card">
    <view class="row" bindtap="onAdmin">
      <view class="row-main">
        <text class="row-title">管理层级</text>
        <text class="row-sub">当前 {{tierLabel}} · 角色 {{role}}</text>
      </view>
      <text class="row-go">›</text>
    </view>
    <view class="row" bindtap="onProgress">
      <view class="row-main"><text class="row-title">背诵进度</text></view>
      <text class="row-go">›</text>
    </view>
    <view class="row" bindtap="onGame">
      <view class="row-main"><text class="row-title">古诗词大会</text><text class="row-sub">飞花令 · 题库 · 模拟考试</text></view>
      <text class="row-go">›</text>
    </view>
    <view class="row" bindtap="onRecite">
      <view class="row-main"><text class="row-title">背诵设置</text></view>
      <text class="row-go">›</text>
    </view>
    <view class="row" bindtap="onReader">
      <view class="row-main"><text class="row-title">注音与朗读</text></view>
      <text class="row-go">›</text>
    </view>
    <view class="row" bindtap="onSettings">
      <view class="row-main"><text class="row-title">通用设置</text></view>
      <text class="row-go">›</text>
    </view>
    <view class="row" bindtap="onAbout">
      <view class="row-main"><text class="row-title">关于与反馈</text></view>
      <text class="row-go">›</text>
    </view>
  </view>

  <view class="card">
    <view class="row" bindtap="onExport">
      <view class="row-main"><text class="row-title">导出备份</text><text class="row-sub">复制成 JSON，换手机时导回去</text></view>
      <text class="row-go">›</text>
    </view>
    <view class="row" bindtap="onImport">
      <view class="row-main"><text class="row-title">从备份导回</text></view>
      <text class="row-go">›</text>
    </view>
    <view class="row" bindtap="onClear">
      <view class="row-main"><text class="row-title danger-text">清空本机数据</text></view>
      <text class="row-go">›</text>
    </view>
  </view>

  <view class="safe-bottom"></view>
</view>
