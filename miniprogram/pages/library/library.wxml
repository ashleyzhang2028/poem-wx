<view class="page {{barBelow ? 'has-tabbar' : 'tall'}} {{name}}" style="{{themeStyle}}">
  <lock-card wx:if="{{locked}}" title="漫读" note="登录后查看" mark="漫" bind:login="onLogin" />

  <block wx:else>

    <view class="card read-strip" hover-class="read-strip-hover" hover-stay-time="60" bindtap="onOpenRead">
      <text class="read-strip-t">继续读</text>
      <text class="read-strip-meta" wx:if="{{last}}">{{last.title}}</text>
      <text class="read-strip-go">下拉 ›</text>
    </view>

    <corpus-state state="{{corpusState}}" bind:retry="onCorpusRetry" />

    <view class="card" wx:for="{{groups}}" wx:key="key">
      <view class="gc-head">
        <text class="gc-name">{{item.name}}</text>
        <text class="gc-count">{{item.count}} {{item.unit}}</text>
      </view>
      <text class="gc-desc">{{item.desc}}</text>
      <block wx:if="{{item.key === 'mine'}}">
        <view class="book-grid" wx:if="{{mineOn}}">
          <view class="book-cell" hover-class="book-hover" hover-stay-time="60"
                wx:for="{{mine}}" wx:for-item="c" wx:key="id" data-c="{{c.id}}" bindtap="onOpenMine">
            <view class="book-main">
              <text class="book-name">{{c.name}}</text>
              <text class="book-sub">共 {{c.count}} 首</text>
            </view>
            <text class="row-go">›</text>
          </view>
        </view>
        <view class="empty" wx:elif="{{!mineCount}}">
          <text class="empty-text">{{mineOn ? '暂无自选集合' : '自选集合 ' + mineTier + ' 起可用'}}</text>
          <text class="hint empty-tip">{{mineOn ? '在「我的 → 我的自选」新建集合' : '升级后可新建集合'}}</text>
        </view>
      </block>

      <view class="book-grid {{item.wide ? 'book-grid-wide' : ''}}" wx:else>
        <view class="book-cell {{item.wide ? 'book-cell-wide' : ''}}" hover-class="book-hover" hover-stay-time="60"
              wx:for="{{item.books}}" wx:for-item="b" wx:key="id" data-b="{{b.id}}" bindtap="onOpenBook">
          <view class="book-main">
            <text class="book-name">{{b.name}}</text>
            <text class="book-sub">共 {{b.count}} {{b.unit}}</text>
          </view>
          <text class="row-go">›</text>
        </view>
      </view>
    </view>

    <view class="safe-bottom"></view>
  </block>

  <read-sheet id="read-sheet" bind:opened="onReadOpened" />
</view>
