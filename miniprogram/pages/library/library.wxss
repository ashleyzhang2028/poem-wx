.gc-head {
  display: flex;
  align-items: baseline;
}

.gc-name {
  flex: 1;
  min-width: 0;
  font-family: var(--font-poem);
  font-size: var(--fs-lead);
  font-weight: 600;
  color: var(--strong-text);
  letter-spacing: var(--ls-title);
}

.gc-count {
  flex: none;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  padding-left: var(--sp-2);
  font-variant-numeric: tabular-nums;
}

.gc-desc {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: var(--sp-1);
}

.book-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--sp-2);
  margin-top: var(--sp-3);
}

.book-cell {
  display: flex;
  align-items: center;
  min-height: var(--h-opt);
  padding: var(--sp-2) var(--sp-3);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-ctl);
  background: var(--surface);
  transition: background-color var(--t-press), transform var(--t-press);
}

.book-hover {
  background: var(--sink);
  transform: scale(.992);
}

.book-main {
  flex: 1;
  min-width: 0;
}

.book-name {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-title);
  color: var(--strong-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.book-sub {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 6rpx;
}
