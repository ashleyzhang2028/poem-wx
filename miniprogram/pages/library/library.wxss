/* 四张集子卡：整块可点，所以给整卡反馈 ——
   之前它是 <view bindtap> 却没有按下态，点上去像没反应 */
.group-card {
  background: var(--card);
  border: 1rpx solid var(--line-2);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: var(--sp-4);
  margin-bottom: var(--sp-3);
  transition: background-color var(--t-press), border-color var(--t-press), transform var(--t-press);
}

.group-hover {
  background: var(--green-light);
  border-color: var(--green-edge);
  transform: scale(.992);
}

.gc-head {
  display: flex;
  align-items: center;
}

.gc-left {
  flex: 1;
  min-width: 0;
}

.gc-name {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-lead);
  font-weight: 600;
  color: var(--green);
  letter-spacing: 1rpx;
}

.gc-desc {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: var(--sp-1);
}

.gc-count {
  flex: none;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  padding-left: var(--sp-2);
}

.gc-books {
  margin-top: var(--sp-2);
  padding-top: var(--sp-2);
  border-top: 1rpx solid var(--line-2);
}

.gc-books .tag {
  margin: 0 12rpx 12rpx 0;
}

/* 返回条：它是个可点元素，得给按下态 */
.back-bar {
  display: flex;
  align-items: center;
  font-size: var(--fs-body);
  color: var(--green);
  padding: var(--sp-1) var(--sp-1) var(--sp-3);
  border-radius: var(--radius-sm);
  transition: background-color var(--t-press);
}

.back-hover {
  background: var(--green-light);
}

.back-arrow {
  font-size: var(--fs-hero);
  padding-right: var(--sp-1);
  line-height: 1;
}
