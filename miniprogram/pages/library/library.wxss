.gc-head {
  display: flex;
  align-items: baseline;
}

.gc-count {
  flex: none;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  padding-left: var(--sp-2);
  font-variant-numeric: tabular-nums;
}

.gc-desc {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: var(--sp-1);
}

.book-grid {
  display: flex;
  flex-wrap: wrap;
  column-gap: var(--sp-2);
  margin-top: var(--sp-3);
}

.book-grid-wide {
  flex-direction: column;
  row-gap: 0;
}

.book-cell {
  display: flex;
  align-items: center;
  width: calc((100% - var(--sp-2)) / 2);
  min-height: var(--h-row);
  padding: var(--sp-2) 0;
  border-bottom: 1rpx solid var(--line-2);
  transition: background-color var(--t-press);
}

.book-cell-wide {
  width: 100%;
}

.book-hover {
  background: var(--sink);
}

.book-main {
  flex: 1;
  min-width: 0;
}

.book-name {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-lead);
  color: var(--strong-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.book-sub {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 6rpx;
}

.read-strip {
  display: flex;
  align-items: center;
  min-height: var(--h-row);
  margin-top: -1rpx;
  border-radius: 0 0 var(--radius) var(--radius);
  transition: background-color var(--t-press);
}

.read-strip-hover {
  background: var(--sink);
}

.read-strip-t {
  flex: none;
  font-size: var(--fs-hint);
  color: var(--strong-text);
}

.read-strip-meta {
  flex: 1;
  min-width: 0;
  margin-left: var(--sp-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-family: var(--font-poem);
  font-size: var(--fs-hint);
  color: var(--ink-3);
}

.read-strip-go {
  flex: none;
  margin-left: var(--sp-2);
  font-size: var(--fs-caption);
  color: var(--ink-4);
}
