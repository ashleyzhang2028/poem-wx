<view class="tabbar {{name}}" style="{{themeStyle}}">
  <view class="tab {{active === index ? 'on' : ''}}"
        wx:for="{{list}}" wx:key="pagePath"
        data-index="{{index}}" bindtap="onTap">
    <view class="tab-ico">
      <image class="tab-ico-face" wx:if="{{item.me && meAvatar}}" src="{{meAvatar}}" mode="aspectFill" />
      <view class="tab-ico-face tab-ico-char" wx:elif="{{item.me}}">{{meChar}}</view>
      <view class="tab-ico-mask" wx:else
            style="mask-image:url('{{item.icon}}');-webkit-mask-image:url('{{item.icon}}');"></view>
    </view>
    <text class="tab-text" style="{{fontStyle ? 'font-family:' + fontStyle : ''}}">{{item.text}}</text>
  </view>
</view>
