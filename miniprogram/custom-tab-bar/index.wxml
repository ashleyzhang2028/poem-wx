<view class="tabbar {{pageHere ? '' : 'bar-away'}}" style="{{themeStyle}}">
  <view class="tab {{active === index ? 'on' : ''}}"
        wx:for="{{list}}" wx:key="pagePath"
        data-index="{{index}}" bindtap="onTap">
    <view class="tab-ico">
      <view class="tab-ico-mask" style="mask-image:url('{{item.icon}}');-webkit-mask-image:url('{{item.icon}}');"></view>
    </view>
    <text class="tab-text">{{item.text}}</text>
  </view>
</view>
