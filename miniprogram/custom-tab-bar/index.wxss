.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: flex-start;
  height: calc(112rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, .94);

  border-top: 1rpx solid #ececef;
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 112rpx;
  gap: 6rpx;
  color: #9ca3af;
  transition: color .12s;
}

.tab-text {
  font-size: 22rpx;
  line-height: 1;
  letter-spacing: 1rpx;
}

.tab.on {
  color: var(--strong-text);
}

.tab.on .tab-text {
  font-weight: 600;
}

.tab-ico {
  position: relative;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  --ic: #9ca3af;
  transition: background-color .12s;
}

.tab.on .tab-ico {
  background: var(--strong);

  --ic: var(--on-ink);

  box-shadow: 0 0 0 2rpx var(--on-ink);
}

.tab-ico::before,
.tab-ico::after {
  content: "";
  position: absolute;
  box-sizing: border-box;
  background: var(--ic);
}

.tab-ico-book::before {
  left: 13rpx;
  top: 16rpx;
  width: 30rpx;
  height: 24rpx;
  background: transparent;
  border: 3rpx solid var(--ic);
  border-radius: 3rpx 3rpx 5rpx 5rpx;
}

.tab-ico-book::after {
  left: 26rpx;
  top: 17rpx;
  width: 3rpx;
  height: 22rpx;
  border-radius: 1rpx;
}

.tab-ico-stack::before {
  left: 14rpx;
  top: 22rpx;
  width: 28rpx;
  height: 16rpx;
  background: transparent;
  border: 3rpx solid var(--ic);
  border-radius: 3rpx;
}

.tab-ico-stack::after {
  left: 17rpx;
  top: 16rpx;
  width: 22rpx;
  height: 3rpx;
  border-radius: 2rpx;
}

.tab-ico-search::before {
  left: 13rpx;
  top: 13rpx;
  width: 20rpx;
  height: 20rpx;
  background: transparent;
  border: 3rpx solid var(--ic);
  border-radius: 50%;
}

.tab-ico-search::after {
  left: 30rpx;
  top: 30rpx;
  width: 12rpx;
  height: 3rpx;
  border-radius: 2rpx;
  transform: rotate(45deg);
  transform-origin: left center;
}

.tab-ico-person::before {
  left: 21rpx;
  top: 13rpx;
  width: 14rpx;
  height: 14rpx;
  border: 3rpx solid var(--ic);
  border-radius: 50%;
  background: transparent;
}

.tab-ico-person::after {
  left: 15rpx;
  top: 32rpx;
  width: 26rpx;
  height: 13rpx;
  background: transparent;
  border: 3rpx solid var(--ic);
  border-bottom: none;
  border-radius: 13rpx 13rpx 0 0;
}

