<view class="card identity" wx:if="{{logged}}">
  <view class="identity-row">
    <view class="avatar-wrap">
      <image class="avatar" wx:if="{{avatarUrl}}" src="{{avatarUrl}}" mode="aspectFill" />
      <view class="avatar-fallback" wx:else>{{avatarChar}}</view>
      <button class="wechat-choose" open-type="chooseAvatar" aria-label="换成微信头像"
              bindchooseavatar="onWechatAvatar"></button>
    </view>

    <view class="identity-main">
      <view class="identity-main-text" bindtap="onWechat">
        <text class="identity-name">{{nickname}}</text>
      </view>
      <text class="identity-sub">已登录 · 微信账号</text>
    </view>

    <view class="tier-chip" hover-class="tier-chip-hover" hover-stay-time="60"
          bindtap="onTier">{{tierLabel}}</view>
  </view>

  <button class="btn primary block wechat-go" wx:if="{{picking}}" bindtap="promptName">用微信昵称</button>

  <view class="identity-acts">
    <button class="btn ghost" bindtap="onWechat">换成微信的</button>
    <button class="btn ghost" bindtap="onLogout">辞别</button>
  </view>
</view>

<view class="card login-box" wx:else>
  <button class="btn primary block" bindtap="onLogin">登录</button>
</view>
