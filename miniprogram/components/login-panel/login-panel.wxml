<view class="card identity id-card tier-{{tierKey}}" wx:if="{{logged}}">
  <view class="id-crest" wx:if="{{tierKey !== 'free'}}"
        style="mask-image:url('{{crest}}');-webkit-mask-image:url('{{crest}}');"></view>
  <view class="id-top">
    <text class="id-kind poem">{{kindText}}</text>
    <view class="id-chips">
      <view class="tier-chip tier-act" hover-class="tier-chip-hover" hover-stay-time="60"
            bindtap="onUpgrade">{{upgradeText}}</view>
      <view class="tier-chip" hover-class="tier-chip-hover" hover-stay-time="60"
            bindtap="onTier">{{tierLabel}}</view>
      <view class="gear" hover-class="gear-hover" hover-stay-time="60" bindtap="onSettings">
        <view class="gear-icon" aria-label="设置"
              style="mask-image:url('{{gearIcon}}');-webkit-mask-image:url('{{gearIcon}}');"></view>
      </view>
    </view>
  </view>

  <view class="identity-row">
    <view class="avatar-wrap">
      <image class="avatar" wx:if="{{avatarUrl}}" src="{{avatarUrl}}" mode="aspectFill" />
      <view class="avatar-fallback" wx:else>{{avatarChar}}</view>
      <button class="wechat-choose" open-type="chooseAvatar" aria-label="使用微信头像"
              bindchooseavatar="onWechatAvatar"></button>
    </view>

    <view class="identity-main">
      <view class="identity-main-text" bindtap="onName">
        <text class="identity-name">{{nickname}}</text>
      </view>
      <text class="identity-sub">已登录 · 微信账号</text>
    </view>
  </view>

  <text class="id-motto poem">{{motto}}</text>

  <view class="id-foot">
    <view class="id-valid">
      <text class="id-valid-k">有效期</text>
      <text class="id-valid-v">{{validText}}</text>
    </view>
  </view>
</view>

<button class="btn primary block login-lead" wx:else bindtap="onLogin">登录</button>
