.identity-row {
  display: flex;
  align-items: center;
}

.avatar-wrap {
  position: relative;
  width: 112rpx;
  height: 112rpx;
  flex: none;
  border-radius: 50%;
  overflow: hidden;
  box-shadow: 0 0 0 2rpx var(--line);
}

.avatar {
  position: absolute;
  top: 0;
  left: 0;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
}

.avatar-fallback {
  position: absolute;
  top: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--sink);
  font-family: var(--font-poem);
  font-size: var(--fs-mark);
  line-height: var(--lh-tight);
  color: var(--ink-2);
}

.wechat-choose {
  position: absolute;
  top: 0;
  left: 0;
  width: 112rpx;
  height: 112rpx;
  margin: 0;
  padding: 0;
  border: none;
  background: transparent;
  opacity: 0;
  z-index: 1;
}

.wechat-choose::after {
  border: none;
}

.identity-main {
  flex: 1;
  min-width: 0;
  padding-left: var(--sp-3);
}

.identity-main-text {
  display: block;
  padding: 0;
}

.identity-name {
  display: block;
  font-size: var(--fs-lead);
  line-height: 1.4;
  color: var(--ink);
  letter-spacing: var(--ls-title);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.identity-sub {
  display: block;
  margin-top: var(--sp-1);
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

.tier-chip {
  flex: none;
  height: auto;
  padding: var(--pad-opt-y) var(--sp-2);
  border: 1rpx solid var(--line-strong);
  border-radius: var(--radius-pill);
  font-size: var(--fs-caption);
  line-height: 1.4;
  letter-spacing: 1rpx;
  color: var(--ink-2);
}

.id-chips {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
}

.tier-act {
  color: var(--strong-text);
  border-color: var(--strong);
}

.tier-chip-hover {
  background: var(--line);
  opacity: 1;
}

.login-lead {
  height: var(--h-field);
  margin-top: var(--sp-4);
}

.id-card {
  position: relative;
  overflow: hidden;
}

.id-crest {
  position: absolute;
  right: -72rpx;
  bottom: -84rpx;
  width: 360rpx;
  height: 360rpx;
  background: rgba(255, 255, 255, .16);
  -webkit-mask-size: contain;
  mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
  pointer-events: none;
}

.id-top,
.identity-row,
.id-motto,
.id-foot {
  position: relative;
  z-index: 1;
}

.id-motto {
  display: block;
  margin-top: var(--sp-3);
  font-size: var(--fs-hint);
  letter-spacing: 2rpx;
  color: var(--ink-3);
}

.id-top,
.id-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.id-top {
  margin-bottom: var(--sp-3);
}

.id-foot {
  margin-top: var(--sp-3);
}

.id-kind,
.id-valid-k {
  font-size: var(--fs-caption);
  letter-spacing: 4rpx;
  color: var(--ink-3);
}

.id-valid-k {
  display: block;
  letter-spacing: 2rpx;
}

.id-valid-v {
  display: block;
  font-size: var(--fs-body);
  letter-spacing: 2rpx;
  color: var(--ink-2);
  font-variant-numeric: tabular-nums;
}

.tier-pro,
.tier-max {
  border: none;
}

.tier-pro {
  background: var(--card-fei);
}

.tier-max {
  background: var(--card-zi);
}

.tier-pro .identity-name,
.tier-max .identity-name,
.tier-pro .id-valid-v,
.tier-max .id-valid-v,
.tier-pro .id-kind,
.tier-max .id-kind {
  color: var(--on-ink);
}

.tier-pro .identity-sub,
.tier-max .identity-sub,
.tier-pro .id-motto,
.tier-max .id-motto,
.tier-pro .id-valid-k,
.tier-max .id-valid-k {
  color: var(--on-ink-soft);
}

.tier-pro .avatar-fallback,
.tier-max .avatar-fallback {
  background: rgba(255, 255, 255, .2);
  color: var(--on-ink);
}

.tier-pro .tier-act,
.tier-max .tier-act {
  background: rgba(255, 255, 255, .22);
  border-color: rgba(255, 255, 255, .7);
}

.tier-pro .tier-chip,
.tier-max .tier-chip {
  color: var(--on-ink);
  background: transparent;
  border-color: rgba(255, 255, 255, .5);
}

.tier-pro .tier-chip-hover,
.tier-max .tier-chip-hover {
  background: rgba(255, 255, 255, .16);
}

.tier-pro .avatar-wrap,
.tier-max .avatar-wrap {
  box-shadow: 0 0 0 4rpx rgba(255, 255, 255, .35);
}

.tier-pro .tier-chip::before {
  content: "✦";
  margin-right: 6rpx;
}
