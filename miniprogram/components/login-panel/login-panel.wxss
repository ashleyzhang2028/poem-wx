.identity-row {
  display: flex;
  align-items: center;
}

.avatar-wrap {
  position: relative;
  width: 112rpx;
  height: 112rpx;
  flex: none;
  border-radius: 50%;
  overflow: hidden;
  box-shadow: 0 0 0 2rpx var(--line);
}

.avatar {
  position: absolute;
  top: 0;
  left: 0;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
}

.avatar-fallback {
  position: absolute;
  top: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--sink);
  font-family: var(--font-poem);
  font-size: var(--fs-mark);
  line-height: var(--lh-tight);
  color: var(--ink-2);
}

.wechat-choose {
  position: absolute;
  top: 0;
  left: 0;
  width: 112rpx;
  height: 112rpx;
  margin: 0;
  padding: 0;
  border: none;
  background: transparent;
  opacity: 0;
  z-index: 1;
}

.wechat-choose::after {
  border: none;
}

.identity-main {
  flex: 1;
  min-width: 0;
  padding-left: var(--sp-3);
}

.identity-main-text {
  display: block;
  padding: 0;
}

.identity-name {
  display: block;
  font-size: var(--fs-lead);
  line-height: 1.4;
  color: var(--ink);
  letter-spacing: var(--ls-title);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.identity-sub {
  display: block;
  margin-top: var(--sp-1);
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

.tier-chip {
  flex: none;
  margin-left: var(--sp-2);
  padding: var(--pad-opt-y) var(--pad-opt-x);
  border: 1rpx solid var(--line-strong);
  border-radius: var(--radius-pill);
  font-size: var(--fs-caption);
  line-height: 1.4;
  color: var(--ink-2);
  letter-spacing: 1rpx;
}

.tier-chip-hover {
  background: var(--line);
}

.identity-acts {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  margin-top: var(--sp-3);
}
.identity-acts .btn {
  width: 100%;
}

.login-box {
  margin-bottom: var(--sp-2);
}
