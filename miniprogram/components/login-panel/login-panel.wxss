.identity-row {
  display: flex;
  align-items: center;
}

.avatar-wrap {
  position: relative;
  width: 112rpx;
  height: 112rpx;
  flex: none;
  border-radius: 50%;
  overflow: hidden;
  box-shadow: 0 0 0 2rpx var(--line);
}

.avatar {
  position: absolute;
  top: 0;
  left: 0;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
}

.avatar-fallback {
  position: absolute;
  top: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--sink);
  font-family: var(--font-poem);
  font-size: var(--fs-mark);
  line-height: var(--lh-tight);
  color: var(--ink-2);
}

.wechat-choose {
  position: absolute;
  top: 0;
  left: 0;
  width: 112rpx;
  height: 112rpx;
  margin: 0;
  padding: 0;
  border: none;
  background: transparent;
  opacity: 0;
  z-index: 1;
}

.wechat-choose::after {
  border: none;
}

.identity-main {
  flex: 1;
  min-width: 0;
  padding-left: var(--sp-3);
}

.identity-main-text {
  display: block;
  padding: 0;
}

.identity-name {
  display: block;
  font-size: var(--fs-lead);
  line-height: 1.4;
  color: var(--ink);
  letter-spacing: var(--ls-title);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.identity-sub {
  display: block;
  margin-top: var(--sp-1);
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

.tier-chip {
  flex: none;
  height: auto;
  padding: var(--pad-opt-y) var(--sp-2);
  border: 1rpx solid var(--line-strong);
  border-radius: var(--radius-pill);
  font-size: var(--fs-caption);
  line-height: 1.4;
  letter-spacing: 1rpx;
  color: var(--ink-2);
}

.tier-chip-hover {
  background: var(--line);
  opacity: 1;
}

.login-lead {
  height: var(--h-field);
  margin-top: var(--sp-4);
}

.id-card {
  position: relative;
  overflow: hidden;
}

.id-top,
.id-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.id-top {
  margin-bottom: var(--sp-3);
}

.id-foot {
  margin-top: var(--sp-3);
}

.id-kind,
.id-valid-k {
  font-size: var(--fs-caption);
  letter-spacing: 4rpx;
  color: var(--ink-3);
}

.id-valid-k {
  display: block;
  letter-spacing: 2rpx;
}

.id-valid-v {
  display: block;
  font-size: var(--fs-body);
  letter-spacing: 2rpx;
  color: var(--ink-2);
  font-variant-numeric: tabular-nums;
}

.tier-pro,
.tier-max {
  border: none;
}

.tier-pro {
  background: var(--card-platinum);
}

.tier-max {
  background: var(--card-gold);
}

.tier-pro .identity-name,
.tier-max .identity-name,
.tier-pro .id-valid-v,
.tier-max .id-valid-v {
  color: var(--card-metal-ink);
}

.tier-pro .identity-sub,
.tier-max .identity-sub,
.tier-pro .id-kind,
.tier-max .id-kind,
.tier-pro .id-valid-k,
.tier-max .id-valid-k {
  color: var(--card-metal-ink);
  opacity: .65;
}

.tier-pro .tier-chip,
.tier-max .tier-chip {
  color: var(--card-metal-ink);
  background: transparent;
  border-color: var(--card-metal-line);
}

.tier-pro .avatar-wrap,
.tier-max .avatar-wrap {
  box-shadow: 0 0 0 4rpx rgba(255, 255, 255, .7), 0 0 0 6rpx var(--card-metal-line);
}

.tier-max .tier-chip::before {
  content: "✦";
  margin-right: 6rpx;
}
