.audio-knob {
  flex: none;
  align-self: center;
  box-sizing: border-box;
  width: var(--h-pref);
  height: var(--h-pref);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: background-color var(--t-press);
}

.audio-knob.framed {
  box-sizing: content-box;
  width: var(--h-pref);
  height: var(--h-pref);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
}

.audio-knob-hover {
  background: var(--sink);
}

.audio-knob-glyph {
  width: var(--glyph-round);
  height: var(--glyph-round);
  background-color: currentColor;
  color: var(--ink-4);
  mask-repeat: no-repeat;
  mask-position: center;
  mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-position: center;
  -webkit-mask-size: contain;
}

.audio-knob.list .audio-knob-glyph {
  width: var(--h-round-ico);
  height: var(--h-round-ico);
  color: var(--ink-3);
}

