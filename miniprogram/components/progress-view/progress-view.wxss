.overview {
  padding-top: var(--sp-4);
  padding-bottom: var(--sp-3);
}

.ov-head {
  display: flex;
  align-items: center;
  padding-bottom: var(--sp-3);
  border-bottom: 1rpx solid var(--line-2);
}

.ov-main {
  padding-left: var(--sp-3);
  min-width: 0;
}

.ov-title {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-lead);
  color: var(--strong-text);
  letter-spacing: var(--ls-title);
}

.ov-sub {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: var(--sp-1);
}

.ov-row {
  padding-top: var(--sp-3);
}

.ov-row .stat-v {
  font-size: var(--fs-hero);
}

.warn {
  display: block;
  color: var(--amber);
  padding-top: var(--sp-3);
}

.cal {
  display: flex;
  align-items: flex-end;
}

.cal-cell {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--sp-1) 0 var(--sp-1);
  border-radius: var(--radius-sm);
}

.cal-cell.today {
  background: var(--sink);
}

.cal-count {
  height: 30rpx;
  font-family: var(--font-num);
  font-size: var(--fs-caption);
  line-height: 30rpx;
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
}

.cal-cell.has .cal-count,
.cal-cell.today .cal-count {
  color: var(--strong-text);
}

.cal-bar {
  display: flex;
  align-items: flex-end;
  width: 16rpx;
  height: 96rpx;
  margin: var(--sp-1) 0;
  border-radius: var(--radius-pill);
  background: var(--sink);
  overflow: hidden;
}

.cal-bar-fill {
  width: 100%;
  border-radius: var(--radius-pill);
  background: var(--strong);
}

.cal-day {
  font-size: var(--fs-caption);
  color: var(--ink-2);
  line-height: 1.4;
}

.cal-cell.today .cal-day {
  color: var(--strong-text);
}

.cal-date {
  font-size: var(--fs-caption);
  color: var(--ink-4);
  font-variant-numeric: tabular-nums;
  line-height: 1.4;
}

.panel + .panel {
  margin-top: var(--sp-2);
}

.panel-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: var(--sp-1) 0;
}

.panel-when {
  font-family: var(--font-poem);
  font-size: var(--fs-body);
  color: var(--ink-2);
}

.panel-when.today {
  color: var(--strong-text);
}

.panel-when.late {
  color: var(--amber);
}

.panel-date {
  font-family: var(--font-num);
  font-size: var(--fs-caption);
  color: var(--ink-3);
  padding-left: var(--sp-2);
  font-variant-numeric: tabular-nums;
}

.panel-count {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
}

.due {
  display: flex;
  align-items: center;
  padding: var(--sp-2) 0;
  border-top: 1rpx solid var(--line-2);
}

.due-main {
  flex: 1;
  min-width: 0;
}

.due-name {
  display: block;
  font-family: var(--font-poem);
  font-size: var(--fs-body);
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.due-sub {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.due-state {
  flex: none;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  padding-left: var(--sp-2);
}

.due-when {
  flex: none;
  width: 150rpx;
  text-align: right;
  font-size: var(--fs-caption);
  color: var(--strong-text);
  font-variant-numeric: tabular-nums;
}

.due-when.late {
  color: var(--amber);
}

.bar-row {
  display: flex;
  align-items: center;
  padding: var(--sp-1) 0;
}

.bar-row.zero {
  opacity: .45;
}

.bar-label {
  flex: none;
  width: 224rpx;
  font-size: var(--fs-caption);
  color: var(--ink-2);
}

.bar-track {
  flex: 1;
  min-width: 0;
  height: 14rpx;
  border-radius: var(--radius-pill);
  background: var(--sink);
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: var(--radius-pill);
  background: var(--strong);
  transition: width var(--t-move) var(--ease);
}

.bar-count {
  flex: none;
  width: 72rpx;
  text-align: right;
  font-family: var(--font-num);
  font-size: var(--fs-caption);
  color: var(--ink-2);
  font-variant-numeric: tabular-nums;
}

.defer-lead {
  display: block;
  padding-bottom: var(--sp-2);
}



