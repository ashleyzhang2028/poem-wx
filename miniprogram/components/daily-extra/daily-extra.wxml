<view class="de" style="{{themeStyle}}">
  <view class="de-limit hint" wx:if="{{count}}">今天已加 {{count}} / {{max}} 首</view>

  <view class="de-suggest" wx:if="{{rows.length}}">
    <view class="de-row" wx:for="{{rows}}" wx:key="id"
          hover-class="row-hover" hover-stay-time="60"
          data-id="{{item.id}}" bindtap="onOpen">

      <view class="de-btn {{item.on ? 'on' : ''}}"
            hover-class="de-btn-hover" hover-stay-time="60"
            data-id="{{item.id}}" catchtap="onToggle"
            aria-label="{{item.on ? '移出今日背诵' : '加入今日背诵'}}">
        <view class="glyph ic-{{item.on ? 'added' : 'add'}}"></view>
      </view>
      <view class="row-main">
        <text class="row-title row-poem">{{item.title}}</text>
        <text class="row-sub">{{item.dynasty}}{{item.author ? ' · ' + item.author : ''}} · {{item.bookName}}</text>
      </view>
      <text class="row-go">›</text>
    </view>
  </view>

  <view class="empty de-empty" wx:if="{{searched && !rows.length}}">
    <text class="empty-text">没找到「{{keyword}}」</text>
    <text class="hint empty-tip">换个篇名、作者或朝代试试</text>
  </view>
</view>
