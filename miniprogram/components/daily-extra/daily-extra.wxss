.de-search {

  margin-bottom: 0;
}

.de-limit {
  display: block;
  padding: var(--sp-2) 0 0;
}

.de-suggest {
  margin-top: var(--sp-2);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  overflow: hidden;
}

.de-row {
  display: flex;
  align-items: center;
  min-height: var(--h-row);
  padding: var(--sp-2) var(--sp-3);
  border-bottom: 1rpx solid var(--line-2);
  transition: background-color var(--t-press);
}

.de-row:last-child {
  border-bottom: none;
}

.de-btn {
  flex: none;
  width: 60rpx;
  height: 60rpx;
  margin-right: var(--sp-3);
  border: 1rpx solid var(--line-strong);
  border-radius: 50%;
  background: var(--surface);
  color: var(--strong-text);
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  transition: background-color var(--t-press), border-color var(--t-press), color var(--t-press);
}

.de-btn.on {
  background: var(--strong);
  border-color: var(--strong);
  color: var(--on-ink);
}

.de-btn-hover {
  transform: scale(.94);
}

.de-glyph {
  font-size: var(--fs-hint);
  line-height: 1;
}

.de-empty {
  padding: var(--sp-4) 0 var(--sp-2);
}
