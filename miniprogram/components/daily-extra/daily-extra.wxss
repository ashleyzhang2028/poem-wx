.de-suggest {
  border-bottom: 1rpx solid var(--line);
}

.de-row {
  display: flex;
  align-items: center;
  min-height: var(--h-row);
  padding: var(--sp-2) var(--sp-3);
  border-bottom: 1rpx solid var(--line-2);
  transition: background-color var(--t-press);
}

.de-row:last-child {
  border-bottom: none;
}

.de-btn {
  flex: none;
  width: 60rpx;
  height: 60rpx;
  margin-right: var(--sp-3);
  box-sizing: border-box;
  border: 1rpx solid transparent;
  border-radius: 50%;
  background: var(--sink);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color var(--t-press), border-color var(--t-press), color var(--t-press);
}

.de-btn .glyph {
  color: var(--ink-2);
}

.de-btn.on {
  background: var(--strong-soft);
  border-color: var(--strong);
}

.de-btn.on .glyph {
  color: var(--strong-text);
}

.de-btn-hover {
  transform: scale(.94);
}

.de-empty {
  padding: var(--sp-4) 0 var(--sp-2);
}
