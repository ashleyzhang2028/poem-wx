.sheet-root {
  position: fixed;
  inset: 0;
  z-index: 60;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.sheet-mask {
  position: absolute;
  inset: 0;
  background: rgba(28, 21, 15, .38);
  animation: sheet-fade .2s var(--ease);
}

.sheet {
  position: relative;
  display: flex;
  flex-direction: column;
  width: 100%;

  max-height: 88vh;
  background: var(--surface);
  border-radius: var(--radius-block) var(--radius-block) 0 0;
  padding: 0 var(--sp-3);
  animation: sheet-up .26s var(--ease);
}

@keyframes sheet-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes sheet-up {
  from { transform: translateY(40rpx); opacity: .4; }
  to { transform: none; opacity: 1; }
}

.sheet-grip {
  width: 48rpx;
  height: 6rpx;
  flex: none;
  margin: var(--sp-2) auto var(--sp-1);
  border-radius: var(--radius-pill);
  background: var(--line-strong);
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex: none;
  min-height: var(--h-btn-mini);
}

.sheet-step {
  font-size: var(--fs-hint);
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
}

.sheet-close {
  width: var(--h-btn-mini);
  height: var(--h-btn-mini);
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--sink);
  transition: background-color var(--t-press);
}

.sheet-close-hover {
  background: var(--line);
}

.sheet-close-t {
  font-size: var(--fs-title);
  color: var(--ink-2);
  line-height: 1;
}

.sheet-body {
  flex: none;
  width: 100%;
}

.sheet-foot {
  flex: none;

  margin-top: auto;
  padding: var(--sp-3) 0 var(--sp-1);
  border-top: 1rpx solid var(--line-2);

  padding-bottom: calc(var(--sp-3) + env(safe-area-inset-bottom));
}

.sheet-prev {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--h-btn-mini);
  margin-top: var(--sp-1);
  border-radius: var(--radius-sm);
  transition: background-color var(--t-press);
}

.sheet-prev-hover {
  background: var(--sink);
}

.sheet-prev-t {
  font-size: var(--fs-hint);
  color: var(--ink-3);
}
