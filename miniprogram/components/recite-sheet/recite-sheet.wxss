.sheet-root {
  position: fixed;
  inset: 0;
  --bar-h: calc(var(--tabbar-h) + var(--sp-2));
  --sheet-max-h: calc(100vh - 96rpx - var(--bar-h));
  z-index: 60;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.sheet-mask {
  position: absolute;
  inset: 0;
  background: rgba(28, 21, 15, .38);
  animation: sheet-fade .2s var(--ease);
}

.sheet {
  position: relative;
  display: flex;
  flex-direction: column;
  width: 100%;

  max-height: var(--sheet-max-h);
  background: var(--surface);
  border-radius: var(--radius-block) var(--radius-block) 0 0;
  padding: 0 var(--sp-3) var(--bar-h);
  animation: sheet-up .26s var(--ease);
}

@keyframes sheet-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes sheet-up {
  from { transform: translateY(40rpx); opacity: .4; }
  to { transform: none; opacity: 1; }
}

.sheet-grip {
  width: 48rpx;
  height: 6rpx;
  flex: none;
  margin: var(--sp-2) auto var(--sp-1);
  border-radius: var(--radius-pill);
  background: var(--line-strong);
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex: none;
  min-height: var(--h-btn-mini);
}

.sheet-step {
  font-size: var(--fs-hint);
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
}

.sheet-close {
  width: var(--h-btn-mini);
  height: var(--h-btn-mini);
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--sink);
  transition: background-color var(--t-press);
}

.sheet-close-hover {
  background: var(--line);
}

.sheet-close-x {
  position: relative;
  flex: none;
  width: 16rpx;
  height: 16rpx;
}

.sheet-close-x::before,
.sheet-close-x::after {
  content: "";
  position: absolute;
  top: 50%;
  left: 0;
  width: 100%;
  height: 1px;
  margin-top: -.5px;
  background: var(--ink-2);
}

.sheet-close-x::before {
  transform: rotate(45deg);
}

.sheet-close-x::after {
  transform: rotate(-45deg);
}

.sheet-body {
  flex: 1;
  min-height: 0;
  width: 100%;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.sheet-foot {
  flex: none;
  padding: var(--sp-3) 0 var(--sp-2);
}

.sheet-tail {
  display: flex;
  align-items: stretch;
  gap: var(--sp-2);
  margin-top: var(--sp-3);
}

.sheet-step-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--h-btn-mini);
  border-radius: var(--radius-pill);
  background: var(--sink);
  transition: background-color var(--t-press), opacity var(--t-press);
}

.sheet-step-btn.prev,
.sheet-step-btn.next {
  flex: 0 0 auto;
  padding: 0 var(--sp-3);
}

.sheet-step-btn .glyph {
  margin-right: var(--sp-1);
}

.sheet-step-btn.on {
  background: var(--strong-soft);
}

.sheet-step-btn.on .sheet-step-t {
  color: var(--strong-text);
}

.sheet-step-hover {
  background: var(--line);
}

.sheet-step-btn.off {
  opacity: .4;
  pointer-events: none;
}

.sheet-step-t {
  font-size: var(--fs-hint);
  color: var(--ink-2);
}

.sheet-head,
.sheet-body,
.sheet-foot {
  width: 100%;
}

.sheet-foot .chip-group.actions {
  margin-top: var(--sp-2);
}

.poem-loading {
  position: relative;
  height: 2rpx;
  margin-top: var(--sp-2);
  border-radius: var(--radius-pill);
  background: var(--line);
  overflow: hidden;
}

.poem-loading::after {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 40%;
  height: 100%;
  border-radius: var(--radius-pill);
  background: var(--strong);
  animation: poem-loading 1.1s var(--ease) infinite;
}

@keyframes poem-loading {
  from { transform: translateX(-100%); }
  to { transform: translateX(250%); }
}

.poem-miss {
  padding: var(--sp-6) var(--sp-2);
  text-align: center;
  font-family: var(--font-ui);
}

.poem-miss-t {
  display: block;
}

.poem-miss-btn {
  display: flex;
  margin: var(--sp-3) auto 0;
  width: 220rpx;
  height: var(--h-btn);
  font-size: var(--fs-body);
}

.note-card {
  margin-top: var(--sp-3);
}

