.rs-root {
  position: fixed;
  inset: 0;
  z-index: 60;
  display: flex;
  align-items: flex-start;
}

.rs-mask {
  position: absolute;
  inset: 0;
  background: rgba(28, 21, 15, .38);
  animation: rs-fade .2s var(--ease);
}

.rs {
  position: relative;
  display: flex;
  flex-direction: column;
  width: 100%;
  max-height: calc(100vh - var(--tabbar-h) - 64rpx);
  box-sizing: border-box;
  padding: var(--sp-2) var(--sp-3) var(--sp-3);
  background: var(--surface);
  border-radius: 0 0 var(--radius-block) var(--radius-block);
  animation: rs-up .24s var(--ease);
}

@keyframes rs-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes rs-up {
  from { transform: translateY(-100%); }
  to { transform: translateY(0); }
}

.rs-grip {
  width: 48rpx;
  height: 6rpx;
  flex: none;
  margin: 0 auto var(--sp-2);
  border-radius: var(--radius-pill);
  background: var(--line-strong);
}

.rs-head {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: var(--h-btn-mini);
}

.rs-head-right {
  flex: none;
  display: flex;
  align-items: center;
}

.rs-title {
  font-size: var(--fs-hint);
  color: var(--ink-3);
  letter-spacing: var(--ls-caption);
}

.rs-close {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--h-btn-mini);
  height: var(--h-btn-mini);
  border-radius: 50%;
  background: var(--sink);
  transition: background-color var(--t-press);
}

.rs-close-hover {
  background: var(--line);
}

.rs-close-x {
  position: relative;
  flex: none;
  width: 16rpx;
  height: 16rpx;
}

.rs-close-x::before,
.rs-close-x::after {
  content: "";
  position: absolute;
  top: 50%;
  left: 0;
  width: 100%;
  height: 1px;
  margin-top: -.5px;
  background: var(--ink-2);
}

.rs-close-x::before {
  transform: rotate(45deg);
}

.rs-close-x::after {
  transform: rotate(-45deg);
}

.rs-body {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.rs-row {
  display: flex;
  align-items: center;
  min-height: var(--h-row);
  padding: 0 var(--sp-1);
  border-radius: var(--radius-sm);
  transition: background-color var(--t-press);
}

.rs-row-hover,
.rs-more-hover {
  background: var(--sink);
}

.rs-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-family: var(--font-poem);
  font-size: var(--fs-body);
  color: var(--ink);
}

.rs-tag {
  margin: 0 0 0 var(--sp-2);
}

.rs-meta {
  flex: none;
  max-width: 45%;
  margin-left: var(--sp-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

.rs-more {
  flex: none;
  margin-right: var(--sp-2);
  padding: var(--sp-1) var(--sp-2);
  border-radius: var(--radius-pill);
  transition: background-color var(--t-press);
}

.rs-more-t {
  font-size: var(--fs-hint);
  color: var(--strong-text);
}
