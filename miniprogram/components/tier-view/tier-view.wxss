.grant {
  margin-top: var(--sp-3);
}

.grant-eyebrow {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

.grant-tier-name {
  display: block;
  margin-top: var(--sp-1);
  font-family: var(--font-poem);
  font-size: var(--fs-hero);
  color: var(--strong-text);
  letter-spacing: var(--ls-title);
  line-height: var(--lh-tight);
}

.note {
  display: block;
  margin-top: var(--sp-1);
}

.grant-meter {
  margin-top: var(--sp-4);
}

.grant-meter-t {
  display: block;
  margin-top: var(--sp-2);
  font-size: var(--fs-caption);
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
}

.chips {
  display: flex;
  gap: var(--sp-2);
  margin-top: var(--sp-4);
}

.chip {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--sp-2) 0;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-ctl);
}

.chip.is-now {
  border-color: var(--green);
  background: var(--green-soft);
}

.chip-name {
  font-size: var(--fs-hint);
  color: var(--ink-2);
}

.chip.is-now .chip-name {
  color: var(--green);
}

.chip-count {
  margin-top: 4rpx;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
}

.cap-tag {
  margin-right: 0;
  margin-left: var(--sp-2);
}
