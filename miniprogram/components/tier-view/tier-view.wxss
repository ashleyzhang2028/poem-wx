.grant {
  margin-top: var(--sp-3);
}

.grant-top {
  display: block;
}

.grant-eyebrow {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

.grant-tier-name {
  display: block;
  margin-top: var(--sp-1);
  font-family: var(--font-ui);
  font-size: var(--fs-hero);
  color: var(--strong-text);
  letter-spacing: var(--ls-title);
  line-height: var(--lh-tight);
}

.guest-note {
  display: block;
  margin-top: var(--sp-1);
  font-size: var(--fs-hint);
  color: var(--ink-3);
  line-height: var(--lh-body);
}

.grant-meter {
  margin-top: var(--sp-4);
}

.grant-meter-t {
  display: block;
  margin-top: var(--sp-2);
  font-size: var(--fs-caption);
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
  text-align: center;
}

.tier-table {
  margin-top: var(--sp-2);
}

.tier-line {
  display: flex;
  align-items: center;
  padding: var(--sp-2) 0;
  border-top: 1rpx solid var(--line);
}

.tier-line:first-child {
  border-top: 0;
}

.tier-head {
  padding-bottom: var(--sp-1);
}

.tier-head .tier-cap,
.tier-head .tier-cell-t {
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

.tier-cap {
  flex: 0 0 38%;
  min-width: 0;
  padding-right: var(--sp-2);
  font-size: var(--fs-hint);
  color: var(--ink-2);
  line-height: 1.4;
}

.tier-cell {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 0 2rpx;
}

.tier-cell-t {
  font-size: var(--fs-hint);
  color: var(--ink-4);
  font-variant-numeric: tabular-nums;
}

.tier-cell-t.yes {
  color: var(--ink-2);
}

.tier-cell.is-now .tier-cell-t:not(.no) {
  color: var(--on-ink);
}

.tier-cell-n {
  font-size: var(--fs-caption);
  color: var(--ink-4);
}

.tier-cell-ic {
  width: var(--glyph-round);
  height: var(--glyph-round);
  color: var(--ink-4);
  background-color: currentColor;
  mask-repeat: no-repeat;
  mask-position: center;
  mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-position: center;
  -webkit-mask-size: contain;
}

.tier-cell-ic.no {
  color: var(--ink-4);
}

.tier-cell-ic.yes {
  color: var(--ink-2);
}

.tier-cell.is-now .tier-cell-ic {
  box-sizing: border-box;
  padding: var(--glyph-edge);
  border-radius: 50%;
  background: var(--strong);
}

.tier-cell.is-now .tier-cell-ic:not(.no) {
  color: var(--on-ink);
}

.tier-head .tier-cell.is-now::after {
  content: "";
  display: block;
  width: 16rpx;
  height: 3rpx;
  margin-top: 4rpx;
  border-radius: var(--radius-pill);
  background: var(--strong);
}
