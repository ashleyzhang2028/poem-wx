<view class="card grant">
  <view class="grant-top">
    <text class="grant-eyebrow">当前档位</text>
    <text class="grant-tier-name">{{status.label}}</text>
    <text class="guest-note" wx:if="{{!logged}}">未登录 · 暂按 Free</text>
    <text class="guest-note" wx:elif="{{note}}">{{note}}</text>
  </view>

  <view class="meter grant-meter">
    <view class="meter-fill" style="width:{{stats.percent}}%"></view>
  </view>
  <text class="grant-meter-t">已开 {{stats.enabled}} / {{stats.caps}} 项功能</text>
</view>

<view class="card">
  <view class="card-title">权限对比</view>

  <view class="tier-table">
    <view class="tier-line tier-head">
      <text class="tier-cap">功能</text>
      <view class="tier-cell {{col.now ? 'is-now' : ''}}" wx:for="{{heads}}" wx:for-item="col" wx:key="tier">
        <text class="tier-cell-t">{{col.label}}</text>
      </view>
    </view>

    <view class="tier-line" wx:for="{{compareRows}}" wx:key="cap">
      <text class="tier-cap">{{item.name}}</text>
      <view class="tier-cell {{cell.now ? 'is-now' : ''}}" wx:for="{{item.cells}}" wx:for-item="cell" wx:key="tier">
        <text class="tier-cell-t {{cell.cls}}" wx:if="{{cell.text}}">{{cell.text}}</text>
        <view class="tier-cell-ic {{cell.cls}}"
              style="mask-image:url('{{cell.icon}}');-webkit-mask-image:url('{{cell.icon}}');"></view>
        <text class="tier-cell-n" wx:if="{{cell.note}}">{{cell.note}}</text>
      </view>
    </view>
  </view>
</view>
