<view class="card grant">
  <text class="grant-eyebrow">当前档位</text>
  <text class="grant-tier-name">{{status.label}}</text>
  <text class="hint note" wx:if="{{!logged}}">未登录 · 暂按 Free</text>
  <text class="hint note" wx:elif="{{note}}">{{note}}</text>

  <view class="meter grant-meter">
    <view class="meter-fill" style="width:{{stats.percent}}%"></view>
  </view>
  <text class="grant-meter-t">已开 {{stats.enabled}} / {{stats.caps}} 项能力</text>

  <view class="chips">
    <view class="chip {{col.now ? 'is-now' : ''}}" wx:for="{{heads}}" wx:for-item="col" wx:key="tier">
      <text class="chip-name">{{col.label}}</text>
      <text class="chip-count">{{col.on}} / {{col.total}}</text>
    </view>
  </view>
</view>

<view class="card" wx:for="{{compareGroups}}" wx:key="key">
  <view class="card-title bar">{{item.note}}</view>
  <view class="row row-flush" wx:for="{{item.rows}}" wx:for-item="r" wx:key="cap">
    <view class="row-main">
      <text class="row-title">{{r.name}}</text>
      <text class="row-sub">{{r.desc}}</text>
    </view>
    <text class="tag {{r.ok ? 'green' : 'ghost'}} cap-tag">{{r.ok ? '可用' : '未开'}}</text>
  </view>
</view>
