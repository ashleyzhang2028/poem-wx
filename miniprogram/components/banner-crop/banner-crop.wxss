.bc-root {
  position: fixed;
  inset: 0;
  z-index: 90;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--sp-3);
}

.bc-mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, .45);
}

.bc-panel {
  position: relative;
  width: 100%;
  max-width: 640px;
  box-sizing: border-box;
  padding: var(--sp-4);
  border-radius: var(--radius);
  background: var(--surface);
}

.bc-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--sp-2);
  margin-bottom: var(--sp-3);
}

.bc-title {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-title);
  color: var(--strong-text);
  line-height: var(--lh-tight);
}

.bc-ratio {
  flex: none;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  letter-spacing: var(--ls-caption);
}

.bc-stage {
  position: relative;
  margin: 0 auto;
  overflow: hidden;
  border-radius: var(--radius-sm);
  background: var(--sink);
}

.bc-img {
  position: absolute;
  left: 0;
  top: 0;
  display: block;
}

.bc-frame {
  position: absolute;
  inset: 0;
  pointer-events: none;
  box-shadow: inset 0 0 0 1rpx var(--line-strong);
  border-radius: var(--radius-sm);
}

.bc-stage-touch {
  position: absolute;
  inset: 0;
}

.bc-acts {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
  margin-top: var(--sp-3);
}

.bc-acts .btn.mini {
  flex: 1;
  min-width: 0;
  padding: 0;
}

.bc-canvas {
  position: fixed;
  top: 0;
  left: 0;
  width: 1px;
  height: 1px;
  opacity: 0;
  pointer-events: none;
}
