<view class="cp-mask" wx:if="{{open}}" bindtap="onMask">
  <view class="cp" catchtap="onStop" style="{{themeStyle}}">
    <view class="cp-head">
      <text class="cp-title">收进自选集</text>
      <view class="cp-close" hover-class="cp-close-hover" hover-stay-time="60" bindtap="close">
        <view class="cp-close-x"></view>
      </view>
    </view>
    <text class="hint cp-sub" wx:if="{{title}}">{{title}}</text>

    <view class="cp-list">
      <view class="row row-flush cp-row" hover-class="row-hover" hover-stay-time="60"
            wx:for="{{rows}}" wx:key="id"
            data-id="{{item.id}}" data-name="{{item.name}}" bindtap="onPick">
        <view class="row-main">
          <text class="row-title">{{item.name}}</text>
          <text class="row-sub">{{item.has ? '已经在里面' : item.count + ' 首 / ' + itemsMax + ' 首'}}</text>
        </view>
        <text class="row-state {{item.has ? 'on' : 'idle'}}">{{item.has ? '已收' : '收进'}}</text>
      </view>

      <view class="empty cp-empty" wx:if="{{!rows.length}}">
        <text class="empty-text say">还没有自选集合</text>
        <text class="hint empty-tip">在下面新建一个，把这首收进去</text>
      </view>
    </view>

    <view class="cp-create" wx:if="{{creating}}">
      <input class="cp-input" value="{{draft}}" placeholder="新集合的名字" maxlength="12" bindinput="onDraft" />
      <button class="btn mini primary" bindtap="onSubmitCreate">创建并收录</button>
    </view>
    <button class="btn ghost block cp-new" wx:else bindtap="onStartCreate">新建一个集合</button>

    <button class="btn ghost block cp-dismiss" bindtap="close">先不收了</button>
  </view>
</view>

<view class="cp-mask" wx:if="{{tierOpen}}" bindtap="onTierClose">
  <view class="cp cp-tier" catchtap="onStop" style="{{themeStyle}}">
    <tier-view />
    <button class="btn ghost block cp-dismiss" bindtap="onTierClose">取消</button>
  </view>
</view>
