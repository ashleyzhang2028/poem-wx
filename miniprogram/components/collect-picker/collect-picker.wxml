<view class="cp-mask" wx:if="{{open}}" bindtap="onMask">
  <view class="cp" catchtap="onStop" style="{{themeStyle}}">
    <view class="cp-head">
      <text class="cp-title">加入自选集</text>
      <text class="cp-count">已建 {{total}} / {{cap}} 个</text>
      <view class="cp-close" hover-class="cp-close-hover" hover-stay-time="60" bindtap="close">
        <view class="cp-close-x"></view>
      </view>
    </view>

    <text class="hint cp-sub" wx:if="{{title}}">{{title}}</text>

    <view class="cp-list">
      <view class="cp-row" hover-class="row-hover" hover-stay-time="60"
            wx:for="{{rows}}" wx:key="id"
            data-id="{{item.id}}" data-name="{{item.name}}" bindtap="onPick">
        <view class="cp-main">
          <text class="cp-name">{{item.name}}</text>
          <text class="cp-meta">{{item.meta}}</text>
        </view>
        <text class="cp-state {{item.has ? 'on' : ''}}">{{item.has ? '已加入' : '加入'}}</text>
      </view>

      <view class="empty cp-empty" wx:if="{{!rows.length}}">
        <text class="empty-text say">还没有自选集合</text>
        <text class="hint empty-tip">在「我的 → 自选背诵」新建，加入此首</text>
      </view>
    </view>

    <view class="cp-foot" wx:if="{{rows.length}}">
      <view class="cp-new" hover-class="cp-new-hover" hover-stay-time="60" bindtap="onNew">
        <view class="cp-new-plus"></view>
        <text class="cp-new-text" wx:if="{{total < cap}}">新建集合，加入此首</text>
        <text class="cp-new-text" wx:elif="{{cap}}">已建满 {{cap}} 个，删掉一个才能再建</text>
        <text class="cp-new-text" wx:else>当前档位还不能建集合</text>
      </view>
    </view>
  </view>
</view>
