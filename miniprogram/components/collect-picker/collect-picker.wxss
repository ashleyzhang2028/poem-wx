.cp-mask {
  position: fixed;
  inset: 0;
  z-index: 60;
  background: rgba(0, 0, 0, .35);
  display: flex;
  align-items: flex-end;
}

.cp {
  width: 100%;
  max-height: 80vh;
  box-sizing: border-box;
  padding: var(--sp-4) var(--sp-4) calc(var(--sp-4) + env(safe-area-inset-bottom));
  background: var(--surface);
  border-radius: var(--radius) var(--radius) 0 0;
  overflow-y: auto;
}

.cp-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
}

.cp-close {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--h-btn-mini);
  height: var(--h-btn-mini);
  border-radius: 50%;
  background: var(--sink);
  transition: background-color var(--t-press);
}

.cp-close-hover {
  background: var(--line);
}

.cp-close-x {
  position: relative;
  flex: none;
  width: 16rpx;
  height: 16rpx;
}

.cp-close-x::before,
.cp-close-x::after {
  content: "";
  position: absolute;
  top: 50%;
  left: 0;
  width: 100%;
  height: 1px;
  margin-top: -.5px;
  background: var(--ink-2);
}

.cp-close-x::before {
  transform: rotate(45deg);
}

.cp-close-x::after {
  transform: rotate(-45deg);
}

.cp-title {
  display: block;
  font-size: var(--fs-title);
  color: var(--strong-text);
}

.cp-sub {
  display: block;
  margin-top: var(--sp-1);
}

.cp-list {
  margin: var(--sp-3) 0;
}

.cp-row {
  border-bottom: 1rpx solid var(--line-2);
}

.cp-empty {
  padding: var(--sp-4) 0;
}

.cp-create {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  margin-bottom: var(--sp-2);
}

.cp-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 var(--sp-3);
  box-sizing: border-box;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--sink);
  font-size: var(--fs-body);
}

.cp-new,
.cp-dismiss {
  margin-top: var(--sp-2);
}

.cp-tier {
  max-height: 86vh;
}
