.cp-mask {
  position: fixed;
  inset: 0;
  z-index: 60;
  background: rgba(0, 0, 0, .35);
  display: flex;
  align-items: flex-end;
}

.cp {
  --bar-h: calc(var(--tabbar-h) + var(--sp-2));
  position: relative;
  display: flex;
  flex-direction: column;
  width: 100%;
  max-height: calc(100vh - 96rpx - var(--bar-h));
  box-sizing: border-box;
  padding: var(--sp-4) var(--sp-4) 0;
  background: var(--surface);
  border-radius: var(--radius) var(--radius) 0 0;
}

.cp-head {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
}

.cp-close {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--h-btn-mini);
  height: var(--h-btn-mini);
  border-radius: 50%;
  background: var(--sink);
  transition: background-color var(--t-press);
}

.cp-close-hover {
  background: var(--line);
}

.cp-close-x {
  position: relative;
  flex: none;
  width: 16rpx;
  height: 16rpx;
}

.cp-close-x::before,
.cp-close-x::after {
  content: "";
  position: absolute;
  top: 50%;
  left: 0;
  width: 100%;
  height: 1px;
  margin-top: -.5px;
  background: var(--ink-2);
}

.cp-close-x::before {
  transform: rotate(45deg);
}

.cp-close-x::after {
  transform: rotate(-45deg);
}

.cp-title {
  flex: 1;
  min-width: 0;
  display: block;
  font-size: var(--fs-title);
  color: var(--strong-text);
}

.cp-count {
  flex: none;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  letter-spacing: var(--ls-caption);
}

.cp-sub {
  flex: none;
  display: block;
  margin-top: var(--sp-1);
}

.cp-list {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  margin-top: var(--sp-2);
}

.cp-row {
  display: flex;
  align-items: center;
  min-height: var(--h-row);
  padding: var(--sp-2) 0;
  border-bottom: 1rpx solid var(--line-2);
  transition: background-color var(--t-press);
}

.cp-row:last-child {
  border-bottom: none;
}

.cp-main {
  flex: 1;
  min-width: 0;
}

.cp-name {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-family: var(--font-poem);
  font-size: var(--fs-title);
  color: var(--ink);
}

.cp-meta {
  display: block;
  margin-top: 6rpx;
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

.cp-state {
  flex: none;
  margin-left: var(--sp-3);
  padding: var(--pad-opt-y) var(--pad-opt-x);
  border-radius: var(--radius-pill);
  background: var(--sink);
  font-size: var(--fs-caption);
  line-height: 1.5;
  white-space: nowrap;
  color: var(--strong-text);
}

.cp-state.on {
  background: transparent;
  color: var(--ink-3);
}

.cp-empty {
  padding: var(--sp-4) 0;
}

.cp-foot {
  flex: none;
  padding: var(--sp-2) 0 var(--bar-h);
}

.cp-new {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--sp-2);
  height: var(--h-row);
  border: 1rpx dashed var(--line-strong);
  border-radius: var(--radius);
  transition: background-color var(--t-press);
}

.cp-new-hover {
  background: var(--sink);
}

.cp-new-plus {
  position: relative;
  flex: none;
  width: 24rpx;
  height: 24rpx;
}

.cp-new-plus::before,
.cp-new-plus::after {
  content: "";
  position: absolute;
  top: 50%;
  left: 0;
  width: 100%;
  height: 2px;
  margin-top: -1px;
  background: var(--ink-3);
}

.cp-new-plus::after {
  transform: rotate(90deg);
}

.cp-new-text {
  font-size: var(--fs-hint);
  color: var(--ink-2);
}
