.dock {
  position: fixed;
  right: var(--sp-4);
  bottom: calc(var(--tabbar-h) + var(--sp-4));
  z-index: 90;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: var(--sp-2);
}

.dock.above {
  bottom: calc(env(safe-area-inset-bottom) + var(--sp-4));
}

.dock-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: -1;
  background: rgba(0, 0, 0, .06);
  opacity: 0;
  pointer-events: none;
  transition: opacity var(--t-move) var(--ease);
}

.dock-mask.in {
  opacity: 1;
  pointer-events: auto;
}

.dock-item {
  flex: none;
  opacity: 0;
  transform: translateY(28rpx) scale(.6);
  transition-delay: 0s;
  transform-origin: 100% 100%;
  pointer-events: none;
  visibility: hidden;
  transition: opacity var(--t-move) var(--ease),
    transform var(--t-move) var(--ease),
    visibility 0s linear var(--t-move);
}

.dock-item.in {
  opacity: 1;
  transform: none;
  pointer-events: auto;
  visibility: visible;
  transition: opacity var(--t-move) var(--ease),
    transform var(--t-move) var(--ease),
    visibility 0s;
}

.dock-item.in:nth-child(4) {
  transition-delay: .12s;
}

.dock-item.in:nth-child(3) {
  transition-delay: .06s;
}

.dock-fly {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: var(--sp-2);
}

.dock-label {
  flex: none;
  font-size: var(--fs-caption);
  color: var(--ink-2);
  letter-spacing: var(--ls-caption);
  background: var(--surface);
  border-radius: var(--radius-pill);
  padding: 4rpx var(--sp-2);
}

.dock-face {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--h-dock);
  height: var(--h-dock);
  border-radius: 50%;
  background: var(--surface);
  border: 1rpx solid var(--line);
  transition: background-color var(--t-press), border-color var(--t-press);
}

.dock-glyph {
  width: 44rpx;
  height: 44rpx;
  background-color: currentColor;
  color: var(--ink-2);
  mask-repeat: no-repeat;
  mask-position: center;
  mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-position: center;
  -webkit-mask-size: contain;
}

.dock-item.on .dock-face {
  background: var(--strong-soft);
  border-color: var(--strong);
}

.dock-item.on .dock-glyph {
  color: var(--strong-text);
}

.dock-item-hover .dock-face {
  background: var(--sink);
}

.dock-trigger {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--h-dock);
  height: var(--h-dock);
  border-radius: 50%;
  background: var(--strong);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, .16);
  transition: transform var(--t-press) var(--ease), background-color var(--t-press);
}

.dock-trigger-hover {
  transform: scale(.94);
}

.dock-trigger-glyph {
  width: 44rpx;
  height: 44rpx;
  background-color: currentColor;
  color: var(--on-theme);
  mask-repeat: no-repeat;
  mask-position: center;
  mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-position: center;
  -webkit-mask-size: contain;
}
