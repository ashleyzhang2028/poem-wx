.dock {
  position: fixed;
  right: var(--sp-4);
  bottom: calc(var(--tabbar-h) + var(--sp-4));
  z-index: 10001;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: var(--sp-2);
}

.dock-mask {
  position: absolute;
  left: -200vw;
  top: -200vh;
  right: -200vw;
  bottom: -200vh;
  z-index: -1;
  pointer-events: none;
}

.dock-mask.in {
  pointer-events: auto;
}

.dock-panel {
  width: 520rpx;
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
  padding: var(--sp-3);
  border-radius: var(--radius-block);
  background: var(--surface);
  border: 1rpx solid var(--line);
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, .1);
  opacity: 0;
  transform: translateY(24rpx) scale(.92);
  transform-origin: 100% 100%;
  pointer-events: none;
  visibility: hidden;
  transition: opacity var(--t-move) var(--ease),
    transform var(--t-move) var(--ease),
    visibility 0s linear var(--t-move);
}

.dock-panel.in {
  opacity: 1;
  transform: none;
  pointer-events: auto;
  visibility: visible;
  transition: opacity var(--t-move) var(--ease),
    transform var(--t-move) var(--ease),
    visibility 0s;
}

.dock-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  opacity: 0;
  transform: translateY(12rpx);
  transition: opacity var(--t-press) var(--ease), transform var(--t-press) var(--ease);
}

.dock-panel.in .dock-row {
  opacity: 1;
  transform: none;
  transition: opacity var(--t-move) var(--ease), transform var(--t-move) var(--ease);
}

.dock-panel.in .dock-row:nth-child(3) { transition-delay: .04s; }
.dock-panel.in .dock-row:nth-child(2) { transition-delay: .08s; }
.dock-panel.in .dock-row:nth-child(1) { transition-delay: .12s; }

.dock-swatch {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 1rpx solid var(--line-strong);
  box-sizing: border-box;
  transition: transform var(--t-press) var(--ease), box-shadow var(--t-press);
}

.dock-swatch.on {
  box-shadow: 0 0 0 4rpx var(--surface), 0 0 0 6rpx var(--strong);
  transform: scale(1.05);
}

.dock-seg {
  display: flex;
  align-items: center;
  flex: none;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  overflow: hidden;
}

.dock-tool {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: var(--h-pref);
  transition: background-color var(--t-press), opacity var(--t-press);
}

.dock-tool.off {
  opacity: .35;
}

.dock-tool.on {
  background: var(--strong-soft);
}

.dock-tool-hover {
  background: var(--sink);
}

.dock-tool-glyph,
.dock-glyph,
.dock-trigger-glyph {
  background-color: currentColor;
  mask-repeat: no-repeat;
  mask-position: center;
  mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-position: center;
  -webkit-mask-size: contain;
}

.dock-tool-glyph {
  width: 36rpx;
  height: 36rpx;
  color: var(--ink-3);
}

.dock-tool.on .dock-tool-glyph {
  color: var(--strong-text);
}

.dock-round {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--h-dock);
  height: var(--h-dock);
  border-radius: 50%;
  background: var(--sink);
  transition: background-color var(--t-press), transform var(--t-press) var(--ease);
}

.dock-glyph {
  width: 28rpx;
  height: 28rpx;
  color: var(--ink-2);
}

.dock-round.on {
  background: var(--strong);
}

.dock-round.on .dock-glyph {
  color: var(--on-theme);
}

.dock-round-hover {
  transform: scale(.94);
}

.dock-trigger {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: var(--h-dock);
  height: var(--h-dock);
  border-radius: 50%;
  background: var(--read-bg, var(--bg));
  border: 1rpx solid var(--ink-3);
  transition: transform var(--t-press) var(--ease), background-color var(--t-press),
    border-color var(--t-press), box-shadow var(--t-press);
}

.dock-trigger-hover,
.dock-trigger.drag {
  background: var(--strong);
  border-color: var(--strong);
}

.dock-trigger-hover {
  transform: scale(.94);
}

.dock-trigger.drag {
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, .18);
}

.dock-trigger-glyph {
  width: 30rpx;
  height: 30rpx;
  color: var(--ink-3);
  transition: color var(--t-press);
}

.dock-trigger-hover .dock-trigger-glyph,
.dock-trigger.drag .dock-trigger-glyph {
  color: var(--on-theme);
}
