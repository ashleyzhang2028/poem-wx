:host {
  display: block;
}

.audio-bar {
  position: fixed;
  left: var(--sp-3);
  right: var(--sp-3);
  bottom: calc(var(--tabbar-h) + var(--sp-2));
  z-index: 55;
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  padding: var(--sp-2) var(--sp-3);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-block);
  background: var(--surface-glass);
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, .1);
  animation: audio-bar-up .22s var(--ease);
}

@keyframes audio-bar-up {
  from { transform: translateY(24rpx); opacity: 0; }
  to { transform: none; opacity: 1; }
}

.audio-bar-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: var(--sp-2);
}

.audio-bar-disc {
  position: relative;
  flex: none;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--sink);
}

.audio-bar-disc-img {
  display: block;
  width: 100%;
  height: 100%;
  animation: audio-bar-spin 12s linear infinite;
}

.audio-bar-disc.paused .audio-bar-disc-img {
  animation-play-state: paused;
}

@keyframes audio-bar-spin {
  to { transform: rotate(360deg); }
}

.audio-bar-disc-hole {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 28%;
  height: 28%;
  margin: -14% 0 0 -14%;
  box-sizing: border-box;
  border: 1rpx solid rgba(0, 0, 0, .08);
  border-radius: 50%;
  background: var(--surface);
}

.audio-bar-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.audio-bar-title {
  font-family: var(--font-poem);
  font-size: var(--fs-title);
  line-height: var(--lh-tight);
  color: var(--strong-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.audio-bar-next {
  font-size: var(--fs-caption);
  line-height: var(--lh-tight);
  color: var(--ink-3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.audio-bar-acts {
  flex: none;
  display: flex;
  align-items: center;
  gap: var(--sp-1);
}

.audio-bar-btn {
  box-sizing: border-box;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid transparent;
  border-radius: 50%;
  transition: background-color var(--t-press), border-color var(--t-press), color var(--t-press);
}

.audio-bar-btn-hover {
  background: var(--sink);
}

.audio-bar-glyph {
  width: 40rpx;
  height: 40rpx;
  background-color: currentColor;
  color: var(--ink-3);
  mask-repeat: no-repeat;
  mask-position: center;
  mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-position: center;
  -webkit-mask-size: contain;
}

.audio-bar-btn.mode.on .audio-bar-glyph {
  color: var(--strong-text);
}

.audio-bar-btn.play .audio-bar-glyph {
  color: var(--strong-text);
}
