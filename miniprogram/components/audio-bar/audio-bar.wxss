:host {
  display: block;
}

.audio-bar {
  position: fixed;
  left: var(--sp-3);
  right: var(--sp-3);
  bottom: calc(var(--tabbar-h) + var(--sp-2));
  z-index: 55;
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  padding: var(--sp-2) var(--sp-3) var(--sp-2) var(--sp-2);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-pill);
  background: var(--surface-glass);
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, .12), 0 0 0 1rpx var(--line-2);
  animation: audio-bar-up .22s var(--ease);
}

@keyframes audio-bar-up {
  from { transform: translateY(24rpx); opacity: 0; }
  to { transform: none; opacity: 1; }
}

.audio-bar-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: var(--sp-2);
}

.audio-bar-disc {
  position: relative;
  flex: none;
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--sink);
  box-shadow: 0 0 0 4rpx var(--surface), 0 0 0 5rpx var(--theme);
}

.audio-bar-disc-img {
  display: block;
  width: 100%;
  height: 100%;
  animation: audio-bar-spin 12s linear infinite;
}

.audio-bar-disc.paused .audio-bar-disc-img {
  animation-play-state: paused;
}

@keyframes audio-bar-spin {
  to { transform: rotate(360deg); }
}

.audio-bar-disc-hole {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 28%;
  height: 28%;
  margin: -14% 0 0 -14%;
  box-sizing: border-box;
  border: 1rpx solid rgba(0, 0, 0, .08);
  border-radius: 50%;
  background: var(--surface);
}

.audio-bar-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.audio-bar-title {
  font-family: var(--font-poem);
  font-size: var(--fs-title);
  line-height: var(--lh-tight);
  color: var(--strong-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.audio-bar-next {
  font-size: var(--fs-caption);
  line-height: var(--lh-tight);
  color: var(--ink-3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.audio-bar-acts {
  flex: none;
  display: flex;
  align-items: center;
  gap: var(--sp-1);
}

.audio-bar-btn {
  box-sizing: border-box;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid transparent;
  border-radius: 50%;
  transition: background-color var(--t-press), border-color var(--t-press), color var(--t-press);
}

.audio-bar-btn-hover {
  background: var(--sink);
}

.audio-bar-glyph {
  width: 40rpx;
  height: 40rpx;
  background-color: currentColor;
  color: var(--ink-3);
  mask-repeat: no-repeat;
  mask-position: center;
  mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-position: center;
  -webkit-mask-size: contain;
}

.audio-bar-btn.mode.on .audio-bar-glyph {
  color: var(--strong-text);
}

.audio-bar-btn.play {
  width: 76rpx;
  height: 76rpx;
  margin: 0 var(--sp-1);
  background: var(--theme);
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, .16);
}

.audio-bar-btn.play.audio-bar-btn-hover {
  opacity: .85;
}

.audio-bar-btn.play .audio-bar-glyph {
  color: var(--on-ink);
}

.audio-bar-track {
  position: absolute;
  left: var(--sp-5);
  right: var(--sp-5);
  bottom: 0;
  height: 20rpx;
}

.audio-bar-line {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 1rpx;
  background: var(--line-strong);
  transition: height .18s var(--ease);
}

.audio-bar-line.dragging {
  height: 5rpx;
  border-radius: 2.5rpx;
}

.audio-bar-fill {
  height: 100%;
  background: var(--theme);
}

.audio-bar-line:not(.dragging) .audio-bar-fill {
  transition: width .25s linear;
}

.audio-bar-thumb {
  position: absolute;
  bottom: 50%;
  width: 18rpx;
  height: 18rpx;
  margin: 0 0 -9rpx -9rpx;
  border-radius: 50%;
  background: var(--theme);
  box-shadow: 0 0 0 6rpx var(--surface), 0 4rpx 12rpx rgba(0, 0, 0, .2);
  opacity: 0;
  transform: scale(.2);
  transition: opacity .15s var(--ease), transform .2s var(--ease);
}

.audio-bar-line.dragging .audio-bar-thumb {
  opacity: 1;
  transform: scale(1);
}
