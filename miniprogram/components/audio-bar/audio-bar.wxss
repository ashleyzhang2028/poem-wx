:host {
  display: block;
}

.audio-bar {
  position: fixed;
  left: var(--sp-3);
  right: var(--sp-3);
  bottom: calc(var(--tabbar-h) + var(--sp-2));
  z-index: 55;
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  padding: var(--sp-2) var(--sp-3);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-block);
  background: var(--surface);
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, .1);
  animation: audio-bar-up .22s var(--ease);
}

@keyframes audio-bar-up {
  from { transform: translateY(24rpx); opacity: 0; }
  to { transform: none; opacity: 1; }
}

.audio-bar-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.audio-bar-title {
  font-family: var(--font-poem);
  font-size: var(--fs-body);
  color: var(--strong-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.audio-bar-next {
  font-size: var(--fs-hint);
  color: var(--ink-3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.audio-bar-acts {
  flex: none;
  display: flex;
  align-items: center;
  gap: var(--sp-1);
}

.audio-bar-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: background-color var(--t-press);
}

.audio-bar-btn-hover {
  background: var(--sink);
}

.audio-bar-glyph {
  width: 40rpx;
  height: 40rpx;
  background-color: currentColor;
  color: var(--ink-2);
  mask-repeat: no-repeat;
  mask-position: center;
  mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-position: center;
  -webkit-mask-size: contain;
}

.audio-bar-btn.mode .audio-bar-glyph {
  color: var(--strong-text);
}

.audio-bar-btn.play .audio-bar-glyph {
  color: var(--strong-text);
}
