/* 设计令牌：取自 poem 网页版 css/style.css 的 :root，宋代传统色。
   小程序没有 CSS 变量继承问题，但 WXSS 自定义属性在 app.wxss 全局生效，
   这里只做一处声明，页面不再各自抄一份。

   这一版把「色」之外的几件事也收成令牌：字阶、行高、间距、圆角、投影、动效。
   理由是同一件东西各页各写一遍数值，早晚会漂 —— 色漂了有人管（自检盯着），
   间距漂了没人看得出来，只是整体「说不上哪里不对」。 */
page {
  /* ---------- 色 ---------- */
  --bg: #f6f1e3;            /* 素绢 */
  --bg-soft: #fcfaf3;
  --bg-sink: #f1eaD9;       /* 比底色再沉一档，用于「凹下去」的槽 */
  --card: rgba(255, 254, 250, .90);
  --card-2: #f7f1e1;

  --green: #2f6055;         /* 雨过天青 · 主色 */
  --green-dark: #234b42;
  --green-deep: #1b3a33;    /* 首屏渐变的那一头 */
  --green-light: rgba(47, 96, 85, .09);
  --green-edge: rgba(47, 96, 85, .22);
  --celadon: #4f7a6e;

  --amber: #a55c19;         /* 琥珀 · 复习 */
  --amber-light: #f7e6d0;
  --autumn: #8a7327;        /* 秋香 · 第三组分组标题 */
  --red: #a83b32;           /* 朱砂 · 忘记 */
  --red-light: #f7e5e1;
  --red-edge: #ecd2cd;
  --blue: #3d6379;          /* 天水碧 */
  --blue-light: #dee9ef;
  --gold: #f0cd7c;          /* 缃色 · 进度环 */
  --gold-soft: rgba(240, 205, 124, .34);

  --ink: #241d18;
  --ink-2: #6b5c4d;
  --ink-3: #8a7a68;
  --ink-on-dark: #f3ecdc;   /* 压在主色上的字 */
  --line: #d6c8ad;
  --line-2: #ece3d2;

  /* ---------- 形 ---------- */
  --radius: 24rpx;
  --radius-sm: 16rpx;
  --radius-md: 20rpx;
  --radius-pill: 999rpx;

  --shadow: 0 4rpx 28rpx rgba(74, 58, 38, .10);
  --shadow-up: 0 -4rpx 32rpx rgba(74, 58, 38, .12);
  /* 卡片的第二层：只在首屏那张大卡上用。层数多了就不叫层次，叫脏 */
  --shadow-lift: 0 10rpx 44rpx rgba(47, 96, 85, .16);
  --shadow-press: 0 2rpx 10rpx rgba(74, 58, 38, .10);

  /* ---------- 字 ---------- */
  /* 宋体排正文，黑体排界面 —— 与网页版同一套字体口径。

     小程序端不外挂整套字体文件（一套中文字库 1MB+，主包只剩几百 KB），
     所以「宋体」这件事分两步办：

     1. **先把系统里那个宋体找准**。--font-poem 按平台深浅排一串名字：
        iOS / macOS 有 Songti SC，Windows 有 SimSun，Android 各家 ROM
        把华文宋体、思源宋体、Noto Serif CJK 分别叫 STSong / Source Han Serif /
        Noto Serif CJK SC。名字一个都不能少 —— 少一个，那台机上就
        悄悄退回黑体，而「字体没生效」这件事在界面上看不出来。
        最后兜到 serif（通用族），Android 上通常落 Noto Serif。

     2. **兜不住时用外挂子集补**。真机上若整串名字都没命中（少数
        定制 ROM），app.js 会 wx.loadFontFace 拉一份「篇名子集」的
        思源宋体，注册成 "Kuibu Serif"。它排在系统名字之后、
        通用族之前 —— 系统有就不下载，没有才有一次网络。

     口径与网页版一致：网页版 css/style.css 也是 NotoSerifSC 外挂 +
     系统宋体兜底，这里只是把「先系统、后外挂」的顺序钉死在令牌里。 */
  --font-poem: "Kuibu Serif", "Songti SC", "STSong", "STZhongsong", "Source Han Serif SC",
    "Source Han Serif CN", "Noto Serif CJK SC", "Noto Serif SC", "SimSun", "SimSun-ExtB",
    "FangSong", serif;
  --font-ui: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB",
    "Microsoft YaHei", sans-serif;

  /* 字阶：只留六档。界面里出现的字号都从这里取，
     临时拍一个数值就说明这一处没想清楚要表达什么。 */
  --fs-caption: 22rpx;      /* 脚注、来源、单位 */
  --fs-hint: 25rpx;         /* 说明文字 */
  --fs-body: 28rpx;         /* 界面正文 */
  --fs-title: 31rpx;        /* 列表标题、字段名 */
  --fs-lead: 36rpx;         /* 卡片主标题 */
  --fs-hero: 44rpx;         /* 一屏只有一处的那种大标题 */
  --fs-mark: 52rpx;         /* 印章 / 头像里的那个字 */
  --fs-brand: 72rpx;        /* 品牌名，一页只出现一次 */
  --fs-score: 104rpx;       /* 考试分数，一屏只有它一个 */
  --fs-poem: 36rpx;         /* 诗行基准字号，各档在它上下浮动 */
  --fs-pinyin: 18rpx;       /* 注音的小字 */

  --lh-tight: 1.45;
  --lh-body: 1.7;
  --lh-loose: 1.95;

  /* 字距：中文标题略微放开一点才「稳」，正文不加 */
  --ls-title: 2rpx;
  --ls-caption: 3rpx;

  /* ---------- 距 ---------- */
  --sp-1: 8rpx;
  --sp-2: 16rpx;
  --sp-3: 24rpx;            /* 卡片之间的固定间距 */
  --sp-4: 32rpx;            /* 卡片内边距 */
  --sp-5: 48rpx;
  --sp-6: 64rpx;
  --page-x: 28rpx;

  /* ---------- 高 ----------
     一屏里「能点的那一块」只有三种高度，取这三档就够：
       主按钮 88  —— 一屏最多一两个，是这一屏的正事
       小按钮 60  —— 一行里的小动作（搜索键、开关）
       动作块 88  —— 「忘记 / 模糊 / 记住」这类平铺的动作，
                     与主按钮同高才不会显得笨重

     上一版动作块是 112rpx，比主按钮高出一头半：三个并排像三块砖，
     而它承载的只是两个字。高度一旦各页各写，就会这么漂。 */
  --h-btn: 88rpx;
  --h-btn-mini: 60rpx;
  --h-act: 88rpx;

  /* ---------- 动 ---------- */
  /* 按下就用这个时间：慢了像卡，快了像没反应 */
  --t-press: .12s;
  --t-move: .28s;
  --ease: cubic-bezier(.22, .61, .36, 1);

  background: var(--bg);
  color: var(--ink);
  font-family: var(--font-ui);
  font-size: var(--fs-body);
  line-height: var(--lh-body);
}
