page {

  --theme: #1c1c1e;
  --ink: #1c1c1e;

  --strong: var(--theme);

  --strong-text: var(--theme);

  --theme-deep: #000000;
  --ink-strong: var(--theme-deep);

  --ink-2: #6b7280;
  --ink-3: #9ca3af;
  --ink-4: #c7c9cd;

  --on-theme: #ffffff;
  --on-theme-soft: rgba(255, 255, 255, .7);
  --on-ink: var(--on-theme);
  --on-ink-soft: var(--on-theme-soft);

  --bg: #f5f5f7;
  --surface: #ffffff;
  --sink: #f2f2f4;

  --line: #ececef;
  --line-2: #f4f4f6;
  --line-strong: #e2e2e6;

  --green: #2e7d5b;
  --green-soft: #e8f3ed;
  --amber: #b26a00;
  --amber-soft: #fdf2e2;
  --red: #c0392b;
  --red-soft: #fbeceb;
  --blue: #2f6f9f;
  --blue-soft: #eaf2f9;

  --gold: #d9b061;
  --gold-soft: rgba(217, 176, 97, .28);
  --celadon: #2e7d5b;
  --green-light: var(--green-soft);
  --green-edge: rgba(46, 125, 91, .2);
  --green-dark: #23624a;
  --green-deep: #1c1c1e;
  --bg-soft: var(--surface);
  --bg-sink: var(--sink);
  --card: var(--surface);
  --card-2: var(--sink);
  --amber-light: var(--amber-soft);
  --amber-edge: rgba(178, 106, 0, .22);
  --red-light: var(--red-soft);
  --red-edge: rgba(192, 57, 43, .22);
  --blue-light: var(--blue-soft);
  --ink-on-dark: var(--on-ink);

  --radius-sm: calc(16rpx * var(--ui-scale));

  --radius-ctl: calc(20rpx * var(--ui-scale));
  --radius: calc(20rpx * var(--ui-scale));
  --radius-block: calc(24rpx * var(--ui-scale));
  --radius-pill: 999rpx;

  --shadow: none;
  --shadow-lift: none;
  --shadow-press: none;

  --font-poem: "Kuibu Serif", "Songti SC", "STSong", "STZhongsong", "Source Han Serif SC",
    "Source Han Serif CN", "Noto Serif CJK SC", "Noto Serif SC", "SimSun", "SimSun-ExtB",
    "FangSong", serif;
  --font-ui: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB",
    "Microsoft YaHei", sans-serif;

  --font-num: -apple-system, "SF Pro Display", "Helvetica Neue", Arial, sans-serif;

  --ui-scale: 1;

  --fs-caption: calc(22rpx * var(--ui-scale));
  --fs-hint: calc(25rpx * var(--ui-scale));
  --fs-body: calc(29rpx * var(--ui-scale));
  --fs-title: calc(32rpx * var(--ui-scale));
  --fs-lead: calc(38rpx * var(--ui-scale));
  --fs-hero: calc(46rpx * var(--ui-scale));
  --fs-brand: calc(60rpx * var(--ui-scale));
  --fs-head: calc(46rpx * var(--ui-scale));
  --fs-stat: calc(64rpx * var(--ui-scale));
  --fs-score: calc(104rpx * var(--ui-scale));
  --fs-glyph: calc(200rpx * var(--ui-scale));
  --fs-mark: calc(52rpx * var(--ui-scale));
  --fs-poem: calc(36rpx * var(--ui-scale));
  --fs-pinyin: calc(18rpx * var(--ui-scale));
  --py-gap: calc(2rpx * var(--ui-scale));
  --py-slot: calc(34rpx * var(--ui-scale));

  --lh-tight: 1.3;
  --lh-body: 1.65;
  --lh-loose: 1.9;

  --ls-title: 1rpx;
  --ls-caption: 2rpx;

  --sp-1: calc(8rpx * var(--ui-scale));
  --sp-2: calc(16rpx * var(--ui-scale));
  --sp-3: calc(24rpx * var(--ui-scale));
  --sp-4: calc(32rpx * var(--ui-scale));
  --sp-5: calc(48rpx * var(--ui-scale));
  --sp-6: calc(64rpx * var(--ui-scale));
  --page-x: calc(28rpx * var(--ui-scale));

  --h-btn: calc(96rpx * var(--ui-scale));
  --h-btn-mini: calc(60rpx * var(--ui-scale));
  --h-act: calc(96rpx * var(--ui-scale));
  --h-row: calc(96rpx * var(--ui-scale));
  --h-field: calc(84rpx * var(--ui-scale));

  --h-opt: calc(76rpx * var(--ui-scale));
  --h-opt-seg: calc(56rpx * var(--ui-scale));

  --pad-opt-y: calc(4rpx * var(--ui-scale));
  --pad-opt-x: calc(24rpx * var(--ui-scale));

  --t-press: .12s;
  --t-move: .28s;
  --ease: cubic-bezier(.22, .61, .36, 1);

  background: var(--bg);
  color: var(--ink);
  font-family: var(--font-ui);
  font-size: var(--fs-body);
  line-height: var(--lh-body);
  -webkit-font-smoothing: antialiased;
}
