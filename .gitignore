node_modules/
.DS_Store
*.log

reference/

# 微信开发者工具的本地私有配置
miniprogram/project.private.config.json

# 语料编译产物由 scripts/build-data.js 生成，不入库（语料本身在 scripts/corpus/）
miniprogram/data/

# 云调用两栏由构建期从密钥仓库注入 server.js，值不进代码库
# （server.js 本体是空壳、要入库：它不在时 remote.js 整个 require 不进，
#   主包页面会在 onLoad 前就 MODULE_NOT_FOUND，首页连语料一起空）
dist/

# deploy/ 是部署描述；本机构建会摊一份上下文，别提交
deploy/.build/

# 开发者工具的工程文件只认 miniprogram/ 下这一份
/project.config.json
/project.private.config.json

# 分片缓存指纹（scripts/shard-stage.js 写，构建节点上那份缓存对不对就靠它）
.shard-fp
